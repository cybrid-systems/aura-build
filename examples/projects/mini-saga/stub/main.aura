; Broken main — wrong COUNT; still calls saga-run / saga-status
(define (show label val)
  (display label)(display "=")(display val)(newline))
(define (full-init)
  (idemp-init)
  (journal-init)
  (book-init)
  (pay-init)
  (ship-init)
  (saga-init))

(full-init)
(define ok (saga-run "s1" "r1" "10" "home"))
(show "OK" ok)
(show "ST1" (saga-status))
(define dup (saga-run "s1" "r1" "10" "home"))
(show "DUP" dup)
(show "ST1B" (saga-status))

(full-init)
