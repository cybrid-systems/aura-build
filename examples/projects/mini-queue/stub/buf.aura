; Intentionally sticky — enqueue OK but no real shared pending/leased/done wiring helpers
(define pending '())
(define leased '())
(define done '())
(define tick 0)
(define (queue-init)
  (set! pending '())
  (set! leased '())
  (set! done '())
  (set! tick 0))
(define (len xs)
  (if (null? xs) 0 (+ 1 (len (cdr xs)))))
(define (queue-enqueue id payload)
  (set! pending (append pending (list (list id payload))))
  (len pending))
