; Broken main — wrong COUNT; still calls queue ops so structural checks pass
(queue-init)
(define (show label val)
  (display label)(display "=")(display val)(newline))
(queue-enqueue "j1" "a")
(show "ENQ" (queue-enqueue "j2" "b"))
(show "LEASE_A" (queue-lease "w1" 5))
(show "LEASE_B" (queue-lease "w1" 5))
(show "LEASE_MISS" (queue-lease "w1" 5))
(show "ACK_OK" (queue-ack "j1"))
(queue-nack "j2")
(show "NACK_STATUS" (queue-status "j2"))
(queue-lease "w1" 2)
(queue-tick 2)
(show "AFTER_TICK" (queue-status "j2"))
(define last (queue-lease "w1" 5))
(show "DONE" (if (equal? last "miss") 0 (queue-ack last)))
; wrong: counts 5 including LEASE_MISS
(show "COUNT" 5)
