(define led-cash '())
(define led-pos '())
(define (ledger-init)
  (set! led-cash '())
  (set! led-pos '()))
(define (led-get table acct)
  (define (look xs)
    (if (null? xs) 0
        (if (equal? (car (car xs)) acct)
            (car (cdr (car xs)))
            (look (cdr xs)))))
  (look table))
(define (led-set table acct n)
  (define (drop xs)
    (if (null? xs) '()
        (if (equal? (car (car xs)) acct)
            (cdr xs)
            (cons (car xs) (drop (cdr xs))))))
  (cons (list acct n) (drop table)))
(define (ledger-fund acct cash pos)
  (set! led-cash (led-set led-cash acct cash))
  (set! led-pos (led-set led-pos acct pos)))
(define (ledger-cash acct) (led-get led-cash acct))
(define (ledger-pos acct) (led-get led-pos acct))
(define (ledger-debit-cash acct n)
  (set! led-cash (led-set led-cash acct (- (ledger-cash acct) n))))
(define (ledger-credit-cash acct n)
  (set! led-cash (led-set led-cash acct (+ (ledger-cash acct) n))))
(define (ledger-credit-pos acct n)
  (set! led-pos (led-set led-pos acct (+ (ledger-pos acct) n))))
(define (ledger-debit-pos acct n)
  (set! led-pos (led-set led-pos acct (- (ledger-pos acct) n))))
