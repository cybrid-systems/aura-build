(define bids-list '())
(define asks-list '())
(define book-seq 0)
(define (book-init)
  (set! bids-list '())
  (set! asks-list '())
  (set! book-seq 0))
(define (book-next-seq)
  (set! book-seq (+ book-seq 1))
  book-seq)
(define (book-bids) bids-list)
(define (book-asks) asks-list)
(define (book-add oid acct side price qty)
  (let ((o (list oid acct side price qty (book-next-seq))))
    (if (equal? side "buy")
        (set! bids-list (cons o bids-list))
        (set! asks-list (cons o asks-list)))
    o))
(define (book-drop-oid oid xs)
  (if (null? xs) '()
      (if (equal? (car (car xs)) oid)
          (cdr xs)
          (cons (car xs) (book-drop-oid oid (cdr xs))))))
(define (book-remove oid)
  (set! bids-list (book-drop-oid oid bids-list))
  (set! asks-list (book-drop-oid oid asks-list)))
(define (book-find-in oid xs)
  (if (null? xs) #f
      (if (equal? (car (car xs)) oid)
          (car xs)
          (book-find-in oid (cdr xs)))))
(define (book-find oid)
  (let ((b (book-find-in oid bids-list)))
    (if b b (book-find-in oid asks-list))))
(define (book-qty oid)
  (let ((o (book-find oid)))
    (if o (car (cdr (cdr (cdr (cdr o))))) 0)))
(define (book-set-qty-in oid q xs)
  (if (null? xs) '()
      (let ((o (car xs)))
        (if (equal? (car o) oid)
            (cons (list (car o) (car (cdr o)) (car (cdr (cdr o)))
                        (car (cdr (cdr (cdr o)))) q
                        (car (cdr (cdr (cdr (cdr (cdr o)))))))
                  (cdr xs))
            (cons o (book-set-qty-in oid q (cdr xs)))))))
(define (book-set-qty oid q)
  (if (book-find-in oid bids-list)
      (set! bids-list (book-set-qty-in oid q bids-list))
      (set! asks-list (book-set-qty-in oid q asks-list))))
