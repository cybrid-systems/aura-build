; Broken orchestrator
(define (exchange-init) #t)
(define (exchange-place cloid acct side price qty) "resting")
(define (exchange-cancel cloid) "missing")
(define (exchange-halt) "open")
(define (exchange-resume) "open")
(define (exchange-snapshot) "broken")
(define (exchange-replay) "ok")
(define (exchange-eq a b) 0)
