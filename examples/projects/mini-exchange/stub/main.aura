; Broken main — wrong values; still calls exchange/query
(define (show label val)
  (display label)(display "=")(display val)(newline))
(exchange-init)
(exchange-place "A1" "Alice" "buy" 5 10)
(exchange-place "B1" "Bob" "sell" 5 7)
(show "FILL1" "filled")
(show "LEFT1" (query-left "A1"))
(show "RISK" (exchange-place "BIG" "Alice" "buy" 9 100))
(exchange-place "A2" "Alice" "sell" 5 3)
(show "STP" 7)
(show "CXL" (exchange-cancel "A1"))
(show "HALT" (exchange-halt))
(show "REJ_HALT" (exchange-place "B2" "Bob" "sell" 5 1))
(show "RESUME" (exchange-resume))
(show "DUP" (exchange-place "A1" "Alice" "buy" 5 1))
(define snap (exchange-snapshot))
(show "REPLAY" (exchange-replay))
(show "EQ" (exchange-eq snap (exchange-snapshot)))
(show "FEES" (query-fees))
(show "COUNT" 0)
