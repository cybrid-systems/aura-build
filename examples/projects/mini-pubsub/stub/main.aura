; Broken main — wrong COUNT; still calls bus ops so structural checks pass
(bus-init)
(define (show label val)
  (display label)(display "=")(display val)(newline))
(define (len xs)
  (if (null? xs) 0 (+ 1 (len (cdr xs)))))
(topic-create "t")
(subscribe "t" "a")
(subscribe "t" "b")
(show "SUBS" (len (sub-list "t")))
(show "PUB" (publish "t" "hello"))
(define pa (poll "a"))
(show "POLL_A" pa)
(define pb (poll "b"))
(show "POLL_B" pb)
(define pm (poll "a"))
(show "POLL_MISS" pm)
(unsubscribe "t" "a")
(show "AFTER_UNSUB" (publish "t" "world"))
(define pa2 (poll "a"))
(show "POLL_A2" pa2)
(define pb2 (poll "b"))
(show "POLL_B2" pb2)
; wrong: counts all five polls
(show "COUNT" 5)
