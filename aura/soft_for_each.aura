; Soft-materialized for-each helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=recur-begin  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft oneshot unbound for-each (orch/worldline/acp/export redefine)
(begin
  (export for-each)
  (define for-each
    (lambda (f xs)
      (if (null? xs)
        #t
        (begin
          (f (car xs))
          (for-each
            f (cdr xs)))))))
