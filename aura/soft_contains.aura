; Soft-materialized contains? helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=scan-letrec  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: substring needle checks (export/redaction/path search)
(begin
  (export contains?)
  (define contains?
    (lambda (s sub)
      (let ((n (string-length sub)))
        (let ((m (string-length s)))
          (if (=
              n 0)
            #t
            (letrec ((loop (lambda (i)
                (if (>
                    (+
                      i n) m)
                  #f
                  (if (equal?
                      (substring
                        s i (+
                          i n)) sub)
                    #t
                    (loop (+
                        i 1)))))))
              (loop 0))))))))
