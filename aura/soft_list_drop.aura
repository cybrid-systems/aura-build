; Soft-materialized list-drop helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=letrec-go  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip 069bafa gold-binds R7RS drop (#4221 CLOSED). soft_list_drop =
; denseness defense-in-depth (prefer Soft-native drop)
(begin
  (export list-drop)
  (define list-drop
    (lambda (xs n)
      (letrec ((go (lambda (xs n)
          (if (or
              (<=
                n 0) (null? xs))
            xs
            (go
              (cdr xs) (-
                n 1))))))
        (go
          xs n)))))
