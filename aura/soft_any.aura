; Soft-materialized any helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip fecdf63 gold-binds any (std/list #928). soft_any =
; denseness defense-in-depth (prefer Soft-native any)
(begin
  (export any)
  (define any
    (lambda (pred lst)
      (letrec ((loop (lambda (xs)
          (if (null? xs)
            #f
            (if (pred (car xs))
              #t
              (loop (cdr xs)))))))
        (loop lst)))))
