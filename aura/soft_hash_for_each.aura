; Soft-materialized hash-for-each helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let-keys  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft oneshot unbound hash-for-each (orch/harness/export use it;
; Soft std/hash.aura defines it but Soft oneshot does not auto-load std/hash)
(begin
  (export hash-for-each)
  (define hash-for-each
    (lambda (h f)
      (letrec ((loop (lambda (ks)
          (if (null? ks)
            #t
            (begin
              (f
                (car ks) (hash-ref
                  h (car ks)))
              (loop (cdr ks)))))))
        (loop (hash-keys h))))))
