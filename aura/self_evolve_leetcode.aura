; The kernel edits a leetcode solution.
; number-of-1-bits solution_2 defines solve but prints no CASE lines,
; so the harness scored 0. Candidates rebind solve. The live calls are
; the observation. The higher score is written to solution_evolved.aura.
(require "compat" all:)
(load "corpus/leetcode/number-of-1-bits/solution_2.aura")

(let* ((good-body "(lambda (n) (let loop ((i 0) (acc 0)) (if (>= i 32) acc (loop (+ i 1) (+ acc (modulo (quotient n (expt 2 i)) 2))))))")
       (hit (lambda (n expect)
              (if (= (solve n) expect) 1 0)))
       (score (lambda ()
                (+ (hit 0 0)
                   (hit 1 1)
                   (hit 11 3)
                   (hit 128 1)
                   (hit 255 8)
                   (hit 4294967295 32)
                   (hit 4294967293 31)
                   (hit 2147483648 1))))
       (score-body (lambda (body)
                     (mutate:rebind "solve" body "solve-cand")
                     (eval-current)
                     (score)))
       (orig (score))
       (bad (score-body "(lambda (n) 0)"))
       (good (score-body good-body))
       (use-good (> good bad))
       (body-src "(define (solve n) (let loop ((i 0) (acc 0)) (if (>= i 32) acc (loop (+ i 1) (+ acc (modulo (quotient n (expt 2 i)) 2))))))")
       (cases "(display \"CASE0=\") (display (solve 0)) (newline) (display \"CASE1=\") (display (solve 1)) (newline) (display \"CASE2=\") (display (solve 11)) (newline) (display \"CASE3=\") (display (solve 128)) (newline) (display \"CASE4=\") (display (solve 255)) (newline) (display \"CASE5=\") (display (solve 4294967295)) (newline) (display \"CASE6=\") (display (solve 4294967293)) (newline) (display \"CASE7=\") (display (solve 2147483648)) (newline)")
       (path "corpus/leetcode/number-of-1-bits/solution_evolved.aura")
       (text (string-append "(require \"compat\" all:)\n" body-src "\n" cases))
       (_ (if use-good (write-file path text) #f)))
  (display "EVOLVE_OK selected=")
  (display (if use-good "good" "bad"))
  (display " orig=")(display orig)
  (display " bad=")(display bad)
  (display " good=")(display good)
  (newline)
  (display "EVOLVE_WROTE ")
  (display (if use-good path "none"))
  (newline))
