; Invent popcount without a handwritten loop skeleton.
; A program is three opcodes. The machine is general:
;   0 add the low bit of x into a
;   1 x := x/2
;   2 x := x/10
;   3 a := a+1
;   4 if x!=0 go to instruction 0, else fall through
;   5 a := 0
; Search scores every triple on the eight number-of-1-bits cases.
; Nothing in the search names the winning triple.
(set-code "(define (solve n) 0)")
(eval-current)

(define (op-at ops pc)
  (if (= pc 0) (car ops) (if (= pc 1) (car (cdr ops)) (car (cdr (cdr ops))))))

(define (exec ops n)
  (let loop ((x n) (a 0) (pc 0) (fuel 128))
    (if (or (<= fuel 0) (>= pc 3))
        a
        (let ((op (op-at ops pc)))
          (if (= op 0)
              (loop x (+ a (modulo x 2)) (+ pc 1) (- fuel 1))
              (if (= op 1)
                  (loop (quotient x 2) a (+ pc 1) (- fuel 1))
                  (if (= op 2)
                      (loop (quotient x 10) a (+ pc 1) (- fuel 1))
                      (if (= op 3)
                          (loop x (+ a 1) (+ pc 1) (- fuel 1))
                          (if (= op 4)
                              (if (= x 0)
                                  (loop x a (+ pc 1) (- fuel 1))
                                  (loop x a 0 (- fuel 1)))
                              (loop x 0 (+ pc 1) (- fuel 1)))))))))))

(define (score ops)
  (if (not (= (exec ops 0) 0)) 0
      (if (not (= (exec ops 1) 1)) 0
          (if (not (= (exec ops 11) 3)) 0
              (if (not (= (exec ops 128) 1)) 0
                  (if (not (= (exec ops 255) 8)) 0
                      (if (not (= (exec ops 4294967295) 32)) 0
                          (if (not (= (exec ops 4294967293) 31)) 0
                              (if (not (= (exec ops 2147483648) 1)) 0
                                  8)))))))))

(let* ((searched
        (let i-loop ((i 0) (best (cons -1 (list 0 0 0))))
          (if (>= i 6)
              best
              (i-loop (+ i 1)
                (let j-loop ((j 0) (best best))
                  (if (>= j 6)
                      best
                      (j-loop (+ j 1)
                        (let k-loop ((k 0) (best best))
                          (if (>= k 6)
                              best
                              (k-loop (+ k 1)
                                (let* ((ops (list i j k))
                                       (s (score ops)))
                                  (if (> s (car best)) (cons s ops) best))))))))))))
       (best-score (car searched))
       (ops (cdr searched))
       (path "corpus/leetcode/number-of-1-bits/solution_invented.aura")
       (text (string-append
               "(define (op-at ops pc) (if (= pc 0) (car ops) (if (= pc 1) (car (cdr ops)) (car (cdr (cdr ops))))))\n"
               "(define (exec ops n) (let loop ((x n) (a 0) (pc 0) (fuel 128)) (if (or (<= fuel 0) (>= pc 3)) a (let ((op (op-at ops pc))) (if (= op 0) (loop x (+ a (modulo x 2)) (+ pc 1) (- fuel 1)) (if (= op 1) (loop (quotient x 2) a (+ pc 1) (- fuel 1)) (if (= op 2) (loop (quotient x 10) a (+ pc 1) (- fuel 1)) (if (= op 3) (loop x (+ a 1) (+ pc 1) (- fuel 1)) (if (= op 4) (if (= x 0) (loop x a (+ pc 1) (- fuel 1)) (loop x a 0 (- fuel 1))) (loop x 0 (+ pc 1) (- fuel 1)))))))))))\n"
               "(define ops (list " (number->string (car ops)) " " (number->string (car (cdr ops))) " " (number->string (car (cdr (cdr ops)))) "))\n"
               "(define (solve n) (exec ops n))\n"
               "(display \"CASE0=\") (display (solve 0)) (newline)"
               "(display \"CASE1=\") (display (solve 1)) (newline)"
               "(display \"CASE2=\") (display (solve 11)) (newline)"
               "(display \"CASE3=\") (display (solve 128)) (newline)"
               "(display \"CASE4=\") (display (solve 255)) (newline)"
               "(display \"CASE5=\") (display (solve 4294967295)) (newline)"
               "(display \"CASE6=\") (display (solve 4294967293)) (newline)"
               "(display \"CASE7=\") (display (solve 2147483648)) (newline)"))
       (_ (if (= best-score 8) (write-file path text) #f)))
  (display "EVOLVE_OK score=")
  (display best-score)
  (display " tried=216 ops=")
  (display (car ops))
  (display ",")
  (display (car (cdr ops)))
  (display ",")
  (display (car (cdr (cdr ops))))
  (newline)
  (display "EVOLVE_WROTE ")
  (display (if (= best-score 8) path "none"))
  (newline))
