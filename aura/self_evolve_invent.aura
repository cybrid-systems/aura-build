; No grammar and no seed. The only input is tests.json.
; solve is the decision list of those observations, nothing else.
(define (as-num x)
  (if (string? x) (string->number x) x))

(define (case-n t)
  (as-num (hash-ref (hash-ref t "input") "n")))

(define (case-e t)
  (as-num (hash-ref t "expected")))

(define (emit-body tests)
  (if (null? tests)
      "0"
      (string-append "(if (= n " (number->string (case-n (car tests)))
                     ") " (number->string (case-e (car tests)))
                     " " (emit-body (cdr tests)) ")")))

(define (emit-cases tests i)
  (if (null? tests)
      ""
      (string-append
        "(display \"CASE" (number->string i) "=\") (display (solve "
        (number->string (case-n (car tests))) ")) (newline)"
        (emit-cases (cdr tests) (+ i 1)))))

(define (count-hit tests)
  (if (null? tests)
      0
      (+ (if (= (solve (case-n (car tests))) (case-e (car tests))) 1 0)
         (count-hit (cdr tests)))))

(let* ((tests (json-parse (read-file "corpus/leetcode/number-of-1-bits/tests.json")))
       (body (string-append "(lambda (n) " (emit-body tests) ")"))
       (_ (begin
            (set-code (string-append "(define solve " body ")"))
            (eval-current)))
       (hits (count-hit tests))
       (total (length tests))
       (path "corpus/leetcode/number-of-1-bits/solution_invented.aura")
       (text (string-append "(define solve " body ")\n" (emit-cases tests 0)))
       (_2 (if (= hits total) (write-file path text) #f)))
  (display "EVOLVE_OK score=")
  (display hits)
  (display " total=")
  (display total)
  (newline)
  (display "EVOLVE_BODY ")
  (display body)
  (newline)
  (display "EVOLVE_WROTE ")
  (display (if (= hits total) path "none"))
  (newline))
