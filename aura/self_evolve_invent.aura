; Invent a popcount by search. No candidate is labeled correct.
; The space is an operator vocabulary inside one loop shape.
; Observation is eight live calls. The highest score is written out.
(require "compat" all:)
(set-code "(define (solve n) 0)")
(eval-current)

(define (op-name i)
  (if (= i 0) "+" (if (= i 1) "-" "bitwise-xor")))

(define (bit-expr i)
  (if (= i 0) "(modulo x 2)" (if (= i 1) "(modulo x 10)" "1")))

(define (next-expr i)
  (if (= i 0) "(quotient x 2)" "(quotient x 10)"))

(define (make-body op bit next)
  (string-append
    "(lambda (n) (let loop ((x n) (acc 0)) (if (= x 0) acc (loop "
    next " (" op " acc " bit ")))))"))

(define (hit n expect)
  (if (= (solve n) expect) 1 0))

(define (score)
  (+ (hit 0 0)
     (hit 1 1)
     (hit 11 3)
     (hit 128 1)
     (hit 255 8)
     (hit 4294967295 32)
     (hit 4294967293 31)
     (hit 2147483648 1)))

(define (consider body best-score best-body)
  (mutate:rebind "solve" body "invent")
  (eval-current)
  (let ((s (score)))
    (if (> s best-score)
        (cons s body)
        (cons best-score best-body))))

(let* ((searched
        (let op-loop ((oi 0) (best (cons -1 "")))
          (if (>= oi 3)
              best
              (op-loop (+ oi 1)
                (let bit-loop ((bi 0) (best best))
                  (if (>= bi 3)
                      best
                      (bit-loop (+ bi 1)
                        (let next-loop ((ni 0) (best best))
                          (if (>= ni 2)
                              best
                              (next-loop (+ ni 1)
                                (consider
                                  (make-body (op-name oi) (bit-expr bi) (next-expr ni))
                                  (car best)
                                  (cdr best))))))))))))
       (best-score (car searched))
       (best-body (cdr searched))
       (path "corpus/leetcode/number-of-1-bits/solution_invented.aura")
       (text (string-append
               "(require \"compat\" all:)\n(define solve "
               best-body
               ")\n"
               "(display \"CASE0=\") (display (solve 0)) (newline)"
               "(display \"CASE1=\") (display (solve 1)) (newline)"
               "(display \"CASE2=\") (display (solve 11)) (newline)"
               "(display \"CASE3=\") (display (solve 128)) (newline)"
               "(display \"CASE4=\") (display (solve 255)) (newline)"
               "(display \"CASE5=\") (display (solve 4294967295)) (newline)"
               "(display \"CASE6=\") (display (solve 4294967293)) (newline)"
               "(display \"CASE7=\") (display (solve 2147483648)) (newline)"))
       (_ (if (= best-score 8) (write-file path text) #f)))
  (display "EVOLVE_OK score=")
  (display best-score)
  (display " tried=18")
  (newline)
  (display "EVOLVE_BODY ")
  (display best-body)
  (newline)
  (display "EVOLVE_WROTE ")
  (display (if (= best-score 8) path "none"))
  (newline))
