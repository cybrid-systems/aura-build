; aura-build kernel entry — dispatch AURA_BUILD_CMD
; Invoked by thin host with AURA_PATH covering aura/ + stdlib.

(require "util" all:)
(require "traj" all:)
(require "orch" all:)
(require "prove" all:)
(require "harness" all:)
(require "memory" all:)
(require "l2" all:)
(require "export" all:)
(require "acp" all:)
(require "tui" all:)
(require "self_evolve" all:)
(require "llm_dogfood" all:)
(require "std/io" all:)

(define (write-response obj)
  (let* ((root (env-get "AURA_BUILD_HARNESS_ROOT" ".aura-build"))
         (path (env-get "AURA_BUILD_RESPONSE" (join-path root "kernel-response.json"))))
    (ensure-dir (dirname-path path))
    (write-file path (normalize-json-empties (json-encode obj)))
    path))

(define (print-run-summary result)
  (let* ((ep (hash-ref result "episode"))
         (sel (hash-ref result "selected"))
         (rt (hash-ref ep "runtime"))
         (ev (hash-ref sel "eval")))
    (display "selected=")(display (hash-ref sel "id"))
    (display " fitness=")(display (hash-ref ev "fitness"))
    (display " mode=")(display (hash-ref rt "mode"))
    (display " kernel=aura")
    (display " incr_proven=")(display (hash-ref rt "incr_proven" #f))
    (display " measured=")(display (hash-ref rt "measured" #f))
    (display " fiber_live=")(display (hash-ref rt "fiber_live" #f))
    (display " worldline_backend=")(display (hash-ref rt "worldline_backend" "file"))
    (display " episode=")(display (hash-ref ep "episode_id"))
    (display " wrote=")(display (hash-ref result "path"))
    (newline)))

(define (cmd-run)
  (let ((result (run-episode)))
    (print-run-summary result)
    (write-response (hash "cmd" "run" "ok" #t
                          "episode_id" (hash-ref (hash-ref result "episode") "episode_id")
                          "path" (hash-ref result "path")
                          "selected_id" (hash-ref (hash-ref result "selected") "id")
                          "fitness" (hash-ref (hash-ref (hash-ref result "selected") "eval") "fitness")
                          "runtime" (hash-ref (hash-ref result "episode") "runtime")))
    0))

(define (cmd-prove)
  (let* ((cycles (env-int "AURA_BUILD_CYCLES" 8))
         (pressure (env-int "AURA_BUILD_WORLDLINES" 3))
         (root (env-get "AURA_BUILD_HARNESS_ROOT" ".aura-build"))
         (report (prove-or-refuse cycles pressure))
         (path (write-prove-report report root)))
    (display "incr_proven=")(display (hash-ref report "incr_proven"))
    (display " measured=")(display (hash-ref report "measured"))
    (display " aura_healthy=")(display (hash-ref report "aura_healthy"))
    (display " reason=")(display (hash-ref report "reason"))
    (display " session_model=")(display (hash-ref report "session_model"))
    (display " fiber_live=")(display (hash-ref report "fiber_live"))
    (display " kernel=aura")
    (display " cycles_ok=")(display (hash-ref report "cycles_ok"))
    (display "/")(display (hash-ref report "cycles_completed"))
    (display " incr_valid=")(display (hash-ref report "cycles_incr_valid"))
    (display "/")(display (hash-ref report "cycles_completed"))
    (display " report=")(display path)
    (newline)
    (write-response (hash "cmd" "prove-incr" "ok" #t "report" report "path" path))
    0))

(define (cmd-doctor)
  (let* ((root (env-get "AURA_BUILD_HARNESS_ROOT" ".aura-build"))
         (snap (doctor-snapshot root))
         (h (hash-ref snap "honesty")))
    (display "aura-build doctor (Aura kernel)")(newline)
    (display "  aura_bin        = ")(display (hash-ref snap "aura_bin"))(newline)
    (display "  aura_probe_ok   = ")(display (if (hash-ref snap "aura_probe_ok") "True" "False"))(newline)
    (display "  prove_report    = ")(display (hash-ref snap "prove_incr_report_path"))(newline)
    (display "  honesty         = incr_proven=")(display (if (hash-ref h "incr_proven") "True" "False"))
    (display " fiber_live=")(display (if (hash-ref h "fiber_live") "True" "False"))
    (display " session_model=")(display (hash-ref h "session_model"))
    (display " l1_backend=")(display (hash-ref h "l1_backend" "hot-strategy"))
    (display " kernel=aura")(newline)
    (let ((f (hash-ref snap "fiber" (hash))))
      (display "  fiber           = probed=")(display (hash-ref f "probed" #f))
      (display " oneshot=")(display (hash-ref f "oneshot_fiber_ok" #f))
      (display " same_flatast_multi=")(display (hash-ref f "same_flatast_multi_ok" #f))
      (display " serve_session=")(display (hash-ref f "serve_session_ok" #f))
      (display " backend=")(display (hash-ref f "spawn_backend" 0))
      (display " reason=")(display (hash-ref f "reason" ""))(newline)
      (display "  fiber_missing   = ")(display (hash-ref f "missing_surface" ""))(newline))
    (write-response (hash "cmd" "doctor" "ok" #t "snapshot" snap))
    0))

(define (cmd-harness-mutate)
  (let ((result (run-harness-canary)))
    (display "mid=")(display (hash-ref result "mid" "-"))
    (display " outcome=")(display (hash-ref result "outcome"))
    (display " accepted=")(display (hash-ref result "accepted"))
    (display " l1_backend=")(display (hash-ref result "l1_backend" "file"))
    (display " kernel=aura")
    (display " episode=")(display (hash-ref (hash-ref result "episode") "episode_id"))
    (display " wrote=")(display (hash-ref result "path"))
    (newline)
    (write-response (hash "cmd" "harness-mutate" "ok" #t
                          "accepted" (hash-ref result "accepted")
                          "outcome" (hash-ref result "outcome")
                          "l1_backend" (hash-ref result "l1_backend" "file")
                          "mid" (hash-ref result "mid" "")
                          "path" (hash-ref result "path")
                          "episode" (hash-ref result "episode")))
    (if (hash-ref result "accepted") 0 1)))

(define (cmd-memory)
  (let* ((root (env-get "AURA_BUILD_HARNESS_ROOT" ".aura-build"))
         (op (env-get "AURA_BUILD_MEM_OP" "get"))
         (profile (env-get "AURA_BUILD_MEM_PROFILE" "default"))
         (key (env-get "AURA_BUILD_MEM_KEY" ""))
         (value (env-get "AURA_BUILD_MEM_VALUE" "")))
    (cond
      ((equal? op "get")
       (let ((v (memory-get root profile key)))
         (if (or (null? v) (eq? v #f))
           (begin (display "null")(newline) (write-response (hash "ok" #f)) 1)
           (begin (display (if (string? v) v (json-encode v)))(newline)
                  (write-response (hash "ok" #t "value" v)) 0))))
      ((equal? op "set")
       (let ((note (memory-set root profile key value)))
         (display (json-encode note))(newline)
         (write-response (hash "ok" #t "note" note)) 0))
      ((equal? op "list")
       (let ((notes (memory-list root profile)))
         (display (json-encode notes))(newline)
         (write-response (hash "ok" #t "notes" notes)) 0))
      (else (display "unknown mem op")(newline) 2))))

(define (cmd-l2)
  (let* ((root (env-get "AURA_BUILD_HARNESS_ROOT" ".aura-build"))
         (op (env-get "AURA_BUILD_L2_OP" "show"))
         (id (env-get "AURA_BUILD_L2_ID" ""))
         (notes (env-get "AURA_BUILD_L2_NOTES" "")))
    (cond
      ((equal? op "show")
       (let ((ref (l2-resolve root id)))
         (if (not ref)
           (begin (display "null")(newline) 1)
           (begin
             (display "id=")(display (hash-ref ref "weights_id"))
             (display " loaded=")(display (hash-ref ref "loaded"))
             (display " stub=")(display (hash-ref ref "stub"))
             (display " artifact_present=")(display (hash-ref ref "artifact_present"))
             (display " path=")(display (hash-ref ref "artifact_path"))
             (newline)
             (write-response (hash "ok" #t "ref" ref)) 0))))
      ((equal? op "list")
       (let ((refs (l2-list root)))
         (display (json-encode refs))(newline)
         (write-response (hash "ok" #t "refs" refs)) 0))
      ((equal? op "promote")
       (let ((ref (l2-promote root id notes)))
         (display "promoted id=")(display (hash-ref ref "weights_id"))
         (display " stub=")(display (hash-ref ref "stub"))
         (display " artifact_present=")(display (hash-ref ref "artifact_present"))
         (display " path=")(display (hash-ref ref "artifact_path"))
         (newline)
         (write-response (hash "ok" #t "ref" ref)) 0))
      (else 2))))

(define (cmd-harness-show)
  (let* ((root (env-get "AURA_BUILD_HARNESS_ROOT" ".aura-build"))
         (cfg (load-harness root)))
    (display "harness_id=")(display (hash-ref cfg "harness_id"))
    (display " version=")(display (hash-ref cfg "version"))
    (display " worldline_count=")(display (hash-ref cfg "worldline_count"))
    (display " routing=")(display (hash-ref cfg "routing"))
    (newline)
    (write-response (hash "ok" #t "harness" cfg))
    0))


(define (cmd-export)
  (let ((result (export-trajectories))
        (want-pq (env-bool "AURA_BUILD_EXPORT_WANT_PARQUET" #t)))
    (display "exported=")(display (hash-ref result "episodes_exported" 0))
    (display " files=")(display (hash-ref result "files_read" 0))
    (display " skipped_invalid=")(display (hash-ref result "episodes_skipped_invalid" 0))
    (display " redacted=")(display (hash-ref result "redacted" #t))
    (display " kernel=aura")
    (display " json=")(display (hash-ref result "json_path" ""))
    (newline)
    (if want-pq
      (begin
        (display "parquet_skip_reason=")
        (display (hash-ref result "parquet_skip_reason" ""))
        (newline))
      #t)
    (write-response (hash "cmd" "export" "ok" (hash-ref result "ok" #f)
                          "result" result))
    (if (hash-ref result "ok" #f) 0 2)))

(define (cmd-acp)
  (acp-run))

(define (cmd-tui)
  (tui-run))

(define (cmd-self-evolve)
  (let ((result (run-self-evolve)))
    (write-response (hash "cmd" "self-evolve"
                          "ok" (hash-ref result "ok" #f)
                          "commit_ready" (hash-ref result "commit_ready" #f)
                          "traj_id" (hash-ref result "traj_id" "")
                          "harness_mid" (hash-ref result "harness_mid" "")
                          "selected_id" (hash-ref result "selected_id" "")
                          "fitness" (hash-ref result "fitness" 0)
                          "generation" (hash-ref result "generation" 0)
                          "path" (hash-ref result "path" "")
                          "stamp_path" (hash-ref result "stamp_path" "")
                          "commit_message" (hash-ref result "commit_message" "")
                          "reason" (hash-ref result "reason" "")
                          "verify" (hash-ref result "verify" (hash))
                          "honesty" (hash-ref result "honesty" (hash))
                          "materialized" (hash-ref result "materialized" (list))
                          "canary_outcome" (hash-ref result "canary_outcome" "")
                          "kernel" "aura"))
    (if (hash-ref result "ok" #f) 0 1)))



(define (cmd-llm-dogfood)
  (let ((result (run-llm-dogfood)))
    (write-response (hash "cmd" "llm-dogfood"
                          "ok" (hash-ref result "ok" #f)
                          "traj_id" (hash-ref result "traj_id" "")
                          "selected_id" (hash-ref result "selected_id" "")
                          "path" (hash-ref result "path" "")
                          "reason" (hash-ref result "reason" "")
                          "honesty" (hash-ref result "honesty" (hash))
                          "kernel" "aura"))
    (if (hash-ref result "ok" #f) 0 1)))

(define (kernel-main)
  (let ((cmd (env-get "AURA_BUILD_CMD" "run")))
    (display "AURA_BUILD_KERNEL cmd=")(display cmd)(newline)
    (cond
      ((equal? cmd "run") (cmd-run))
      ((equal? cmd "prove-incr") (cmd-prove))
      ((equal? cmd "doctor") (cmd-doctor))
      ((equal? cmd "harness-mutate") (cmd-harness-mutate))
      ((equal? cmd "memory") (cmd-memory))
      ((equal? cmd "l2") (cmd-l2))
      ((equal? cmd "harness-show") (cmd-harness-show))
      ((equal? cmd "export") (cmd-export))
      ((equal? cmd "acp") (cmd-acp))
      ((equal? cmd "tui") (cmd-tui))
      ((equal? cmd "self-evolve") (cmd-self-evolve))
      ((equal? cmd "llm-dogfood") (cmd-llm-dogfood))
      (else
        (display "unknown AURA_BUILD_CMD=")(display cmd)(newline)
        (write-response (hash "ok" #f "error" "unknown_cmd"))
        2))))

(define *_kernel_exit* (kernel-main))
#t
