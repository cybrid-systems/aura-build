; Soft-materialized last helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip 32b07d8 gold-binds last on oneshot. soft_last =
; denseness defense-in-depth (prefer Soft-native last)
(begin
  (export last)
  (define last
    (lambda (lst)
      (if (null? lst)
        (quote ())
        (letrec ((loop (lambda (xs)
            (if (null? (cdr xs))
              (car xs)
              (loop (cdr xs))))))
          (loop lst))))))
