; Soft-materialized starts-with? helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=prefix-loop  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; soft_export_restored=true  (Soft current-source emptied export list)
(export starts-with?)
(begin
  ; Soft dropped export names — restored
  (define starts-with?
    (lambda (s pre)
      (let ((n (string-length pre)))
        (let ((m (string-length s)))
          (if (>
              n m)
            #f
            (equal?
              (substring
                s 0 n) pre)))))))
