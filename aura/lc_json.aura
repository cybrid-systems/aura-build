; Print a solve result as the JSON text tests.json stores.
; Lists display as "(0 1)"; the harness compares "[0,1]".
(export lc-json lc-show)

(require "std/string" all:)

(define (lc-escape s)
  (let loop ((i 0) (acc ""))
    (if (>= i (string-length s))
        acc
        (let ((c (string-ref s i)))
          (if (or (= c 34) (= c 92))
              (loop (+ i 1) (string-append acc "\\" (substring s i (+ i 1))))
              (loop (+ i 1) (string-append acc (substring s i (+ i 1)))))))))

(define (lc-json-list xs first)
  (if (not (pair? xs))
      ""
      (string-append (if first "" ",")
                     (lc-json (car xs))
                     (lc-json-list (cdr xs) #f))))

(define (lc-json v)
  (cond
    ((boolean? v) (if v "true" "false"))
    ((number? v) (number->string v))
    ((string? v) (string-append "\"" (lc-escape v) "\""))
    ((null? v) "[]")
    ((pair? v) (string-append "[" (lc-json-list v #t) "]"))
    (else "null")))

(define (lc-show id v)
  (display "CASE")
  (display id)
  (display "=")
  (display (lc-json v))
  (newline))
