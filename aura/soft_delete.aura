; Soft-materialized delete helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip 25c8ae0 gold-binds delete (#4226 CLOSED). soft_delete =
; defense-in-depth denseness materialize (selected=named-let)
(begin
  (export delete)
  (define delete
    (lambda (x lst)
      (letrec ((loop (lambda (xs acc)
          (if (null? xs)
            (reverse acc)
            (loop
              (cdr xs) (if (equal?
                  (car xs) x)
                acc
                (cons
                  (car xs) acc)))))))
        (loop
          lst (quote ()))))))
