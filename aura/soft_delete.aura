; Soft-materialized delete helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip 7c0952a gold-binds delete (#4226 CLOSED). soft_delete =
; denseness defense-in-depth; prefer Soft-native.
(begin
  (export delete)
  (define delete
    (lambda (x lst)
      (letrec ((loop (lambda (xs acc)
          (if (null? xs)
            (reverse acc)
            (loop
              (cdr xs) (if (equal?
                  (car xs) x)
                acc
                (cons
                  (car xs) acc)))))))
        (loop
          lst (quote ()))))))
