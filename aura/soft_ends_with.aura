; Soft-materialized ends-with? helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=suffix-loop  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: path/export suffix checks (e.g. ends-with-jsonl?)
(begin
  (export ends-with?)
  (define ends-with?
    (lambda (s suf)
      (let ((n (string-length suf)))
        (let ((m (string-length s)))
          (if (>
              n m)
            #f
            (equal?
              (substring
                s (-
                  m n) m) suf)))))))
