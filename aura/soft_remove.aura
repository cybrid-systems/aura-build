; Soft-materialized remove helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip fecdf63 gold-binds remove (#4224 CLOSED). soft_remove =
; denseness defense-in-depth (prefer Soft-native remove)
(begin
  (export remove)
  (define remove
    (lambda (pred lst)
      (letrec ((loop (lambda (xs acc)
          (if (null? xs)
            (reverse acc)
            (loop
              (cdr xs) (if (pred (car xs))
                acc
                (cons
                  (car xs) acc)))))))
        (loop
          lst (quote ()))))))
