; Soft-materialized remove helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft oneshot unbound remove (Soft std/list does not export
; remove — SRFI-1 gap #4224; Soft tip 5954717 has find/count/filter)
(begin
  (export remove)
  (define remove
    (lambda (pred lst)
      (letrec ((loop (lambda (xs acc)
          (if (null? xs)
            (reverse acc)
            (loop
              (cdr xs) (if (pred (car xs))
                acc
                (cons
                  (car xs) acc)))))))
        (loop
          lst (quote ()))))))
