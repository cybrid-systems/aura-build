; Soft-materialized all helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft oneshot unbound all (Soft std/list defines iterative
; any/all #928; Soft oneshot does not auto-load std/list; sibling of any)
(begin
  (export all)
  (define all
    (lambda (pred lst)
      (letrec ((loop (lambda (xs)
          (if (null? xs)
            #t
            (if (pred (car xs))
              (loop (cdr xs))
              #f)))))
        (loop lst)))))
