; Soft-materialized all helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip fecdf63 gold-binds all (std/list #928). soft_all =
; denseness defense-in-depth (prefer Soft-native all)
(begin
  (export all)
  (define all
    (lambda (pred lst)
      (letrec ((loop (lambda (xs)
          (if (null? xs)
            #t
            (if (pred (car xs))
              (loop (cdr xs))
              #f)))))
        (loop lst)))))
