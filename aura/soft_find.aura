; Soft-materialized find helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft tip 32b07d8 gold-binds find (#4220 CLOSED). soft_find =
; denseness defense-in-depth (prefer Soft-native find)
(begin
  (export find)
  (define find
    (lambda (pred lst)
      (letrec ((loop (lambda (xs)
          (if (null? xs)
            (quote ())
            (if (pred (car xs))
              (car xs)
              (loop (cdr xs)))))))
        (loop lst)))))
