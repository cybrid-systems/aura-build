; Soft-materialized find helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=named-let  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft oneshot unbound find (Soft std/list does not export
; find — SRFI-1 gap; Soft oneshot auto-loads list/string/hash/math only)
(begin
  (export find)
  (define find
    (lambda (pred lst)
      (letrec ((loop (lambda (xs)
          (if (null? xs)
            (quote ())
            (if (pred (car xs))
              (car xs)
              (loop (cdr xs)))))))
        (loop lst)))))
