; Soft-materialized string-upcase helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=map-list  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: util/orch/harness normalize (Soft oneshot lacks string-upcase prim)
(begin
  (export string-upcase)
  (define string-upcase
    (lambda (s)
      (list->string (map
          (lambda (c)
            (if (and
                (>=
                  c 97) (<=
                  c 122))
              (-
                c 32)
              c)) (string->list s))))))
