; Soft-materialized hash-empty? helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=hash-length-eq  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft oneshot unbound hash-empty? (Soft std/hash defines via
; hash-length; Soft oneshot does not auto-load std/hash; sibling of hash-fold)
(begin
  (export hash-empty?)
  (define hash-empty?
    (lambda (h)
      (=
        (hash-length h) 0))))
