; Soft-materialized string-split helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=scan-letrec  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: line/catalog/export splits (Soft lacks string-split prim)
(begin
  (export string-split)
  (define string-split
    (lambda (s sep)
      (let ((n (string-length sep)))
        (let ((m (string-length s)))
          (if (=
              n 0)
            (list s)
            (letrec ((loop (lambda (i start acc)
                (if (>
                    (+
                      i n) m)
                  (reverse (cons
                      (substring
                        s start m) acc))
                  (if (equal?
                      (substring
                        s i (+
                          i n)) sep)
                    (loop
                      (+
                        i n) (+
                        i n) (cons
                        (substring
                          s start i) acc))
                    (loop
                      (+
                        i 1) start acc))))))
              (loop
                0 0 (list)))))))))
