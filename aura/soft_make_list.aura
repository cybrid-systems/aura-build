; Soft-materialized make-list helper (self-evolve Soft path)
; materialize=current-source  fiber_live=true when denseness measured
; selected=recur-cons  denseness=soft_ready_async_denseness_4048
; incr_proven=false
; Product: Soft oneshot lacks make-list (self_evolve_select / leetcode gap)
(begin
  (export make-list)
  (define make-list
    (lambda (n fill)
      (if (<=
          n 0)
        (list)
        (cons
          fill (make-list
            (-
              n 1) fill))))))
