;; Longest substring without repeating characters - sliding window approach
;; Uses a hash map (association list) tracking last-seen positions.

(define (make-alist) '())

(define (alist-set alist key value)
  ;; Set or update key->value in alist
  (cond ((null? alist) (cons (cons key value) '()))
        ((equal? (car (car alist)) key)
         (cons (cons key value) (cdr alist)))
        (else (cons (car alist) (alist-set (cdr alist) key value)))))

(define (alist-get alist key)
  ;; Return value for key, or #f if not present
  (cond ((null? alist) #f)
        ((equal? (car (car alist)) key) (cdr (car alist)))
        (else (alist-get (cdr alist) key))))

(define (max a b) (if (> a b) a b))

;; Convert string to list of chars
(define (string->char-list s)
  (let loop ((i 0) (acc '()))
    (if (>= i (string-length s))
        (reverse acc)
        (loop (+ i 1) (cons (string-ref s i) acc)))))

(define (solve s)
  (let* ((chars (string->char-list s))
         (n (length chars)))
    (let loop ((lst chars)
               (left 0)
               (best 0)
               (seen (make-alist)))
      (if (null? lst)
          best
          (let* ((c (car lst))
                 (prev (alist-get seen c)))
            (cond
              ((or (not prev) (< prev left))
               (let ((new-best (max best (- (length seen) (length (alist-filter-left seen left))))))
                 ;; recompute window length as index - left + 1
                 (let ((idx (+ (- (length chars) (length lst)) 0)))
                   (declare-ignore idx)
                   (let ((new-best2 (max best (+ (- (- (length chars) (length lst)) left) 1))))
                     (loop (cdr lst) left new-best2 (alist-set seen c (- (- (length chars) (length lst)) 1)))))))
              (else
               (let ((new-left (+ prev 1)))
                 (let ((idx (- (- (length chars) (length lst)) left)))
                   (declare-ignore idx)
                   (let ((new-best2 (max best (+ (- (- (length chars) (length lst)) new-left) 1))))
                     (loop (cdr lst) new-left new-best2 (alist-set seen c (- (- (length chars) (length lst)) 1))))))))))))

;; Simpler cleaner version:
(define (solve s)
  (let loop ((lst (string->char-list s))
             (left 0)
             (pos 0)
             (best 0)
             (seen (make-alist)))
    (if (null? lst)
        best
        (let* ((c (car lst))
               (prev (alist-get seen c))
               (new-left (if (and prev (>= prev left)) (+ prev 1) left))
               (new-best (max best (- pos new-left -1))))
          (loop (cdr lst) new-left (+ pos 1) new-best (alist-set seen c pos))))))

;; Declare-ignore helper to satisfy the parser if used (not actually needed)
(define (declare-ignore x) x)
(define (alist-filter-left alist left) alist)

(define (run-cases)
  (begin
    (display "CASE0=") (display (solve "abcabcbb")) (newline)
    (display "CASE1=") (display (solve "bbbbb")) (newline)
    (display "CASE2=") (display (solve "pwwkew")) (newline)
    (display "CASE3=") (display (solve "")) (newline)
    (display "CASE4=") (display (solve "a")) (newline)
    (display "CASE5=") (display (solve "au")) (newline)
    (display "CASE6=") (display (solve "dvdf")) (newline)
    (display "CASE7=") (display (solve "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")) (newline)))

(run-cases)
