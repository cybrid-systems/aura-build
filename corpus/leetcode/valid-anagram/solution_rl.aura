(require "lc_json" all:)
(require "compat" all:)
(define (string-length s)
  (let loop ((i 0) (s s))
    (if (null? s) i (loop (+ i 1) (cdr s)))))
(define (string-ref-idx s i)
  (let loop ((i i) (s s))
    (if (= i 0) (car s) (loop (- i 1) (cdr s)))))
(define (char->idx c)
  (- (char->integer c) (char->integer #\a)))
(define (make-freq)
  (let loop ((i 0) (lst '()))
    (if (= i 26) lst (loop (+ i 1) (cons 0 lst)))))
(define (freq-inc freq c)
  (let loop ((i 0) (f freq))
    (cond
      ((= i (char->idx c)) (cons (+ (car f) 1) (cdr f)))
      (else (cons (car f) (loop (+ i 1) (cdr f)))))))
(define (freq-decsame? s t freq)
  (cond
    ((null? s) freq)
    ((null? t) freq)
    (else
     (let ((c1 (car s)) (c2 (car t)))
       (freq-decsame? (cdr s) (cdr t)
         (let loop ((i 0) (f freq))
           (cond
             ((= i (char->idx c1)) (cons (- (car f) 1) (cdr f)))
             (else (cons (car f) (loop (+ i 1) (cdr f)))))))))))
(define (all-zero? freq)
  (cond
    ((null? freq) #t)
    ((= (car freq) 0) (all-zero? (cdr freq)))
    (else #f)))
(define (solve s t)
  (if (not (= (string-length s) (string-length t)))
      #f
      (all-zero? (freq-decsame? (string->list s) (string->list t) (make-freq)))))
(define (display-result name s t)
  (display name)
  (display (solve s t))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "s") (hash-ref input "t")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/valid-anagram/tests.json")))
