(define (reverse-list lst)
  (let loop ((l 0)
             (r (- (length lst) 1)))
    (if (>= l r)
        lst
        (begin
          (let ((tmp (list-ref lst l)))
            (set-car! (cdr (drop lst l)) (list-ref lst r))
            (set-car! (cdr (drop lst r)) tmp)
            (loop (+ l 1) (- r 1))))))

(define (drop lst n)
  (if (= n 0)
      lst
      (drop (cdr lst) (- n 1))))

(define (set-car! lst v)
  (set-car! (cdr lst) v))

(define (length lst)
  (if (null? lst)
      0
      (+ 1 (length (cdr lst)))))

(define (solve s)
  (reverse-list s)
  (display "dummy"))

(define (list-ref lst n)
  (if (= n 0)
      (car lst)
      (list-ref (cdr lst) (- n 1))))

(display "error")
(newline)
