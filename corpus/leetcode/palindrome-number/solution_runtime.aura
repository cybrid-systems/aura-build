; soft_leetcode_runtime slug=palindrome-number path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-2 hits=8/8
; baseline_hits=0/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define reverse-half
    (lambda (n)
      (let ((rev 0))
        (begin
          (set! rev (reverse-iter
              n 0))
          rev))))
  (define reverse-iter
    (lambda (n rev)
      (if (=
          n 0)
        rev
        (let ((q (quotient
            n 10)))
          (reverse-iter
            q (+
              (*
                rev 10) (modulo
                n 10)))))))
  (define solve
    (lambda (x)
      (if (<
          x 0)
        #f
        (if (=
            x 0)
          #t
          (let ((reversed (reverse-half x)))
            (=
              reversed x))))))
  (display "CASE0=")
  (display (solve 121))
  (newline)
  (display "CASE1=")
  (display (solve -121))
  (newline)
  (display "CASE2=")
  (display (solve 10))
  (newline)
  (display "CASE3=")
  (display (solve 0))
  (newline)
  (display "CASE4=")
  (display (solve 123))
  (newline)
  (display "CASE5=")
  (display (solve 1221))
  (newline)
  (display "CASE6=")
  (display (solve 12321))
  (newline)
  (display "CASE7=")
  (display (solve -2147483648))
  (newline))
