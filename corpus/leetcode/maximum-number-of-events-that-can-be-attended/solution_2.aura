(define (solve events)
  (let* ((n (length events))
         (sorted (sort-by-end events))
         (occupied '()))
    (let loop ((i 0) (count 0))
      (if (= i n)
          count
          (let* ((e (list-ref sorted i))
                 (s (car e))
                 (t (car (cdr e)))
                 (day (find-available occupied s)))
            (if (or (< day s) (> day t))
                (loop (+ i 1) count)
                (loop (+ i 1) (+ count 1))))))))

(define (sort-by-end events)
  (let* ((pairs (map (lambda (e) (cons (car (cdr e)) (car e))) events))
         (n (length pairs)))
    (let loop ((i 0) (result pairs))
      (if (= i (- n 1))
          (map (lambda (p) (cons (cdr p) (car p))) result)
          (let loop2 ((j 0) (r result))
            (if (= j (- n 1))
                (loop (+ i 1) r)
                (let* ((a (list-ref r j))
                       (b (list-ref r (+ j 1))))
                  (if (<= (car a) (car b))
                      (loop2 (+ j 1) r)
                      (loop2 (+ j 1)
                             (list-set r j (list-set (list-copy r) j b)))))
                ))))
    (let loop3 ((i 0) (r result))
      (if (= i (- n 1))
          (map (lambda (p) (cons (cdr p) (car p))) r)
          (let* ((a (list-ref r i))
                 (b (list-ref r (+ i 1))))
            (if (<= (car a) (car b))
                (loop3 (+ i 1) r)
                (loop3 (+ i 1) 
                       (list-set r i (list-set (list-copy r) i b)))))
            ))))
