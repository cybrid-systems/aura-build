from typing import Optional

class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

def build_tree(values):
    if not values or values[0] is None:
        return None
    nodes = [None if v is None else TreeNode(v) for v in values]
    kids = nodes[1:]
    for parent in nodes:
        for _ in range(2):
            if kids:
                kid = kids.pop(0)
                parent.left = kid
            if kids:
                kid = kids.pop(0)
                parent.right = kid
            else:
                break
    return nodes[0]

def find_node(root, val):
    cur = root
    while cur:
        if val == cur.val:
            return cur
        elif val < cur.val:
            cur = cur.left
        else:
            cur = cur.right
    return None

def solve(root: Optional[TreeNode], p: TreeNode, q: TreeNode) -> TreeNode:
    a, b = p.val, q.val
    cur = root
    while cur:
        if a < cur.val and b < cur.val:
            cur = cur.left
        elif a > cur.val and b > cur.val:
            cur = cur.right
        else:
            return cur
    return None

CASES = [
    {"root": [2, 1, 3], "p": 1, "q": 3, "expected": 2},
    {"root": [6, 2, 8, 0, 4, 7, 9, None, None, 3, 5], "p": 2, "q": 8, "expected": 6},
    {"root": [6, 2, 8, 0, 4, 7, 9, None, None, 3, 5], "p": 2, "q": 4, "expected": 2},
    {"root": [2, 1], "p": 2, "q": 1, "expected": 2},
    {"root": [5, 3, 7, 2, 4, 6, 8], "p": 7, "q": 8, "expected": 7},
    {"root": [5, 3, 7, 2, 4, 6, 8], "p": 3, "q": 8, "expected": 5},
    {"root": [1], "p": 1, "q": 1, "expected": 1},
    {"root": [4, 2, 6, 1, 3, 5, 7], "p": 1, "q": 3, "expected": 2},
]

if __name__ == '__main__':
    import json
    results = []
    for i, case in enumerate(CASES):
        root = build_tree(case["root"])
        p_node = find_node(root, case["p"])
        q_node = find_node(root, case["q"])
        result = solve(root, p_node, q_node)
        results.append({
            "id": i,
            "input": {
                "root": case["root"],
                "p": case["p"],
                "q": case["q"],
            },
            "expected": json.dumps(result.val, separators=(',', ':'), ensure_ascii=False),
        })
    print(json.dumps(results, separators=(',', ':'), ensure_ascii=False))
