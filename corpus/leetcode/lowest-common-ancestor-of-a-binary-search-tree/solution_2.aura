;; ---- Tree representation ----
;; A node is a 3-list: (val left right). '() means null.

(define (make-node v l r) (list v l r))
(define (node-val n) (car n))
(define (node-left n) (cadr n))
(define (node-right n) (caddr n))
(define (null-node? n) (null? n))

;; ---- Build BST from level-order list ----
;; Input is a list where 'null (symbol) represents missing nodes.
;; We rebuild by indices: left = 2*i+1, right = 2*i+2.

(define (list-ref-safe lst i)
  (define (loop lst k)
    (cond ((null? lst) 'null)
          ((= k 0) (car lst))
          (else (loop (cdr lst) (- k 1)))))
  (loop lst i))

(define (build-tree arr)
  (define n (length arr))
  (define (build i)
    (cond ((>= i n) '())
          (else
           (let ((v (list-ref-safe arr i)))
             (if (eq? v 'null)
                 '()
                 (let ((l (build (+ (* 1 i) 1)))
                       (r (build (+ (* 1 i) 2))))
                   (make-node v l r)))))))
  (build 0))

;; ---- Locate node by value (returns the node, not just val) ----
(define (find-node root target)
  (cond ((null-node? root) '())
        ((= (node-val root) target) root)
        (else
         (let ((l (find-node (node-left root) target)))
           (if (null-node? l)
               (find-node (node-right root) target)
               l)))))

;; ---- LCA using BST property ----
(define (lca-bst root p q)
  (let ((pv (node-val p))
        (qv (node-val q)))
    (define (walk node)
      (cond ((null-node? node) '())
            ((and (<= pv (node-val node)) (<= (node-val node) qv)) node)
            ((and (<= qv (node-val node)) (<= (node-val node) pv)) node)
            ((and (< pv (node-val node)) (< qv (node-val node))) node)
            ((> pv (node-val node)) (walk (node-right node)))
            (else (walk (node-left node)))))
    (walk root)))

;; ---- solve: takes root array, p val, q val; returns LCA value ----
(define (solve root-arr p-val q-val)
  (let ((root (build-tree root-arr))
        (p (find-node (build-tree root-arr) p-val))
        (q (find-node (build-tree root-arr) q-val)))
    (node-val (lca-bst root p q))))

;; ---- Pretty print list helper ----
(define (display-list lst)
  (display "[")
  (define (loop xs first?)
    (cond ((null? xs) (display ""))
          (else
           (if (not first?) (display ",") (display ""))
           (display (car xs))
           (loop (cdr xs) #f))))
  (loop lst #t)
  (display "]"))

;; ---- Run all test cases ----
(define (run-case i root-arr p-val q-val)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve root-arr p-val q-val))
  (newline))

;; Case 0: root=[2,1,3], p=1, q=3
(run-case 0 (list 2 1 3) 1 3)
;; Case 1: root=[6,2,8,0,4,7,9,null,null,3,5], p=2, q=8
(run-case 1 (list 6 2 8 0 4 7 9 'null 'null 3 5) 2 8)
;; Case 2: same tree, p=2, q=4
(run-case 2 (list 6 2 8 0 4 7 9 'null 'null 3 5) 2 4)
;; Case 3: root=[5,3,7,2,4,6,8], p=2, q=4
(run-case 3 (list 5 3 7 2 4 6 8) 2 4)
;; Case 4: same, p=6, q=8
(run-case 4 (list 5 3 7 2 4 6 8) 6 8)
;; Case 5: root=[1], p=1, q=1
(run-case 5 (list 1) 1 1)
;; Case 6: root=[10,5,15,3,7,null,18], p=5, q=15
(run-case 6 (list 10 5 15 3 7 'null 18) 5 15)
;; Case 7: root=[10,5,15,3,7,12,18], p=7, q=18
(run-case 7 (list 10 5 15 3 7 12 18) 7 18)
