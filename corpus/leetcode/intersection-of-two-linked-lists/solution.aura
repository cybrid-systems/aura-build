(define (make-node val next) (cons val next))
(define (node-val n) (car n))
(define (node-next n) (cdr n))
(define (null-node? n) (null? n))

(define (list-length n)
  (let loop ((node n) (acc 0))
    (if (null-node? node)
        acc
        (loop (node-next node) (+ acc 1)))))

(define (nth-node n i)
  (let loop ((node n) (k i))
    (if (= k 0)
        node
        (loop (node-next node) (- k 1)))))

(define (intersect headA headB)
  (if (or (null-node? headA) (null-node? headB))
      '()
      (let loop ((a headA) (b headB))
        (cond
          ((and (null-node? a) (null-node? b)) '())
          ((null-node? a) (loop headB b))
          ((null-node? b) (loop a headB))
          ((eq? a b) a)
          (else (loop (node-next a) (node-next b)))))))

(define (solve headA headB)
  (intersect headA headB))

;; Build nodes for CASE0: A = 4->1->8->4->5, B = 5->6->1->8->4->5
(define node-5 (make-node 5 '()))
(define node-4b (make-node 4 node-5))
(define node-8 (make-node 8 node-4b))
(define node-1b (make-node 1 node-8))
(define node-6 (make-node 6 node-1b))
(define headB0 (make-node 5 node-6))

(define node-1a (make-node 1 node-8))
(define node-4a (make-node 4 node-1a))
(define headA0 (make-node 4 node-4a))

;; CASE1: disjoint A = 2->6->4, B = 1->5
(define c1-4 (make-node 4 '()))
(define c1-6 (make-node 6 c1-4))
(define c1-A (make-node 2 c1-6))
(define c1-5 (make-node 5 '()))
(define c1-B (make-node 1 c1-5))

;; CASE2: A = 1->9->1, B = 3 -> intersect at 2->4
(define c2-4 (make-node 4 '()))
(define c2-2 (make-node 2 c2-4))
(define c2-1b (make-node 9 c2-2))
(define c2-1a (make-node 1 c2-2))
(define c2-B (make-node 3 c2-1b))
(define c2-A (make-node 1 c2-1a))

;; CASE3: disjoint A = 2->6->4->5->6, B = 1->5
(define c3-6b (make-node 6 '()))
(define c3-5b (make-node 5 c3-6b))
(define c3-4 (make-node 4 c3-5b))
(define c3-6a (make-node 6 c3-4))
(define c3-A (make-node 2 c3-6a))
(define c3-B (make-node 1 c3-5b))

;; CASE4: A = 4->1->8->4->5, B = 5->6->1->8->4->5 (same as case0 different ids)
(define node4-5 (make-node 5 '()))
(define node4-4b (make-node 4 node4-5))
(define node4-8 (make-node 8 node4-4b))
(define node4-1b (make-node 1 node4-8))
(define node4-6 (make-node 6 node4-1b))
(define headB4 (make-node 5 node4-6))
(define node4-1a (make-node 1 node4-8))
(define node4-4a (make-node 4 node4-1a))
(define headA4 (make-node 4 node4-4a))

;; CASE5: both same single node 1
(define shared (make-node 1 '()))
(define headA5 shared)
(define headB5 shared)

;; CASE6: headA null, headB = 1
(define headA6 '())
(define node6-1 (make-node 1 '()))
(define headB6 node6-1)

;; CASE7: A=4->1->8, B=2->4->1->8 sharing the 8
(define node7-8 (make-node 8 '()))
(define node7-1a (make-node 1 node7-8))
(define headA7 (make-node 4 node7-1a))
(define node7-1b (make-node 1 node7-8))
(define node7-4 (make-node 4 node7-1b))
(define headB7 (make-node 2 node7-4))

;; Display helper
(define (display-node n)
  (cond
    ((null-node? n)
     (display "None"))
    (else
     (display "Node(val=")
     (display (number->string (node-val n)))
     (display ")"))))

(define (run-case i headA headB)
  (let ((r (solve headA headB)))
    (display "CASE")
    (display (number->string i))
    (display "=")
    (display-node r)
    (newline)))

(run-case 0 headA0 headB0)
(run-case 1 c1-A c1-B)
(run-case 2 c2-A c2-B)
(run-case 3 c3-A c3-B)
(run-case 4 headA4 headB4)
(run-case 5 headA5 headB5)
(run-case 6 headA6 headB6)
(run-case 7 headA7 headB7)
