;; Find K Pairs with Smallest Sums
;; Heap-based solution in Aura

(define (len lst)
  (if (null? lst) 0 (+ 1 (len (cdr lst)))))

(define (ref lst i)
  (if (= i 0) (car lst) (ref (cdr lst) (- i 1))))

;; Heap operations on list of (sum i j) tuples
(define (heap-empty? h) (null? h))

(define (heap-push h item)
  (cons item h))

(define (heap-pop-min h)
  (let loop ((best-sum 999999999) (best-item '()) (best-pos 0) (cur h) (pos 0))
    (if (null? cur)
        (list best-item best-pos)
        (let ((s (car (car cur))))
          (if (< s best-sum)
              (loop s (car cur) pos (cdr cur) (+ pos 1))
              (loop best-sum best-item best-pos (cdr cur) (+ pos 1)))))))

(define (heap-remove-at h pos)
  (if (= pos 0)
      (cdr h)
      (cons (car h) (heap-remove-at (cdr h) (- pos 1)))))

;; solve function
(define (solve nums1 nums2 k)
  (let ((n1 (len nums1))
        (n2 (len nums2))
        (limit k))
    (if (or (= n1 0) (= n2 0) (= limit 0))
        '()
        (let ((heap '())
              (result '())
              (count 0)
              (push-limit (min limit n1)))
          ;; Seed heap with first push-limit pairs
          (let ((seed-loop (lambda (i heap)
            (if (>= i push-limit)
                heap
                (seed-loop (+ i 1)
                  (heap-push heap 
                    (list (+ (ref nums1 i) (ref nums2 0)) i 0)))))))
            (set! heap (seed-loop 0 heap)))
          ;; Pop min, add to result, push next from same i if available
          (let ((main-loop (lambda ()
            (if (or (>= count limit) (heap-empty? heap))
                '()
                (let ((popped (heap-pop-min heap))
                      (pop-pos (cadr (heap-pop-min heap))))
                  (let ((item (car popped))
                        (pos (cadr popped)))
                    (set! count (+ count 1))
                    (set! result (cons (list (ref nums1 (cadr item)) (ref nums2 (caddr item))) result))
                    ;; Push next pair with same i if j+1 exists
                    (if (< (+ (caddr item) 1) n2)
                        (set! heap 
                          (heap-push heap 
                            (list (+ (ref nums1 (cadr item)) (ref nums2 (+ (caddr item) 1)))
                                  (cadr item) (+ (caddr item) 1))))
                        '())
                    (main-loop)))))))
            (main-loop))
          result))))

;; Display list of pairs as (a,b);... or empty
(define (display-pair p)
  (display "(")
  (display (car p))
  (display ",")
  (display (cdr p))
  (display ")"))

(define (display-pairs lst)
  (display "[")
  (if (null? lst)
      (display "]")
      (begin
        (display-pair (car lst))
        (let loop ((rest (cdr lst)))
          (if (null? rest)
              (display "]")
              (begin
                (display ",")
                (display-pair (car rest))
                (loop (cdr rest))))))))

;; Test cases
(define (run-test i nums1 nums2 k)
  (display "CASE")
  (display i)
  (display "=")
  (display-pairs (solve nums1 nums2 k))
  (newline))

(run-test 0 (list 1 7 11) (list 2 4 6) 3)
(run-test 1 (list 1 7 11) (list 2 4 6) 10)
(run-test 2 (list 1 2) (list 3) 3)
(run-test 3 '() (list 1 2 3) 5)
(run-test 4 (list 1 1 2) (list 1 2 3) 2)
(run-test 5 (list 1 2 3 4) (list 1 2 3 4) 1)
(run-test 6 (list 5 6 7) (list 1 2 3) 5)
(run-test 7 (list 1 1 1) (list 1 1 1) 4)
