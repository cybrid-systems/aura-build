(define (parse-tree tokens)
  (let* ((idx (list 0))
         (n (length tokens)))
    (define (next-token)
      (let ((i (car idx)) (tok (list-ref tokens i)))
        (set-car! idx (+ i 1))
        tok))
    (define (parse)
      (if (>= (car idx) n)
          '()
          (let ((tok (next-token)))
            (if (equal? tok "null")
                '()
                (let ((val (string->number tok)))
                  (cons (list 'val val 'left 'right)
                        (begin
                          (set-car! (cdr (assemble-node)) ...)
                          ;; can't easily, rebuild manually
                          (let ((left (parse)) (right (parse)))
                            (list 'val val 'left left 'right right))))))))
    ;; Simpler approach: build flat node list and link
    (define (build)
      (if (>= (car idx) n)
          '()
          (let ((tok (next-token)))
            (if (equal? tok "null")
                '()
                (let ((val (string->number tok)))
                  (cons (list 'val val 'left 'right 'children '())
                        (begin
                          (let ((node (car (last-built))))
                            (let ((left (build)))
                              (let ((right (build)))
                                (set-cdr! (assq 'left node) (cons left (cdr (assq 'left node))))
                                (set-cdr! (assq 'right node) (cons right (cdr (assq 'right node))))
                                node))))))))))
    ;; Even simpler: collect all nodes in order, then link by index
    (let ((all '()))
      (define (collect)
        (if (>= (car idx) n)
            (begin (set-car! idx (- (car idx) 1)) '())  ;; tricky
            (let ((tok (next-token)))
              (if (equal? tok "null")
                  '()
                  (let ((val (string->number tok)))
                    (let ((node (list 'val val 'left '() 'right '())))
                      (set! all (append all (list node)))
                      (collect)))))))
      ;; reset
      (set-car! idx 0)
      (collect)
      ;; now link: node i's left = node 2i+1, right = node 2i+2 if exist
      (define (link i)
        (if (>= i (length all))
            '()
            (let ((node (list-ref all i)))
              (let ((li (+ (* 2 i) 1)) (ri (+ (* 2 i) 2)))
                (if (< li (length all))
                    (set-cdr! (assq 'left node) (list (list-ref all li)))
                    '())
                (if (< ri (length all))
                    (set-cdr! (assq 'right node) (list (list-ref all ri)))
                    '())
                (link (+ i 1))))))
      (link 0)
      (if (null? all) '() (car all))))

(define (solve tokens)
  (let ((root (parse-tree tokens)))
    (if (null? root)
        '()
        (let ((result '()))
          ;; BFS
          (define (bfs queue)
            (if (null? queue)
                (reverse result)
                (let ((level queue)
                      (next '())
                      (sum 0)
                      (cnt 0))
                  (define (sum-level q)
                    (if (null? q)
                        '()
                        (let ((node (car q)))
                          (set! sum (+ sum (cadr (assq 'val node))))
                          (set! cnt (+ cnt 1))
                          (let ((l (cadr (assq 'left node))) (r (cadr (assq 'right node))))
                            (if (not (null? l))
                                (set! next (append next (list l)))
                                '())
                            (if (not (null? r))
                                (set! next (append next (list r)))
                                '()))
                          (sum-level (cdr q)))))
                  (sum-level level)
                  (set! result (cons (/ sum cnt) result))
                  (bfs next))))
          (bfs (list root))))))

(define (format-avg x)
  ;; format with 5 decimal places
  (let ((s (number->string x)))
    ;; ensure at least 5 decimals
    (let ((dot (string-contains s ".")))
      (if dot
          (let ((frac-len (- (string-length s) dot 1)))
            (if (>= frac-len 5)
                s
                (string-append s (make-string (- 5 frac-len) #\0))))
          (string-append s ".00000")))))

(define (make-string n ch)
  (if (= n 0)
      ""
      (string-append (make-string (- n 1) ch) (string ch))))

(define (string-contains s ch)
  (let ((len (string-length s)))
    (define (find i)
      (cond ((>= i len) #f)
            ((char=? (string-ref s i) ch) i)
            (else (find (+ i 1)))))
    (find 0)))

(define (string ch)
  (cond ((char=? ch #\0) "0")
        ((char=? ch #\1) "1")
        ((char=? ch #\2) "2")
        ((char=? ch #\3) "3")
        ((char=? ch #\4) "4")
        ((char=? ch #\5) "5")
        ((char=? ch #\6) "6")
        ((char=? ch #\7) "7")
        ((char=? ch #\8) "8")
        ((char=? ch #\9) "9")
        ((char=? ch #\.) ".")
        (else "")))

(define (display-list lst)
  (cond ((null? lst) (display ""))
        ((null? (cdr lst)) (display (format-avg (car lst))))
        (else
         (display (format-avg (car lst)))
         (display " ")
         (display-list (cdr lst)))))

;; Embedded test inputs
(define cases
  (list
    (list "3" "9" "20" "null" "null" "15" "7")
    (list "1" "null" "2")
    (list "-1" "null" "2" "null" "3" "null" "4" "null" "5")
    (list "0" "0" "0" "0" "0")
    (list "5")
    (list "10" "5" "15" "3" "7" "null" "20")))

(define (run-cases i lst)
  (if (null? lst)
      '()
      (begin
        (display (string-append "CASE" (number->string i) "="))
        (display-list (solve (car lst)))
        (newline)
        (run-cases (+ i 1) (cdr lst)))))

(run-cases 0 cases)
