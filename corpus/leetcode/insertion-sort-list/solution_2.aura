;; Build a linked list from a vector (Aura vectors not assumed; use list of values)
;; Nodes are represented as (cons val next). Empty list is '().

(define (list-from-vec vals i n)
  (if (>= i n)
      '()
      (cons (vector-ref vals i) (list-from-vec vals (+ i 1) n))))

(define (list-to-vec lst)
  ;; Return a vector with the values of lst
  (let loop ((l lst) (acc '()))
    (if (null? l)
        (list->vector (reverse acc))
        (loop (cdr l) (cons (car l) acc)))))

;; Insertion sort on linked list of cons cells
;; Insertion-sort a list of (cons val next) nodes, returning the head of sorted list.
(define (insert-sorted head node)
  ;; Insert node into sorted list starting at head; node is detached (its cdr ignored).
  ;; Returns new head.
  (let ((nv (car node)))
    (cond
      ;; Insert at head
      ((or (null? head) (<= nv (car head)))
       (set-cdr! node head)
       node)
      (else
       ;; Walk to find insertion point: prev whose next has val >= nv, or end
       (let loop ((prev head))
         (cond
           ((null? (cdr prev))
            ;; Append at end
            (set-cdr! prev node)
            (set-cdr! node '())
            head)
           ((>= (car (cdr prev)) nv)
            ;; Insert between prev and (cdr prev)
            (set-cdr! node (cdr prev))
            (set-cdr! prev node)
            head)
           (else
            (loop (cdr prev)))))))))

(define (insertion-sort lst)
  ;; Return sorted head
  (if (null? lst)
      '()
      (let ((head lst)
            (cur (cdr lst)))
        (set-cdr! head '())
        (let loop ((cur cur))
          (if (null? cur)
              head
              (let ((nxt (cdr cur)))
                (set-cdr! cur '())
                (set! head (insert-sorted head cur))
                (loop nxt)))))))

(define (solve N VALUES)
  (let* ((lst (list-from-vec VALUES 0 N))
         (sorted (insertion-sort lst)))
    (list-to-vec sorted)))

;; ---- display helpers ----
(define (display-result v)
  ;; Display a vector as "[v0,v1,...]"
  (display "[")
  (let loop ((i 0))
    (when (< i (vector-length v))
      (when (> i 0) (display ","))
      (display (vector-ref v i))
      (loop (+ i 1))))
  (display "]"))

;; ---- test harness ----
(let ((cases
       (list
        (vector 0 (vector))
        (vector 1 (vector 5))
        (vector 5 (vector 4 2 1 3 5))
        (vector 6 (vector -1 5 3 4 0 2))
        (vector 7 (vector 3 3 1 2 2 1 3))
        (vector 3 (vector 1 2 3))
        (vector 3 (vector 3 2 1))
        (vector 8 (vector -5 10 -3 8 8 0 1 -5)))))
  (let loop ((cases cases) (i 0))
    (if (null? cases)
        '()
        (begin
          (let* ((c (car cases))
                 (N (vector-ref c 0))
                 (V (vector-ref c 1))
                 (r (solve N V)))
            (display "CASE")
            (display i)
            (display "=")
            (display-result r)
            (newline))
          (loop (cdr cases) (+ i 1))))))
