;; House Robber II - Aura solution

(define (max a b) (if (> a b) a b))

;; Linear house robber on a list (from index lo to hi inclusive)
(define (rob-range nums lo hi)
  (if (> lo hi)
      0
      (let ((prev 0)
            (curr 0))
        (let loop ((i lo))
          (if (> i hi)
              curr
              (let ((new-val (max curr (+ prev (list-ref nums i)))))
                (set! prev curr)
                (set! curr new-val)
                (loop (+ i 1))))))))

;; list-ref using index on a list (handles out-of-range by returning 0)
(define (list-ref lst i)
  (cond ((null? lst) 0)
        ((= i 0) (car lst))
        (else (list-ref (cdr lst) (- i 1)))))

;; Helper for rob-range: we need array-style access; use a list-based approach instead.
;; Recompute using a list and a start count.
(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (take lst n)
  (if (= n 0)
      '()
      (cons (car lst) (take (cdr lst) (- n 1)))))

(define (drop lst n)
  (if (= n 0)
      lst
      (drop (cdr lst) (- n 1))))

;; Rob a linear list (no circle)
(define (rob-linear lst)
  (let ((prev 0)
        (curr 0))
    (let loop ((xs lst))
      (if (null? xs)
          curr
          (let ((new-val (max curr (+ prev (car xs)))))
            (set! prev curr)
            (set! curr new-val)
            (loop (cdr xs)))))))

(define (solve nums)
  (let ((n (length nums)))
    (cond ((= n 0) 0)
          ((= n 1) (car nums))
          (else
           ;; Exclude first: rob indices 1..n-1  (drop 1)
           ;; Exclude last:  rob indices 0..n-2  (take n-1)
           (let ((r1 (rob-linear (drop nums 1)))
                 (r2 (rob-linear (take nums (- n 1)))))
             (max r1 r2))))))

(define (run-case i nums)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums))
  (newline))

(run-case 0 '(2 3 2))
(run-case 1 '(1 2 3 1))
(run-case 2 '(0))
(run-case 3 '(1))
(run-case 4 '(1 2))
(run-case 5 '(2 3 2 5 8 1))
(run-case 6 '(0 0 0 0))
(run-case 7 '(10 1 1 10 1 1 10))
