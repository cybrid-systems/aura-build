(define (length-of s)
  (let loop ((i 0) (c 0))
    (if (null? s) c
        (loop (+ i 1) (+ c 1)))))

(define (ref s i)
  (if (= i 0) (car s) (ref (cdr s) (- i 1))))

(define (substring s start end)
  (let loop ((i 0) (acc '()))
    (if (= i end) (reverse acc)
        (loop (+ i 1) (cons (ref s (+ start i)) acc)))))

(define (balance s)
  (let ((n (length-of s)))
    (let ((target (/ n 4)))
      (let ((cnt (list 0 0 0 0)))
        (let loop-build ((i 0))
          (if (= i n) 'done
              (let ((ch (ref s i)))
                (let ((idx (cond ((equal? ch 'Q) 0)
                                 ((equal? ch 'W) 1)
                                 ((equal? ch 'E) 2)
                                 (else 3))))
                  (set! cnt (list-set cnt idx (+ (list-ref cnt idx) 1)))
                  (loop-build (+ i 1))))))
        (let ((maxc (max4 (list-ref cnt 0) (list-ref cnt 1) (list-ref cnt 2) (list-ref cnt 3))))
          (if (= maxc target)
              0
              (let ((excess (list (- (list-ref cnt 0) target)
                                  (- (list-ref cnt 1) target)
                                  (- (list-ref cnt 2) target)
                                  (- (list-ref cnt 3) target))))
                (let ((total-excess (+ (list-ref excess 0) (list-ref excess 1)
                                       (list-ref excess 2) (list-ref excess 3))))
                  (let ((min-len n))
                    (let ((win (list 0 0 0 0)))
                      (let loop-sliding ((left 0) (right 0))
                        (cond
                          ((= right n)
                            (let ((needed (max 0 (- (list-ref excess 0) (list-ref win 0)))
                                          (max 0 (- (list-ref excess 1) (list-ref win 1)))
                                          (max 0 (- (list-ref excess 2) (list-ref win 2)))
                                          (max 0 (- (list-ref excess 3) (list-ref win 3)))))
                              (if (= needed 0)
                                  (set! min-len (min min-len (- right left)))
                                  min-len)
                              min-len))
                          (else
                            (let ((ch (ref s right)))
                              (let ((idx (cond ((equal? ch 'Q) 0)
                                               ((equal? ch 'W) 1)
                                               ((equal? ch 'E) 2)
                                               (else 3))))
                                (set! win (list-set win idx (+ (list-ref win idx) 1)))
                                (let loop-inner ((r (+ right 1)))
                                  (cond
                                    ((= r n)
                                      (let loop2 ((l left))
                                        (cond
                                          ((> l n) min-len)
                                          ((= l n) min-len)
                                          (else
                                            (let ((needed (max 0 (- (list-ref excess 0) (list-ref win 0)))
                                                          (max 0 (- (list-ref excess 1) (list-ref win 1)))
                                                          (max 0 (- (list-ref excess 2) (list-ref win 2)))
                                                          (max 0 (- (list-ref excess 3) (list-ref win 3)))))
                                              (if (= needed 0)
                                                  (begin
                                                    (set! min-len (min min-len (- r l)))
                                                    (set! win (list-set win idx (- (list-ref win idx) 1)))
                                                    (loop2 (+ l 1)))
                                                  (loop2 (+ n 1))))))))
                                    ((let ((c1 (ref s r))) #t)
                                     (let loop2 ((l left))
                                       (cond
                                         ((= l (- r 1))
                                          (let ((needed (max 0 (- (list-ref excess 0) (list-ref win 0)))
                                                        (max 0 (- (list-ref excess 1) (list-ref win 1)))
                                                        (max 0 (- (list-ref excess 2) (list-ref win 2)))
                                                        (max 0 (- (list-ref excess 3) (list-ref win 3)))))
                                            (if (= needed 0)
                                                (begin
                                                  (set! min-len (min min-len (- r l)))
                                                  (set! win (list-set win idx (- (list-ref win idx) 1)))
                                                  (loop-inner (+ r 1)))
                                                min-len)))
                                         ((let ((c2 (ref s l))) #t)
                                          (let ((idx2 (cond ((equal? c2 'Q) 0)
                                                            ((equal? c2 'W) 1)
                                                            ((equal? c2 'E) 2)
                                                            (else 3))))
                                            (set! win (list-set win idx2 (- (list-ref win idx2) 1)))
                                            (let ((needed (max 0 (- (list-ref excess 0) (list-ref win 0)))
                                                          (max 0 (- (list-ref excess 1) (list-ref win 1)))
                                                          (max 0 (- (list-ref excess 2) (list-ref win 2)))
                                                          (max 0 (- (list-ref excess 3) (list-ref win 3)))))
                                              (if (= needed 0)
                                                  (begin
                                                    (set! min-len (min min-len (- (+ r 1) (+ l 1))))
                                                    (loop-inner (+ r 1)))
                                                  (begin
                                                    (loop2 (+ l 1)))))))))))))))))))))))))))))

(define (max a b) (if (> a b) a b))
(define (min a b) (if (< a b) a b))
(define (max4 a b c d) (max (max a b) (max c d)))
