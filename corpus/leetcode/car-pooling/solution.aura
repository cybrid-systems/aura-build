(define (cons-3 a b c) (cons a (cons b (cons c '()))))

;; Insert event into sorted list. Events compared by pos, then by delta (dropoff < pickup)
(define (insert-event ev events)
  (cond
    ((null? events) (cons ev '()))
    (else
     (let ((p1 (car ev)) (d1 (car (cdr ev))) (id1 (car (cdr (cdr ev)))))
       (let ((p2 (car (car events))) (d2 (car (cdr (car events)))))
         (if (or (< p1 p2) (and (= p1 p2) (< d1 d2)))
             (cons ev events)
             (cons (car events) (insert-event ev (cdr events)))))))))

(define (build-events trips id)
  (if (null? trips)
      '()
      (let ((t (car trips)))
        (let ((s (car t)) (e (car (cdr t))) (p (car (cdr (cdr t)))))
          (let ((rest (build-events (cdr trips) (+ id 1))))
            (insert-event (cons-3 s p id) (insert-event (cons-3 e (- 0 p) id) rest)))))))

(define (sweep events capacity)
  (let ((total 0) (es events))
    (let loop ((total total) (es es))
      (if (null? es)
          #t
          (let ((new-total (+ total (car (cdr (car es))))))
            (if (> new-total capacity)
                #f
                (loop new-total (cdr es))))))))

(define (solve n capacity trips)
  (let ((events (build-events trips 0)))
    (if (sweep events capacity) "YES" "NO")))

(define (display-list xs)
  (cond ((null? xs) (display ")"))
        (else (display " ") (display (car xs)) (display-list (cdr xs)))))

(define (display-trips trips)
  (display "[")
  (let loop ((ts trips))
    (cond ((null? ts) (display "]"))
          (else
           (let ((t (car ts)))
             (display "[") (display (car t)) (display ",") (display (car (cdr t)))
             (display ",") (display (car (cdr (cdr t)))) (display "]"))
           (if (null? (cdr ts))
               (display "]")
               (begin (display ",") (loop (cdr ts))))))))

(define (run-case i n capacity trips)
  (begin
    (display "CASE") (display i) (display "=")
    (display (solve n capacity trips))
    (newline)))

;; Test cases
(run-case 0 3 4 (list (cons 1 (cons 5 (cons 2 '()))) (cons 2 (cons 4 (cons 3 '()))) (cons 5 (cons 9 (cons 3 '())))))
(run-case 1 2 2 (list (cons 1 (cons 3 (cons 2 '()))) (cons 3 (cons 5 (cons 2 '())))))
(run-case 2 2 3 (list (cons 1 (cons 5 (cons 2 '()))) (cons 2 (cons 6 (cons 3 '())))))
(run-case 3 1 1 (list (cons 0 (cons 1000000000 (cons 1 '())))))
(run-case 4 3 5 (list (cons 1 (cons 4 (cons 3 '()))) (cons 4 (cons 7 (cons 3 '()))) (cons 2 (cons 5 (cons 2 '())))))
(run-case 5 2 5 (list (cons 2 (cons 5 (cons 3 '()))) (cons 5 (cons 9 (cons 3 '())))))
(run-case 6 3 3 (list (cons 1 (cons 3 (cons 2 '()))) (cons 3 (cons 5 (cons 2 '()))) (cons 2 (cons 4 (cons 3 '())))))
(run-case 7 1 1 (list (cons 5 (cons 10 (cons 1 '())))))
