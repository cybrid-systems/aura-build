(require "lc_json" all:)
(require "compat" all:)
(define (string-length s)
  (let loop ((s s) (n 0))
    (if (null? s) n (loop (cdr s) (+ n 1)))))
(define (string-ref s i)
  (let loop ((s s) (i i))
    (if (= i 0) (car s) (loop (cdr s) (- i 1)))))
(define (substring s start end)
  (let loop ((s s) (start start) (end end) (acc '()))
    (if (= start end) (list->string (reverse acc))
        (loop (cdr s) (+ start 1) (- end 1) (cons (car s) acc)))))
(define (list->string lst)
  (apply string (map (lambda (c) (string c)) lst)))
(define (string-prefix-of? prefix s)
  (let ((pl (string-length prefix))
        (sl (string-length s)))
    (if (> pl sl) #f
        (let loop ((i 0))
          (cond
            ((= i pl) #t)
            ((not (equal? (string-ref prefix i) (string-ref s i))) #f)
            (else (loop (+ i 1))))))))
(define (find-shortest-root roots word)
  (let loop ((roots roots))
    (cond
      ((null? roots) #f)
      ((string-prefix-of? (car roots) word) (car roots))
      (else (loop (cdr roots))))))
(define (split-words s)
  (let ((len (string-length s)))
    (if (= len 0) '()
        (let loop ((i 0) (start 0) (acc '()))
          (cond
            ((= i len) (reverse (cons (substring s start len) acc)))
            ((equal? (string-ref s i) " ")
             (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
            (else (loop (+ i 1) start acc)))))))
(define (join-words words)
  (cond
    ((null? words) "")
    ((null? (cdr words)) (car words))
    (else (string-append (car words) " " (join-words (cdr words))))))
(define (replace-word roots word)
  (let ((root (find-shortest-root roots word)))
    (if root root word)))
(define (replace-words-in roots words)
  (cond
    ((null? words) '())
    (else (cons (replace-word roots (car words))
                (replace-words-in roots (cdr words))))))
(define (solve roots sentence)
  (join-words (replace-words-in roots (split-words sentence))))
(define (parse-roots s)
  (split-words s))
(define (run-case i roots-str sentence)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve (parse-roots roots-str) sentence))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "roots") (hash-ref input "sentence")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/replace-words/tests.json")))
