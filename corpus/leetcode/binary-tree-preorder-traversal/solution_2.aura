(define (list-length lst)
  (if (null? lst) 0 (+ 1 (list-length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (solve root)
  (define (preorder i)
    (if (>= i (vector-length root))
        '()
        (let ((v (vector-ref root i)))
          (if (null? v)
              '()
              (cons v (append (preorder (+ (* 2 i) 1))
                              (preorder (+ (* 2 i) 2))))))))
  (preorder 0))

(define (display-list lst)
  (display "(")
  (let loop ((l lst) (first #t))
    (cond ((null? l) (display ")"))
          (else
           (if first (set! first #f) (display " "))
           (display (car l))
           (loop (cdr l) first)))))

(display "CASE0=") (display-list (solve #(1 () 2 () 3))) (newline)
(display "CASE1=") (display-list (solve #(1 2 3 4 5 6 7))) (newline)
(display "CASE2=") (display-list (solve #(1))) (newline)
(display "CASE3=") (display-list (solve #(1 2 () 3 () 4 () 5))) (newline)
(display "CASE4=") (display-list (solve #(10 5 15 () 7 12 20))) (newline)
(display "CASE5=") (display-list (solve #(3 1 2))) (newline)
(display "CASE6=") (display-list (solve #(4 2 6 1 3 5 7))) (newline)
(display "CASE7=") (display-list (solve #(0 -1 1 -2 2 -3 3))) (newline)
