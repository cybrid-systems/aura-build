;; Recover Binary Search Tree
;; Each node is a 3-element list: (value left right), where children are nodes or '()
;; We treat '() as null (no child).

(define (make-node v l r) (list v l r))
(define (node-val n) (car n))
(define (node-left n) (car (cdr n)))
(define (node-right n) (car (cdr (cdr n))))
(define (set-val! n v) (set-car! n v))

;; Build tree from level-order list. null -> '()
(define (build-tree lst)
  (if (null? lst) '()
      (let ((v (car lst)))
        (if (null? v) '()
            (let ((rest (cdr lst))
                  (left-list (build-left lst))
                  (right-start (build-left-end lst)))
              (let ((left (build-tree left-list))
                    (right (build-tree (slice-list rest right-start (length rest)))))
                (make-node v left right)))))))

;; Actually, let's do it more simply by index access.
(define (lst-get lst i)
  (if (= i 0) (car lst) (lst-get (cdr lst) (- i 1))))

(define (lst-set! lst i v)
  ;; returns new list with position i set to v (functional update via set-car! chain)
  (if (= i 0)
      (begin (set-car! lst v) lst)
      (lst-set! (cdr lst) (- i 1) v)))

;; Build tree level-order from list of values (using '() for null)
(define (build-tree lst)
  (let ((n (length lst)))
    (if (= n 0) '()
        (let ((root (make-node (car lst) '() '())))
          (letrec ((fill
                    (lambda (idx)
                      (if (>= idx n) '()
                          (let ((v (lst-get lst idx)))
                            (if (null? v) '()
                                (let ((left-idx (+ (* 2 idx) 1))
                                      (right-idx (+ (* 2 idx) 2))
                                      (node (make-node v '() '())))
                                  (let ((l (fill left-idx))
                                        (r (fill right-idx)))
                                    (set-car! (cdr node) l)
                                    (set-car! (cdr (cdr node)) r)
                                    node))))))))
            (fill 0))))))

;; Iterative in-order traversal to find swapped nodes
(define (recover-tree root)
  (let ((first '())
        (second '())
        (prev (make-node (- (expt 2 62)) '() '())))  ;; sentinel with very small value
    (letrec ((stack '())
             (cur root))
      ;; We'll use a loop via recursion since Aura doesn't have while
      (letrec ((step
                (lambda ()
                  (cond
                    ((not (null? cur))
                     (set! stack (cons cur stack))
                     (set! cur (node-left cur))
                     (step))
                    ((not (null? stack))
                     (let ((top (car stack)))
                       (set! stack (cdr stack))
                       ;; visit top
                       (let ((pval (node-val prev))
                             (tval (node-val top)))
                         (when (and (< pval tval) #f) '()) ;; dummy
                         (if (< pval tval)
                             '()
                             (begin
                               (if (null? first)
                                   (set! first prev)
                                   '())
                               (set! second top)))))
                       (set! prev top)
                       (set! cur (node-right top))
                       (step))
                    (else '())))))
        (step)
        ;; Swap values
        (let ((fv (node-val first))
              (sv (node-val second)))
          (set-val! first sv)
          (set-val! second fv))))
    root))

;; Convert tree back to level-order list, trimming trailing nulls
(define (tree-to-list root)
  (letrec ((result '())
           (collect
             (lambda (nodes)
               (if (null? nodes)
                   '()
                   (let ((vals (map (lambda (n) (if (null? n) '() (node-val n))) nodes))
                         (next '())
                         (more #f))
                     (set! result (append result vals))
                     (for-each
                       (lambda (n)
                         (when (not (null? n))
                           (begin
                             (set! more #t)
                             (set! next (append next (list (node-left n) (node-right n)))))))
                       nodes)
                     (if more (collect next) '()))))))
    (collect (list root))
    ;; trim trailing '()
    (letrec ((trim
              (lambda (lst)
                (cond
                  ((null? lst) '())
                  ((null? (car lst))
                   (let ((rest (trim (cdr lst))))
                     (if (null? rest) '() rest)))
                  (else lst)))))
      (trim result))))

;; Helper: append
(define (append a b)
  (if (null? a) b (cons (car a) (append (cdr a) b))))

;; Helper: length
(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

;; Display a value: number as number, null as "null"
(define (display-val v)
  (if (null? v) (display "null") (display v)))

(define (display-list lst)
  (letrec ((loop
            (lambda (l first?)
              (when (not (null? l))
                (when (not first?) (display " "))
                (display-val (car l))
                (loop (cdr l) #f)))))
    (loop lst #t)))

(define (solve root-list)
  (let ((tree (build-tree root-list)))
    (let ((fixed (recover-tree tree)))
      (tree-to-list fixed))))

;; Test cases
(define case0 (list 4 3 7 '() '() 2 6))
(define case1 (list 1 3 '() '() 2))
(define case2 (list 3 '() 2 '() 1))
(define case3 (list 2 1 3))
(define case4 (list 10 5 15 2 7 12 20))

(display "CASE0=") (display-list (solve case0)) (newline)
(display "CASE1=") (display-list (solve case1)) (newline)
(display "CASE2=") (display-list (solve case2)) (newline)
(display "CASE3=") (display-list (solve case3)) (newline)
(display "CASE4=") (display-list (solve case4)) (newline)
