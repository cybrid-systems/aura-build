(require "lc_json" all:)
(require "compat" all:)
(define (popcount n)
  (cond ((= n 0) 0)
        (else (+ (modulo n 2) (popcount (quotient n 2))))))
(define (solve n)
  (define (build i)
    (if (> i n)
        '()
        (cons (popcount i) (build (+ i 1)))))
  (build 0))
(define (list->display xs)
  (display "[")
  (define (loop rest)
    (cond ((null? rest) #t)
          (else
           (display (car rest))
           (if (null? (cdr rest))
               #t
               (begin (display " ") (loop (cdr rest)))))))
  (loop xs)
  (display "]"))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/counting-bits/tests.json")))
