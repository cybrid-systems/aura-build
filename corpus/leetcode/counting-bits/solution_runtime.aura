; soft_leetcode_runtime slug=counting-bits path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-2 hits=8/8
; baseline_hits=1/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define popcount
    (lambda (n)
      (if (=
          n 0)
        0
        (+
          (modulo
            n 2) (popcount (quotient
              n 2))))))
  (define solve
    (lambda (n)
      (begin
        (define build
          (lambda (i)
            (if (>
                i n)
              (quote ())
              (cons
                (popcount i) (build (+
                    i 1))))))
        (build 0))))
  (define list->display
    (lambda (xs)
      (begin
        (display "[")
        (define loop
          (lambda (rest)
            (if (null? rest)
              #t
              (begin
                (display (car rest))
                (if (null? (cdr rest))
                  #t
                  (begin
                    (display ",")
                    (loop (cdr rest))))))))
        (loop xs)
        (display "]"))))
  (display "CASE0=")
  (list->display (solve 2))
  (newline)
  (display "CASE1=")
  (list->display (solve 5))
  (newline)
  (display "CASE2=")
  (list->display (solve 0))
  (newline)
  (display "CASE3=")
  (list->display (solve 1))
  (newline)
  (display "CASE4=")
  (list->display (solve 7))
  (newline)
  (display "CASE5=")
  (list->display (solve 10))
  (newline)
  (display "CASE6=")
  (list->display (solve 16))
  (newline)
  (display "CASE7=")
  (list->display (solve 100))
  (newline))
