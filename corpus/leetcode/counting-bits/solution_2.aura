(define (popcount n)
  (cond ((= n 0) 0)
        (else (+ (modulo n 2) (popcount (quotient n 2))))))

(define (solve n)
  (define (build i)
    (if (> i n)
        '()
        (cons (popcount i) (build (+ i 1)))))
  (build 0))

(define (list->display xs)
  (display "[")
  (define (loop rest)
    (cond ((null? rest) #t)
          (else
           (display (car rest))
           (if (null? (cdr rest))
               #t
               (begin (display " ") (loop (cdr rest)))))))
  (loop xs)
  (display "]"))

(display "CASE0=") (list->display (solve 2)) (newline)
(display "CASE1=") (list->display (solve 5)) (newline)
(display "CASE2=") (list->display (solve 0)) (newline)
(display "CASE3=") (list->display (solve 1)) (newline)
(display "CASE4=") (list->display (solve 7)) (newline)
(display "CASE5=") (list->display (solve 10)) (newline)
(display "CASE6=") (list->display (solve 16)) (newline)
(display "CASE7=") (list->display (solve 100)) (newline)
