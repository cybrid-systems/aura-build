(define (solve matrix target)
  (let ((rows (length matrix)))
    (if (= rows 0)
        #f
        (let ((cols (length (car matrix))))
          (if (= cols 0)
              #f
              (letrec ((row 0)
                       (col (- cols 1))
                       (found #f)
                       (loop (lambda ()
                               (if (or found (< row 0) (>= col cols) (>= row rows))
                                   found
                                   (let ((val (list-ref (list-ref matrix row) col)))
                                     (cond ((= val target) (set! found #t))
                                           ((> val target) (set! col (- col 1)))
                                           (else (set! row (+ row 1))))
                                     (loop))))))
                (loop)))))))

(define (test-case i matrix target)
  (display "CASE")
  (display i)
  (display "=")
  (display (if (solve matrix target) "true" "false"))
  (newline))

(test-case 0 '((1 4 7 11 15) (2 5 8 12 19) (3 6 9 16 22) (10 13 14 17 24) (18 21 23 26 30)) 5)
(test-case 1 '((1 4 7 11 15) (2 5 8 12 19) (3 6 9 16 22) (10 13 14 17 24) (18 21 23 26 30)) 20)
(test-case 2 '((1 4 7 11 15) (2 5 8 12 19) (3 6 9 16 22) (10 13 14 17 24) (18 21 23 26 30)) 1)
(test-case 3 '((1 4 7 11 15) (2 5 8 12 19) (3 6 9 16 22) (10 13 14 17 24) (18 21 23 26 30)) 30)
(test-case 4 '((-5)) -5)
(test-case 5 '((-5)) 0)
(test-case 6 '((1 2 3) (4 5 6) (7 8 9)) 7)
(test-case 7 '() 1)
(test-case 8 '(() ) 1)
(test-case 9 '((1 3 5 7) (2 4 6 8) (10 12 14 16)) 11)
