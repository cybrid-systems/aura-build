(define (char->val c)
  (- (char->integer c) (char->integer #\A) 1))

(define (solve s)
  (let loop ((i 0) (ans 0))
    (if (= i (string-length s))
        ans
        (loop (+ i 1)
              (+ (* ans 26) (+ (char->val (string-ref s i)) 1))))))

(define (run-case i s)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve s))
  (newline))

(run-case 0 "A")
(run-case 1 "Z")
(run-case 2 "AA")
(run-case 3 "AB")
(run-case 4 "AZ")
(run-case 5 "BA")
(run-case 6 "ZZ")
(run-case 7 "AAA")
(run-case 8 "ZY")
