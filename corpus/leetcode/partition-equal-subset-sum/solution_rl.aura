(require "lc_json" all:)
(require "compat" all:)
(define (sum lst)
  (if (null? lst)
      0
      (+ (car lst) (sum (cdr lst)))))
(define (any-sum? lst target)
  (any-sum-helper lst target 0))
(define (any-sum-helper lst target current)
  (cond
    ((= current target) #t)
    ((null? lst) #f)
    (else
      (let ((next (+ current (car lst))))
        (if (> next target)
            (any-sum-helper (cdr lst) target current)
            (or (any-sum-helper (cdr lst) target next)
                (any-sum-helper (cdr lst) target current)))))))
(define (solve arr)
  (let ((s (sum arr)))
    (if (or (null? arr) (null? (cdr arr)))
        #f
        (if (not (= 0 (modulo s 2)))
            #f
            (any-sum? arr (quotient s 2))))))
(define (print-list lst)
  (display "[")
  (cond
    ((null? lst) (display "]"))
    (else
      (display (car lst))
      (let loop ((rest (cdr lst)))
        (if (null? rest)
            (display "]")
            (begin
              (display ", ")
              (display (car rest))
              (loop (cdr rest))))))))
(define (display-result label val)
  (display label)
  (display val)
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "arr")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/partition-equal-subset-sum/tests.json")))
