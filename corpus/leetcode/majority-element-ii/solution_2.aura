(define (solve nums)
  (let* ((n (length nums))
         (threshold (quotient n 3))
         (counts '()))
    (define (inc x)
      (set! counts (cons (cons x (+ (cdr (assv x counts)) 1))
                         (remove-assv x counts))))
    (define (remove-assv x lst)
      (cond ((null? lst) '())
            ((= (car (car lst)) x) (cdr lst))
            (else (cons (car lst) (remove-assv x (cdr lst))))))
    (define (assv x lst)
      (cond ((null? lst) #f)
            ((= (car (car lst)) x) (car lst))
            (else (assv x (cdr lst)))))
    (define (loop lst)
      (if (null? lst) '()
          (let ((x (car lst)))
            (if (assv x counts)
                (begin
                  (set! counts
                        (cons (cons x (+ (cdr (assv x counts)) 1))
                              (remove-assv x counts)))
                  (loop (cdr lst)))
                (begin
                  (set! counts (cons (cons x 1) counts))
                  (loop (cdr lst)))))))
    (loop nums)
    (define (filter-helper lst acc)
      (cond ((null? lst) acc)
            ((> (cdr (car lst)) threshold)
             (filter-helper (cdr lst) (cons (car (car lst)) acc)))
            (else (filter-helper (cdr lst) acc))))
    (filter-helper counts '())))

(define (display-list lst)
  (display "[")
  (define (helper l)
    (if (null? l) '()
        (begin
          (display (number->string (car l)))
          (if (not (null? (cdr l)))
              (display ", "))
          (helper (cdr l)))))
  (helper lst)
  (display "]"))

(display "CASE0=") (display-list (solve '(3 2 3 2 1 1 1))) (newline)
(display "CASE1=") (display-list (solve '(1 2))) (newline)
(display "CASE2=") (display-list (solve '(1))) (newline)
(display "CASE3=") (display-list (solve '(1 1 1))) (newline)
(display "CASE4=") (display-list (solve '(1 2 3 4))) (newline)
(display "CASE5=") (display-list (solve '(5 5 5 5 1 2 3))) (newline)
(display "CASE6=") (display-list (solve '(2 2 2))) (newline)
(display "CASE7=") (display-list (solve '())) (newline)
