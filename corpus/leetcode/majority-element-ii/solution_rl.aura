(require "compat" all:)
(define (solve nums)
  (let* ((n (length nums))
         (threshold (quotient n 3))
         (freq '()))
    (define (inc x)
      (let ((entry (assoc x freq)))
        (if entry
            (set-cdr! entry (+ (cdr entry) 1))
            (set! freq (cons (cons x 1) freq)))))
    (define (collect-list xs)
      (cond ((null? xs) '())
            (else
              (let* ((p (car xs))
                     (k (car p))
                     (c (cdr p)))
                (if (> c threshold)
                    (cons k (collect-list (cdr xs)))
                    (collect-list (cdr xs)))))))
    (let loop ((rest nums))
      (if (null? rest)
          (collect-list freq)
          (begin
            (inc (car rest))
            (loop (cdr rest)))))))

(define (display-list lst)
  (display "[")
  (let loop ((xs lst) (first? #t))
    (cond ((null? xs) (display "]"))
          (else
           (if first? (set! first? #f) (display ", "))
           (display (car xs))
           (loop (cdr xs) #f)))))

(display "CASE0=") (display-list (solve '(3 2 3 2 1 1 1))) (newline)
(display "CASE1=") (display-list (solve '(1 2))) (newline)
(display "CASE2=") (display-list (solve '(1))) (newline)
(display "CASE3=") (display-list (solve '(1 1 1))) (newline)
(display "CASE4=") (display-list (solve '(1 2 3 4))) (newline)
(display "CASE5=") (display-list (solve '(5 5 5 5 1 2 3))) (newline)
(display "CASE6=") (display-list (solve '(2 2 2))) (newline)
(display "CASE7=") (display-list (solve '())) (newline)
