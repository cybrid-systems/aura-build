(require "lc_json" all:)
(require "compat" all:)
(define (solve nums)
  (let* ((n (length nums))
         (threshold (quotient n 3))
         (counts '()))
    (define (inc x)
      (set! counts (cons (cons x (+ (cdr (assv x counts)) 1))
                         (remove-assv x counts))))
    (define (remove-assv x lst)
      (cond ((null? lst) '())
            ((= (car (car lst)) x) (cdr lst))
            (else (cons (car lst) (remove-assv x (cdr lst))))))
    (define (assv x lst)
      (cond ((null? lst) #f)
            ((= (car (car lst)) x) (car lst))
            (else (assv x (cdr lst)))))
    (define (loop lst)
      (if (null? lst) '()
          (let ((x (car lst)))
            (if (assv x counts)
                (begin
                  (set! counts
                        (cons (cons x (+ (cdr (assv x counts)) 1))
                              (remove-assv x counts)))
                  (loop (cdr lst)))
                (begin
                  (set! counts (cons (cons x 1) counts))
                  (loop (cdr lst)))))))
    (loop nums)
    (define (filter-helper lst acc)
      (cond ((null? lst) acc)
            ((> (cdr (car lst)) threshold)
             (filter-helper (cdr lst) (cons (car (car lst)) acc)))
            (else (filter-helper (cdr lst) acc))))
    (filter-helper counts '())))
(define (display-list lst)
  (display "[")
  (define (helper l)
    (if (null? l) '()
        (begin
          (display (number->string (car l)))
          (if (not (null? (cdr l)))
              (display ", "))
          (helper (cdr l)))))
  (helper lst)
  (display "]"))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/majority-element-ii/tests.json")))
