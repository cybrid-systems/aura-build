from collections import deque

def solve(grid):
    if not grid or not grid[0]:
        return
    m, n = len(grid), len(grid[0])
    INF = 2147483647
    q = deque()
    # Add all gates as starting points
    for i in range(m):
        for j in range(n):
            if grid[i][j] == 0:
                q.append((i, j))
    # Multi-source BFS
    dist = 0
    while q:
        dist += 1
        sz = len(q)
        for _ in range(sz):
            i, j = q.popleft()
            for di, dj in ((-1,0),(1,0),(0,-1),(0,1)):
                ni, nj = i + di, j + dj
                if 0 <= ni < m and 0 <= nj < n and grid[ni][nj] == INF:
                    grid[ni][nj] = dist
                    q.append((ni, nj))

CASES = [
    {"grid": []},
    {"grid": [[0]]},
    {"grid": [[-1]]},
    {"grid": [[INF, 0, INF], [INF, INF, INF], [0, INF, -1]]},
    {"grid": [[0, -1, 0]]},
    {"grid": [[-1, INF], [0, INF]]},
    {"grid": [[INF for _ in range(5)] for _ in range(5)]},
    {"grid": [[-1, 0, -1, INF, INF], [INF, INF, INF, -1, INF], [INF, -1, INF, -1, 0]]},
]

if __name__ == '__main__':
    import json
    out = []
    for i, case in enumerate(CASES):
        # deep copy grid for each run
        grid = [row[:] for row in case["grid"]]
        solve(grid)
        out.append({"id": i, "input": {"grid": case["grid"]}, "expected": json.dumps(grid, separators=(',', ':'), ensure_ascii=False)})
    print(json.dumps(out, separators=(',', ':'), ensure_ascii=False))
