; soft_leetcode_runtime slug=merge-k-sorted-lists path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-2 hits=2/8
; baseline_hits=1/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define display-list
    (lambda (lst)
      (begin
        (display "[")
        (letrec ((loop (lambda (l first)
            (if (null? l)
              (begin
                (display "]")
                #t)
              (begin
                (if first
                  (set! first #f)
                  (begin
                    (display ",")))
                (display (car l))
                (loop
                  (cdr l) first))))))
          (loop
            lst #t)))))
  (define display-value
    (lambda (v)
      (if (null? v)
        (display "[]")
        (if (list? v)
          (display-list v)
          (display v)))))
  (define make-list
    (lambda (n v)
      (letrec ((loop (lambda (i acc)
          (if (>=
              i n)
            acc
            (loop
              (+
                i 1) (cons
                v acc))))))
        (loop
          0 (quote ())))))
  (define list-set
    (lambda (lst i v)
      (letrec ((loop (lambda (l idx)
          (if (null? l)
            (quote ())
            (if (=
                idx i)
              (cons
                v (cdr l))
              (cons
                (car l) (loop
                  (cdr l) (+
                    idx 1))))))))
        (loop
          lst 0))))
  (define insert-heap
    (lambda (entry heap)
      (if (null? heap)
        (list entry)
        (if (<=
            (car entry) (car (car heap)))
          (cons
            entry heap)
          (cons
            (car heap) (insert-heap
              entry (cdr heap)))))))
  (define solve
    (lambda (lists)
      (let ((n (length lists)))
        (if (=
            n 0)
          (quote ())
          (let ((positions (make-list
              n 0)))
            (let ((initial-heap (letrec ((loop (lambda (i acc)
                  (if (>=
                      i n)
                    acc
                    (let ((l (list-ref
                        lists i)))
                      (if (null? l)
                        (loop
                          (+
                            i 1) acc)
                        (loop
                          (+
                            i 1) (insert-heap
                            (cons
                              (car l) i) acc))))))))
                (loop
                  0 (quote ())))))
              (letrec ((loop (lambda (heap positions result)
                  (if (null? heap)
                    (reverse result)
                    (let ((top (car heap)))
                      (let ((val (car top)))
                        (let ((idx (cdr top)))
                          (let ((rest-heap (cdr heap)))
                            (let ((cur-pos (list-ref
                                positions idx)))
                              (let ((new-pos (list-set
                                  positions idx (+
                                    cur-pos 1))))
                                (let ((lst (list-ref
                                    lists idx)))
                                  (let ((next-pos (+
                                      cur-pos 1)))
                                    (let ((advanced (if (>=
                                          next-pos (length lst))
                                        #f
                                        (list-ref
                                          lst next-pos))))
                                      (loop
                                        (if advanced
                                          (insert-heap
                                            (cons
                                              advanced idx) rest-heap)
                                          rest-heap) new-pos (cons
                                          val result)))))))))))))))
                (loop
                  initial-heap positions (quote ())))))))))
  (define run-test
    (lambda (case-id lists)
      (let ((result (solve lists)))
        (begin
          (display "CASE")
          (display case-id)
          (display "=")
          (display-value result)
          (newline)))))
  (run-test
    0 (quote ((1
          4 5)
        (1
          3 4) (2 6))))
  (run-test
    1 (quote ()))
  (run-test
    2 (quote (0
        0 0)))
  (run-test
    3 (quote ((1
          2 3))))
  (run-test
    4 (quote ((1)
        (2) (3) (4) (5))))
  (run-test
    5 (quote ((5
          10 15)
        (1
          2 3) (7
          8 9))))
  (run-test
    6 (quote ((-5 -2)
        (-3
          0 4) (-1
          1 6))))
  (run-test
    7 (quote ((1
          1 1)
        (2
          2 2) (3
          3 3)))))
