(define (value-of c)
  (cond ((equal? c "I") 1)
        ((equal? c "V") 5)
        ((equal? c "X") 10)
        ((equal? c "L") 50)
        ((equal? c "C") 100)
        ((equal? c "D") 500)
        ((equal? c "M") 1000)
        (else 0)))

(define (solve s)
  (let* ((len (string-length s))
         (loop (lambda (i acc)
                 (if (= i len)
                     acc
                     (let ((cur (value-of (string-ref s i)))
                           (next (if (< (+ i 1) len)
                                     (value-of (string-ref s (+ i 1)))
                                     0)))
                       (if (< cur next)
                           (loop (+ i 2) (+ acc 0))
                           (loop (+ i 1) (+ acc cur))))))))
    (let ((result (loop 0 0))
          (total 0))
      (let ((loop2 (lambda (i acc)
                     (if (= i len)
                         acc
                         (let ((cur (value-of (string-ref s i)))
                               (next (if (< (+ i 1) len)
                                         (value-of (string-ref s (+ i 1)))
                                         0)))
                           (if (< cur next)
                               (loop2 (+ i 2) (- acc cur))
                               (loop2 (+ i 1) (+ acc cur))))))))
        (set! total (loop2 0 0)))
      total)))

(define (string-length s)
  (let ((loop (lambda (i acc)
                (if (>= i (string-length-helper s))
              acc
              (loop (+ i 1) (+ acc 1))))))
    (loop 0 0)))

(define (string-length-helper s)
  (let ((n 0))
    (let ((loop (lambda (i)
                  (if (equal? (substring s i (+ i 1)) "")
                      (set! n i)
                      (loop (+ i 1))))))
      (loop 0)
      n)))

(define (substring s start end)
  (let ((loop (lambda (i acc)
                (if (= i end)
                    acc
                    (loop (+ i 1) (string-append acc (string-ref s i)))))))
    (loop start "")))

(display "CASE0=") (display (solve "III")) (newline)
(display "CASE1=") (display (solve "LVIII")) (newline)
(display "CASE2=") (display (solve "MCMXCIV")) (newline)
(display "CASE3=") (display (solve "IV")) (newline)
(display "CASE4=") (display (solve "IX")) (newline)
(display "CASE5=") (display (solve "XL")) (newline)
(display "CASE6=") (display (solve "XC")) (newline)
(display "CASE7=") (display (solve "CD")) (newline)
(display "CASE8=") (display (solve "CM")) (newline)
(display "CASE9=") (display (solve "MMMDCCCLXXXVIII")) (newline)
