(define current-n 0)
(define current-pick 0)

(define (set-test n pick)
  (set! current-n n)
  (set! current-pick pick))

(define (guess num)
  (cond ((< current-pick num) -1)
        ((> current-pick num) 1)
        (else 0)))

(define (solve)
  (let ((lo 1) (hi current-n))
    (let loop ((l lo) (h hi))
      (cond ((> l h) l)
            (else
              (let ((m (quotient (+ l h) 2)))
                (let ((g (guess m)))
                  (cond ((= g 0) m)
                        ((= g -1) (loop l (- m 1)))
                        (else (loop (+ m 1) h))))))))))

(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display result)
  (newline))

(begin
  (set-test 1 1)
  (display-case 0 (solve))
  (set-test 2 1)
  (display-case 1 (solve))
  (set-test 2 2)
  (display-case 2 (solve))
  (set-test 10 6)
  (display-case 3 (solve))
  (set-test 10 1)
  (display-case 4 (solve))
  (set-test 10 10)
  (display-case 5 (solve))
  (set-test 1000 500)
  (display-case 6 (solve))
  (set-test 1000 999)
  (display-case 7 (solve)))
