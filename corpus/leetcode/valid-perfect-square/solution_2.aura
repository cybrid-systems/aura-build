(define (solve n)
  (letrec ((helper (lambda (lo hi)
                     (if (> lo hi)
                         #f
                         (let ((mid (quotient (+ lo hi) 2)))
                              (cond
                                ((= (* mid mid) n) #t)
                                ((< (* mid mid) n) (helper (+ mid 1) hi))
                                (else (helper lo (- mid 1)))))))))
    (helper 1 n)))

(define (display-list xs)
  (display "(")
  (letrec ((loop (lambda (xs)
                   (cond
                     ((null? xs) (display ""))
                     (else
                      (display (car xs))
                      (when (not (null? (cdr xs)))
                        (display " "))
                      (loop (cdr xs)))))))
    (loop xs))
  (display ")"))

(define cases (list
  (list 0 1)
  (list 1 16)
  (list 2 14)
  (list 3 4)
  (list 4 2147483647)
  (list 5 2147395600)
  (list 6 2)
  (list 7 100000000)))

(letrec ((run-all (lambda (cases)
                    (if (null? cases)
                        '()
                        (begin
                          (let ((c (car cases)))
                            (let ((i (car c)) (n (car (cdr c))))
                                 (display (string-append "CASE" (number->string i) "="))
                                 (display (if (solve n) "#t" "#f"))
                                 (newline)))
                          (run-all (cdr cases)))))))
  (run-all cases))
