(require "lc_json" all:)
(require "compat" all:)
(define (solve n)
  (letrec ((helper (lambda (lo hi)
                     (if (> lo hi)
                         #f
                         (let ((mid (quotient (+ lo hi) 2)))
                              (cond
                                ((= (* mid mid) n) #t)
                                ((< (* mid mid) n) (helper (+ mid 1) hi))
                                (else (helper lo (- mid 1)))))))))
    (helper 1 n)))
(define (display-list xs)
  (display "(")
  (letrec ((loop (lambda (xs)
                   (cond
                     ((null? xs) (display ""))
                     (else
                      (display (car xs))
                      (when (not (null? (cdr xs)))
                        (display " "))
                      (loop (cdr xs)))))))
    (loop xs))
  (display ")"))
(define cases (list
  (list 0 1)
  (list 1 16)
  (list 2 14)
  (list 3 4)
  (list 4 2147483647)
  (list 5 2147395600)
  (list 6 2)
  (list 7 100000000)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/valid-perfect-square/tests.json")))
