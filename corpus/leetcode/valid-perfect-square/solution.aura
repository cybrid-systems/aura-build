(define (solve n)
  (let ((lo 1)
        (hi n))
    (let loop ((lo lo) (hi hi))
      (if (> lo hi)
          #f
          (let* ((mid (quotient (+ lo hi) 2))
                 (sq (* mid mid)))
            (cond ((= sq n) #t)
                  ((< sq n) (loop (+ mid 1) hi))
                  (else (loop lo (- mid 1))))))))

(define (display-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n))
  (newline))

(display-case 0 1)
(display-case 1 16)
(display-case 2 14)
(display-case 3 4)
(display-case 4 2147483647)
(display-case 5 2147395600)
(display-case 6 2)
(display-case 7 100000000)
