(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (list-set! lst i v)
  (if (= i 0)
      (set-car! lst v)
      (list-set! (cdr lst) (- i 1) v)))

(define (abs x)
  (if (< x 0) (- 0 x) x))

(define (solve nums)
  (let* ((n (length nums))
         (arr (list-copy nums)))
    (begin
      (for-each-i
        (lambda (i)
          (let ((v (list-ref arr i)))
            (let ((idx (- (abs v) 1)))
              (if (and (>= idx 0) (< idx n))
                  (let ((cur (list-ref arr idx)))
                    (if (> cur 0) (list-set! arr idx (- 0 cur))))))
            ))
        n)
      (collect-missing arr n 0 '()))))

(define (for-each-i f n)
  (if (> n 0)
      (begin (f (- n 1)) (for-each-i f (- n 1)))))

(define (list-copy lst)
  (if (null? lst) '() (cons (car lst) (list-copy (cdr lst)))))

(define (collect-missing arr i result)
  (if (= i (length-of-flattened arr))
      result
      (let ((v (list-ref arr i)))
        (if (> v 0)
            (collect-missing arr (+ i 1) (cons (+ i 1) result))
            (collect-missing arr (+ i 1) result)))))

(define (length-of-flattened arr)
  (let loop ((l arr) (n 0))
    (if (null? l) n (loop (cdr l) (+ n 1)))))

(define (reverse lst)
  (let loop ((l lst) (acc '()))
    (if (null? l) acc (loop (cdr l) (cons (car l) acc)))))

(define (print-list lst)
  (if (null? lst)
      (begin (newline))
      (begin
        (display (car lst))
        (if (null? (cdr lst))
            (newline)
            (begin (display " ") (print-list-tail (cdr lst)))))))

(define (print-list-tail lst)
  (if (null? lst)
      (newline)
      (begin
        (display (car lst))
        (if (null? (cdr lst))
            (newline)
            (begin (display " ") (print-list-tail (cdr lst)))))))

;; For test harness
(display "CASE0=") (display (solve (list 4 3 2 7 8 2 3 1))) (newline)
(display "CASE1=") (display (solve (list 1 1))) (newline)
(display "CASE2=") (display (solve (list 1 2 3 4))) (newline)
(display "CASE3=") (display (solve (list 2 2))) (newline)
(display "CASE4=") (display (solve (list 3 3 3 3))) (newline)
(display "CASE5=") (display (solve (list 5 4 3 2 1))) (newline)
(display "CASE6=") (display (solve (list))) (newline)
(display "CASE7=") (display (solve (list 2))) (newline)
(display "CASE8=") (display (solve (list 1 1 1 2 2 3))) (newline)
