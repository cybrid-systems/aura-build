(define (string->list-of-chars s)
  (let ((len (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (= i len)
          (reverse acc)
          (loop (+ i 1) (cons (string-ref s i) acc))))))

(define (char-in-set? c s)
  (cond ((null? s) #f)
        ((equal? (car s) c) #t)
        (else (char-in-set? c (cdr s)))))

(define (count-jewels stones-chars jewel-set)
  (cond ((null? stones-chars) 0)
        ((char-in-set? (car stones-chars) jewel-set)
         (+ 1 (count-jewels (cdr stones-chars) jewel-set)))
        (else (count-jewels (cdr stones-chars) jewel-set))))

(define (solve jewels stones)
  (let ((jewel-chars (string->list-of-chars jewels)))
    (count-jewels (string->list-of-chars stones) jewel-chars)))

;; Embedded test cases
(define CASE0 (list "aA" "aAAbbbb"))
(define CASE1 (list "z" "ZZ"))
(define CASE2 (list "" "abc"))
(define CASE3 (list "abc" ""))
(define CASE4 (list "aAbBcC" "aabbccddeeff"))
(define CASE5 (list "abcdefghijklmnopqrstuvwxyz" "TheQuickBrownFoxJumpsOverTheLazyDog"))
(define CASE6 (list "abc" "aabbccabc"))
(define CASE7 (list "ZZ" "zZzZzZ"))

(display "CASE0=") (display (solve (car CASE0) (cadr CASE0))) (newline)
(display "CASE1=") (display (solve (car CASE1) (cadr CASE1))) (newline)
(display "CASE2=") (display (solve (car CASE2) (cadr CASE2))) (newline)
(display "CASE3=") (display (solve (car CASE3) (cadr CASE3))) (newline)
(display "CASE4=") (display (solve (car CASE4) (cadr CASE4))) (newline)
(display "CASE5=") (display (solve (car CASE5) (cadr CASE5))) (newline)
(display "CASE6=") (display (solve (car CASE6) (cadr CASE6))) (newline)
(display "CASE7=") (display (solve (car CASE7) (cadr CASE7))) (newline)
