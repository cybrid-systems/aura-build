;; Basic Calculator in Aura
;; Evaluates an arithmetic expression with +, -, parentheses, and spaces.

(define (list-from-string s)
  ;; Convert a string into a list of characters.
  (let ((len (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (>= i len)
          (reverse acc)
          (loop (+ i 1) (cons (string-ref s i) acc))))))

(define (char->int c)
  ;; Convert character digit to integer.
  (- (char->integer c) (char->integer #\0)))

(define (digit? c)
  (and (>= (char->integer c) (char->integer #\0))
       (<= (char->integer c) (char->integer #\9))))

(define (char=? a b)
  (= (char->integer a) (char->integer b)))

(define (evaluate chars)
  ;; Evaluate the expression represented as a list of characters.
  (let loop ((chars chars)
             (result 0)
             (sign 1)
             (num 0)
             (stack '()))
    (cond
      ((null? chars)
       ;; End of expression: finalize.
       (let ((final (+ result (* sign num))))
         (if (null? stack)
             final
             (apply-saved final stack))))
      ((digit? (car chars))
       (loop (cdr chars) result sign
             (+ (* num 10) (char->int (car chars))) stack))
      ((char=? (car chars) #\space)
       (loop (cdr chars) result sign num stack))
      ((char=? (car chars) #\+)
       (loop (cdr chars)
             (+ result (* sign num))
             1 0 stack))
      ((char=? (car chars) #\-)
       (loop (cdr chars)
             (+ result (* sign num))
             -1 0 stack))
      ((char=? (car chars) #\()
       ;; Push current result and sign onto stack.
       (loop (cdr chars)
             0 1 0
             (cons (cons result sign) stack)))
      ((char=? (car chars) #\))
       ;; Pop and combine.
       (let ((cur (+ result (* sign num))))
         (let ((top (car stack)))
           (let ((saved-result (car top))
                 (saved-sign (cdr top)))
             (let ((combined (+ saved-result (* saved-sign cur))))
               (loop (cdr chars) combined 1 0 (cdr stack)))))))
      (else
       (loop (cdr chars) result sign num stack)))))

(define (apply-saved val stack)
  (if (null? stack)
      val
      (let ((top (car stack)))
        (let ((saved-result (car top))
              (saved-sign (cdr top)))
          (apply-saved (+ saved-result (* saved-sign val)) (cdr stack))))))

(define (solve s)
  (evaluate (list-from-string s)))

;; ---------- Display helper ----------
(define (display-value v)
  (display v))

;; ---------- Test cases ----------
(display "CASE0=") (display-value (solve "1 + 1")) (newline)
(display "CASE1=") (display-value (solve "(1+(4+5+2)-3)+(6+8)")) (newline)
(display "CASE2=") (display-value (solve " 2-1 + 2")) (newline)
(display "CASE3=") (display-value (solve "1")) (newline)
(display "CASE4=") (display-value (solve "0")) (newline)
(display "CASE5=") (display-value (solve "(1)")) (newline)
(display "CASE6=") (display-value (solve "1-2-3")) (newline)
(display "CASE7=") (display-value (solve "((1+2)+(3+4))")) (newline)
(display "CASE8=") (display-value (solve "100 + 200 - 50")) (newline)
(display "CASE9=") (display-value (solve "10 - (2 + 3) - (5 - 1)")) (newline)
(display "CASE10=") (display-value (solve "-(3 + 4)")) (newline)
