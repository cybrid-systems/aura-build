; Soft oneshot already full; materialize via Soft current-source. No LLM.
(begin
  (define list-from-string
    (lambda (s)
      (let ((len (string-length s)))
        (letrec ((loop (lambda (i acc)
            (if (>=
                i len)
              (reverse acc)
              (loop
                (+
                  i 1) (cons
                  (string-ref
                    s i) acc))))))
          (loop
            0 (quote 0))))))
  (define char->int
    (lambda (c)
      (-
        (char->integer c) (char->integer 48))))
  (define digit?
    (lambda (c)
      (and
        (>=
          (char->integer c) (char->integer 48)) (<=
          (char->integer c) (char->integer 57)))))
  (define char=?
    (lambda (a b)
      (=
        (char->integer a) (char->integer b))))
  (define evaluate
    (lambda (chars)
      (letrec ((loop (lambda (chars result sign num stack)
          (if (null? chars)
            (let ((final (+
                result (*
                  sign num))))
              (if (null? stack)
                final
                (apply-saved
                  final stack)))
            (if (digit? (car chars))
              (loop
                (cdr chars) result sign (+
                  (*
                    num 10) (char->int (car chars))) stack)
              (if (char=?
                  (car chars) 32)
                (loop
                  (cdr chars) result sign num stack)
                (if (char=?
                    (car chars) 43)
                  (loop
                    (cdr chars) (+
                      result (*
                        sign num)) 1 0 stack)
                  (if (char=?
                      (car chars) 45)
                    (loop
                      (cdr chars) (+
                        result (*
                          sign num)) -1 0 stack)
                    (if (char=?
                        (car chars) 40)
                      (loop
                        (cdr chars) 0 1 0 (cons
                          (cons
                            result sign) stack))
                      (if (char=?
                          (car chars) 41)
                        (let ((cur (+
                            result (*
                              sign num))))
                          (let ((top (car stack)))
                            (let ((saved-result (car top)))
                              (let ((saved-sign (cdr top)))
                                (let ((combined (+
                                    saved-result (*
                                      saved-sign cur))))
                                  (loop
                                    (cdr chars) combined 1 0 (cdr stack)))))))
                        (loop
                          (cdr chars) result sign num stack)))))))))))
        (loop
          chars 0 1 0 (quote 0)))))
  (define apply-saved
    (lambda (val stack)
      (if (null? stack)
        val
        (let ((top (car stack)))
          (let ((saved-result (car top)))
            (let ((saved-sign (cdr top)))
              (apply-saved
                (+
                  saved-result (*
                    saved-sign val)) (cdr stack))))))))
  (define solve
    (lambda (s)
      (evaluate (list-from-string s))))
  (define display-value
    (lambda (v)
      (display v)))
  (display "CASE0=")
  (display-value (solve "1 + 1"))
  (newline)
  (display "CASE1=")
  (display-value (solve "(1+(4+5+2)-3)+(6+8)"))
  (newline)
  (display "CASE2=")
  (display-value (solve " 2-1 + 2"))
  (newline)
  (display "CASE3=")
  (display-value (solve "1"))
  (newline)
  (display "CASE4=")
  (display-value (solve "0"))
  (newline)
  (display "CASE5=")
  (display-value (solve "(1)"))
  (newline)
  (display "CASE6=")
  (display-value (solve "1-2-3"))
  (newline)
  (display "CASE7=")
  (display-value (solve "((1+2)+(3+4))"))
  (newline)
  (display "CASE8=")
  (display-value (solve "100 + 200 - 50"))
  (newline)
  (display "CASE9=")
  (display-value (solve "10 - (2 + 3) - (5 - 1)"))
  (newline)
  (display "CASE10=")
  (display-value (solve "-(3 + 4)"))
  (newline))
