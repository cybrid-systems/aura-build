import sys
import json
import ctypes

def solve(root):
    """Compute maximum depth of binary tree (number of nodes on longest root-to-leaf path)."""
    if root is None:
        return 0
    # dereference atom to get node map
    node = root.value if hasattr(root, 'value') else root
    if node is None:
        return 0
    left = node['left']
    right = node['right']
    left_depth = solve(left)
    right_depth = solve(right)
    return 1 + (left_depth if left_depth > right_depth else right_depth)


def make_atom():
    """Create a tiny mutable cell to simulate Clojure atom."""
    box = {'v': None}
    def setv(x):
        box['v'] = x
        return x
    def getv():
        return box['v']
    class A:
        def __init__(self, init=None):
            box['v'] = init
        @property
        def value(self):
            return box['v']
        def __deref__(self):
            return box['v']
    # Use simple wrapper with __deref__ via attribute
    class Atom:
        def __init__(self, val=None):
            self._v = val
        def __deref__(self):
            return self._v
        @property
        def value(self):
            return self._v
    return Atom


def build_tree_from_list(values, idx=0):
    """Build a tree from level-order list representation. None means absent."""
    Atom = None  # placeholder
    if idx >= len(values) or values[idx] is None:
        return None
    node = AtomClass(values[idx])
    node._v = {'left': build_tree_from_list(values, 2*idx+1),
               'right': build_tree_from_list(values, 2*idx+2)}
    return node


AtomClass = None

def init_atom_class():
    global Atom
    class AtomClass:
        def __init__(self, val=None):
            self._v = val
        def __deref__(self):
            return self._v
        @property
        def value(self):
            return self._v
    return AtomClass


init_atom_class()


def build(values):
    """Helper to build tree from level-order list using None for missing nodes."""
    def helper(idx):
        if idx >= len(values) or values[idx] is None:
            return None
        n = AtomClass()
        n._v = {'left': helper(2*idx+1), 'right': helper(2*idx+2)}
        return n
    return helper(0)


CASES = [
    {'name': 'empty', 'root': None},
    {'name': 'single_node', 'root': build([1])},
    {'name': 'two_levels_left', 'root': build([1, 2])},
    {'name': 'two_levels_right', 'root': build([1, None, 3])},
    {'name': 'balanced', 'root': build([1, 2, 3, 4, 5, 6, 7])},
    {'name': 'skewed_left', 'root': build([1, 2, None, 3, None, None, None, 4])},
    {'name': 'skewed_right', 'root': build([1, None, 2, None, None, None, 3])},
    {'name': 'unbalanced', 'root': build([1, 2, 3, None, None, None, 4])},
]


if __name__ == '__main__':
    results = []
    for i, case in enumerate(CASES):
        out = solve(case['root'])
        results.append({"id": i, "input": case['name'], "expected": json.dumps(out, separators=(',', ':'))})
    print(json.dumps(results, separators=(',', ':'), ensure_ascii=False))
