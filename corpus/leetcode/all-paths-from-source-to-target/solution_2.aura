(define (list-length lst)
  (if (null? lst) 0 (+ 1 (list-length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (append-list a b)
  (if (null? a) b (cons (car a) (append-list (cdr a) b))))

(define (reverse-list lst)
  (define (rev acc rest)
    (if (null? rest) acc (rev (cons (car rest) acc) (cdr rest))))
  (rev '() lst))

(define (display-list lst)
  (display "[")
  (define (loop rest)
    (cond ((null? rest) (display "]"))
          (else
            (let ((v (car rest)))
              (cond ((number? v) (display v))
                    (else (display-list v))))
            (if (null? (cdr rest))
                (display "")
                (display ","))
            (loop (cdr rest)))))
  (loop lst)
  (display "]"))

(define (list-to-vector lst)
  (define n (list-length lst))
  (define (build i acc)
    (if (= i 0) acc (build (- i 1) (cons (list-ref lst (- i 1)) acc))))
  (build n '()))

(define (vector-to-list v)
  (define n (vector-length v))
  (define (build i acc)
    (if (= i 0) acc (build (- i 1) (cons (vector-ref v (- n i)) acc))))
  (build n '()))

(define (vector-ref-vec v i)
  (vector-ref v i))

(define (solve graph)
  (let ((n (vector-length graph)))
    (define (dfs u path result)
      (if (= u (- n 1))
          (let ((new-result (cons (reverse-list path) result)))
            new-result)
          (let ((nbrs (vector-ref-vec graph u)))
            (define (iter ns r)
              (if (null? ns)
                  r
                  (let ((v (car ns)))
                    (iter (cdr ns)
                          (dfs v (cons v path) r)))))
            (iter nbrs result))))
    (let ((result-list (dfs 0 (list 0) '())))
      (list-to-vector (reverse-list result-list)))))

(define input0 #([[1, 2], [3], [3], []]))
(define input1 #([[1, 2], [3], [3], [4], []]))
(define input2 #([[1], [2], [3], [4], []]))
(define input3 #([[1, 2, 3], [3], [3], []]))
(define input4 #([[1], [2, 3], [3], []]))
(define input5 #([[4, 3, 1], [3, 2, 4], [3], [4], []]))
(define input6 #([[1], [2, 3], [3], [4], [5], []]))
(define input7 #([[1, 2, 3, 4, 5], [3, 4], [3, 5], [5], [5], []]))

(display "CASE0=")
(display-list (solve input0))
(newline)
(display "CASE1=")
(display-list (solve input1))
(newline)
(display "CASE2=")
(display-list (solve input2))
(newline)
(display "CASE3=")
(display-list (solve input3))
(newline)
(display "CASE4=")
(display-list (solve input4))
(newline)
(display "CASE5=")
(display-list (solve input5))
(newline)
(display "CASE6=")
(display-list (solve input6))
(newline)
(display "CASE7=")
(display-list (solve input7))
(newline)
