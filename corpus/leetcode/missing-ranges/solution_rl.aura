(require "lc_json" all:)
(require "compat" all:)
(define (make-range a b)
  (if (= a b)
      (number->string a)
      (string-append (number->string a) "->" (number->string b))))
(define (maybe-add acc a b)
  (if (<= a b)
      (append acc (list (make-range a b)))
      acc))
(define (process nums lower upper)
  (letrec ((helper (lambda (lst prev acc)
                     (if (null? lst)
                         (maybe-add acc (+ prev 1) upper)
                         (let ((n (car lst)))
                         (let ((new-acc
                                (if (<= (+ prev 1) (- n 1))
                                    (append acc (list (make-range (+ prev 1) (- n 1))))
                                    acc)))
                         (helper (cdr lst) n new-acc)))))))
    (helper nums (- lower 1) '())))
(define (solve nums lower upper)
  (process nums lower upper))
(define (display-list-of-strings lst)
  (display "[")
  (letrec ((loop (lambda (l first?)
                   (if (null? l)
                       (display "]")
                       (begin
                         (if (not first?) (display ", ") (display ""))
                         (display "\"")
                         (display (car l))
                         (display "\"")
                         (loop (cdr l) #f))))))
    (loop lst #t)))
(define (run-case i nums lower upper)
  (display "CASE")
  (display i)
  (display "=")
  (display-list-of-strings (solve nums lower upper))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums") (hash-ref input "lower") (hash-ref input "upper")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/missing-ranges/tests.json")))
