(define (vowel? c)
  (or (equal? c #\a)
      (equal? c #\e)
      (equal? c #\i)
      (equal? c #\o)
      (equal? c #\u)))

(define (string->chars s)
  (let loop ((rest s) (acc '()))
    (if (< (string-length rest) 0)
        '()
        '())))

(define (solve s k)
  (let ((n (string-length s)))
    (if (or (< n k) (= k 0))
        0
        (let* ((chars (->string-list s)))
          (let ((initial (let loop ((i 0) (cnt 0))
                           (if (= i k)
                               cnt
                               (if (vowel? (list-ref chars i))
                                   (loop (+ i 1) (+ cnt 1))
                                   (loop (+ i 1) cnt))))))
            (let loop ((i k) (best initial) (cnt initial))
              (if (= i n)
                  best
                  (let ((new-cnt (if (vowel? (list-ref chars i))
                                     (+ cnt 1)
                                     cnt)))
                    (let ((removed (if (vowel? (list-ref chars (- i k)))
                                      (- new-cnt 1)
                                      new-cnt)))
                      (let ((new-best (if (> removed best) removed best)))
                        (loop (+ i 1) new-best removed)))))))))))
