(define (display-list xs)
  (display "[")
  (let loop ((rest xs) (first #t))
    (cond
      ((null? rest) (display "]"))
      (else
        (if first (set! first #f) (begin (display ", ") (set! first #f)))
        (display (car rest))
        (loop (cdr rest) #f)))))

(define (make-tree x)
  (if (or (equal? x 'null) (equal? x "null") (equal? x "None"))
      '()
      (cons (car x)
            (cons (make-tree (car (cdr x)))  ; left
                  (make-tree (car (cdr (cdr x)))))))) ; right

(define (postorder tree)
  (if (null? tree)
      '()
      (let ((stack1 (list tree))
            (stack2 '()))
        (let loop ()
          (if (null? stack1)
              '()
              (let* ((node (car stack1))
                     (rest-s1 (cdr stack1))
                     (new-s2 (cons (car node) stack2)))
                (define new-s1 rest-s1)
                (when (not (null? (car (cdr node))))
                  (set! new-s1 (cons (car (cdr node)) new-s1)))
                (when (not (null? (car (cdr (cdr node)))))
                  (set! new-s1 (cons (car (cdr (cdr node))) new-s1)))
                (set! stack1 new-s1)
                (set! stack2 new-s2)
                (loop)))))
        stack2))

(define (solve x)
  (let ((tree (make-tree x)))
    (postorder tree)))

(display "CASE0=") (display (solve 'null)) (newline)
(display "CASE1=") (display (solve (list "root" 1 "left" 'null "right" 'null))) (newline)
(display "CASE2=") (display (solve (list "root" 1 "left" (list "root" 2 "left" 'null "right" 'null) "right" (list "root" 3 "left" 'null "right" 'null)))) (newline)
(display "CASE3=") (display (solve (list "root" 1 "left" (list "root" 2 "left" (list "root" 3 "left" (list "root" 4 "left" 'null "right" 'null) "right" 'null) "right" 'null) "right" 'null))) (newline)
(display "CASE4=") (display (solve (list "root" 1 "left" 'null "right" (list "root" 2 "left" 'null "right" (list "root" 3 "left" 'null "right" (list "root" 4 "left" 'null "right" 'null)))))) (newline)
(display "CASE5=") (display (solve (list "root" 1 "left" (list "root" 2 "left" (list "root" 4 "left" 'null "right" 'null) "right" (list "root" 5 "left" 'null "right" 'null)) "right" (list "root" 3 "left" 'null "right" 'null)))) (newline)
(display "CASE6=") (display (solve (list "root" 1 "left" (list "root" 2 "left" 'null "right" 'null) "right" 'null))) (newline)
(display "CASE7=") (display (solve (list "root" 1 "left" 'null "right" (list "root" 2 "left" 'null "right" 'null)))) (newline)
(display "CASE8=") (display (solve (list "root" 1 "left" (list "root" 2 "left" (list "root" 4 "left" 'null "right" 'null) "right" (list "root" 5 "left" 'null "right" 'null)) "right" (list "root" 3 "left" (list "root" 6 "left" 'null "right" 'null) "right" (list "root" 7 "left" 'null "right" 'null))))) (newline)
