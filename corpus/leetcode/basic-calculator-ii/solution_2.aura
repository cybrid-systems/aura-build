(define (trunc-div a b)
  (quotient a b))

(define (skip-spaces s i)
  (if (and (< i (string-length s)) (char=? (string-ref s i) #\space))
      (skip-spaces s (+ i 1))
      i))

(define (read-num s i)
  (let ((start i))
    (let loop ((j i))
      (if (and (< j (string-length s))
               (or (char>=? (string-ref s j) #\0) (char=? (string-ref s j) #\-)))
          (loop (+ j 1))
          j))))

(define (num-val s start end)
  (let ((len (- end start)))
    (let loop ((k 0) (result 0))
      (if (>= k len)
          result
          (let ((c (string-ref s (+ start k))))
            (if (char=? c #\-)
                (loop (+ k 1) (- 0))
                (loop (+ k 1) (+ (* result 10) (- (char->integer c) (char->integer #\0))))))))))

(define (solve s)
  (let ((len (string-length s)))
    (let loop ((i 0) (stack '()) (op #\+))
      (if (>= i len)
          (let sum-loop ((st stack) (acc 0))
            (if (null? st) acc (sum-loop (cdr st) (+ acc (car st)))))
          (let ((ci (skip-spaces s i)))
            (cond
              ((>= ci len)
               (let sum-loop ((st stack) (acc 0))
                 (if (null? st) acc (sum-loop (cdr st) (+ acc (car st))))))
              ((char=? (string-ref s ci) #\+)
               (loop (+ ci 1) stack #\+))
              ((char=? (string-ref s ci) #\-)
               (loop (+ ci 1) stack #\-))
              ((char=? (string-ref s ci) #\*)
               (let ((j (skip-spaces s (+ ci 1))))
                 (let ((end (read-num s j)))
                   (let ((val (num-val s j end)))
                     (let ((top (car stack)))
                       (loop end (cons (* top val) (cdr stack)) op))))))
              ((char=? (string-ref s ci) #\/)
               (let ((j (skip-spaces s (+ ci 1))))
                 (let ((end (read-num s j)))
                   (let ((val (num-val s j end)))
                     (let ((top (car stack)))
                       (loop end (cons (trunc-div top val) (cdr stack)) op))))))
              (else
               (let ((end (read-num s ci)))
                 (let ((val (num-val s ci end)))
                   (let ((new-stack (if (char=? op #\+)
                                       (cons val stack)
                                       (cons (- val) stack))))
                     (loop end new-stack #\+))))))))))

(define (display-int n) (display n))

(define (run-case i s)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve s))
  (newline))

(run-case 0 "3+2*2")
(run-case 1 " 3/2 ")
(run-case 2 " 3+5 / 2 ")
(run-case 3 "0")
(run-case 4 "1-1-1")
(run-case 5 "14/3*2")
(run-case 6 "1000000/6/2")
(run-case 7 "1*2*3*4*5")
(run-case 8 " 6/4 ")
(run-case 9 "10-6/2+3*2")
