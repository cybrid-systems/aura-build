(define (split-spaces s)
  (let ((len (string-length s)))
    (let loop ((i 0) (start 0) (acc '()))
      (cond ((= i len)
             (if (> i start)
                 (append acc (list (substring s start i)))
                 acc))
            ((char=? (string-ref s i) #\space)
             (if (> i start)
                 (loop (+ i 1) (+ i 1) (append acc (list (substring s start i))))
                 (loop (+ i 1) (+ i 1) acc)))
            (else (loop (+ i 1) start acc))))))

(define (parse-int s)
  (let ((len (string-length s)))
    (let loop ((i 0) (n 0))
      (if (= i len) n
          (loop (+ i 1)
                (+ (* n 10) (- (char->integer (string-ref s i)) 48)))))))

(define (tdiv a b)
  (let ((q (quotient a b)) (r (modulo a b)))
    (if (or (and (< r 0) (> b 0)) (and (> r 0) (< b 0)))
        (- q 1)
        q)))

(define (solve s)
  (let ((toks (split-spaces s)))
    (let ((n (length toks)))
      (let ((first (parse-int (list-ref toks 0))))
        (let loop ((i 1) (stack (list first)) (op #\+))
          (cond ((>= i n)
                 (let sumloop ((st stack) (acc 0))
                   (if (null? st) acc
                       (sumloop (cdr st) (+ acc (car st))))))
                (else
                 (let ((cur (parse-int (list-ref toks i))))
                   (cond ((char=? op #\+)
                          (loop (+ i 1) (cons cur stack) #\+))
                         ((char=? op #\-)
                          (loop (+ i 1) (cons (- cur) stack) #\+))
                         ((char=? op #\*)
                          (loop (+ i 1)
                                (cons (* (car stack) cur) (cdr stack))
                                #\+))
                         ((char=? op #\/)
                          (loop (+ i 1)
                                (cons (tdiv (car stack) cur) (cdr stack))
                                #\+))
                         (else
                          (let ((next-op (string-ref (list-ref toks i) 0)))
                            (loop (+ i 1) stack next-op))))))))))))
