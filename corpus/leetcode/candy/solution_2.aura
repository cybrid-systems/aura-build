(define (solve ratings)
  (let ((n (length ratings)))
    (cond
      ((= n 0) 0)
      ((= n 1) 1)
      (else
       (let ((left (make-list n 1))
             (right (make-list n 1)))
         (begin
           (fill-left! left ratings 1)
           (fill-right! right ratings (- n 2))
           (sum-candies left right 0 (- n 1))))))))

(define (make-list n v)
  (if (= n 0)
      '()
      (cons v (make-list (- n 1) v))))

(define (list-ref lst i)
  (cond
    ((= i 0) (car lst))
    (else (list-ref (cdr lst) (- i 1)))))

(define (list-set! lst i v)
  (if (= i 0)
      (set-car! lst v)
      (list-set! (cdr lst) (- i 1) v)))

(define (length lst)
  (if (null? lst)
      0
      (+ 1 (length (cdr lst)))))

(define (fill-left! left ratings i)
  (if (>= i (length left))
      '()
      (begin
        (when (> i 0)
          (let ((cur (list-ref ratings i))
                (prev (list-ref ratings (- i 1))))
            (when (> cur prev)
              (list-set! left i (+ (list-ref left (- i 1)) 1)))))
        (fill-left! left ratings (+ i 1)))))

(define (fill-right! right ratings i)
  (if (< i 0)
      '()
      (begin
        (when (< i (- (length right) 1))
          (let ((cur (list-ref ratings i))
                (nxt (list-ref ratings (+ i 1))))
            (when (> cur nxt)
              (list-set! right i (+ (list-ref right (+ i 1)) 1)))))
        (fill-right! right ratings (- i 1)))))

(define (sum-candies left right i n)
  (if (< i 0)
      n
      (sum-candies left right (- i 1) (+ n (max (list-ref left i) (list-ref right i))))))

(define (max a b)
  (if (> a b) a b))

;; Driver
(define cases (list
  (list 1 0 2)
  (list 1 2 2 4 3)
  (list 4 3 2 1)
  (list)
  (list 5)
  (list 1 2 3 4 5)
  (list 5 4 3 2 1)
  (list 1 3 4 5 2)))

(define (run-cases cases i)
  (if (null? cases)
      'done
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display (solve (car cases)))
        (newline)
        (run-cases (cdr cases) (+ i 1)))))

(run-cases cases 0)
