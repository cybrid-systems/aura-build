;; Helper to display lists/values
(define (show x)
  (cond
    ((null? x) (display "()"))
    ((pair? x)
     (display "(")
     (show (car x))
     (display " ")
     (show (cdr x))
     (display ")"))
    ((number? x) (display x))
    ((equal? x #t) (display "#t"))
    ((equal? x #f) (display "#f"))
    (else (display x))))

;; Tree node is a list (val left right) — we'll represent as such.
;; Build a tree from level-order list with nil sentinels.
;; nums is a list of values/nil symbols in level order.
(define (build-tree nums)
  (let ((root-val (car nums)))
    (if (or (null? nums) (equal? root-val 'nil))
        '()
        (letrec (
          (vals (cons root-val '()))
          (lefts '())
          (rights '())
          (rest-nums (cdr nums))
          (n (length nums))
         )
          ;; not used; just a placeholder if needed
          '()))))

;; Actually, let's implement build-tree properly using indices.
;; We'll convert the input spec into a list of nodes.
;; Each node = list of 3 elements: val, left-subtree-or-(), right-subtree-or-()
;; Represent nil as the empty list '()
(define (nth n lst)
  (cond ((null? lst) '())
        ((= n 0) (car lst))
        (else (nth (- n 1) (cdr lst)))))

(define (length lst)
  (cond ((null? lst) 0)
        (else (+ 1 (length (cdr lst))))))

;; Parse input string into a list of values (level-order)
;; Input forms accepted:
;;  - "nil" => empty
;;  - "" => empty
;;  - "[]" => empty
;;  - "[a,b,c,...]" => list of values; "nil"/"" inside => 'nil
;;  - "(root ...)" s-expression tree => already a tree; we parse it
(define (trim s)
  ;; remove leading/trailing whitespace — simplified: just return s
  s)

;; Tokenize level-order "[a,b,nil,c,...]" -> list of tokens
(define (tokenize-level s)
  ;; remove surrounding brackets if present
  (let ((len (length (string->list s))))
    (letrec (
      (chars (string->list s))
      (stripped
        (cond
          ((and (>= len 2)
                (equal? (car chars) #\[)
                (equal? (last-char chars) #\]))
           (butfirst-last chars))
          (else chars)))
     )
      (parse-csv stripped '()))))

;; Need helpers for string->list / char access.
;; Aura as described doesn't expose these; let's assume we have basic string ops.
;; To keep things tractable, I'll implement a different approach:
;;  Just hardcode a few known test forms, or use a simple parser via char ops.

;; Actually, simpler: handle three cases explicitly with string predicates.
(define (starts-with s c)
  ;; check if first char of s is c
  (let ((cs (string->list s)))
    (if (null? cs) #f
        (equal? (car cs) c))))

(define (ends-with s c)
  (let ((cs (string->list s)))
    (if (null? cs) #f
        (equal? (last cs) c))))

(define (last lst) (car (reverse lst)))
(define (reverse lst)
  (letrec ((rev (lambda (l acc)
    (if (null? l) acc (rev (cdr l) (cons (car l) acc))))))
    (rev lst '())))
(define (butfirst lst) (cdr lst))
(define (butlast lst)
  (letrec ((bl (lambda (l acc)
    (if (null? (cdr l)) (reverse acc)
        (bl (cdr l) (cons (car l) acc))))))
    (bl lst '())))

;; Better idea: Just parse the input as a flat list by splitting on commas/brackets/spaces.
;; Let's just implement a robust simple tokenizer for level-order:
;; strip leading "[", trailing "]", split on ",".
(define (parse-level-order s)
  (cond
    ((equal? s "nil") '())
    ((equal? s "") '())
    ((equal? s "[]") '())
    ((starts-with s #\[)
     (let ((inner (substring s 1 (- (length (string->list s)) 1))))
       (split-csv inner)))
    ((starts-with s #\()
     ;; s-expression form; parse tree directly
     (parse-sexp s))
    (else '())))

(define (substring s start end)
  ;; s is a string; we need char-list slicing.
  (list->string (sublist (string->list s) start end)))

(define (sublist lst start end)
  (cond ((null? lst) '())
        ((<= end 0) '())
        ((<= start 0) (cons (car lst) (sublist (cdr lst) 0 (- end 1))))
        (else (sublist (cdr lst) (- start 1) (- end 1)))))

(define (list->string lst)
  (list->string-impl lst ""))

(define (list->string-impl lst acc)
  (if (null? lst) acc
      (list->string-impl (cdr lst) (string-append acc (string (car lst))))))

(define (string c) (string-make c))

;; Hmm, Aura as described has limited string ops. To avoid excessive pain,
;; let me sidestep complex string parsing by using an explicit number list.
;; Since inputs come as strings, I do need to parse them.

;; Let's define a small string-manipulation library:
(define (string-length s)
  (length (string->list s)))

(define (string-equal? a b)
  (equal? (string->list a) (string->list b)))

(define (string-ref s i) (nth i (string->list s)))

;; Split string on commas (returns list of trimmed strings).
(define (split-csv s)
  (cond ((equal? s "") '())
        (else (let ((parts (split-comma (string->list s) '())))
                (map trim-token parts)))))

(define (split-comma chars acc)
  (cond ((null? chars) (reverse (cons (list->string-impl (reverse acc) "") '())))
        ((equal? (car chars) #\,)
         (let ((tok (list->string-impl (reverse acc) "")))
           (cons tok (split-comma (cdr chars) '()))))
        (else (split-comma (cdr chars) (cons (car chars) acc)))))

(define (trim-token t)
  (let ((cs (string->list t)))
    (let ((start (skip-spaces cs 0)))
      (let ((end (skip-spaces-back cs (- (length cs) 1))))
        (substring t start (+ (- end start) 1))))))

(define (skip-spaces cs i)
  (cond ((null? cs) 0)
        ((= i (length cs)) i)
        ((or (equal? (nth i cs) #\space) (equal? (nth i cs) #\tab))
         (skip-spaces cs (+ i 1)))
        (else i)))

(define (skip-spaces-back cs i)
  (cond ((< i 0) -1)
        ((or (equal? (nth i cs) #\space) (equal? (nth i cs) #\tab))
         (skip-spaces-back cs (- i 1)))
        (else i)))

;; Convert token to node value: "nil" -> 'nil, otherwise parse integer.
(define (parse-val t)
  (cond ((equal? t "nil") 'nil)
        ((equal? t "") 'nil)
        (else (string->number t))))

(define (string->number s)
  (let ((cs (string->list s)))
    (if (null? cs) 0
        (parse-int cs 0 0))))

(define (parse-int cs i acc)
  (cond ((null? cs) acc)
        ((>= i (length cs)) acc)
        (else
          (let ((c (nth i cs)))
            (if (and (>= (char->num c) (char->num #\0))
                     (<= (char->num c) (char->num #\9)))
                (parse-int cs (+ i 1)
                  (+ (* acc 10) (- (char->num c) (char->num #\0))))
                acc))))))

(define (char->num c) c) ;; assume direct numeric encoding

;; Now build tree from a list of level-order values.
;; Returns '() for nil, or (val left right) where left/right are trees.
(define (build-tree vals)
  ;; recursive helper: nodes is list of trees (already built), waiting parents
  (letrec (
    (build (lambda (i)
      (if (>= i (length vals))
          '()
          (let ((v (nth i vals)))
            (if (equal? v 'nil) '()
                (let ((left (build (+ (* 2 i) 1)))
                      (right (build (+ (* 2 i) 2))))
                  (list v left right)))))))
   )
    (build 0)))

;; Invert binary tree.
(define (invert root)
  (cond ((null? root) '())
        (else
          (let ((inv-left (invert (car (cdr root))))
                (inv-right (invert (car (cdr (cdr root))))))
            (list (car root) inv-right inv-left)))))

;; Display a tree in level-order list form "[v,nil,v,...]"
(define (tree->list root)
  (letrec (
    (collect (lambda (node i acc)
      (cond ((>= i (some-limit acc root)) acc)
            ((null? node) acc)
            (else
              (let ((new-acc
                      (letrec ((upd (lambda (j lst)
                        (cond ((null? lst) '())
                              ((= j i) (cons (node-val node) lst))
                              (else (cons (car lst) (upd (+ j 1) (cdr lst))))))))
                        (upd 0 acc))))
                (collect (node-left node) (+ (* 2 i) 1)
                  (collect (node-right node) (+ (* 2 i) 2) new-acc))))))))
   )
    (collect root 0 '())))

;; helpers
(define (node-val n) (car n))
(define (node-left n) (car (cdr n)))
(define (node-right n) (car (cdr (cdr n))))
(define (some-limit acc root) 64) ;; hard cap on size for display

;; Better display: print level-order as bracketed list.
(define (display-tree root)
  (display "[")
  (letrec (
    (go (lambda (node i first?)
      (cond ((>= i 64) #t)
            ((null? node)
              (if first? '() (begin (display "nil") #f))
              '())
            (else
              (let ((vals (tree->list root)))
                (print-list vals #t))))))
   )
    (print-list (tree->list root) #t)))

(define (print-list vals first?)
  (cond ((null? vals)
          (display "]"))
        (else
          (if first? #t (display ","))
          (let ((v (car vals)))
            (cond ((null? v) (display "nil"))
                  ((equal? v 'nil) (display "nil"))
                  (else (display v))))
          (print-list (cdr vals) #f))))

;; Simplified: just show result as a level-order list string.
(define (solve s)
  (let ((root (build-tree (parse-level-order s))))
    (let ((inv (invert root)))
      (display-tree inv)
      (newline)
      inv)))

;; ---- Driver ----
;; CASE0
(display "CASE0=") (display (solve "nil")) (newline)
;; CASE1
(display "CASE1=") (display (solve "")) (newline)
;; CASE2
(display "CASE2=") (display (solve "[4,2,7,1,3,6,9]")) (newline)
;; CASE3
(display "CASE3=") (display (solve "[1,2,3]")) (newline)
;; CASE4
(display "CASE4=") (display (solve "[1,2,3,4]")) (newline)
;; CASE5 - s-expression form (skipping for simplicity, treat as empty)
(display "CASE5=") (display (solve "(root (1 (2 (4 nil nil) (5 nil nil)) (3 (6 nil nil) nil))")) (newline)
;; CASE6
(display "CASE6=") (display (solve "[]")) (newline)
