(define (make-vec n)
  (let loop ((i 0) (acc '()))
    (if (= i n) acc (loop (+ i 1) (cons 0 acc)))))

(define (vec-set v i val)
  (let loop ((l v) (idx 0))
    (cond ((null? l) '())
          ((= idx i) (cons val (cdr l)))
          (else (cons (car l) (loop (cdr l) (+ idx 1)))))))

(define (vec-get v i)
  (let loop ((l v) (idx 0))
    (if (= idx i) (car l) (loop (cdr l) (+ idx 1)))))

(define (char->idx c)
  (- (char->integer c) (char->integer #\a)))

(define (solve s k)
  (let* ((n (string-length s))
         (result 0))
    (let loop-h ((h 1))
      (if (> h 26)
          result
          (let* ((freq (make-vec 26))
                 (distinct 0)
                 (satisfied 0)
                 (best 0))
            (let ((left 0))
              (let loop-r ((right 0))
                (if (= right n)
                    (begin
                      (set! result (max result best))
                      (loop-h (+ h 1)))
                    (let* ((r-idx (char->idx (string-ref s right)))
                           (r-prev (vec-get freq r-idx))
                           (r-val (+ r-prev 1)))
                      (set! freq (vec-set freq r-idx r-val))
                      (cond ((= r-prev 0) (set! distinct (+ distinct 1))
                            ((= r-prev (- k 1)) (set! satisfied (+ satisfied 1)))
                            (else '()))
                      (cond ((> distinct h)
                             (let loop-shrink ()
                               (let* ((l-idx (char->idx (string-ref s left)))
                                      (l-val (vec-get freq l-idx)))
                                 (cond ((= l-val 1)
                                        (set! freq (vec-set freq l-idx 0))
                                        (set! distinct (- distinct 1))
                                        (set! left (+ left 1)))
                                       (else
                                        (set! freq (vec-set freq l-idx (- l-val 1)))
                                        (cond ((= l-val k) (set! satisfied (- satisfied 1))))
                                        (set! left (+ left 1))))
                                 (if (> distinct h) (loop-shrink)))))
                            (else '()))
                      (cond ((= distinct h) (set! best (max best (- right left 1)))))
                      (loop-r (+ right 1))))))))))))

(define (max a b) (if (> a b) a b))

(define (display-list-result lst)
  (cond ((null? lst) (display "()"))
        (else (display "(")
              (let loop ((l lst))
                (cond ((null? l) (display ")"))
                      (else (display (car l))
                            (if (null? (cdr l)) '() (display " "))
                            (loop (cdr l))))))))

(display "CASE0=") (display (solve "aaabb" 3)) (newline)
(display "CASE1=") (display (solve "ababbc" 2)) (newline)
(display "CASE2=") (display (solve "aabbcc" 1)) (newline)
(display "CASE3=") (display (solve "abcdef" 2)) (newline)
(display "CASE4=") (display (solve "a" 1)) (newline)
(display "CASE5=") (display (solve "a" 2)) (newline)
(display "CASE6=") (display (solve "aaabbb" 3)) (newline)
(display "CASE7=") (display (solve "ababacb" 3)) (newline)
(display "CASE8=") (display (solve "bbaa" 3)) (newline)
(display "CASE9=") (display (solve "weitong" 2)) (newline)
