(require "lc_json" all:)
(require "compat" all:)
(define (solve grid)
  ;; grid is a list of rows; each row is a list of numbers (0 or 1)
  ;; We need to update each row in place; since Aura uses immutable lists,
  ;; we'll produce new rows but reassign via set! on the grid's row pointers.
  ;; For simplicity, treat grid as a list of row-lists, and mutate row lists
  ;; cell by cell by replacing elements via set-car! ... but we don't have
  ;; set-car! listed. We'll instead build new rows and set! the grid's rows.
  ;; Actually, the spec says "in place" but caller translates markers.
  ;; We'll mutate the structure using set! on grid elements (rows).
  (let ((R (length grid)))
    (let loop-r ((r 0))
      (if (< r R)
          (let ((row (list-ref grid r)))
            (let ((C (length row)))
              (let loop-c ((c 0))
                (if (< c C)
                    (let* ((cur (list-ref row c))
                           (cnt (neighbors grid r c R C))
                           (new
                             (cond
                               ((= cur 1)
                                (if (or (= cnt 2) (= cnt 3)) 1 2))
                               ((= cur 0)
                                (if (= cnt 3) 3 0))
                               (else cur))))
                      (set-car! (list-tail row c) new)
                      (loop-c (+ c 1)))
                    'done))))
            (loop-r (+ r 1)))
          'done)))
(define (list-nth lst n)
  (cond
    ((= n 0) (car lst))
    (else (list-nth (cdr lst) (- n 1)))))
(define (next-cell cur cnt)
  (cond
    ((= cur 1)
     (if (or (= cnt 2) (= cnt 3)) 1 2))
    ((= cur 0)
     (if (= cnt 3) 3 0))
    (else cur)))
(define (process-row grid r c R C)
  (build-row grid r c R C))
(define (build-row grid r c R C)
  (cond
    ((= c C) '())
    (else
      (let* ((cur (list-nth (list-nth grid r) c))
             (cnt (count-nb grid r c R C))
             (nv (next-cell cur cnt)))
        (cons nv (build-row grid r (+ c 1) R C))))))
(define (count-nb grid r c R C)
  (let ((cnt 0)
        (dr -1))
    (let loop-dr ()
      (cond
        ((> dr 1) cnt)
        (else
          (let ((dc -1))
            (let loop-dc ()
              (cond
                ((> dc 1)
                 (set! dr (+ dr 1))
                 (loop-dr))
                (else
                  (let ((nr (+ r dr))
                        (nc (+ c dc)))
                    (cond
                      ((and (= dr 0) (= dc 0))
                       (set! dc (+ dc 1))
                       (loop-dc))
                      ((and (>= nr 0) (< nr R) (>= nc 0) (< nc C))
                       (let ((v (list-nth (list-nth grid nr) nc)))
                         (if (or (= v 1) (= v 2))
                             (set! cnt (+ cnt 1))
                             'noop))
                       (set! dc (+ dc 1))
                       (loop-dc))
                      (else
                        (set! dc (+ dc 1))
                        (loop-dc)))))))))))))
(define (solve grid)
  (let ((R (length grid))
        (C (if (null? grid) 0 (length (car grid)))))
    (rebuild grid 0 R C)))
(define (rebuild grid r R C)
  (cond
    ((= r R) '())
    (else (cons (build-row grid r 0 R C)
                (rebuild grid (+ r 1) R C)))))
(define (display-grid g)
  (let ((R (length g)))
    (let loop-r ((r 0))
      (cond
        ((= r R) 'done)
        (else
          (let ((row (list-nth g r)))
            (let ((C (length row)))
              (let loop-c ((c 0))
                (cond
                  ((= c C)
                   (newline)
                   (loop-r (+ r 1)))
                  (else
                    (cond
                      ((> c 0) (display " "))
                      (else 'noop))
                    (display (list-nth row c))
                    (loop-c (+ c 1))))))))))))
(define cases
  (list
    (list (list (list 1)))
    (list (list (list 0)))
    (list (list (list 0 1 0) (list 0 1 0) (list 0 1 0)))
    (list (list (list 1 1 1) (list 1 1 1) (list 1 1 1)))
    (list (list (list 1 0 1) (list 0 1 0) (list 1 0 1)))
    (list (list (list 1 1 0 0) (list (list 1 0 0 1)) (list (list 0 0 1 1)) (list (list 0 1 1 0))))
    (list (list (list 1 0 1 0 1)))
    (list (list (list 1 1) (list 1 0)))))
(define (run-cases lst i)
  (cond
    ((null? lst) 'done)
    (else
      (let* ((g (car lst))
             (result (solve g)))
        (display "CASE")
        (display i)
        (display "=")
        (newline)
        (display-grid result))
      (run-cases (cdr lst) (+ i 1)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "grid")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/game-of-life/tests.json")))
