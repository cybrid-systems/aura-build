(define (insert-sorted x lst)
  (cond ((null? lst) (list x))
        ((<= x (car lst)) (cons x lst))
        (else (cons (car lst) (insert-sorted x (cdr lst))))))

(define (min-heap-insert heap x)
  (insert-sorted x heap))

(define (min-heap-pop heap)
  (if (null? heap)
      (cons #f '())
      (cons (car heap) (cdr heap))))

(define (min-heap-push-pop heap x)
  (let ((r (min-heap-pop heap)))
    (cons (car r) (min-heap-insert (cdr r) x))))

(define (solve sticks)
  (let loop ((heap '()) (sticks sticks) (total 0))
    (cond ((null? sticks)
           (let iloop ((h heap) (t total))
             (if (< (length h) 2)
                 t
                 (let ((p (min-heap-pop h)))
                   (let ((q (min-heap-pop (cdr p))))
                     (let ((s (+ (car p) (car q))))
                       (iloop (min-heap-insert (cdr q) s) (+ t s))))))))
          (else (loop (min-heap-insert heap (car sticks)) (cdr sticks) total)))))

(define (run-cases)
  (let ((c0 (solve (list 2 4 1 3)))
        (c1 (solve (list 1 8 3 5)))
        (c2 (solve (list 5)))
        (c3 (solve (list)))
        (c4 (solve (list 2 2)))
        (c5 (solve (list 1 2 3 4 5)))
        (c6 (solve (list 10 10 10 10)))
        (c7 (solve (list 1))))
    (display "CASE0=") (display c0) (newline)
    (display "CASE1=") (display c1) (newline)
    (display "CASE2=") (display c2) (newline)
    (display "CASE3=") (display c3) (newline)
    (display "CASE4=") (display c4) (newline)
    (display "CASE5=") (display c5) (newline)
    (display "CASE6=") (display c6) (newline)
    (display "CASE7=") (display c7) (newline)))

(run-cases)
