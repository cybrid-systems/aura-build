(require "lc_json" all:)
(require "compat" all:)
(define (solve ops)
  (letrec ((main-stack '())
           (min-stack '())
           (answers '())
           (process (lambda (op)
                      (let ((op-type (car op)))
                        (cond ((= op-type 1)
                               (let ((x (car (cdr op))))
                                 (set! main-stack (cons x main-stack))
                                 (if (null? min-stack)
                                     (set! min-stack (cons x min-stack))
                                     (let ((cur-min (car min-stack)))
                                       (if (< x cur-min)
                                           (set! min-stack (cons x min-stack))
                                           (set! min-stack (cons cur-min min-stack)))))))
                              ((= op-type 2)
                               (set! main-stack (cdr main-stack))
                               (set! min-stack (cdr min-stack)))
                              ((= op-type 3)
                               (set! answers (cons (car min-stack) answers)))
                              ((= op-type 4)
                               #t)))))
           (loop-ops (lambda (ops-left)
                       (if (null? ops-left)
                           (reverse answers)
                           (begin
                             (process (car ops-left))
                             (loop-ops (cdr ops-left)))))))
    (loop-ops ops)))
(define (display-list lst)
  (display "[")
  (letrec ((loop (lambda (l)
                   (if (null? l)
                       #t
                       (begin
                         (display (car l))
                         (if (not (null? (cdr l)))
                             (display ", "))
                         (loop (cdr l)))))))
    (loop lst))
  (display "]"))
(define (run-case n ops)
  (let ((result (solve ops)))
    (display "CASE")
    (display n)
    (display "=")
    (display-list result)
    (newline)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "ops")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/min-stack/tests.json")))
