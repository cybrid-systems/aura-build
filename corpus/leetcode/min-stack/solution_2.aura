(define (solve ops)
  (letrec ((main-stack '())
           (min-stack '())
           (answers '())
           (process (lambda (op)
                      (let ((op-type (car op)))
                        (cond ((= op-type 1)
                               (let ((x (car (cdr op))))
                                 (set! main-stack (cons x main-stack))
                                 (if (null? min-stack)
                                     (set! min-stack (cons x min-stack))
                                     (let ((cur-min (car min-stack)))
                                       (if (< x cur-min)
                                           (set! min-stack (cons x min-stack))
                                           (set! min-stack (cons cur-min min-stack)))))))
                              ((= op-type 2)
                               (set! main-stack (cdr main-stack))
                               (set! min-stack (cdr min-stack)))
                              ((= op-type 3)
                               (set! answers (cons (car min-stack) answers)))
                              ((= op-type 4)
                               #t)))))
           (loop-ops (lambda (ops-left)
                       (if (null? ops-left)
                           (reverse answers)
                           (begin
                             (process (car ops-left))
                             (loop-ops (cdr ops-left)))))))
    (loop-ops ops)))

(define (display-list lst)
  (display "[")
  (letrec ((loop (lambda (l)
                   (if (null? l)
                       #t
                       (begin
                         (display (car l))
                         (if (not (null? (cdr l)))
                             (display ", "))
                         (loop (cdr l)))))))
    (loop lst))
  (display "]"))

(define (run-case n ops)
  (let ((result (solve ops)))
    (display "CASE")
    (display n)
    (display "=")
    (display-list result)
    (newline)))

(run-case 0 '((1 5) (1 2) (1 8) (3) (2) (2) (1 3) (3) (2) (2)))
(run-case 1 '((1 1) (3) (2)))
(run-case 2 '((1 -5) (1 0) (1 7) (3) (3) (2) (3) (2) (2)))
(run-case 3 '((1 10) (3) (1 5) (3) (2) (3) (2)))
(run-case 4 '((1 3) (1 3) (3) (2) (2)))
(run-case 5 '((1 2) (1 1) (3) (2) (3)))
(run-case 6 '((1 -100) (1 100) (3) (1 -50) (3) (2) (3)))
