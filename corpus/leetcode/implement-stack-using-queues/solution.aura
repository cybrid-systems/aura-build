(define (make-queue)
  (let ((front '()) (back '()) (sz 0))
    (lambda (msg . args)
      (cond
        ((equal? msg 'enqueue)
         (let ((v (car args)))
           (set! front (cons v front))
           (set! sz (+ sz 1))))
        ((equal? msg 'dequeue)
         (let ((v (car back)))
           (set! back (cdr back))
           (set! sz (- sz 1))
           v))
        ((equal? msg 'isEmpty) (= sz 0))
        ((equal? msg 'size) sz)
        ((equal? msg 'peek) (car back))))))

(define (q-empty? q) (q 'isEmpty))
(define (q-enqueue q v) (q 'enqueue v))
(define (q-dequeue q) (q 'dequeue))
(define (q-size q) (q 'size))
(define (q-peek q) (q 'peek))

(define (make-stack)
  (let ((q1 (make-queue)) (q2 (make-queue)))
    (lambda (msg . args)
      (cond
        ((equal? msg 'push)
         (let ((v (car args)))
           (q-enqueue q1 v)
           (q-enqueue q2 v)
           ;; rotate q2 so its front holds the most recent push
           (let ((s (q-size q2)))
             (let loop ((i 0))
               (if (< i (- s 1))
                   (begin
                     (q-enqueue q2 (q-dequeue q2))
                     (loop (+ i 1))))))))
        ((equal? msg 'pop)
         (let ((v (q-dequeue q1)))
           (q-dequeue q2)
           v))
        ((equal? msg 'top)
         (q-peek q2))
        ((equal? msg 'empty)
         (q-empty? q1))))))

(define (stack-push s v) (s 'push v))
(define (stack-pop s) (s 'pop))
(define (stack-top s) (s 'top))
(define (stack-empty s) (s 'empty))

(define (solve operations)
  (let ((stk (make-stack)) (results '()))
    (let loop ((ops operations))
      (cond
        ((null? ops) (reverse results))
        (else
         (let ((op (car ops)))
           (cond
             ((equal? (car op) 'push)
              (stack-push stk (car (cdr op))))
             ((equal? (car op) 'pop)
              (set! results (cons (stack-pop stk) results)))
             ((equal? (car op) 'top)
              (set! results (cons (stack-top stk) results)))
             ((equal? (car op) 'empty)
              (set! results (cons (stack-empty stk) results)))))
         (loop (cdr ops)))))))

(define (display-list xs)
  (display "[")
  (let loop ((first #t) (rest xs))
    (cond
      ((null? rest) (display "]"))
      (else
       (if first (display (car rest)) (begin (display ", ") (display (car rest))))
       (loop #f (cdr rest))))))

(define (run-case i operations)
  (display "CASE")
  (display i)
  (display "=")
  (let ((r (solve operations)))
    (cond
      ((null? r) (display "[]"))
      ((or (equal? (car r) #t) (equal? (car r) #f))
       (display-list r))
      (else
       (display-list r))))
  (newline))

(run-case 0 (list (list 'push 1) (list 'push 2) (list 'top) (list 'pop)))
(run-case 1 '())
(run-case 2 (list (list 'push 1) (list 'pop) (list 'empty)))
(run-case 3 (list (list 'push 1) (list 'push 2) (list 'push 3) (list 'pop) (list 'pop) (list 'pop) (list 'empty)))
(run-case 4 (list (list 'empty)))
(run-case 5 (list (list 'push 42) (list 'top) (list 'top) (list 'pop) (list 'empty) (list 'push 7) (list 'top) (list 'pop)))
(run-case 6 (list (list 'push 5) (list 'push 10) (list 'pop) (list 'push 15) (list 'top) (list 'pop) (list 'pop) (list 'empty)))
