(define (popcount n)
  (if (= n 0)
      0
      (+ (modulo n 2) (popcount (quotient n 2)))))

(define (hamming x y)
  (popcount (logxor x y)))

(define (solve case-num x y)
  (display "CASE")
  (display case-num)
  (display "=")
  (display (hamming x y))
  (newline))

;; Embedded test cases
(solve 0 1 4)
(solve 1 3 1)
(solve 2 0 0)
(solve 3 7 8)
(solve 4 0 4294967295)
(solve 5 4294967295 4294967295)
(solve 6 123456789 987654321)
(solve 7 1 1)
