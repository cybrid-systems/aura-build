; soft_leetcode_runtime slug=hamming-distance path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-2 hits=8/8
; baseline_hits=0/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define popcount
    (lambda (n)
      (if (=
          n 0)
        0
        (+
          (modulo
            n 2) (popcount (quotient
              n 2))))))
  (define hamming
    (lambda (x y)
      (letrec ((loop (lambda (xx yy count)
          (if (and
              (=
                xx 0) (=
                yy 0))
            count
            (loop
              (quotient
                xx 2) (quotient
                yy 2) (+
                count (if (=
                    (modulo
                      xx 2) (modulo
                      yy 2))
                  0
                  1)))))))
        (loop
          x y 0))))
  (define solve
    (lambda (case-num x y)
      (begin
        (display "CASE")
        (display case-num)
        (display "=")
        (display (hamming
            x y))
        (newline))))
  (solve
    0 1 4)
  (solve
    1 3 1)
  (solve
    2 0 0)
  (solve
    3 7 8)
  (solve
    4 0 4294967295)
  (solve
    5 4294967295 4294967295)
  (solve
    6 123456789 987654321)
  (solve
    7 1 1))
