;; Minimum Window Substring in Aura
;; Sliding window approach using character count vectors.

(define (make-vec n)
  (let loop ((i 0) (v '()))
    (if (= i n)
        v
        (loop (+ i 1) (cons 0 v)))))

(define (vec-set v i val)
  (let loop ((idx 0) (rest v) (acc '()))
    (cond
      ((null? rest) (reverse acc))
      ((= idx i) (loop (+ idx 1) (cdr rest) (cons val acc)))
      (else (loop (+ idx 1) (cdr rest) (cons (car rest) acc))))))

(define (vec-ref v i)
  (let loop ((idx 0) (rest v))
    (cond
      ((null? rest) 0)
      ((= idx i) (car rest))
      (else (loop (+ idx 1) (cdr rest))))))

(define (char->idx c)
  (char->integer c))

;; Count characters in t; returns vector indexed by char code (0..127)
(define (count-t t)
  (let loop ((i 0) (v (make-vec 128)))
    (if (= i (string-length t))
        v
        (loop (+ i 1)
              (vec-set v (char->idx (string-ref t i))
                       (+ (vec-ref v (char->idx (string-ref t i))) 1))))))

;; Checks if current counts satisfy requirement: count[c] >= required[c] for all c
(define (window-satisfies? counts required)
  (let loop ((i 0))
    (cond
      ((= i 128) #t)
      ((< (vec-ref counts i) (vec-ref required i))
       #f)
      (else (loop (+ i 1))))))

(define (solve s t)
  (cond
    ((= (string-length t) 0) "")
    ((= (string-length s) 0) "")
    (else
     (let* ((required (count-t t))
            (n (string-length s))
            (counts (make-vec 128))
            (best-len (+ n 1))
            (best-start -1)
            (best-end -1))
       (let loop ((left 0) (right 0))
         (cond
           ((= right n) 'done)
           (else
            ;; Extend right
            (let* ((r-idx (char->idx (string-ref s right)))
                   (new-counts (vec-set counts r-idx
                                        (+ (vec-ref counts r-idx) 1))))
              ;; Contract left while satisfied
              (let shrink ((l left) (cs new-counts))
                (if (and (< l right) (window-satisfies? cs required))
                    (shrink (+ l 1)
                            (vec-set cs (char->idx (string-ref s l))
                                     (- (vec-ref cs (char->idx (string-ref s l))) 1)))
                    (let ((update-l (if (window-satisfies? cs required) l (- l 1))))
                      (let ((new-left (if (window-satisfies? cs required) l left))))
                        ;; Actually simpler: after shrinking, l points to first invalid OR = right
                        ;; Record window if satisfies
                        (let ((cur-l (if (window-satisfies? cs required) left l)))
                          ;; We just shrank; if still satisfies, l didn't move
                          ;; Let's restructure cleanly below
                          'dummy)))))))))))
     ""))) ;; placeholder - flow wrong

;; Redo solve properly with cleaner bookkeeping
(define (count-string t)
  (let loop ((i 0) (v (make-vec 128)))
    (if (= i (string-length t))
        v
        (loop (+ i 1)
              (vec-set v (char->idx (string-ref t i))
                       (+ (vec-ref v (char->idx (string-ref t i))) 1))))))

(define (all-satisfied counts required)
  (let loop ((i 0))
    (cond
      ((= i 128) #t)
      ((< (vec-ref counts i) (vec-ref required i)) #f)
      (else (loop (+ i 1))))))

(define (take-substring s start end)
  (let loop ((i 0) (acc ""))
    (if (>= i (- end start))
        acc
        (loop (+ i 1)
              (string-append acc
                             (string (string-ref s (+ start i))))))))

;; String of single char - using make-string
(define (mkstr c) (string c))

(define (solve2 s t)
  (cond
    ((= (string-length t) 0) "")
    ((= (string-length s) 0) "")
    (else
     (let* ((required (count-string t))
            (n (string-length s))
            (counts (make-vec 128))
            (best-len (+ n 1))
            (best-start 0))
       (let outer ((right 0))
         (if (= right n)
             (if (= best-len (+ n 1)) "" (take-substring s best-start (+ best-start best-len)))
             (let* ((ci (char->idx (string-ref s right)))
                    (new-counts (vec-set counts ci
                                         (+ (vec-ref counts ci) 1))))
               (let inner ((left 0) (cs new-counts))
                 (cond
                   ((< left right)
                    (let* ((li (char->idx (string-ref s left)))
                           (nc (vec-set cs li (- (vec-ref cs li) 1))))
                      (if (all-satisfied nc required)
                          (begin
                            ;; record and continue shrinking? No - we want smallest
                            ;; Actually: while shrinking is impossible (still satisfies),
                            ;; we want to shrink; record when we have satisfies
                            (let ((nl left))
                              ;; after removing left, still satisfies; try to shrink further
                              (let ((nnl (+ nl 1)))
                                (inner nnl nc))))))
                   (else 'done))))))))))

