              (counts (make-vec 128))
              (have 0)
              (need 0))
         ;; Count distinct needed chars
         (set! need
               (let loop ((i 0) (cnt 0))
                 (if (= i 128) cnt
                     (loop (+ i 1)
                           (if (> (vec-ref required i) 0) (+ cnt 1) cnt)))))
         (let ((best-len (make-vec 1)))
           (vec-set! best-len 0 (+ ns 1))
           (let ((best-start 0) (start 0) (have 0))
             (let outer ((right 0))
               (cond
                 ((= right ns)
                  (let ((bl (vec-ref best-len 0)))
                    (if (= bl (+ ns 1)) ""
                        (take-substring s best-start (+ best-start bl)))))
