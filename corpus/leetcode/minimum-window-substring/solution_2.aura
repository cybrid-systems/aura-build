;; Let me give up on the fancy approach and just use a simple correctness-first
;; O(n * |alphabet| * n) sliding window which is fine for these test sizes.

(define (solve s t)
  (let ((ns (string-length s))
        (nt (string-length t)))
    (cond
      ((= nt 0) "")
      ((< ns nt) "")
      (else
       (let* ((req (count-string t))
              (best-len (+ ns 1))
              (best-start 0))
         (let loop-left ((left 0))
           (if (>= left ns) 
               (if (= best-len (+ ns 1)) "" 
                   (take-substring s best-start (+ best-start best-len)))
               (let ((right-len-found (+ ns 1)))
                 (let loop-right ((right left) (cnt (make-vec 128)) (have 0))
                   (cond
                     ((= right ns) 'done)
                     ((and (< right-len-found best-len))
                      ;; try extending and checking
                      (let* ((ci (char->idx (string-ref s right)))
                             (cv (+ (vec-ref cnt ci) 1)))
                        (vec-set! cnt ci cv)
                        (let ((nh (if (= cv (vec-ref req ci))
                                      (+ have 1) have)))
                          (if (>= nh need)
                              (begin
                                (let ((len (+ (- right left) 1)))
                                  (if (< len best-len)
                                      (begin
                                        (set! best-len len)
                                        (set! best-start left))))
                                'break-inner)
                              (loop-right (+ right 1) cnt nh))))))
                     (else 'break-inner))
                   ;; outer continues
                   )
                 (loop-left (+ left 1))))))))))

