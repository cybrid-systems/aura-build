(define (cons-cell val next)
  (cons val next))

(define (node-val n) (car n))
(define (node-next n) (cdr n))
(define (null-node? n) (null? n))

(define (make-list values)
  (define (helper vals)
    (if (null? vals)
        '()
        (cons-cell (car vals) (helper (cdr vals)))))
  (helper values))

(define (solve head)
  (if (null-node? head)
      '()
      (let ((slow head)
            (fast head))
        (define (loop)
          (cond
            ((null-node? (node-next fast)) slow)
            ((null-node? (node-next (node-next fast))) (node-next slow))
            (else
             (set! slow (node-next slow))
             (set! fast (node-next (node-next fast)))
             (loop))))
        (loop))))

(define (display-list lst)
  (display "(")
  (define (loop l)
    (cond ((null? l) (display ")"))
          (else
           (display (car l))
           (if (not (null? (cdr l))) (display " "))
           (loop (cdr l)))))
  (loop lst))

(define (run-case idx values)
  (define head (make-list values))
  (define result (solve head))
  (display "CASE")
  (display idx)
  (display "=")
  (if (null? result)
      (display "")
      (display (node-val result)))
  (newline))

(run-case 0 '())
(run-case 1 (list 1))
(run-case 2 (list 1 2))
(run-case 3 (list 1 2 3))
(run-case 4 (list 1 2 3 4))
(run-case 5 (list 1 2 3 4 5))
(run-case 6 (list 10 20 30 40 50 60 70 80))
(run-case 7 (list -1 0 1 2 3))
