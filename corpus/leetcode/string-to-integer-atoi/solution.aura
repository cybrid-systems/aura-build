;; String to Integer (atoi) implementation in Aura
;; Reads embedded test cases, calls solve, prints CASEi=result

(define (digit? c)
  (and (string? c) (= (string-length c) 1)
       (char>=? c #\0) (char<=? c #\9)))

(define (char->digit c)
  (- (char->integer c) (char->integer #\0)))

(define (myAtoi s)
  (let* ((len (string-length s))
         (i 0)
         (result 0)
         (sign 1))
    ;; Skip leading whitespace
    (set! i 0)
    (define (skip-ws i)
      (if (and (< i len) (char=? (string-ref s i) #\space))
          (skip-ws (+ i 1))
          i))
    (set! i (skip-ws i))
    ;; Check sign
    (cond
      ((>= i len) (set! result 0))
      ((char=? (string-ref s i) #\-)
       (set! sign -1)
       (set! i (+ i 1)))
      ((char=? (string-ref s i) #\+)
       (set! i (+ i 1))))
    ;; Read digits
    (define (read-digits i result)
      (if (>= i len)
          result
          (let ((c (string-ref s i)))
            (if (digit? c)
                (read-digits (+ i 1)
                             (+ (* result 10) (* sign (char->digit c))))
                result))))
    (set! result (read-digits i result))
    ;; Clamp to 32-bit signed integer range
    (if (< result -2147483648)
        (set! result -2147483648))
    (if (> result 2147483647)
        (set! result 2147483647))
    result))

(define (solve s)
  (myAtoi s))

;; Helper: char comparison for single chars
(define (char=? a b)
  (= (char->integer a) (char->integer b)))

(define (char>=? a b)
  (>= (char->integer a) (char->integer b)))

(define (char<=? a b)
  (<= (char->integer a) (char->integer b)))

(define (char->integer c)
  (char->int c))

(define (string-ref s i)
  (str-ref s i))

(define (string-length s)
  (str-len s))

;; Built-in helpers (assumed available in the runtime)
;; char->int, str-ref, str-len, char=?, char>=?, char<=? provided above as wrappers

;; Test cases
(display "CASE0=") (display (solve "42")) (newline)
(display "CASE1=") (display (solve "   -042")) (newline)
(display "CASE2=") (display (solve "1337c0d3")) (newline)
(display "CASE3=") (display (solve "0-1")) (newline)
(display "CASE4=") (display (solve "words and 987")) (newline)
(display "CASE5=") (display (solve "-91283472332")) (newline)
(display "CASE6=") (display (solve "+1")) (newline)
(display "CASE7=") (display (solve "   +0 123")) (newline)
(display "CASE8=") (display (solve "2147483648")) (newline)
(display "CASE9=") (display (solve "-2147483649")) (newline)
(display "CASE10=") (display (solve "")) (newline)
(display "CASE11=") (display (solve " ")) (newline)
(display "CASE12=") (display (solve "+")) (newline)
(display "CASE13=") (display (solve "-")) (newline)
(display "CASE14=") (display (solve "+-12")) (newline)
(display "CASE15=") (display (solve "  +  123")) (newline)
(display "CASE16=") (display (solve "00000-42a1234")) (newline)
(display "CASE17=") (display (solve "  -000000000000001")) (newline)
