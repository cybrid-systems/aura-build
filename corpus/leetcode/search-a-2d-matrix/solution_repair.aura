;; Fix: the prior code created (cons rows cols) and tried (cadr matrix) which
;; doesn't exist on a pair. Use a flat list-of-lists representation where the
;; matrix IS the list of rows, and compute cols from (length (car matrix)).
;; We also pass columns as an explicit parameter through solve.

(define (list-length xs)
  (let loop ((xs xs) (n 0))
    (if (null? xs) n (loop (cdr xs) (+ n 1)))))

(define (matrix-ref mat i cols)
  (let* ((r (quotient i cols))
         (c (modulo i cols)))
    (list-ref (list-ref mat r) c)))

(define (search-helper mat cols target lo hi)
  (if (>= lo hi)
      #f
      (let* ((mid (quotient (+ lo hi) 2))
             (val (matrix-ref mat mid cols)))
        (cond ((= val target) #t)
              ((< val target) (search-helper mat cols target (+ mid 1) hi))
              (else (search-helper mat cols target lo mid))))))

(define (rows-empty? mat)
  (or (null? mat)
      (null? (car mat))
      (= (list-length (car mat)) 0)))

(define (solve target matrix)
  (if (or (null? matrix) (null? (car matrix)))
      #f
      (let* ((cols (list-length (car matrix)))
             (rows (list-length matrix))
             (len (* rows cols)))
        (if (= len 0)
            #f
            (search-helper matrix cols target 0 len)))))

(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display result)
  (newline))

(define mat0 (list (list 1 3 5 7) (list 10 11 16 20) (list 23 30 34 60)))
(define mat1 (list (list 7)))
(define mat2 (list (list 1 2 3)))
(define mat3 (list (list 1) (list 3) (list 5)))
(define mat4 (list (list)))
(define mat5 (list))

(display-case 0 (solve 5 mat0))
(display-case 1 (solve 13 mat0))
(display-case 2 (solve 1 mat0))
(display-case 3 (solve 60 mat0))
(display-case 4 (solve 0 mat0))
(display-case 5 (solve 7 mat1))
(display-case 6 (solve 2 mat2))
(display-case 7 (solve 3 mat3))
(display-case 8 (solve 4 mat3))
(display-case 9 (solve 1 mat4))
(display-case 10 (solve 1 mat5))
