(require "compat" all:)

(define (matrix-rows mat) (car mat))
(define (matrix-cols mat) (cdr mat))

(define (matrix-ref mat i)
  (let* ((rows (matrix-rows mat))
         (cols (matrix-cols mat))
         (r (quotient i cols))
         (c (modulo i cols)))
    (list-ref (list-ref rows r) c)))

(define (matrix-len mat)
  (* (matrix-rows mat) (matrix-cols mat)))

(define (search-helper mat target lo hi)
  (if (>= lo hi)
      #f
      (let* ((mid (quotient (+ lo hi) 2))
             (val (matrix-ref mat mid)))
        (cond ((= val target) #t)
              ((< val target) (search-helper mat target (+ mid 1) hi))
              (else (search-helper mat target lo mid))))))

(define (solve target matrix)
  (let ((rows (car matrix))
        (cols (cdr matrix)))
    (if (or (= rows 0) (= cols 0))
        #f
        (search-helper matrix target 0 (* rows cols)))))

(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display result)
  (newline))

(define mat0 (cons 3 (cons 4 '())))
(define mat1 (cons 1 (cons 1 '())))
(define mat2 (cons 1 (cons 3 '())))
(define mat3 (cons 3 (cons 1 '())))
(define mat4 (cons 1 (cons 0 '())))
(define mat5 (cons 0 (cons 0 '())))

(set-car! mat0 (list (list 1 3 5 7) (list 10 11 16 20) (list 23 30 34 60)))
(set-car! mat1 (list (list 7)))
(set-car! mat2 (list (list 1 2 3)))
(set-car! mat3 (list (list 1) (list 3) (list 5)))
(set-car! mat4 (list (list)))
(set-car! mat5 (list))

(display-case 0 (solve 5 mat0))
(display-case 1 (solve 13 mat0))
(display-case 2 (solve 1 mat0))
(display-case 3 (solve 60 mat0))
(display-case 4 (solve 0 mat0))
(display-case 5 (solve 7 mat1))
(display-case 6 (solve 2 mat2))
(display-case 7 (solve 3 mat3))
(display-case 8 (solve 4 mat3))
(display-case 9 (solve 1 mat4))
(display-case 10 (solve 1 mat5))
