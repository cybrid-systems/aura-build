(define (list-length lst)
  (if (null? lst) 0 (+ 1 (list-length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (make-adj n)
  (let ((v (make-vector n '())))
    (define (set-adj! i val) (vector-set! v i val))
    (define (get-adj i) (vector-ref v i))
    (define (vec v) v)
    (lambda (m)
      (cond ((eq? m 'get) get-adj)
            ((eq? m 'set) set-adj!)
            ((eq? m 'vec) (lambda () v))
            (else '())))))

(define (vec-make n fill)
  (let ((v (make-vector n fill)))
    (define (ref i) (vector-ref v i))
    (define (set i val) (vector-set! v i val))
    (define (the-v v) v)
    (lambda (m)
      (cond ((eq? m 'ref) ref)
            ((eq? m 'set) set)
            ((eq? m 'vec) (lambda () v))
            (else '())))))

(define (solve n prereqs)
  (cond ((= n 0) '())
        (else
         (let ((adj (vec-make n '())))
           (let ((in-deg (vec-make n 0)))
             (let ((m (list-length prereqs)))
               (let loop ((k 0))
                 (if (>= k m) 'done
                     (let ((pair (list-ref prereqs k)))
                       (let ((a (list-ref pair 0)) (b (list-ref pair 1)))
                         (let ((cur (vector-ref (in-deg 'vec) b)))
                           (begin
                             (vector-set! (in-deg 'vec) b (+ cur 1))
                             (let ((cur-adj (vector-ref (adj 'vec) a)))
                               (begin
                                 (vector-set! (adj 'vec) a (append cur-adj (list b)))
                                 (loop (+ k 1))))))))))))
             (let ((queue '()))
             (let qinit ((i 0))
               (if (>= i n) 'done
                   (begin
                     (if (= (vector-ref (in-deg 'vec) i) 0)
                         (set! queue (append queue (list i)))
                         'skip)
                     (qinit (+ i 1)))))
             (let ((result '()))
             (let process ()
               (if (null? queue) 'done
                   (begin
                     (let ((u (car queue)))
                       (set! queue (cdr queue))
                       (set! result (append result (list u)))
                       (let ((neighbors (vector-ref (adj 'vec) u)))
                         (let nloop ((ns neighbors))
                           (if (null? ns) 'done
                               (begin
                                 (let ((v (car ns)))
                                   (let ((d (vector-ref (in-deg 'vec) v)))
                                     (begin
                                       (vector-set! (in-deg 'vec) v (- d 1))
                                       (if (= (- d 1) 0)
                                           (set! queue (append queue (list v)))
                                           'skip)))
                                     (nloop (cdr ns)))))))))))
             (if (= (list-length result) n) result '())))))))

(define (display-list lst)
  (display "[")
  (let loop ((l lst) (first #t))
    (cond ((null? l) (display "]"))
          (else
           (if first (set! first #f) (display ","))
           (display (car l))
           (loop (cdr l) #f)))))

(define (display-result r)
  (cond ((null? r) (display "[]"))
        ((list? r) (display-list r))
        (else (display r))))

(define cases
  (list
    (list 4 '((1 0) (2 0) (3 1) (3 2)))
    (list 3 '((1 0) (2 1)))
    (list 3 '())
    (list 3 '((0 1) (1 2) (2 0)))
    (list 2 '((0 0)))
    (list 0 '())
    (list 1 '())
    (list 6 '((1 0) (2 0) (3 1) (4 1) (5 2) (5 3)))
    (list 4 '((1 0) (2 0) (3 1) (3 2)))
    (list 5 '((1 0) (2 0) (3 0) (4 0)))))

(let loop-cases ((cs cases) (i 0))
  (cond ((null? cs) 'done)
        (else
         (let ((c (car cs)))
           (let ((n (list-ref c 0)) (p (list-ref c 1)))
             (let ((r (solve n p)))
               (begin
                 (display (string-append "CASE" (number->string i)))
                 (display "=")
                 (display-result r)
                 (newline)
                 (loop-cases (cdr cs) (+ i 1)))))))))
