    (cons "dequeue" '())
    (cons "dequeue" '())
    (cons "dequeue" '())
    (cons "dequeue" '())
    (cons "dequeue" '())
    (cons "is_empty" '())
    (cons "front" '())
    (cons "rear" '())))
