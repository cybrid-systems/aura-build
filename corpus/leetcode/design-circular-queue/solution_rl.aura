(require "lc_json" all:)
(require "compat" all:)
(define (solve capacity commands)
  ;; commands is a list of (op . arg) pairs (arg may be absent)
  (let ((arr (make-vector (+ capacity 1) 0))
        (head 0)
        (tail 0)
        (cnt 0)
        (cap (+ capacity 1))
        (results '()))
    (define (rec cmds res)
      (if (null? cmds)
          (reverse res)
          (let* ((cmd (car cmds))
                 (op (car cmd)))
            (cond
              ((equal? op "enqueue")
               (let ((v (car (cdr cmd))))
                 (if (= cnt cap)
                     (rec (cdr cmds) (cons #f res))
                     (begin
                       (vector-set! arr tail v)
                       (set! tail (modulo (+ tail 1) cap))
                       (set! cnt (+ cnt 1))
                       (rec (cdr cmds) (cons #t res))))))
              ((equal? op "dequeue")
               (if (= cnt 0)
                   (rec (cdr cmds) (cons #f res))
                   (begin
                     (set! head (modulo (+ head 1) cap))
                     (set! cnt (- cnt 1))
                     (rec (cdr cmds) (cons #t res)))))
              ((equal? op "front")
               (if (= cnt 0)
                   (rec (cdr cmds) (cons -1 res))
                   (rec (cdr cmds) (cons (vector-ref arr head) res))))
              ((equal? op "rear")
               (if (= cnt 0)
                   (rec (cdr cmds) (cons -1 res))
                   (rec (cdr cmds) (cons (vector-ref arr (modulo (- tail 1) cap)) res))))
              ((equal? op "is_empty")
               (rec (cdr cmds) (cons (= cnt 0) res)))
              ((equal? op "is_full")
               (rec (cdr cmds) (cons (= cnt cap) res)))
              (else (rec (cdr cmds) res)))))))
    (rec commands '()))
(define (display-list-or-val v)
  (cond
    ((null? v) (display "()"))
    ((pair? v)
     (begin
       (display "(")
       (display-list-or-val (car v))
       (display " . ")
       (display-list-or-val (cdr v))
       (display ")")))
    ((vector? v) (display "#vector"))
    (else (display v))))
(define (run-case case-id capacity cmds)
  (let* ((result (solve capacity cmds))
         (lst result)
         (n (length lst)))
    (define (loop i l)
      (if (null? l)
          '()
          (begin
            (display "CASE")
            (display case-id)
            (display "=")
            (let ((v (car l)))
              (cond
                ((equal? v #t) (display "true"))
                ((equal? v #f) (display "false"))
                (else (display v))))
            (newline)
            (loop (+ i 1) (cdr l)))))
    (loop 0 lst)))
