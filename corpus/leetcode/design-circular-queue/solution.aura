(define (solve capacity commands)
  (let ((cap capacity)
        (buf (make-vector capacity 0))
        (head 0)
        (tail 0)
        (size 0)
        (results '()))
    (define (push-res v) (set! results (append results (list v))))
    (define (op c)
      (cond
        ((string=? (vector-ref c 0) "enqueue")
         (if (= size cap)
             (push-res #f)
             (begin
               (vector-set! buf tail (vector-ref c 1))
               (set! tail (modulo (+ tail 1) cap))
               (set! size (+ size 1))
               (push-res #t))))
        ((string=? (vector-ref c 0) "dequeue")
         (if (= size 0)
             (push-res #f)
             (begin
               (set! head (modulo (+ head 1) cap))
               (set! size (- size 1))
               (push-res #t))))
        ((string=? (vector-ref c 0) "front")
         (if (= size 0)
             (push-res -1)
             (push-res (vector-ref buf head))))
        ((string=? (vector-ref c 0) "rear")
         (if (= size 0)
             (push-res -1)
             (push-res (vector-ref buf (modulo (- tail 1) cap)))))
        ((string=? (vector-ref c 0) "is_empty") (push-res (= size 0)))
        ((string=? (vector-ref c 0) "is_full") (push-res (= size cap)))
        (else (push-res #f))))
    (for-each op commands)
    results))

(define (display-list xs)
  (display "[")
  (let loop ((rest xs) (first #t))
    (cond
      ((null? rest) (display "]"))
      (else
       (if first (set! first #f) (begin (display ",") (set! first #f)))
       (display (car rest))
       (loop (cdr rest) #f))))
  (newline))

(define (run-case i cap cmds)
  (let ((res (solve cap cmds)))
    (display "CASE")
    (display i)
    (display "=")
    (display-list res)))

(run-case 0 5 #(  ("enqueue" 1) ("enqueue" 2) ("enqueue" 3) ("enqueue" 4) ("enqueue" 5)
                  ("is_full") ("dequeue") ("enqueue" 6) ("front") ("rear")
                  ("dequeue") ("dequeue") ("dequeue") ("dequeue") ("dequeue")
                  ("is_empty") ("front") ("rear")))
(run-case 1 3 #(  ("enqueue" 10) ("enqueue" 20) ("enqueue" 30) ("is_full") ("rear")
                  ("front") ("dequeue") ("enqueue" 40) ("front") ("rear") ("is_full")))
(run-case 2 1 #(  ("is_empty") ("is_full") ("front") ("rear") ("enqueue" 7)
                  ("is_full") ("front") ("rear") ("enqueue" 8) ("dequeue")
                  ("front") ("is_empty")))
(run-case 3 2 #(  ("front") ("rear") ("dequeue") ("is_empty") ("is_full")))
(run-case 4 4 #(  ("enqueue" 1) ("enqueue" 2) ("dequeue") ("dequeue") ("enqueue" 3)
                  ("enqueue" 4) ("enqueue" 5) ("enqueue" 6) ("front") ("rear") ("is_full")))
(run-case 5 3 #(  ("is_empty") ("is_full") ("front") ("rear")))
