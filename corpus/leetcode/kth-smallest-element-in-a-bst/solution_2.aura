;; Helper: convert a level-order list with 'null sentinels into a BST
;; Returns a list (node ...) where node is (val left right) or '()
;; We represent nodes as a small struct via list: (val left right)
(define (null? x) (if (eq? x 'null) #t (if (eq? x '()) #t #f)))

;; Build BST from sorted order? No - input is level-order, we must rebuild structure.
;; We'll rebuild by inserting values sequentially (BST insertion rule), but
;; the problem provides level-order with nulls. To respect structure exactly,
;; we use level-order construction.

(define (make-tree from-list)
  ;; from-list is a proper list with 'null placeholders
  (let ((n (length from-list)))
    (if (= n 0)
        '()
        (let ((nodes (make-vector n '())))
          ;; helper to set child
          (define (set-child! parent-idx child-idx is-left)
            (if (>= child-idx n)
                '()
                (let ((child-val (list-ref from-list child-idx)))
                  (if (null? child-val)
                      '()
                      (let ((node (list child-val '() '())))
                        (vector-set! nodes child-idx node)
                        (let ((p (vector-ref nodes parent-idx)))
                          (if is-left
                              (vector-set! nodes parent-idx
                                (list (car p) node (caddr p)))
                              (vector-set! nodes parent-idx
                                (list (car p) (cadr p) node)))))))))
          ;; create root
          (let ((root-val (list-ref from-list 0)))
            (vector-set! nodes 0 (list root-val '() '())))
          ;; iterate parents
          (let ((i 0))
            (define (loop)
              (if (>= i n)
                  '()
                  (let ((v (vector-ref nodes i)))
                    (if (null? v)
                        (begin (set! i (+ i 1)) (loop))
                        (begin
                          (set-child! i (+ (* 2 i) 1) #t)
                          (set-child! i (+ (* 2 i) 2) #f)
                          (set! i (+ i 1))
                          (loop))))))
            (loop))
          (vector-ref nodes 0)))))

;; In-order traversal that stops early, using a counter.
(define (kth-smallest root k)
  ;; returns the k-th smallest value, or #f if not found
  (let ((counter 0) (result #f) (done #f))
    (define (inorder node)
      (if done
          '()
          (if (null? node)
              '()
              (begin
                (inorder (cadr node))
                (if done '()
                    (begin
                      (set! counter (+ counter 1))
                      (if (= counter k)
                          (begin
                            (set! result (car node))
                            (set! done #t))
                          (inorder (caddr node)))))))))
    (inorder root)
    (if done result '())))

(define (solve root-list k)
  (let ((tree (make-tree root-list)))
    (kth-smallest tree k)))

;; Display helper: print a value (number, #t/#f, '(), or list)
(define (display-val v)
  (cond
    ((eq? v '()) (display "None"))
    ((number? v) (display (number->string v)))
    ((eq? v #t) (display "#t"))
    ((eq? v #f) (display "#f"))
    (else (display "?"))))

(define (display-list-of-list ll)
  (display "[")
  (define (loop rest first?)
    (if (null? rest)
        (display "]")
        (begin
          (if first? (display "") (display ","))
          (display-val (car rest))
          (loop (cdr rest) #f))))
  (loop ll #t))

;; The test inputs are given as JSON-like dicts.
;; We embed each ROOT as a quoted list and K as a number.

(define (run-case i root-data k)
  (display "CASE")
  (display (number->string i))
  (display "=")
  (let ((r (solve root-data k)))
    (display-val r))
  (newline))

;; CASE0: root=[2,1,3], k=1
(run-case 0 '(2 1 3) 1)

;; CASE1: root=[5,3,6,2,4,null,null,1], k=3
(run-case 1 '(5 3 6 2 4 null null 1) 3)

;; CASE2: root=[5,3,6,2,4,null,null,1], k=6
(run-case 2 '(5 3 6 2 4 null null 1) 6)

;; CASE3: root=[1], k=1
(run-case 3 '(1) 1)

;; CASE4: root=[3,1,5,null,2,null,4], k=4
;; level order with nulls: 3,1,5,null,2,null,4
(run-case 4 '(3 1 5 null 2 null 4) 4)

;; CASE5: root=[4,2,6,1,3,5,7], k=7
(run-case 5 '(4 2 6 1 3 5 7) 7)

;; CASE6: root=[4,2,6,1,3,5,7], k=1
(run-case 6 '(4 2 6 1 3 5 7) 1)

;; CASE7: root=null, k=1
(run-case 7 '() 1)
