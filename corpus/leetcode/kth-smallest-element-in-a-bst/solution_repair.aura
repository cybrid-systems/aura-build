;; Rebuild level-order BST correctly: place children at indices 2i+1, 2i+2,
;; skipping when value is 'null. Use mutable vector of nodes.
(define (make-tree from-list)
  (let ((n (length from-list)))
    (if (= n 0)
        '()
        (let ((nodes (make-vector n '())))
          ;; place a child
          (define (place! parent-idx child-idx)
            (if (>= child-idx n)
                '()
                (let ((cv (list-ref from-list child-idx)))
                  (if (eq? cv 'null)
                      '()
                      (let ((node (list cv '() '())))
                        (vector-set! nodes child-idx node)
                        (let ((p (vector-ref nodes parent-idx)))
                          (if (= child-idx (+ (* 2 parent-idx) 1))
                              (vector-set! nodes parent-idx
                                (list (car p) node (caddr p)))
                              (vector-set! nodes parent-idx
                                (list (car p) (cadr p) node)))))))))
          (let ((rv (list-ref from-list 0)))
            (if (eq? rv 'null)
                '()
                (begin
                  (vector-set! nodes 0 (list rv '() '()))
                  (let loop ((i 0))
                    (if (>= i n)
                        (vector-ref nodes 0)
                        (let ((v (vector-ref nodes i)))
                          (if (eq? v '())
                              (loop (+ i 1))
                              (begin
                                (place! i (+ (* 2 i) 1))
                                (place! i (+ (* 2 i) 2))
                                (loop (+ i 1)))))))))))))

(define (kth-smallest root k)
  (let ((counter 0) (result '()))
    (define (inorder node)
      (if (eq? result '())
          (if (eq? node '())
              '()
              (begin
                (inorder (cadr node))
                (if (eq? result '())
                    (begin
                      (set! counter (+ counter 1))
                      (if (= counter k)
                          (set! result (car node))
                          (inorder (caddr node)))))))))
    (inorder root)
    result))

(define (solve root-list k)
  (kth-smallest (make-tree root-list) k))

(define (display-val v)
  (cond
    ((eq? v '()) (display "null"))
    ((number? v) (display (number->string v)))
    (else (display "?"))))

(define (run-case i root-data k)
  (display "CASE")
  (display (number->string i))
  (display "=")
  (display-val (solve root-data k))
  (newline))

(run-case 0 '(2 1 3) 1)
(run-case 1 '(5 3 6 2 4 null null 1) 3)
(run-case 2 '(5 3 6 2 4 null null 1) 6)
(run-case 3 '(1) 1)
(run-case 4 '(3 1 5 null 2 null 4) 4)
(run-case 5 '(4 2 6 1 3 5 7) 7)
(run-case 6 '(4 2 6 1 3 5 7) 1)
(run-case 7 '() 1)
