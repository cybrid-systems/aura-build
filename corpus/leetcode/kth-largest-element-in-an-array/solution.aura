(define (list-length lst)
  (if (null? lst)
      0
      (+ 1 (list-length (cdr lst)))))

(define (list-ref lst n)
  (if (= n 0)
      (car lst)
      (list-ref (cdr lst) (- n 1))))

(define (partition lst pivot)
  (let loop ((rest lst) (less '()) (equal '()) (greater '()))
    (if (null? rest)
        (list less equal greater)
        (let ((x (car rest)))
          (cond ((< x pivot) (loop (cdr rest) (cons x less) equal greater))
                ((= x pivot) (loop (cdr rest) less (cons x equal) greater))
                (else (loop (cdr rest) less equal (cons x greater))))))))

(define (quickselect lst k)
  ;; k is 0-indexed: k=0 means largest
  (let ((pivot (car lst)))
    (let ((parts (partition (cdr lst) pivot)))
      (let ((less (car parts))
            (equal (cadr parts))
            (greater (caddr parts)))
        (let ((g-len (list-length greater))
              (e-len (+ 1 (list-length equal))))
          (cond ((< k g-len) (quickselect greater k))
                ((< k e-len) pivot)
                (else (quickselect less (- k e-len)))))))))

(define (kth-largest nums k)
  (quickselect nums (- k 1)))

(define (solve nums k)
  (kth-largest nums k))

(define (run-case i nums k)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums k))
  (newline))

(run-case 0 '(3 2 1 5 6 4) 2)
(run-case 1 '(3 2 3 1 2 4 5 5 6) 4)
(run-case 2 '(1) 1)
(run-case 3 '(-1 -2 -3 -4 -5) 1)
(run-case 4 '(7 7 7 7) 4)
(run-case 5 '(2 1) 2)
(run-case 6 '(5 4 3 2 1) 5)
(run-case 7 '(10 -10 0 100 -100 50 50) 3)
(run-case 8 '(63 -72 -94 89 -30 -38 -43 -65 88 -74 73 89 39 -78 51 8 -92 -93 -77 -45) 7)
