(define (string->list s)
  (let ((len (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (= i len)
          (reverse acc)
          (loop (+ i 1) (cons (string-ref s i) acc))))))

(define (solve s)
  (let* ((n (string-length s))
         (chars (string->list s))
         (result 0))
    ;; sliding window: counts of a, b, c
    (let loop-right ((r 0) (l 0) (ca 0) (cb 0) (cc 0))
      (if (= r n)
          result
          (let* ((ch (list-ref chars r))
                 (ca2 (+ ca (if (char=? ch #\a) 1 0)))
                 (cb2 (+ cb (if (char=? ch #\b) 1 0)))
                 (cc2 (+ cc (if (char=? ch #\c) 1 0))))
            (let shrink ((l2 l) (ca3 ca2) (cb3 cb2) (cc3 cc2))
              (if (and (>= ca3 1) (>= cb3 1) (>= cc3 1))
                  (let ((lch (list-ref chars l2)))
                    (if (< l2 r)
                        (shrink (+ l2 1)
                                (- ca3 (if (char=? lch #\a) 1 0))
                                (- cb3 (if (char=? lch #\b) 1 0))
                                (- cc3 (if (char=? lch #\c) 1 0)))
                        ;; l2 is the smallest left; window [l2..r] valid
                        ;; so substrings ending at r with left in [l2..r] are valid => (r - l2 + 1)
                        (loop-right (+ r 1) l2 ca3 cb3 cc3)))
                  (loop-right (+ r 1) l2 ca3 cb3 cc3)))
            )))))

(define (run-case i s)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve s))
  (newline))

(run-case 0 "abc")
(run-case 1 "aaab")
(run-case 2 "aababc")
(run-case 3 "abcabc")
(run-case 4 "a")
(run-case 5 "abca")
(run-case 6 "abcabcabc")
(run-case 7 "aaabbbccc")
