(define (len xs)
  (if (null? xs) 0
      (+ 1 (len (cdr xs)))))

(define (list-ref xs i)
  (if (= i 0) (car xs)
      (list-ref (cdr xs) (- i 1))))

(define (search nums target lo hi)
  (if (>= lo hi) -1
      (let* ((mid (quotient (+ lo hi) 2))
             (mv (list-ref nums mid))
             (lv (list-ref nums lo))
             (hv (list-ref nums (- hi 1))))
        (cond
          ((= mv target) mid)
          ((<= lv mv)
           (if (and (>= target lv) (< target mv))
               (search nums target lo mid)
               (search nums target (+ mid 1) hi)))
          ((<= mv hv)
           (if (and (> target mv) (<= target hv))
               (search nums target (+ mid 1) hi)
               (search nums target lo mid)))
          (else -1)))))

(define (solve nums target)
  (search nums target 0 (len nums)))

(define (run-case i nums target)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums target))
  (newline))

(begin
  (run-case 0 '(4 5 6 7 0 1 2) 0)
  (run-case 1 '(4 5 6 7 0 1 2) 3)
  (run-case 2 '(1) 0)
  (run-case 3 '(1) 1)
  (run-case 4 '(0 1 2 4 5 6 7) 4)
  (run-case 5 '(4 5 6 7 0 1 2) 5)
  (run-case 6 '(3 1) 1)
  (run-case 7 '(5 1 3) 3))
