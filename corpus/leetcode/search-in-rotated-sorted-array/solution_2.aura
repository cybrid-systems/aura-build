(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (search nums left right target)
  (if (> left right)
      -1
      (let ((mid (quotient (+ left right) 2))
            (mv (list-ref nums mid))
            (lv (list-ref nums left))
            (rv (list-ref nums right)))
        (cond
          ((= mv target) mid)
          ((<= lv mv)
           (if (and (>= target lv) (< target mv))
               (search nums left (- mid 1) target)
               (search nums (+ mid 1) right target)))
          (else
           (if (and (> target mv) (<= target rv))
               (search nums (+ mid 1) right target)
               (search nums left (- mid 1) target)))))))

(define (solve nums target)
  (let ((n (length nums)))
    (if (= n 0) -1 (search nums 0 (- n 1) target))))

(define (run-case i nums target)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums target))
  (newline))

(run-case 0 '(4 5 6 7 0 1 2) 0)
(run-case 1 '(4 5 6 7 0 1 2) 3)
(run-case 2 '(1) 0)
(run-case 3 '(1) 1)
(run-case 4 '(0 1 2 4 5 6 7) 4)
(run-case 5 '(4 5 6 7 0 1 2) 5)
(run-case 6 '(3 1) 1)
(run-case 7 '(5 1 3) 3)
