(require "compat" all:)
(define (min-rooms intervals)
  (let ((n (length intervals)))
    (if (= n 0)
        0
        (let* ((starts (map car intervals))
               (ends (map (lambda (p) (car (cdr p))) intervals))
               (sorted-starts (sort-list starts <))
               (sorted-ends (sort-list ends <))
               (result (i 0))
               (ptr-e (i 0))
               (sweep (lambda (idx total-e)
                        (if (= idx n)
                            total-e
                            (let ((s (list-ref sorted-starts idx)))
                              (if (and (< ptr-e n)
                                       (<= (list-ref sorted-ends ptr-e) s))
                                  (sweep idx (+ total-e 1))
                                  (let ((new-total (+ total-e 1)))
                                    (if (> new-total result)
                                        (sweep (+ idx 1) new-total)
                                        (sweep (+ idx 1) new-total))))))))
          (sweep 0 0)))))

(define (solve intervals)
  (min-rooms intervals))

(define (run-case i intervals)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve intervals))
  (newline))

(run-case 0 '((0 30) (5 10) (15 20)))
(run-case 1 '((7 10) (2 4)))
(run-case 2 '((1 4) (4 6) (4 7)))
(run-case 3 '())
(run-case 4 '((1 5)))
(run-case 5 '((1 5) (2 6) (3 7) (4 8)))
(run-case 6 '((1 4) (2 3)))
(run-case 7 '((0 1) (1 2) (2 3) (3 4)))
