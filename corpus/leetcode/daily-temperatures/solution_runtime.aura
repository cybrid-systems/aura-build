; soft_leetcode_runtime slug=daily-temperatures path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-9 hits=8/8
; baseline_hits=7/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define parse-int
    (lambda (s i)
      (let ((len (string-length s)))
        (letrec ((loop (lambda (j neg val)
            (if (>=
                j len)
              (cons
                (if neg
                  (-
                    0 val)
                  val) j)
              (let ((c (string-ref
                  s j)))
                (if (char=?
                    c 45)
                  (loop
                    (+
                      j 1) #t val)
                  (if (or
                      (char=?
                        c 44) (char=?
                        c 93))
                    (cons
                      (if neg
                        (-
                          0 val)
                        val) j)
                    (if (or
                        (char=?
                          c 32) (char=?
                          c 91))
                      (loop
                        (+
                          j 1) neg val)
                      (let ((d (-
                          (char->integer c) (char->integer 48))))
                        (loop
                          (+
                            j 1) neg (+
                            (*
                              val 10) d)))))))))))
          (loop
            i #f 0)))))
  (define parse-temps
    (lambda (s)
      (let ((len (string-length s)))
        (letrec ((find-bracket (lambda (j)
            (if (>=
                j len)
              len
              (if (char=?
                  (string-ref
                    s j) 91)
                (+
                  j 1)
                (find-bracket (+
                    j 1)))))))
          (let ((start (find-bracket 0)))
            (letrec ((loop (lambda (i acc)
                (if (>=
                    i len)
                  (reverse acc)
                  (if (char=?
                      (string-ref
                        s i) 93)
                    (reverse acc)
                    (let ((p (parse-int
                        s i)))
                      (loop
                        (+
                          (cdr p) 1) (cons
                          (car p) acc))))))))
              (loop
                start (quote ()))))))))
  (define list-set!
    (lambda (lst idx val)
      (letrec ((loop (lambda (l i acc)
          (if (null? l)
            (reverse acc)
            (if (=
                i idx)
              (loop
                (cdr l) (+
                  i 1) (cons
                  val acc))
              (loop
                (cdr l) (+
                  i 1) (cons
                  (car l) acc)))))))
        (loop
          lst 0 (quote ())))))
  (define list-ref-safe
    (lambda (lst idx)
      (letrec ((loop (lambda (l i)
          (if (null? l)
            0
            (if (=
                i idx)
              (car l)
              (loop
                (cdr l) (+
                  i 1)))))))
        (loop
          lst 0))))
  (define list-length
    (lambda (lst)
      (letrec ((loop (lambda (l acc)
          (if (null? l)
            acc
            (loop
              (cdr l) (+
                acc 1))))))
        (loop
          lst 0))))
  (define make-zero-list
    (lambda (n)
      (letrec ((loop (lambda (k acc)
          (if (=
              k 0)
            acc
            (loop
              (-
                k 1) (cons
                0 acc))))))
        (loop
          n (quote ())))))
  (define solve
    (lambda (temps)
      (let ((n (list-length temps)))
        (letrec ((main-loop (lambda (i stack result)
            (if (=
                i n)
              result
              (let ((t (list-ref-safe
                  temps i)))
                (letrec ((pop-loop (lambda (st res)
                    (if (null? st)
                      (main-loop
                        (+
                          i 1) (cons
                          i st) res)
                      (let ((idx (car st)))
                        (if (>
                            t (list-ref-safe
                              temps idx))
                          (pop-loop
                            (cdr st) (list-set!
                              res idx (-
                                i idx)))
                          (main-loop
                            (+
                              i 1) (cons
                              i st) res)))))))
                  (pop-loop
                    stack result)))))))
          (main-loop
            0 (quote ()) (make-zero-list n))))))
  (define print-json-array
    (lambda (lst)
      (begin
        (display "[")
        (letrec ((loop (lambda (l first)
            (if (null? l)
              (void)
              (if first
                (begin
                  (display (car l))
                  (loop
                    (cdr l) #f))
                (begin
                  (display ",")
                  (display (car l))
                  (loop
                    (cdr l) #f)))))))
          (loop
            lst #t))
        (display "]"))))
  (define run-case
    (lambda (label input-str)
      (let ((temps (parse-temps input-str)))
        (begin
          (display label)
          (display "=")
          (print-json-array (solve temps))
          (newline)))))
  (run-case
    "CASE0" "CASE0=[73,74,75,71,69,72,76,73]")
  (run-case
    "CASE1" "CASE1=[30,40,50,60]")
  (run-case
    "CASE2" "CASE2=[30,60,90]")
  (run-case
    "CASE3" "CASE3=[90,60,30]")
  (run-case
    "CASE4" "CASE4=[70]")
  (run-case
    "CASE5" "CASE5=[]")
  (run-case
    "CASE6" "CASE6=[0,-1,-2,-3,-4]")
  (run-case
    "CASE7" "CASE7=[-5,-5,-5,-5,-5]"))
