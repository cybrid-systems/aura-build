(define (len xs)
  (if (null? xs) 0 (+ 1 (len (cdr xs)))))

(define (list-get xs i)
  (if (= i 0) (car xs) (list-get (cdr xs) (- i 1))))

(define (list-min a b)
  (if (< a b) a b))

(define (list-max a b)
  (if (> a b) a b))

(define (neg-inf) -1000000000000)
(define (pos-inf) 1000000000000)

(define (get-elem a i m n)
  ; a is shorter array, indexed from 0 to m-1
  ; i is position in combined array
  (cond
    ((= i 0) (neg-inf))
    ((= i m) (pos-inf))
    (else (list-get a i))))

(define (get b j n)
  (cond
    ((= j 0) (neg-inf))
    ((= j n) (pos-inf))
    (else (list-get b j))))

(define (solve nums1 nums2)
  (let* ((m (len nums1))
         (n (len nums2))
         (A (if (<= m n) nums1 nums2))
         (B (if (<= m n) nums2 nums1))
         (lenA (len A))
         (lenB (len B))
         (total (+ lenA lenB))
         (half (quotient total 2)))
    (letrec
      ((search (lambda (lo hi)
        (if (> lo hi)
            0
            (let* ((i (quotient (+ lo hi) 2))
                   (j (- half i))
                   (aLeft (get-elem A i lenA lenB))
                   (aRight (get A (+ i 1) lenA))
                   (bLeft (get B j lenB))
                   (bRight (get B (+ j 1) lenB)))
              (cond
                ((and (<= aLeft bRight) (<= bLeft aRight))
                 (if (= (modulo total 2) 1)
                     (list-min aRight bRight)
                     (/ (+ (list-max aLeft bLeft) (list-min aRight bRight)) 2.0)))
                ((> aLeft bRight) (search lo (- i 1)))
                (else (search (+ i 1) hi))))))))
      (search 0 lenA))))

(define (display-list xs)
  (display "[")
  (letrec ((f (lambda (rest first?)
    (cond
      ((null? rest) (display "]"))
      (else
       (if (not first?) (display ", "))
       (display (car rest))
       (f (cdr rest) #f))))))
    (f xs #t))))

(display "CASE0=") (display (solve (list 1 3) (list 2))) (newline)
(display "CASE1=") (display (solve (list 1 2) (list 3 4))) (newline)
(display "CASE2=") (display (solve '() (list 1))) (newline)
(display "CASE3=") (display (solve (list 0 0) (list 0 0))) (newline)
(display "CASE4=") (display (solve (list 1) (list 2 3 4 5 6))) (newline)
(display "CASE5=") (display (solve (list -5 -3 -1) (list -2 0 4))) (newline)
(display "CASE6=") (display (solve (list 1 2 3 4 5) (list 6 7 8 9 10))) (newline)
(display "CASE7=") (display (solve (list 1 1 1) (list 1 1 1 1))) (newline)
