(define (make-node val left right)
    (cons val (cons left (cons right '())))

(define (node-val n) (car n))
(define (node-left n) (car (cdr n)))
(define (node-right n) (car (cdr (cdr n))))

(define (gen-trees lo hi)
    (if (> lo hi)
        (list '())
        (let ((result '()))
            (begin
                (define (add-tree t) (set! result (cons t result)))
                (define i 1)
                (set! i lo)
                (while (<= i hi)
                    (let ((lefts (gen-trees lo (- i 1)))
                          (rights (gen-trees (+ i 1) hi)))
                        (begin
                            (define build-left (lambda (l) (lambda (r) (make-node i l r))))
                            (define build-right (lambda (b) (lambda (l) (lambda (r) (b l r)))))
                            (define map2 (lambda (f xs ys)
                                (if (or (null? xs) (null? ys))
                                    '()
                                    (cons (f (car xs) (car ys)) (map2 f (cdr xs) (cdr ys))))))
                            (define combined (map2 (lambda (l r) (make-node i l r)) lefts rights))
                            (define add-all (lambda (lst)
                                (if (null? lst)
                                    '()
                                    (begin
                                        (set! result (cons (car lst) result))
                                        (add-all (cdr lst))))))
                            (add-all combined)
                            (set! i (+ i 1))))))
                (reverse result)))))

(define (serialize tree)
    (if (null? tree)
        (list '#)
        (let ((queue (list tree))
              (result '()))
            (define (process-q q)
                (if (null? q)
                    (reverse result)
                    (let ((node (car q)))
                        (begin
                            (if (null? node)
                                (begin
                                    (set! result (cons '# result))
                                    (process-q (cdr q)))
                                (begin
                                    (set! result (cons (number->string (node-val node)) result))
                                    (process-q (append (cdr q) (list (node-left node) (node-right node))))))))))
            (process-q queue))))

(define (solve n)
    (if (= n 0)
        '()
        (serialize-list (gen-trees 1 n))))

(define (serialize-list trees)
    (if (null? trees)
        '()
        (append (serialize (car trees)) (serialize-list (cdr trees)))))

(define (display-list lst)
    (define (helper l first)
        (if (null? l)
            '()
            (begin
                (if (not first) (display " "))
                (display (car l))
                (helper (cdr l) #f))))
    (helper lst #t))

(define (run-case n i)
    (display "CASE")
    (display i)
    (display "=")
    (let ((r (solve n)))
        (begin
            (display-list r)
            (newline))))

(run-case 0 0)
(run-case 1 1)
(run-case 2 2)
(run-case 3 3)
(run-case 4 4)
(run-case 5 5)
