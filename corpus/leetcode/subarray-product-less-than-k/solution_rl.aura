(require "lc_json" all:)
(require "compat" all:)
(define (length lst)
  (if (null? lst) 0
      (+ 1 (length (cdr lst)))))
(define (list-ref lst i)
  (if (= i 0) (car lst)
      (list-ref (cdr lst) (- i 1))))
(define (solve nums k)
  (if (<= k 1)
      0
      (let ((n (length nums)))
        (let loop ((left 0) (right 0) (prod 1) (count 0))
          (if (= right n)
              count
              (let ((rv (list-ref nums right)))
                (let inner ((l left) (r right) (p prod) (c count))
                          (if (>= p k)
                              (let ((lv (list-ref nums l)))
                                (inner (+ l 1) r (/ p lv) c))
                              (let ((new-c (+ c (- r l 1))))
                                (loop l (+ r 1) (* p rv) new-c))))))))))
(define (display-case i result)
  (display "ANS")
  (display i)
  (display "=")
  (display result)
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums") (hash-ref input "k")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/subarray-product-less-than-k/tests.json")))
