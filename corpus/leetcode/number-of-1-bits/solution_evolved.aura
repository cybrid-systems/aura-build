(require "compat" all:)
(define (solve n) (let loop ((i 0) (acc 0)) (if (>= i 32) acc (loop (+ i 1) (+ acc (modulo (quotient n (expt 2 i)) 2))))))
(display "CASE0=") (display (solve 0)) (newline) (display "CASE1=") (display (solve 1)) (newline) (display "CASE2=") (display (solve 11)) (newline) (display "CASE3=") (display (solve 128)) (newline) (display "CASE4=") (display (solve 255)) (newline) (display "CASE5=") (display (solve 4294967295)) (newline) (display "CASE6=") (display (solve 4294967293)) (newline) (display "CASE7=") (display (solve 2147483648)) (newline)