;; Build a tree from list with null = 'null sentinel
(define (make-tree lst)
  (define (build lst i)
    (if (or (>= i (length lst)) (equal? (list-ref lst i) 'null))
        'null
        (let ((node (cons (list-ref lst i) (cons 'null (cons 'null '())))))
          (set-car! (cdr node) (build lst (+ (* 2 i) 1)))
          (set-car! (cdr (cdr node)) (build lst (+ (* 2 i) 2)))
          node)))
  (build lst 0))

(define (tree-val t) (car t))
(define (tree-left t) (car (cdr t)))
(define (tree-right t) (car (cdr (cdr t))))
(define (null-tree? t) (equal? t 'null))

;; BFS right side view
(define (solve root)
  (if (null-tree? root)
      '()
      (let ((queue (list (cons root 0)))
            (result nil))
        (define (loop q r)
          (if (null? q)
              (reverse r)
              (let* ((pair (car q))
                     (node (car pair))
                     (depth (cdr pair))
                     (rest-q (cdr q))
                     (val (tree-val node))
                     (new-r (cons val r)))
                ;; Always overwrite with current node's val (last at depth wins)
                (let ((q2 (append rest-q
                                  (if (null-tree? (tree-left node))
                                      '()
                                      (list (cons (tree-left node) (+ depth 1))))
                                  (if (null-tree? (tree-right node))
                                      '()
                                      (list (cons (tree-right node) (+ depth 1)))))))
                  (loop q2 new-r)))))
        (loop queue nil))))

(define (display-list lst)
  (display "[")
  (define (helper l first?)
    (cond ((null? l) (display "]"))
          (else
           (if (not first?) (display ", "))
           (display (car l))
           (helper (cdr l) #f))))
  (helper lst #t)
  (newline))

(define (run-case i root-list)
  (let ((root (make-tree root-list)))
    (display "CASE")
    (display i)
    (display "=")
    (display-list (solve root))))

(run-case 0 (list 1 2 3 'null 5 'null 4))
(run-case 1 (list 1 2 3 4 'null 'null 'null 5))
(run-case 2 (list 1 'null 3))
(run-case 3 '())
(run-case 4 (list 1))
(run-case 5 (list 1 2 3 4 5 6 7))
(run-case 6 (list 1 2 'null 3 'null 4))
(run-case 7 (list 1 2 3 'null 'null 5 6))
