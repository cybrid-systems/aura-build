(require "compat" all:)

;; Build tree from level-order list; nulls represented by '()
;; Node shape: (list val left right)
(define (build-tree lst)
  (define len (length lst))
  (define (node-at idx)
    (if (>= idx len)
        '()
        (let ((v (list-ref lst idx)))
          (if (null? v)
              '()
              (list v (node-at (+ (* idx 2) 1)) (node-at (+ (* idx 2) 2)))))))
  (node-at 0))

;; BFS right-side view
;; Queue entries: node-or-'(); we track all nodes at current level
;; and select the last non-null one (the rightmost).
(define (right-side-view root)
  (if (null? root)
      '()
      (let ((queue (list root)))
        (define (take-last-nonnull q)
          (if (null? q)
              (error "empty level")
              (let ((cur (car q)) (rest (cdr q)))
                (if (null? rest)
                    cur
                    (take-last-nonnull rest)))))
        (define (step q acc)
          (if (null? q)
              (reverse acc)
              (let ((level-last (take-last-nonnull q))
                    (next-q
                      (let loop ((qq q) (acc '()))
                        (if (null? qq)
                            (reverse acc)
                            (let ((node (car qq)))
                              (if (null? node)
                                  (loop (cdr qq) acc)
                                  (let ((l (cadr node)) (r (caddr node)))
                                    (if (null? r)
                                        (if (null? l)
                                            (loop (cdr qq) acc)
                                            (loop (cdr qq) (cons l acc)))
                                        (loop (cdr qq) (cons r (if (null? l) acc (cons l acc))))))))))))
                (step next-q (cons (car level-last) acc)))))
        (step queue '()))))

;; Display list of numbers as [a, b, c]
(define (display-list lst)
  (display "[")
  (define (loop l first?)
    (if (null? l)
        (begin (display "]") '())
        (begin
          (if (not first?) (display ", "))
          (display (car l))
          (loop (cdr l) #f))))
  (loop lst #t)
  (when (null? lst) (display "]")))

(define (solve root)
  (right-side-view root))

;; Test harness
(define (run-case i lst)
  (let ((root (build-tree lst)))
    (display "CASE")
    (display i)
    (display "=")
    (display-list (solve root))
    (newline)))

(run-case 0 (list 1 2 3 '() 5 '() 4))
(run-case 1 (list 1 2 3 4 '() '() '() 5))
(run-case 2 (list 1 '() 3))
(run-case 3 '())
(run-case 4 (list 1))
(run-case 5 (list 1 2 3 4 5 6 7))
(run-case 6 (list 1 2 '() 3 '() 4))
(run-case 7 (list 1 2 3 '() '() 5 6))
