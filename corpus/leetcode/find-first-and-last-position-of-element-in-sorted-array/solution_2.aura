(define (list-length xs)
  (let loop ((xs xs) (n 0))
    (if (null? xs) n (loop (cdr xs) (+ n 1)))))

(define (list-ref xs i)
  (if (= i 0) (car xs) (list-ref (cdr xs) (- i 1))))

(define (find-first xs target)
  ;; returns index of leftmost target, or -1
  (let ((n (list-length xs)))
    (let loop ((lo 0) (hi (- n 1)) (result -1))
      (if (> lo hi)
          result
          (let* ((mid (/ (+ lo hi) 2))
                 (v (list-ref xs mid)))
            (cond ((= v target)
                   (loop lo (- mid 1) mid))
                  ((< v target)
                   (loop (+ mid 1) hi result))
                  (else
                   (loop lo (- mid 1) result))))))))

(define (find-last xs target)
  ;; returns index of rightmost target, or -1
  (let ((n (list-length xs)))
    (let loop ((lo 0) (hi (- n 1)) (result -1))
      (if (> lo hi)
          result
          (let* ((mid (/ (+ lo hi) 2))
                 (v (list-ref xs mid)))
            (cond ((= v target)
                   (loop (+ mid 1) hi mid))
                  ((< v target)
                   (loop (+ mid 1) hi result))
                  (else
                   (loop lo (- mid 1) result))))))))

(define (solve a target)
  (let ((f (find-first a target)))
    (if (= f -1)
        (cons -1 -1)
        (let ((l (find-last a target)))
          (cons f l)))))

;; Display helpers
(define (display-pair p)
  (display "(")
  (display (car p))
  (display " . ")
  (display (cdr p))
  (display ")"))

;; Test cases
(define case0-a (list 5 7 7 8 8 10))
(define case0-t 8)
(define case1-a (list 5 7 7 8 8 10))
(define case1-t 6)
(define case2-a (list 1))
(define case2-t 1)
(define case3-a (list))
(define case3-t 0)
(define case4-a (list 1 2 3 4 5))
(define case4-t 3)
(define case5-a (list 1 1 1 1 1))
(define case5-t 1)
(define case6-a (list 2 2))
(define case6-t 3)
(define case7-a (list -5 -3 -1 0 2 4 6))
(define case7-t -1)

(define r0 (solve case0-a case0-t))
(display "CASE0=") (display-pair r0) (newline)
(define r1 (solve case1-a case1-t))
(display "CASE1=") (display-pair r1) (newline)
(define r2 (solve case2-a case2-t))
(display "CASE2=") (display-pair r2) (newline)
(define r3 (solve case3-a case3-t))
(display "CASE3=") (display-pair r3) (newline)
(define r4 (solve case4-a case4-t))
(display "CASE4=") (display-pair r4) (newline)
(define r5 (solve case5-a case5-t))
(display "CASE5=") (display-pair r5) (newline)
(define r6 (solve case6-a case6-t))
(display "CASE6=") (display-pair r6) (newline)
(define r7 (solve case7-a case7-t))
(display "CASE7=") (display-pair r7) (newline)
