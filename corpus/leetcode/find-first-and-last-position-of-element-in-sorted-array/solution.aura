(define (list-length xs)
  (if (null? xs) 0 (+ 1 (list-length (cdr xs)))))

(define (list-ref xs i)
  (if (= i 0) (car xs) (list-ref (cdr xs) (- i 1))))

(define (leftmost a target n)
  (let loop ((lo 0) (hi n))
    (if (>= lo hi)
        lo
        (let ((mid (quotient (+ lo hi) 2)))
          (if (>= (list-ref a mid) target)
              (loop lo mid)
              (loop (+ mid 1) hi))))))

(define (rightmost a target n)
  (let loop ((lo 0) (hi n))
    (if (>= lo hi)
        lo
        (let ((mid (quotient (+ lo hi) 2)))
          (if (> (list-ref a mid) target)
              (loop lo mid)
              (loop (+ mid 1) hi))))))

(define (solve a target)
  (let ((n (list-length a)))
    (if (= n 0)
        (cons -1 -1)
        (let ((l (leftmost a target n)))
          (if (or (>= l n) (not (= (list-ref a l) target)))
              (cons -1 -1)
              (let ((r (rightmost a target n)))
                (cons l (- r 1))))))))

(define (print-pair p)
  (display "(")
  (display (car p))
  (display " . ")
  (display (cdr p))
  (display ")"))

(define (run-case i a target)
  (let ((res (solve a target)))
    (display "CASE")
    (display i)
    (display "=")
    (print-pair res)
    (newline)))

(run-case 0 '(5 7 7 8 8 10) 8)
(run-case 1 '(5 7 7 8 8 10) 6)
(run-case 2 '(1) 1)
(run-case 3 '() 0)
(run-case 4 '(1 2 3 4 5) 3)
(run-case 5 '(1 1 1 1 1) 1)
(run-case 6 '(2 2) 3)
(run-case 7 '(-5 -3 -1 0 2 4 6) -1)
