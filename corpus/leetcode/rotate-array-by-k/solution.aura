(define (reverse-list lst)
  (let loop ((acc '()) (xs lst))
    (if (null? xs)
        acc
        (loop (cons (car xs) acc) (cdr xs)))))

(define (reverse-range lst start end)
  ; reverse elements between start and end inclusive (0-indexed)
  (let* ((len (- end start -1))
         (new-list
          (let loop ((i 0) (acc '()))
            (if (> i len)
                acc
                (let ((idx (- end 1 i)))
                  (loop (+ i 1) (cons (list-ref lst idx) acc)))))))
    (let ((prefix (take-list lst start))
          (suffix (drop-list lst (+ end 1))))
      (append-list prefix (append-list new-list suffix)))))

(define (take-list lst n)
  (let loop ((i 0) (acc '()) (xs lst))
    (if (or (= i n) (null? xs))
        (reverse-list acc)
        (loop (+ i 1) (cons (car xs) acc) (cdr xs)))))

(define (drop-list lst n)
  (let loop ((i 0) (xs lst))
    (if (or (= i n) (null? xs))
        xs
        (loop (+ i 1) (cdr xs)))))

(define (append-list a b)
  (if (null? a)
      b
      (cons (car a) (append-list (cdr a) b))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (solve arr k)
  (let* ((n (length arr))
         (eff-k (modulo k n))
         (rotated
          (cond
            ((or (= n 0) (= eff-k 0)) arr)
            (else
              (let* ((reversed (reverse-list arr))
                     (first-part (reverse-range reversed 0 eff-k))
                     (second-part (reverse-range first-part eff-k n)))
                second-part)))))
    rotated))

(define (length lst)
  (let loop ((xs lst) (n 0))
    (if (null? xs)
        n
        (loop (cdr xs) (+ n 1)))))

(define (modulo a b)
  (- a (* (quotient a b) b)))

(define (display-list lst)
  (display "[")
  (let loop ((first? #t) (xs lst))
    (cond
      ((null? xs) (display "]"))
      (else
       (if first?
           (begin (display (number->string (car xs))) (loop #f (cdr xs)))
           (begin (display ",") (display (number->string (car xs))) (loop #f (cdr xs))))))))

(define (display-result r)
  (display-list r))

(display "CASE0=") (display-result (solve '(1 2 3 4 5 6 7) 3)) (newline)
(display "CASE1=") (display-result (solve '(1 2 3 4 5) 0)) (newline)
(display "CASE2=") (display-result (solve '(1 2 3 4 5) 5)) (newline)
(display "CASE3=") (display-result (solve '(1 2 3 4 5) 7)) (newline)
(display "CASE4=") (display-result (solve '() 3)) (newline)
(display "CASE5=") (display-result (solve '(42) 100)) (newline)
(display "CASE6=") (display-result (solve '(-1 -2 -3 -4) 1)) (newline)
(display "CASE7=") (display-result (solve '(1 2 3 4 5 6) 2)) (newline)
