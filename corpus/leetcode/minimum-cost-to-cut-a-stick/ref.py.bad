import heapq

def solve(L: int, cuts: list[int]) -> int:
    cuts_sorted = sorted(cuts)
    # Build segments
    boundaries = [0] + cuts_sorted + [L]
    heap = []
    for i in range(len(boundaries) - 1):
        length = boundaries[i+1] - boundaries[i]
        if length > 0:
            heapq.heappush(heap, length)
    
