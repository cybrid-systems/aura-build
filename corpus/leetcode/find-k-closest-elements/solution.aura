(define (abs-diff a b)
  (if (>= a b) (- a b) (- b a)))

(define (window-better? arr left k x)
  ;; returns #t if window starting at left is better than left+1
  (let ((right-val (list-ref arr (+ left k)))
        (left-val  (list-ref arr left)))
    (if (>= left-val x)
        #t
        (if (< right-val x)
            #f
            (<= (- x left-val) (- right-val x))))))

(define (find-left arr n k x)
  (let ((lo 0)
        (hi (- n k)))
    (let loop ((lo lo) (hi hi))
      (if (>= lo hi)
          lo
          (let ((mid (quotient (+ lo hi) 2)))
            (if (window-better? arr mid k x)
                (loop lo mid)
                (loop (+ mid 1) hi)))))))

(define (sublist arr start k)
  (let loop ((i 0) (acc '()))
    (if (>= i k)
        (reverse acc)
        (loop (+ i 1) (cons (list-ref arr (+ start i)) acc)))))

(define (solve n k x arr)
  (let ((left (find-left arr n k x)))
    (sublist arr left k)))

(define (print-list xs)
  (let loop ((xs xs) (first? #t))
    (cond ((null? xs) (display ""))
          (else
           (if first? (display "") (display " "))
           (display (car xs))
           (loop (cdr xs) #f)))))

;; Test cases
(define cases
  (list
    (list 7 3 5  '(1 2 3 4 7 8 9))
    (list 7 4 5  '(1 2 3 4 7 8 9))
    (list 5 5 3  '(1 2 3 4 5))
    (list 4 1 10 '(1 2 3 100))
    (list 4 1 -5 '(-10 -3 0 5))
    (list 6 3 0  '(-5 -2 -1 1 2 3))
    (list 8 4 4  '(1 2 3 4 5 6 7 8))
    (list 5 2 100 '(1 50 80 120 150))))

(let loop ((cs cases) (i 0))
  (if (null? cs)
      'done
      (begin
        (let ((c (car cs)))
          (let ((n (car c))
                (k (car (cdr c)))
                (x (car (cdr (cdr c))))
                (arr (car (cdr (cdr (cdr c)))))))
            (let ((ans (solve n k x arr)))
              (display "CASE")
              (display i)
              (display "=")
              (print-list ans)
              (newline))))
        (loop (cdr cs) (+ i 1))))
