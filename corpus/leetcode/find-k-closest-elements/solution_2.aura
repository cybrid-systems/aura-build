(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (sublist lst start end)
  (define (helper lst i acc)
    (cond ((null? lst) (reverse acc))
          ((>= i end) (reverse acc))
          ((>= i start) (helper (cdr lst) (+ i 1) (cons (car lst) acc)))
          (else (helper (cdr lst) (+ i 1) acc))))
  (helper lst 0 '()))

(define (solve n k x arr)
  (let* ((lo 0)
         (hi (- n k))
         (result-left 0))
    (define (search lo hi)
      (if (>= lo hi)
          lo
          (let* ((mid (+ lo (quotient (- hi lo) 2)))
                 (left-val (list-ref arr mid))
                 (right-val (list-ref arr (+ mid k)))
                 (diff-left (- x left-val))
                 (diff-right (- right-val x))
                 (go-left (<= diff-left diff-right)))
            (if go-left
                (search lo mid)
                (search (+ mid 1) hi)))))
    (let ((i (search lo hi)))
      (sublist arr i (+ i k)))))

(define (display-list lst)
  (define (helper lst)
    (cond ((null? lst) (display ""))
          ((null? (cdr lst)) (display (car lst)))
          (else (display (car lst)) (display " ") (helper (cdr lst)))))
  (helper lst))

(let ((cases
       (list
        (list 7 3 5 '(1 2 3 4 7 8 9))
        (list 7 4 5 '(1 2 3 4 7 8 9))
        (list 5 5 3 '(1 2 3 4 5))
        (list 4 1 10 '(1 2 3 100))
        (list 4 1 (- 5) '(-10 -3 0 5))
        (list 6 3 0 '(-5 -2 -1 1 2 3))
        (list 8 4 4 '(1 2 3 4 5 6 7 8))
        (list 5 2 100 '(1 50 80 120 150)))))
  (define (run cases i)
    (if (null? cases)
        'done
        (begin
          (let* ((c (car cases))
                 (n (car c))
                 (k (car (cdr c)))
                 (x (car (cdr (cdr c))))
                 (arr (car (cdr (cdr (cdr c))))))
            (display (string-append "CASE" (number->string i) "="))
            (display-list (solve n k x arr))
            (newline))
          (run (cdr cases) (+ i 1)))))
  (run cases 0))
