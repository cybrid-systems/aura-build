    (cons 'DECODE "http://tiny.url/1")))

;; CASE 5
(solve 5
  (list
    (cons 'ENCODE "https://test.com/path?query=1")
    (cons 'ENCODE "https://test.com/path?query=2")
    (cons 'ENCODE "https://test.com/path?query=1")))

;; CASE 6
(solve 6 '())

;; CASE 7
(solve 7
  (list
    (cons 'ENCODE "https://single.com")
    (cons 'ENCODE "https://single.com")
    (cons 'ENCODE "https://single.com")))
