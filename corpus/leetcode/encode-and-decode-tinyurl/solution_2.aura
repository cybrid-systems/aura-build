(define PREFIX "http://tiny.url/")

(define (make-codec)
  (let ((long-to-short '())
        (short-to-long '())
        (counter 0))
    (lambda (op)
      (cond
        ((equal? (car op) 'ENCODE)
         (let ((url (cadr op)))
           (let ((existing (assoc url long-to-short)))
             (if existing
                 (cdr existing)
                 (begin
                   (set! counter (+ counter 1))
                   (let ((short (string-append PREFIX (number->string counter))))
                     (set! long-to-short (cons (cons url short) long-to-short))
                     (set! short-to-long (cons (cons short url) short-to-long))
                     short))))))
        ((equal? (car op) 'DECODE)
         (let ((short (cadr op)))
           (let ((existing (assoc short short-to-long)))
             (if existing (cdr existing) ""))))
        (else "")))))

(define (run-ops codec ops)
  (if (null? ops)
      '()
      (let ((result ((codec) (car ops))))
        (cons result (run-ops codec (cdr ops))))))

(define (display-list lst)
  (display "[")
  (let loop ((l lst) (first #t))
    (cond ((null? l) (display "]"))
          (else
           (if first (set! first #f) (begin (display ", ") #t))
           (display (car l))
           (loop (cdr l) #f)))))

(define CASE0-OPS '(("ENCODE" "https://leetcode.com/problems/design-tinyurl")))
(define CASE1-OPS '(("ENCODE" "https://example.com/very/long/path") ("ENCODE" "https://example.com/very/long/path") ("ENCODE" "https://another.com")))
(define CASE2-OPS '(("ENCODE" "https://a.com") ("ENCODE" "https://b.com") ("ENCODE" "https://c.com")))
(define CASE3-OPS '(("DECODE" "http://tiny.url/1")))
(define CASE4-OPS '(("ENCODE" "https://x.com") ("DECODE" "http://tiny.url/1")))
(define CASE5-OPS '(("ENCODE" "https://test.com/path?query=1") ("ENCODE" "https://test.com/path?query=2") ("ENCODE" "https://test.com/path?query=1")))
(define CASE6-OPS '())
(define CASE7-OPS '(("ENCODE" "https://single.com") ("ENCODE" "https://single.com") ("ENCODE" "https://single.com")))

(define (solve case-n ops)
  (let ((codec (make-codec)))
    (let ((results (run-ops codec ops)))
      (display "CASE")
      (display case-n)
      (display "=")
      (display-list results)
      (newline))))

(solve 0 CASE0-OPS)
(solve 1 CASE1-OPS)
(solve 2 CASE2-OPS)
(solve 3 CASE3-OPS)
(solve 4 CASE4-OPS)
(solve 5 CASE5-OPS)
(solve 6 CASE6-OPS)
(solve 7 CASE7-OPS)
