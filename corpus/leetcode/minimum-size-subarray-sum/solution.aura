(define (sum-list xs)
  (if (null? xs)
      0
      (+ (car xs) (sum-list (cdr xs)))))

(define (min-size-subarray nums target)
  (if (null? nums)
      0
      (let ((best (cons 0 (lambda () 0))))
        (define (iter left right curr-sum n)
          (if (= right n)
              (car best)
              (let ((new-sum (+ curr-sum (car (list-ref nums right)))))
                (let loop ((l left) (s new-sum))
                  (if (and (< l right) (>= s target))
                      (begin
                        (let ((len (+ (- right l) 1)))
                          (if (or (= (car best) 0) (< len (car best)))
                              (set-car! best len)
                              0))
                        (loop l (- s (car (list-ref nums l)))))
                      (iter-loop l right s n))))))
        (define (iter-loop left right curr-sum n)
          (iter left (+ right 1) curr-sum n))
        (iter 0 0 0 (length nums)))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (solve nums target)
  (min-size-subarray nums target))

(display "CASE0=") (display (solve '(2 3 1 2 4 3) 7)) (newline)
(display "CASE1=") (display (solve '(1 4 4) 4)) (newline)
(display "CASE2=") (display (solve '(1 1 1 1 1) 11)) (newline)
(display "CASE3=") (display (solve '(5 1 3 5 10 7 4 9 2 8) 15)) (newline)
(display "CASE4=") (display (solve '() 5)) (newline)
(display "CASE5=") (display (solve '(7) 7)) (newline)
(display "CASE6=") (display (solve '(3) 10)) (newline)
(display "CASE7=") (display (solve '(1 2 3) 0)) (newline)
(display "CASE8=") (display (solve '(1 2 3 4 5) 11)) (newline)
(display "CASE9=") (display (solve '(3 3 3 3 3) 9)) (newline)
(display "CASE10=") (display (solve '(1 1 1) 1)) (newline)
