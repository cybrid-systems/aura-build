; soft_leetcode_runtime slug=longest-repeating-character-substitution path=promote_soft_full
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; baseline_file=solution.aura hits=8/8
; Soft oneshot already full; materialize via Soft current-source. No LLM.
(begin
  (define char->int
    (lambda (c)
      (-
        (char->integer c) (char->integer 65))))
  (define solve
    (lambda (s k)
      (let ((n (string-length s)))
        (let ((freq (make-vector
            26 0)))
          (let ((left 0))
            (let ((max-freq 0))
              (let ((best 0))
                (letrec ((loop (lambda (right)
                    (if (>=
                        right n)
                      best
                      (begin
                        (let ((idx (char->int (string-ref
                              s right))))
                          (begin
                            (vector-set!
                              freq idx (+
                                (vector-ref
                                  freq idx) 1))
                            (when
                              (>
                                (vector-ref
                                  freq idx) max-freq) (set! max-freq (vector-ref
                                  freq idx)))))
                        (when
                          (>
                            (-
                              (-
                                right left) -1 max-freq) k) (begin
                            (let ((lidx (char->int (string-ref
                                  s left))))
                              (vector-set!
                                freq lidx (-
                                  (vector-ref
                                    freq lidx) 1)))
                            (set! left (+
                                left 1))))
                        (let ((cur-len (-
                            (+
                              right 1) left)))
                          (when
                            (>
                              cur-len best) (set! best cur-len)))
                        (loop (+
                            right 1)))))))
                  (loop 0)))))))))
  (define display-solve
    (lambda (i s k)
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display (solve
            s k))
        (newline))))
  (display-solve
    0 "ABAB" 2)
  (display-solve
    1 "AABABBA" 1)
  (display-solve
    2 "AAAA" 0)
  (display-solve
    3 "ABCDE" 0)
  (display-solve
    4 "ABCDE" 2)
  (display-solve
    5 "A" 0)
  (display-solve
    6 "ABBB" 0)
  (display-solve
    7 "ABBB" 1))
