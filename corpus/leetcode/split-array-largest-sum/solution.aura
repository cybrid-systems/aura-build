(define (max-num xs)
  (if (null? (cdr xs))
      (car xs)
      (let ((m (max-num (cdr xs))))
        (if (> (car xs) m) (car xs) m))))

(define (sum-list xs)
  (if (null? xs)
      0
      (+ (car xs) (sum-list (cdr xs)))))

(define (can-split nums m max-sum)
  (let loop ((rest nums) (count 1) (current 0))
    (cond
      ((null? rest)
       (<= count m))
      (else
       (let ((next (+ current (car rest))))
         (if (> next max-sum)
             (if (< count m)
                 (loop (cdr rest) (+ count 1) (car rest))
                 #f)
             (loop (cdr rest) count next)))))))

(define (solve nums m)
  (let ((lo (max-num nums))
        (hi (sum-list nums)))
    (let search ((low lo) (high high))
      (if (<= (- high low) 1)
          low
          (let ((mid (quotient (+ low high 1) 2)))
            (if (can-split nums m mid)
                (search low mid)
                (search (+ mid 1) high)))))))

(define (run-case i nums m)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums m))
  (newline))

(let ((case0 '(7 2 5 10 8)))
  (let ((case1 '(1 2 3 4 5)))
    (let ((case2 '(1 4 4)))
      (let ((case3 '(1 4 4)))
        (let ((case4 '(10 5 2 7 8 4 3 6)))
          (let ((case5 '(5 1 4 5 1)))
            (let ((case6 '(1)))
              (let ((case7 '(2 3 1 2 4 3 2 1 1)))
                (run-case 0 case0 2)
                (run-case 1 case1 2)
                (run-case 2 case2 3)
                (run-case 3 case3 1)
                (run-case 4 case4 4)
                (run-case 5 case5 2)
                (run-case 6 case6 1)
                (run-case 7 case7 3))))))))))
