;; Two Sum II - Input Array Is Sorted
;; Two-pointer O(n) solution on sorted array, returns 1-indexed positions.

(define (list-ref lst n)
  (if (= n 0)
      (car lst)
      (list-ref (cdr lst) (- n 1))))

(define (list-length lst)
  (if (null? lst)
      0
      (+ 1 (list-length (cdr lst)))))

;; solve: takes a numbers list and target, returns list [i j] (1-indexed)
(define (solve numbers target)
  (let ((n (list-length numbers)))
    (solve-helper numbers target 0 (- n 1))))

(define (solve-helper numbers target left right)
  (let ((lv (list-ref numbers left))
        (rv (list-ref numbers right)))
    (let ((sum (+ lv rv)))
      (cond
        ((= sum target) (list (+ left 1) (+ right 1)))
        ((< sum target) (solve-helper numbers target (+ left 1) right))
        (else (solve-helper numbers target left (- right 1)))))))

;; Helper to print a list of two integers as [a,b]
(define (print-pair p)
  (display "[")
  (display (car p))
  (display ",")
  (display (car (cdr p)))
  (display "]"))

;; --- Test cases ---
(define (run-case i numbers target)
  (display "CASE")
  (display i)
  (display "=")
  (print-pair (solve numbers target))
  (newline))

(run-case 0 (list 2 7 11 15) 9)
(run-case 1 (list 2 3 4) 6)
(run-case 2 (list -1 0) -1)
(run-case 3 (list 1 2 3 4 5 6 7 8 9) 17)
(run-case 4 (list -5 -3 -1 2 4 6) 1)
(run-case 5 (list 0 0 1 2 3) 0)
(run-case 6 (list 1 3 4 5 7 11) 9)
(run-case 7 (list -100 -50 -10 10 50 100) 0)
