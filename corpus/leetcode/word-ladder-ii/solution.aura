;; Word Ladder II - BFS + DFS backtracking
;; Returns all shortest transformation sequences

(define (make-set xs)
  (let loop ((xs xs) (acc '()))
    (if (null? xs) acc
        (let ((x (car xs)) (rest (cdr xs)))
          (if (member x acc) (loop rest acc)
              (loop rest (cons x acc)))))))

(define (list-ref-safe lst i)
  (if (= i 0) (car lst)
      (list-ref-safe (cdr lst) (- i 1))))

(define (list-length- lst)
  (let loop ((l lst) (n 0))
    (if (null? l) n (loop (cdr l) (+ n 1)))))

(define (list-set lst i v)
  (if (= i 0) (cons v (cdr lst))
      (cons (car lst) (list-set (cdr lst) (- i 1) v))))

;; Check if two words differ by exactly one character
(define (one-apart? a b)
  (let ((len-a (string-length a))
        (len-b (string-length b)))
    (if (not (= len-a len-b)) #f
        (let loop ((i 0) (diff 0))
          (cond ((>= i len-a) (= diff 1))
                ((>= diff 2) #f)
                (else
                 (let ((ca (string-ref a i))
                       (cb (string-ref b i)))
                   (loop (+ i 1)
                         (if (char=? ca cb) diff (+ diff 1))))))))))

;; Generate all 1-letter variations of a word
(define (generate-variations word)
  (let ((len (string-length word)))
    (let loop ((i 0) (acc '()))
      (if (>= i len) acc
          (let loop2 ((c 0) (chars '()))
            (cond ((= c 26) (loop (+ i 1) acc))
                  ((and (= c (- (char->integer (string-ref word i)) 97))
                        (= i 0))
                   (loop2 (+ c 1) chars))
                  (else
                   (let ((new-char (integer->char (+ c 97)))
                         (new-word (list->string
                                    (list-set
                                     (let ((l '()))
                                       (let loop3 ((j 0) (r '()))
                                         (if (>= j len) (reverse r)
                                             (loop3 (+ j 1) (cons (string-ref word j) r)))))
                                     i
                                     (string new-char)))))
                     (loop2 (+ c 1) chars)))))))))

;; Actually, let me rewrite generate-variations more clearly
(define (string-to-chars s)
  (let ((len (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (>= i len) (reverse acc)
          (loop (+ i 1) (cons (string-ref s i) acc))))))

(define (chars-to-string cs)
  (list->string (reverse cs)))

(define (replace-char lst i c)
  (let loop ((idx 0) (l lst) (acc '()))
    (cond ((null? l) (reverse acc))
          ((= idx i) (loop (+ idx 1) (cdr l) (cons c acc)))
          (else (loop (+ idx 1) (cdr l) (cons (car l) acc))))))

(define (generate-variations word)
  (let ((chars (string-to-chars word))
        (len (string-length word)))
    (let outer ((i 0) (acc '()))
      (if (>= i len) acc
          (let ((orig (list-ref chars i)))
            (let inner ((c 0) (res '()))
              (if (>= c 26) (outer (+ i 1) (append acc res))
                  (if (= c (- (char->integer orig) 97))
                      (inner (+ c 1) res)
                      (let ((new-chars (replace-char chars i (integer->char (+ c 97))))
                            (new-word (chars-to-string (replace-char chars i (integer->char (+ c 97))))))
                        (inner (+ c 1) (cons new-word res)))))))))))

(define (append a b)
  (if (null? a) b (cons (car a) (append (cdr a) b))))

;; Build adjacency: for each word, find neighbors
(define (build-adjacency words)
  (let loop ((ws words) (acc '()))
    (if (null? ws) acc
        (let ((w (car ws)))
          (loop (cdr ws) (cons (cons w (neighbors w words)) acc))))))

(define (neighbors word words)
  (let loop ((ws words) (acc '()))
    (if (null? ws) acc
        (let ((w (car ws)))
          (if (and (not (equal? w word)) (one-apart? w word))
              (loop (cdr ws) (cons w acc))
              (loop (cdr ws) acc))))))

;; BFS to find distances
(define (bfs-distances beginWord word-set)
  (let loop ((queue (list (list beginWord 0)))
             (visited '((,(string->symbol beginWord) . 0)))
             (queue-tail '())
             (result '()))
    (if (null? queue) (cons visited result)
        (let ((item (car queue))
              (rest-q (cdr queue)))
          (let ((word (car item))
                (dist (car (cdr item))))
            (if (member (cons (string->symbol word) dist) visited)
                (loop rest-q visited queue-tail result)
                (loop rest-q (cons (cons (string->symbol word) dist) visited) queue-tail result)))))))

;; Simpler approach using alist
(define (make-alist key val alist)
  (cons (cons key val) alist))

(define (alist-ref key alist)
  (cond ((null? alist) #f)
        ((equal? key (car (car alist))) (cdr (car alist)))
        (else (alist-ref key (cdr alist)))))

(define (alist-set key val alist)
  (cond ((null? alist) (cons (cons key val) alist))
        ((equal? key (car (car alist))) (cons (cons key val) (cdr alist)))
        (else (cons (car alist) (alist-set key val (cdr alist)))))))

;; BFS to get minimum distance from beginWord to each word
(define (bfs beginWord words)
  (let ((word-set (cons beginWord words)))
    (let loop ((queue (list (cons beginWord 1)))
               (distances (list (cons beginWord 1)))
               (queue-end '()))
      (if (null? queue) distances
          (let ((front (car queue))
                (rest-q (cdr queue)))
            (let ((word (car front))
                  (dist (cdr front)))
              (let ((neighs (neighbors word word-set)))
                (let loop2 ((ns neighs) (new-q rest-q) (new-dist distances))
                  (if (null? ns) (loop new-q new-dist queue-end)
                      (let ((n (car ns)))
                        (if (alist-ref n new-dist)
                            (loop2 (cdr ns) new-q new-dist)
                            (loop2 (cdr ns)
                                   (append new-q (list (cons n (+ dist 1))))
                                   (alist-set n (+ dist 1) new-dist)))))))))))))

;; DFS backtrack from endWord to beginWord using distance info
(define (dfs-from-end endWord beginWord distances current path results)
  (let ((cur-dist (alist-ref current distances)))
    (cond ((not cur-dist) results)
          ((equal? current beginWord)
           (cons (cons (cons beginWord (reverse (cons current '()))) '()) results))
          (else
           (let loop ((ns (neighbors current (alist-keys distances)))
                      (acc results))
             (if (null? ns) acc
                 (let ((n (car ns)))
                   (let ((n-dist (alist-ref n distances)))
                     (if (and n-dist (= n-dist (- cur-dist 1)))
                         (loop (cdr ns)
                               (dfs-from-end endWord beginWord distances n (cons current path) acc))
                         (loop (cdr ns) acc))))))))))

(define (alist-keys alist)
  (let loop ((a alist) (acc '()))
    (if (null? a) acc
        (loop (cdr a) (cons (car (car a)) acc)))))

(define (reverse lst)
  (let loop ((l lst) (acc '()))
    (if (null? l) acc (loop (cdr l) (cons (car l) acc)))))

;; Main solve
(define (solve beginWord endWord wordList)
  (let ((word-set (cons beginWord wordList)))
    (if (not (member endWord wordList)) '()
        (let ((distances (bfs beginWord wordList)))
          (let ((end-dist (alist-ref endWord distances)))
            (if (not end-dist) '()
                (let ((results (dfs-from-end endWord beginWord distances endWord '() '())))
                  (let ((path-lists
                         (let loop ((rs results) (acc '()))
                           (if (null? rs) (reverse acc)
                               (loop (cdr rs) (cons (reverse (cons endWord '())) acc))))))
                    path-lists))))))))

;; DFS backtrack - correct version
(define (solve beginWord endWord wordList)
  (let ((word-set (cons beginWord wordList)))
    (if (not (member endWord wordList)) '()
        (let ((distances (bfs beginWord wordList)))
          (let ((end-dist (alist-ref endWord distances)))
            (if (not end-dist) '()
                (let loop-dfs ((current endWord)
                               (path (list endWord))
                               (acc '()))
                  (if (equal? current beginWord)
                      (cons (reverse path) acc)
                      (let ((cur-dist (alist-ref current distances)))
                        (let ((neighs (neighbors current word-set)))
                          (let loop-n ((ns neighs) (new-acc acc))
                            (if (null? ns) new-acc
                                (let ((n (car ns)))
                                  (let ((n-dist (alist-ref n distances)))
                                    (if (and n-dist (= n-dist (- cur-dist 1)))
                                        (loop-n (cdr ns) (loop-dfs n (cons n path) new-acc))
                                        (loop-n (cdr ns) new-acc))))))))))))))))

;; Output helpers
(define (display-list-of-lists lst)
  (display "[")
  (let loop ((l lst) (first #t))
    (cond ((null? l) (display "]"))
          (else
           (if first (display "") (display ","))
           (display "[")
           (let loop2 ((items (car l)) (f2 #t))
             (cond ((null? items) (display "]"))
                   (else
                    (if f2 (display "") (display ","))
                    (display "\"")
                    (display (car items))
                    (display "\"")
                    (loop2 (cdr items) #f)))))
           (loop (cdr l) #f)))))

(define (display-result r)
  (if (null? r) (display "[]")
      (display-list-of-lists r)))

;; Test cases
(define CASE0_BEGIN "hit")
(define CASE0_END "cog")
(define CASE0_LIST '("hot" "dot" "dog" "lot" "log" "cog"))

(define CASE1_BEGIN "hit")
(define CASE1_END "cog")
(define CASE1_LIST '("hot" "dot" "dog" "lot" "log"))

(define CASE2_BEGIN "a")
(define CASE2_END "c")
(define CASE2_LIST '("a" "b" "c"))

(define CASE3_BEGIN "hot")
(define CASE3_END "dog")
(define CASE3_LIST '("hot" "dog"))

(define CASE4_BEGIN "ab")
(define CASE4_END "cd")
(define CASE4_LIST '("ab" "cb" "cd"))

(define CASE5_BEGIN "red")
(define CASE5_END "tax")
(define CASE5_LIST '("ted" "tex" "red" "tax" "tad" "den" "rex" "pee"))

(display "CASE0=") (display-result (solve CASE0_BEGIN CASE0_END CASE0_LIST)) (newline)
(display "CASE1=") (display-result (solve CASE1_BEGIN CASE1_END CASE1_LIST)) (newline)
(display "CASE2=") (display-result (solve CASE2_BEGIN CASE2_END CASE2_LIST)) (newline)
(display "CASE3=") (display-result (solve CASE3_BEGIN CASE3_END CASE3_LIST)) (newline)
(display "CASE4=") (display-result (solve CASE4_BEGIN CASE4_END CASE4_LIST)) (newline)
(display "CASE5=") (display-result (solve CASE5_BEGIN CASE5_END CASE5_LIST)) (newline)
