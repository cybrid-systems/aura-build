(define (list-length lst)
  (if (null? lst) 0 (+ 1 (list-length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (max a b)
  (if (> a b) a b))

(define (max-profit-in-list lst)
  (define (helper l best)
    (if (null? l) best
        (helper (cdr l) (max best (car l)))))
  (helper lst (car lst)))

(define (solve w k capital profits)
  ;; Greedy: at each step, pick the highest profit project among those affordable.
  ;; Implemented via repeated scans over remaining projects (small inputs).
  (let ((current w)
        (selected 0)
        (done #f))
    (letrec ((loop (lambda ()
                     (cond
                       ((or (= selected k) done) current)
                       (else
                        ;; find indices i where capital[i] <= current and not used
                        ;; build list of available profits
                        (letrec (
                          (collect-available
                            (lambda (i cap-lst prof-lst acc)
                              (if (null? cap-lst) acc
                                  (if (<= (car cap-lst) current)
                                      (collect-available (+ i 1) (cdr cap-lst) (cdr prof-lst)
                                                         (cons (car prof-lst) acc))
                                      (collect-available (+ i 1) (cdr cap-lst) (cdr prof-lst) acc))))))
                          (let ((avail (collect-available 0 capital profits '())))
                            (if (null? avail)
                                (set! done #t)
                                (let ((best (max-profit-in-list avail)))
                                  (set! current (+ current best))
                                  (set! selected (+ selected 1))))))
                        (loop))))))
      (loop))))

;; Embedded test inputs
(define cases
  (list
    (list 0 1 '(0) '(1))
    (list 1 2 '(0 1 1) '(1 2 3))
    (list 1 3 '(0 1 2) '(1 2 3))
    (list 0 0 '(1 2 3) '(10 20 30))
    (list 10 2 '(0 5 10) '(100 100 100))
    (list 5 5 '(3 3 3 3 3) '(1 2 3 4 5))
    (list 1 1 '(2) '(5))
    (list 1 10 '(0 1) '(1 100))))

(define (run-case idx case)
  (let ((w (list-ref case 0))
        (k (list-ref case 1))
        (cap (list-ref case 2))
        (pr  (list-ref case 3)))
    (let ((r (solve w k cap pr)))
      (display "CASE")
      (display idx)
      (display "=")
      (display r)
      (newline))))

(define (run-all cs i)
  (if (null? cs) 'done
      (begin
        (run-case i (car cs))
        (run-all (cdr cs) (+ i 1)))))

(run-all cases 0)
