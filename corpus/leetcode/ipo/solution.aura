(define (parse-int s)
  (let loop ((i 0) (acc 0) (neg #f))
    (cond
        ((>= i (string-length s)) acc)
        ((char=? (string-ref s i) #\-) (loop (+ i 1) acc #t))
        (#t
         (let ((d (- (char->integer (string-ref s i)) (char->integer #\0))))
           (loop (+ i 1) (+ (* acc 10) d) neg))))))

(define (skip-ws s i)
  (cond ((>= i (string-length s)) i)
        ((or (char=? (string-ref s i) #\space)
             (char=? (string-ref s i) #\,))
         (skip-ws s (+ i 1)))
        (#t i)))

(define (parse-list-helper s i acc)
  (let ((j (skip-ws s i)))
    (cond ((>= j (string-length s)) (reverse acc))
          ((char=? (string-ref s j) #\]) (reverse acc))
          (else
           (let loop ((k j) (neg #f) (num 0))
             (cond ((>= k (string-length s)) (cons num acc))
                   ((char=? (string-ref s k) #\-)
                    (loop (+ k 1) #t 0))
                   ((char=? (string-ref s k) #\,)
                    (let ((v (if neg (- 0 num) num)))
                      (parse-list-helper s (+ k 1) (cons v acc))))
                   ((char=? (string-ref s k) #\])
                    (let ((v (if neg (- 0 num) num)))
                      (reverse (cons v acc))))
                   (#t
                    (let ((d (- (char->integer (string-ref s k)) (char->integer #\0))))
                      (loop (+ k 1) neg (+ (* num 10) d))))))))))

(define (parse-list s)
  (parse-list-helper s 0 '()))

(define (get-val s key)
  (let ((klen (string-length key)))
    (let loop ((i 0))
      (cond ((>= i (string-length s)) "")
            ((and (<= (+ i klen) (string-length s))
                  (string=? (substring s i (+ i klen)) key))
             (substring s (+ i klen) (string-length s)))
            (#t (loop (+ i 1)))))))

(define (trim s)
  (let ((n (string-length s)))
    (let loop ((start 0))
      (cond ((>= start n) "")
            ((or (char=? (string-ref s start) #\space)
                 (char=? (string-ref s start) #\newline)
                 (char=? (string-ref s start) #\tab))
             (loop (+ start 1)))
            (#t
             (let loop2 ((end n))
               (cond ((<= end start)
                      (substring s start (+ start 1)))
                     ((or (char=? (string-ref s (- end 1)) #\space)
                          (char=? (string-ref s (- end 1)) #\newline)
                          (char=? (string-ref s (- end 1)) #\tab))
                    (loop2 (- end 1)))
                    (#t (substring s start end))))))))))

(define (parse-input input key list?)
  (let ((raw (trim (get-val input key))))
    (if list? (parse-list raw) (parse-int raw))))

(define (display-list xs)
  (display "[")
  (let loop ((rest xs) (first #t))
    (cond ((null? rest) (display "]"))
          (else
           (if first (display (car rest)) (begin (display ",") (display (car rest))))
           (loop (cdr rest) #f)))))

(define (max-heap-insert h x)
  (cons x h))

(define (max-heap-extract-max h)
  (let loop ((rest h) (max-val -999999999) (max-rest '()))
    (cond ((null? rest)
           (values max-val (append (reverse max-rest) (cdr rest))))
          (else
           (let ((v (car rest)))
             (if (> v max-val)
                 (loop (cdr rest) v (cons '() max-rest))
                 (loop (cdr rest) max-val (cons v max-rest))))))))

(define (max-heap-extract-max-2 h)
  (let loop ((rest h) (max-val -999999999) (max-found #f) (acc '()))
    (cond ((null? rest)
           (values max-val (reverse acc)))
          (else
           (let ((v (car rest)))
             (if (and (not max-found) (>= v max-val))
                 (begin
                  (set! max-val v)
                  (set! max-found #t)
                  (loop (cdr rest) max-val max-found acc))
                 (loop (cdr rest) max-val max-found (cons v acc))))))))

(define (solve w k capital profits)
  (let loop ((w w) (k k) (cap capital) (prof profits) (heap '()))
    (cond ((= k 0) w)
          ((null? cap)
           (if (null? heap)
               w
               (let ((v 0) (rest '()))
                 (let-values (((val r) (max-heap-extract-max-2 heap)))
                   (set! v val)
                   (set! rest r))
                 (loop (+ w v) (- k 1) '() '() rest))))
          (else
           (let ((c (car cap)) (p (car prof)) (rest-cap (cdr cap)) (rest-prof (cdr prof)))
             (if (<= c w)
                 (loop w k rest-cap rest-prof (max-heap-insert heap p))
                 (begin
                  (if (null? heap)
                      w
                      (let ((v 0) (new-heap '()))
                        (let-values (((val r) (max-heap-extract-max-2 heap)))
                          (set! v val)
                          (set! new-heap r))
                        (if (= val -999999999)
                            w
                            (loop (+ w v) (- k 1) cap prof new-heap)))))))))))

(define (run-case i input)
  (let ((w (parse-input input "w=" #f))
        (k (parse-input input "k=" #f))
        (capital (parse-input input "capital=" #t))
        (profits (parse-input input "profits=" #t)))
    (let ((result (solve w k capital profits)))
      (display (string-append "CASE" (number->string i) "="))
      (display result)
      (newline))))

(run-case 0 "w=0 k=1 capital=[0] profits=[1]")
(run-case 1 "w=1 k=2 capital=[0,1,1] profits=[1,2,3]")
(run-case 2 "w=1 k=3 capital=[0,1,2] profits=[1,2,3]")
(run-case 3 "w=0 k=0 capital=[1,2,3] profits=[10,20,30]")
(run-case 4 "w=10 k=2 capital=[0,5,10] profits=[100,100,100]")
(run-case 5 "w=5 k=5 capital=[3,3,3,3,3] profits=[1,2,3,4,5]")
(run-case 6 "w=1 k=1 capital=[2] profits=[5]")
(run-case 7 "w=1 k=10 capital=[0,1] profits=[1,100]")
