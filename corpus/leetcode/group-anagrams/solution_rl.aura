(require "lc_json" all:)
(require "compat" all:)
(define (sort-str s)
  ;; Convert string to list of chars, sort, convert back.
  ;; Since aura has lists as primary, represent a string as a list of char-codes (numbers).
  ;; We'll use this function only for sorting char-codes.
  (define (insert x lst)
    (cond ((null? lst) (list x))
          ((<= x (car lst)) (cons x lst))
          (else (cons (car lst) (insert x (cdr lst))))))
  (define (isort lst)
    (if (null? lst) '()
        (insert (car lst) (isort (cdr lst)))))
  (isort s))
(define (string->chars s)
  ;; Convert a string "abc" into list of char codes (97 98 99).
  ;; We don't have a built-in, but we can build a mapping from characters.
  ;; Since we only get lowercase, we can map each char to its code.
  (define (char-code c)
    (cond ((char=? c #\a) 97)
          ((char=? c #\b) 98)
          ((char=? c #\c) 99)
          ((char=? c #\d) 100)
          ((char=? c #\e) 101)
          ((char=? c #\f) 102)
          ((char=? c #\g) 103)
          ((char=? c #\h) 104)
          ((char=? c #\i) 105)
          ((char=? c #\j) 106)
          ((char=? c #\k) 107)
          ((char=? c #\l) 108)
          ((char=? c #\m) 109)
          ((char=? c #\n) 110)
          ((char=? c #\o) 111)
          ((char=? c #\p) 112)
          ((char=? c #\q) 113)
          ((char=? c #\r) 114)
          ((char=? c #\s) 115)
          ((char=? c #\t) 116)
          ((char=? c #\u) 117)
          ((char=? c #\v) 118)
          ((char=? c #\w) 119)
          ((char=? c #\x) 120)
          ((char=? c #\y) 121)
          ((char=? c #\z) 122)
          (else 0)))
  (if (string=? s "")
      '()
      (map char-code (string->list s))))
(define (group-by-key lst)
  ;; Given a list of (key . value) pairs, group values by equal keys.
  ;; Returns a list of lists of values.
  (define (collect key pairs)
    (cond ((null? pairs) '())
          ((equal? (car (car pairs)) key)
           (cons (cdr (car pairs)) (collect key (cdr pairs))))
          (else (collect key (cdr pairs)))))
  (define (unique-keys pairs)
    (cond ((null? pairs) '())
          ((member? (car (car pairs)) (unique-keys (cdr pairs)))
           (unique-keys (cdr pairs)))
          (else (cons (car (car pairs)) (unique-keys (cdr pairs))))))
  (define (member? x lst)
    (cond ((null? lst) #f)
          ((equal? x (car lst)) #t)
          (else (member? x (cdr lst)))))
  (define (build-keys keys pairs)
    (if (null? keys) '()
        (cons (collect (car keys) pairs)
              (build-keys (cdr keys) pairs))))
  (build-keys (unique-keys lst) lst))
(define (solve strings)
  ;; For each string, compute its sorted char-code list as key.
  ;; Group by key.
  (define (with-keys strs)
    (if (null? strs) '()
        (let ((s (car strs)))
          (cons (cons (sort-str (string->chars s)) s)
                (with-keys (cdr strs))))))
  (group-by-key (with-keys strings)))
(define (display-list lst)
  (display "(")
  (cond ((null? lst) (display ")"))
        (else (display (car lst))
              (let loop ((rest (cdr lst)))
                (cond ((null? rest) (display ")"))
                      (else (display " ")
                            (display (car rest))
                            (loop (cdr rest))))))))
(define CASE0 '("eat" "tea" "tan" "ate" "nat" "bat"))
(define CASE1 '())
(define CASE2 '(""))
(define CASE3 '("" ""))
(define CASE4 '("abc" "bca" "cab" "xyz" "zyx" "yxz"))
(define CASE5 '("a"))
(define CASE6 '("listen" "silent" "enlist" "hello" "olleh"))
(define CASE7 '("ab" "ba" "cd" "dc" "ef"))
(define (run-case n input)
  (display "CASE")
  (display n)
  (display "=")
  (display-list (solve input))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "strings")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/group-anagrams/tests.json")))
