(define (solve x n)
  (cond
    ((= n 0) 1.0)
    ((< n 0)
     (cond
       ((= x 0.0) +inf.0)
       (else (/ 1.0 (pow-helper x (- n))))))
    (else (pow-helper x n))))

(define (pow-helper x n)
  (cond
    ((= n 0) 1.0)
    ((= n 1) x)
    (else
     (let ((half (pow-helper x (quotient n 2))))
       (cond
         ((= (modulo n 2) 0) (* half half))
         (else (* x (* half half))))))))

(define (run-case i x n)
  (let ((r (solve x n)))
    (display "CASE")
    (display i)
    (display "=")
    (display r)
    (newline)))

(run-case 0 2.0 10)
(run-case 1 2.1 3)
(run-case 2 2.0 -2)
(run-case 3 1.0 0)
(run-case 4 0.0 0)
(run-case 5 0.0 5)
(run-case 6 -2.0 3)
(run-case 7 -2.0 4)
(run-case 8 2.0 -2147483648)
(run-case 9 1.5 20)
(run-case 10 0.5 -3)
(run-case 11 1.0 2147483647)
