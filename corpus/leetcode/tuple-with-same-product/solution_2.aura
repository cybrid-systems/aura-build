(define (solve nums)
  (let* ((n (length nums))
         (counts '())
         (i 0))
    (define (lookup key alist)
      (cond ((null? alist) #f)
            ((equal? (car (car alist)) key) (cdr (car alist)))
            (else (lookup key (cdr alist)))))
    (define (add-count alist key)
      (let ((existing (lookup key alist)))
        (if existing
            (map (lambda (p) (if (equal? (car p) key) (cons key (+ (cdr p) 1)) p)) alist)
            (cons (cons key 1) alist))))
    (let loop ((i 0) (counts '()))
      (if (>= i n)
          (begin
            (define (sum-contribution alist)
              (if (null? alist)
                  0
                  (let ((k (cdr (car alist))))
                    (+ (* k (- k 1) 8) (sum-contribution (cdr alist))))))
            (sum-contribution counts))
          (let loop2 ((j (+ i 1)) (counts counts))
            (if (>= j n)
                (loop (+ i 1) counts)
                (loop2 (+ j 1) (add-count counts (* (list-ref nums i) (list-ref nums j))))))))))
