;; Power of Two - determine if n is a power of two
;; A positive power of two has exactly one bit set.
;; Check: n > 0 and (n & (n - 1)) == 0

(define (power-of-two? n)
  (and (> n 0)
       (= (bitwise-and n (- n 1)) 0)))

(define (solve n)
  (if (power-of-two? n) #t #f))

(define (display-boolean b)
  (if b (display "true") (display "false")))

;; Bitwise AND helper (since Aura may not have it built-in)
;; Implement via recursion for non-negative integers
(define (bitwise-and a b)
  (cond ((= a 0) 0)
        ((= b 0) 0)
        ((and (even? a) (even? b)) (* 2 (bitwise-and (quotient a 2) (quotient b 2))))
        ((and (even? a) (odd? b))  (* 2 (bitwise-and (quotient a 2) (quotient (- b 1) 2))))
        ((and (odd? a) (even? b))  (* 2 (bitwise-and (quotient (- a 1) 2) (quotient b 2))))
        (else (+ 1 (* 2 (bitwise-and (quotient (- a 1) 2) (quotient (- b 1) 2)))))))

(define (even? x) (= (modulo x 2) 0))
(define (odd? x)  (not (even? x)))

;; Test cases
(define tests (list 1 16 3 -4 1024 2 -1 1))

(define (run-tests lst i)
  (if (null? lst)
      'done
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display-boolean (solve (car lst)))
        (newline)
        (run-tests (cdr lst) (+ i 1)))))

(run-tests tests 0)
