(require "lc_json" all:)
(require "compat" all:)
(define (make-list n fill)
  (if (= n 0) '()
      (cons fill (make-list (- n 1) fill))))
(define (list-set lst i v)
  (if (= i 0)
      (cons v (cdr lst))
      (cons (car lst) (list-set (cdr lst) (- i 1) v))))
(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))
(define (solve n times k)
  (let* ((dist (make-list n 999999))
         (n+1 (+ n 1)))
    (set! dist (list-set dist (- k 1) 0))
    (let loop ((i 0) (changed #f))
      (if (>= i (length times))
          (if changed (loop 0 #f) 'done)
          (let* ((e (list-ref times i))
                 (u (- (car e) 1))
                 (v (- (car (cdr e)) 1))
                 (w (car (cdr (cdr e))))
                 (du (list-ref dist u))
                 (dv (list-ref dist v)))
            (if (< (+ du w) dv)
                (begin
                  (set! dist (list-set dist v (+ du w)))
                  (loop (+ i 1) #t))
                (loop (+ i 1) changed))))))
    (let ((mx 0))
      (let loop2 ((i 0))
        (if (>= i n)
            'done
            (if (and (not (= i (- k 1)))
                     (> (list-ref dist i) mx))
                (begin
                  (set! mx (list-ref dist i))
                  (loop2 (+ i 1)))
                (loop2 (+ i 1))))))
      (if (= mx 999999) -1 mx))
(define (display-list lst)
  (display "[")
  (let loop ((rest lst) (first #t))
    (cond ((null? rest) (display "]"))
          (else
           (if first (begin (display (car rest)) (set! first #f))
               (begin (display ",") (display (car rest))))
           (loop (cdr rest) first)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n") (hash-ref input "times") (hash-ref input "k")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/network-delay-time/tests.json")))
