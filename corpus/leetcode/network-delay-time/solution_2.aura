(define (solve n times k)
  ;; Build adjacency list as a list of (node . neighbors) where neighbors is list of (dest . weight)
  ;; We'll represent adjacency using vector-like approach with association list.
  ;; First, create n empty neighbor lists.
  (define (make-empty-list n)
    (if (= n 0)
        '()
        (cons '() (make-empty-list (- n 1)))))
  (define adj (make-empty-list n))

  ;; Helper: add edge (u v w) to adj (1-indexed: index u-1)
  (define (add-edge u v w adj)
    (define idx (- u 1))
    (define (update lst i)
      (if (= i 0)
          (cons (cons v w) (car lst))
          (cons (car lst) (update (cdr lst) (- i 1)))))
    (define (rebuild lst i new-pair)
      (if (null? lst)
          '()
          (cons (if (= i 0) new-pair (car lst))
                (rebuild (cdr lst) (- i 1) new-pair))))
    ;; Simpler: rebuild adj with updated entry at idx
    (define (rebuild-adj lst i new-entry)
      (if (null? lst)
          '()
          (cons (if (= i 0) new-entry (car lst))
                (rebuild-adj (cdr lst) (- i 1) new-entry))))
    (define old-entry (list-ref adj idx))
    (define new-entry (cons (cons v w) old-entry))
    (rebuild-adj adj idx new-entry))

  ;; list-ref helper
  (define (list-ref lst i)
    (if (= i 0)
        (car lst)
        (list-ref (cdr lst) (- i 1))))

  ;; Process edges
  (define (process-edges edges adj)
    (if (null? edges)
        adj
        (let ((e (car edges)))
          (define u (car e))
          (define v (cadr e))
          (define w (caddr e))
          (process-edges (cdr edges) (add-edge u v w adj)))))

  (define adj-final (process-edges times adj))

  ;; Dijkstra: dist list with n entries, initially infinity except dist[k-1] = 0
  (define INF 1000000000)
  (define (make-dist n k)
    (define (helper i)
      (if (= i n)
          '()
          (cons (if (= i (- k 1)) 0 INF) (helper (+ i 1)))))
    (helper 0))

  (define dist (make-dist n k))

  ;; Priority queue as list of (dist . node), sorted ascending
  ;; We use a simple linear-scan min extraction.
  (define (make-pq)
    '())
  (define (pq-push pq d node)
    ;; Insert maintaining sorted order
    (if (null? pq)
        (cons (cons d node) '())
        (if (< d (caar pq))
            (cons (cons d node) pq)
            (cons (car pq) (pq-push (cdr pq) d node)))))
  (define (pq-pop pq)
    (if (null? pq)
        (cons INF '())
        (cons (cdar pq) (cdr pq))))
  (define (pq-empty? pq)
    (null? pq))

  ;; Initialize pq with (0 . k)
  (define pq (pq-push (make-pq) 0 k))

  ;; Main loop
  (define (loop pq dist)
    (if (pq-empty? pq)
        dist
        (let ((pop (pq-pop pq)))
          (define d (car pop))
          (define u (cdr pop))
          (define rest (cdr pop))
          ;; If d > dist[u-1], skip
          (if (> d (list-ref dist (- u 1)))
              (loop rest dist)
              (let ((neighbors (list-ref adj-final (- u 1))))
                (define (relax nbrs dist pq)
                  (if (null? nbrs)
                      dist
                      (let ((nb (car nbrs)))
                        (define v (car nb))
                        (define w (cdr nb))
                        (define new-d (+ d w))
                        (if (< new-d (list-ref dist (- v 1)))
                            (begin
                              ;; update dist
                              (define (rebuild lst i val)
                                (if (null? lst)
                                    '()
                                    (cons (if (= i 0) val (car lst))
                                          (rebuild (cdr lst) (- i 1) val))))
                              (define new-dist (rebuild dist (- v 1) new-d))
                              (loop (pq-push rest new-d v) new-dist))
                            (relax (cdr nbrs) dist pq)))))
                (relax neighbors dist rest))))))

  (define final-dist (loop pq dist))

  ;; Find max over all i != k, return -1 if any is INF
  (define (find-max lst i max-so-far all-reachable? n k)
    (if (= i n)
        (if all-reachable? max-so-far -1)
        (let ((d (list-ref lst i)))
          (cond ((= i (- k 1)) (find-max lst (+ i 1) max-so-far all-reachable? n k))
                ((= d INF) (find-max lst (+ i 1) max-so-far #f n k))
                ((> d max-so-far) (find-max lst (+ i 1) d all-reachable? n k))
                (else (find-max lst (+ i 1) max-so-far all-reachable? n k))))))

  (find-max final-dist 0 0 #t n k))

;; Display helper for integers
(define (display-int n)
  (display (number->string n)))

;; Main: process each test case
(define (run-case i n times k)
  (display "CASE")
  (display-int i)
  (display "=")
  (display-int (solve n times k))
  (newline))

(run-case 0 3 '((1 1 0) (1 2 1) (2 3 1)) 1)
(run-case 1 2 '((1 2 1)) 2)
(run-case 2 4 '((2 1 1) (2 3 1) (3 4 1)) 2)
(run-case 3 1 '() 1)
(run-case 4 3 '((1 2 2) (1 3 1) (2 3 1)) 1)
(run-case 5 5 '((1 2 5) (1 3 2) (2 4 1) (3 4 1) (4 5 3)) 1)
(run-case 6 4 '((1 2 1) (1 3 1) (2 3 10) (3 4 1) (2 4 100)) 1)
(run-case 7 3 '((1 2 1) (2 1 1) (2 3 1)) 1)
