; soft_leetcode_runtime slug=network-delay-time path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-8 hits=8/8
; baseline_hits=2/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define solve
    (lambda (n times k)
      (begin
        (define make-adj
          (lambda (n)
            (begin
              (define loop
                (lambda (i)
                  (if (=
                      i n)
                    (quote ())
                    (cons
                      (quote ()) (loop (+
                          i 1))))))
              (loop 0))))
        (define list-set
          (lambda (lst i val)
            (if (null? lst)
              (quote ())
              (cons
                (if (=
                    i 0)
                  val
                  (car lst)) (list-set
                  (cdr lst) (-
                    i 1) val)))))
        (define list-ref
          (lambda (lst i)
            (if (=
                i 0)
              (car lst)
              (list-ref
                (cdr lst) (-
                  i 1)))))
        (define add-edge
          (lambda (adj u v w)
            (begin
              (define idx (-
                  u 1))
              (define old (list-ref
                  adj idx))
              (list-set
                adj idx (cons
                  (cons
                    v w) old)))))
        (define build-adj
          (lambda (times adj)
            (if (null? times)
              adj
              (let ((e (car times)))
                (begin
                  (define u (car e))
                  (define v (cadr e))
                  (define w (caddr e))
                  (build-adj
                    (cdr times) (add-edge
                      adj u v w)))))))
        (define adj (build-adj
            times (make-adj n)))
        (define INF 1000000000)
        (define make-dist
          (lambda (n)
            (begin
              (define loop
                (lambda (i)
                  (if (=
                      i n)
                    (quote ())
                    (cons
                      INF (loop (+
                          i 1))))))
              (loop 0))))
        (define dist-set
          (lambda (dist i val)
            (if (null? dist)
              (quote ())
              (cons
                (if (=
                    i 0)
                  val
                  (car dist)) (dist-set
                  (cdr dist) (-
                    i 1) val)))))
        (define dist (dist-set
            (make-dist n) (-
              k 1) 0))
        (define pq-min
          (lambda (pq)
            (if (null? pq)
              (cons
                INF -1)
              (let ((first (car pq)))
                (begin
                  (define best-d (caar pq))
                  (define best-node (cdar pq))
                  (define find-min
                    (lambda (rest d node)
                      (if (null? rest)
                        (cons
                          d node)
                        (let ((cur (car rest)))
                          (begin
                            (define cd (car cur))
                            (define cn (cdr cur))
                            (if (<
                                cd d)
                              (find-min
                                (cdr rest) cd cn)
                              (find-min
                                (cdr rest) d node)))))))
                  (find-min
                    (cdr pq) best-d best-node))))))
        (define pq-remove
          (lambda (pq target)
            (if (null? pq)
              (quote ())
              (if (=
                  (cdar pq) target)
                (cdr pq)
                (cons
                  (car pq) (pq-remove
                    (cdr pq) target))))))
        (define pq-push
          (lambda (pq d node)
            (if (null? pq)
              (cons
                (cons
                  d node) (quote ()))
              (if (<=
                  d (caar pq))
                (cons
                  (cons
                    d node) pq)
                (cons
                  (car pq) (pq-push
                    (cdr pq) d node))))))
        (define pq (list (cons
              0 k)))
        (define dijkstra
          (lambda (pq dist)
            (if (null? pq)
              dist
              (let ((m (pq-min pq)))
                (begin
                  (define d (car m))
                  (define u (cdr m))
                  (if (=
                      u -1)
                    dist
                    (let ((pq2 (pq-remove
                        pq u)))
                      (begin
                        (define cur-dist (list-ref
                            dist (-
                              u 1)))
                        (if (>
                            d cur-dist)
                          (dijkstra
                            pq2 dist)
                          (let ((neighbors (list-ref
                              adj (-
                                u 1))))
                            (begin
                              (define relax
                                (lambda (nbrs pq dist)
                                  (if (null? nbrs)
                                    (dijkstra
                                      pq dist)
                                    (let ((nb (car nbrs)))
                                      (begin
                                        (define v (car nb))
                                        (define w (cdr nb))
                                        (define nd (+
                                            d w))
                                        (define cdist (list-ref
                                            dist (-
                                              v 1)))
                                        (if (<
                                            nd cdist)
                                          (relax
                                            (cdr nbrs) (pq-push
                                              pq nd v) (dist-set
                                              dist (-
                                                v 1) nd))
                                          (relax
                                            (cdr nbrs) pq dist)))))))
                              (relax
                                neighbors pq2 dist))))))))))))
        (define final-dist (dijkstra
            pq dist))
        (define find-max
          (lambda (lst i max-d all-ok)
            (if (null? lst)
              (if all-ok
                max-d
                -1)
              (let ((d (car lst)))
                (if (=
                    d INF)
                  (find-max
                    (cdr lst) (+
                      i 1) max-d #f)
                  (if (and
                      (not (=
                          i (-
                            k 1))) (>
                        d max-d))
                    (find-max
                      (cdr lst) (+
                        i 1) d all-ok)
                    (find-max
                      (cdr lst) (+
                        i 1) max-d all-ok)))))))
        (find-max
          final-dist 0 0 #t))))
  (define display-int
    (lambda (n)
      (display (number->string n))))
  (define run-case
    (lambda (i n times k)
      (begin
        (display "CASE")
        (display-int i)
        (display "=")
        (display-int (solve
            n times k))
        (newline))))
  (run-case
    0 3 (quote ((1
          1 0)
        (1
          2 1) (2
          3 1))) 1)
  (run-case
    1 2 (quote ((1
          2 1))) 2)
  (run-case
    2 4 (quote ((2
          1 1)
        (2
          3 1) (3
          4 1))) 2)
  (run-case
    3 1 (quote ()) 1)
  (run-case
    4 3 (quote ((1
          2 2)
        (1
          3 1) (2
          3 1))) 1)
  (run-case
    5 5 (quote ((1
          2 5)
        (1
          3 2) (2
          4 1) (3
          4 1) (4
          5 3))) 1)
  (run-case
    6 4 (quote ((1
          2 1)
        (1
          3 1) (2
          3 10) (3
          4 1) (2
          4 100))) 1)
  (run-case
    7 3 (quote ((1
          2 1)
        (2
          1 1) (2
          3 1))) 1))
