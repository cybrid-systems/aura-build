;; Helper to check if x is in list
(define (member? x lst)
  (cond ((null? lst) #f)
        ((equal? x (car lst)) #t)
        (else (member? x (cdr lst)))))

;; Backtracking: build permutation from remaining available elements
(define (permute-helper available current result)
  (if (null? available)
      (append result (list (list-copy current)))
      (permute-step available current result '())))

(define (list-copy lst)
  (if (null? lst) '()
      (cons (car lst) (list-copy (cdr lst)))))

(define (permute-step available current result remaining)
  (cond ((null? remaining)
         (if (null? available)
             result
             result))
        (else
         (let* ((chosen (car remaining))
                (rest-remaining (cdr remaining))
                (new-current (append current (list chosen)))
                (new-available (remove-elt chosen available)))
           (permute-helper new-available new-current result)))))

;; Remove first occurrence of x from lst
(define (remove-elt x lst)
  (cond ((null? lst) '())
        ((equal? x (car lst)) (cdr lst))
        (else (cons (car lst) (remove-elt x (cdr lst))))))

;; Main permute function
(define (permute nums)
  (permute-helper nums '() '()))

;; Helper to display a list as space-separated values
(define (display-list lst)
  (cond ((null? lst) (display ""))
        ((null? (cdr lst)) (display (car lst)))
        (else (display (car lst))
              (display " ")
              (display-list (cdr lst)))))

;; Solve function for a single case
(define (solve nums)
  (let ((perms (permute nums)))
    (display-perms perms)))

(define (display-perms perms)
  (if (null? perms)
      'done
      (begin
        (display-list (car perms))
        (newline)
        (display-perms (cdr perms)))))

;; Test cases - run each case
(define (run-cases cases)
  (cond ((null? cases) 'done)
        (else
         (let* ((c (car cases))
                (n (car (cdr c)))
                (k (car (cdr (cdr c)))))
           (display "CASE")
           (display n)
           (display "=")
           (solve k)
           (if (null? (cdr cases))
               (newline)
               (display "")))
         (run-cases (cdr cases)))))

;; Remove the blank line between cases - let me simplify
(define (run-cases cases)
  (cond ((null? cases) 'done)
        (else
         (let* ((c (car cases))
                (n (car (cdr c)))
                (k (car (cdr (cdr c)))))
           (display "CASE")
           (display n)
           (display "=")
           (solve k)
           (run-cases (cdr cases))))))

;; Hmm, I need to restructure. Let me rewrite more carefully.

(define (permute-all lst)
  (if (null? lst)
      (list '())
      (let ((rest-perms (permute-all (cdr lst))))
        (insert-everywhere (car lst) rest-perms))))

(define (insert-everywhere x perms)
  (if (null? perms)
      '()
      (append (insert-one x (car perms))
              (insert-everywhere x (cdr perms)))))

(define (insert-one x perm)
  (insert-helper x perm 0))

(define (insert-helper x perm i)
  (if (> i (length perm))
      '()
      (cons (insert-at x perm i) (insert-helper x perm (+ i 1)))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (insert-at x lst i)
  (if (= i 0)
      (cons x lst)
      (cons (car lst) (insert-at x (cdr lst) (- i 1)))))

;; This approach generates all permutations of the input list
;; which gives unique orderings for distinct elements

(define (solve nums)
  (let ((perms (permute-all nums)))
    (display-perms perms)))

(define (display-perms perms)
  (if (null? perms)
      'done
      (begin
        (display-list (car perms))
          (newline)
          (display-perms (cdr perms)))))

(define (display-list lst)
  (cond ((null? lst) (display ""))
        ((null? (cdr lst)) (display (car lst)))
        (else (display (car lst))
              (display " ")
              (display-list (cdr lst)))))

;; Embedded test inputs as lists
(define CASE0 '(0 1 2 3))
(define CASE1 '(0 1))
(define CASE2 '(1))
(define CASE3 '(5 4 3 2 1))
(define CASE4 '(7))
(define CASE5 '(-1 0 1))
(define CASE6 '(10 20 30 40))
(define CASE7 '(2 1))

;; Run all cases
(begin
  (display "CASE0=")
  (solve CASE0)
  (newline)
  (display "CASE1=")
  (solve CASE1)
  (newline)
  (display "CASE2=")
  (solve CASE2)
  (newline)
  (display "CASE3=")
  (solve CASE3)
  (newline)
  (display "CASE4=")
  (solve CASE4)
  (newline)
  (display "CASE5=")
  (solve CASE5)
  (newline)
  (display "CASE6=")
  (solve CASE6)
  (newline)
  (display "CASE7=")
  (solve CASE7)
  (newline))
