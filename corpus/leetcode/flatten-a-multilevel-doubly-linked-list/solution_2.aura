(define (flatten nodes child)
  (let ((result '()))
    (define (find-head)
      ;; find the node with no prev
      (let loop ((ids (map car nodes)))
        (cond ((null? ids) #f)
              ((equal? (cdr (assq (car ids) nodes)) #f) (car ids))
              (else (loop (cdr ids))))))
    (define (walk id)
      (set! result (cons id result))
      (let ((c (cdr (assq id child))))
        (if (and c (not (equal? c #f)))
            (walk c)))
      (let ((n (cdr (assq id nodes))))
        (if (and n (not (equal? n #f)))
            (walk n))))
    (let ((h (find-head)))
      (if h (walk h)))
    (reverse result)))

(define (display-list xs)
  (cond ((null? xs) (display ""))
        (else
         (display (car xs))
         (let loop ((rest (cdr xs)))
           (cond ((null? rest) (void))
                 (else
                  (display " ")
                  (display (car rest))
                  (loop (cdr rest))))))))

(define (solve case-input)
  (let* ((nodes-assoc
          (map (lambda (kv)
                 (let ((id-str (car kv))
                       (info (cdr kv)))
                   (cons (string->number id-str)
                         (let ((n (cdr (assq 'next info)))
                               (p (cdr (assq 'prev info))))
                           (cond ((and (string? n) (equal? n "null")) #f)
                                 ((and (string? p) (equal? p "null")) #f)
                                 ((string? n) (string->number n))
                                 (else n))))))
               (cdr (assq 'nodes case-input))))
         (child-assoc
          (map (lambda (kv)
                 (let ((id-str (car kv))
                       (info (cdr kv)))
                   (cons (string->number id-str)
                         (let ((c info))
                           (cond ((string? c) (if (equal? c "null") #f (string->number c)))
                                 (else c))))))
               (cdr (assq 'child case-input))))
         (flat (flatten nodes-assoc child-assoc)))
    (display-list flat)
    (newline)))

;; Embedded test case
(define case0
  '((nodes
     ("1" (next . 2)  (prev . null))
     ("2" (next . 3)  (prev . 1))
     ("3" (next . 4)  (prev . 2))
     ("4" (next . 5)  (prev . 3))
     ("5" (next . 6)  (prev . 4))
     ("6" (next . null) (prev . 5))
     ("7" (next . 8)  (prev . null))
     ("8" (next . 9)  (prev . 7))
     ("9" (next . 10) (prev . 8))
     ("10" (next . null) (prev . 9))
     ("11" (next . 12) (prev . null))
     ("12" (next . null) (prev . 11)))
    (child
     ("1" . null)
     ("2" . null)
     ("3" . 7)
     ("4" . null)
     ("5" . null)
     ("6" . null)
     ("7" . null)
     ("8" . 11)
     ("9" . null)
     ("10" . null)
     ("11" . null)
     ("12" . null))))

(display "CASE0=")
(solve case0)
