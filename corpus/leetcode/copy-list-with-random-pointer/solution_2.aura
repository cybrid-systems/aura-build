(define nodes '())
(define count 0)

(define (ensure-size n)
  (let loop ((i count) (ns nodes))
    (if (>= i n)
        (begin (set! count n) (set! nodes ns))
        (loop (+ i 1) (append ns (list (list 0 -1 -1)))))))

(define (set-node! idx val nxt rnd)
  (set! nodes (list-set nodes idx (list val nxt rnd))))

(define (list-set lst i v)
  (cond ((null? lst) '())
        ((= i 0) (cons v (cdr lst)))
        (else (cons (car lst) (list-set (cdr lst) (- i 1) v)))))

(define (solve n specs)
  (ensure-size (* 2 n))
  ;; Place originals at indices 0..n-1
  (let loop-specs ((i 0) (ss specs))
    (if (null? ss)
        '()
        (let ((s (car ss)))
          (set-node! i (car s) (cadr s) (caddr s))
          (loop-specs (+ i 1) (cdr ss)))))
  ;; Interleave copies at indices n..2n-1
  (let loop-copy ((i 0))
    (if (>= i n)
        '()
        (begin
          (set-node! (+ n i) (car (list-ref nodes i)) -1 -1)
          (loop-copy (+ i 1)))))
  ;; Set next pointers: copy[i].next = i+1 (or -1); orig[i].next = n+i
  (let loop-next ((i 0))
    (if (>= i n)
        '()
        (let ((orig (list-ref nodes i))
              (cpy  (list-ref nodes (+ n i)))
              (orig-nxt (cadr (list-ref nodes i)))
              (cpy-nxt (if (< (+ i 1) n) (+ n i 1) -1)))
          (set-node! i (car orig) (+ n i) (caddr orig))
          (set-node! (+ n i) (car cpy) cpy-nxt -1)
          (loop-next (+ i 1)))))
  ;; Set copy random pointers
  (let loop-rand ((i 0))
    (if (>= i n)
        '()
        (let ((orig-rand (caddr (list-ref nodes i))))
          (let ((cpy-rand (if (= orig-rand -1) -1 (cadr (list-ref nodes (+ n orig-rand))))))
            (set-node! (+ n i) (car (list-ref nodes (+ n i))) (cadr (list-ref nodes (+ n i))) cpy-rand))
          (loop-rand (+ i 1)))))
  ;; Restore orig next pointers; print head idx of copy
  (let loop-restore ((i 0))
    (if (>= i n)
        (if (= n 0) -1 n)
        (let ((orig-nxt (cadr (list-ref nodes i))))
          (set-node! i (car (list-ref nodes i)) orig-nxt (caddr (list-ref nodes i)))
          (loop-restore (+ i 1))))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (append lst x)
  (if (null? lst) (cons x '()) (cons (car lst) (append (cdr lst) x))))

;; Test cases
(define cases
  (list
    (list 0 '())
    (list 1 (list (list 10 -1 -1)))
    (list 3 (list (list 10 1 2) (list 20 2 -1) (list 30 -1 1)))
    (list 5 (list (list 10 -1 -1) (list 20 0 2) (list 30 1 -1) (list 40 2 0) (list 50 3 1)))
    (list 4 (list (list 1 1 2) (list 2 2 2) (list 3 3 0) (list 4 -1 -1)))
    (list 2 (list (list 5 1 1) (list 7 -1 -1)))
    (list 6 (list (list 1 1 -1) (list 2 2 4) (list 3 3 0) (list 4 4 2) (list 5 5 5) (list 6 -1 -1)))))

(define (run-case i c)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve (car c) (cadr c)))
  (newline))

(let loop ((i 0) (cs cases))
  (if (null? cs) '()
      (begin
        (run-case i (car cs))
        (loop (+ i 1) (cdr cs)))))
