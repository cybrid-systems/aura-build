;; Build a deep copy of a list with random pointers.
;; Nodes are represented as triples (val nextIdx randIdx), -1 means null.
;; solve returns the head index (0-based) of the new copy within the copy table.

(define (nth-cdr lst i)
  (if (= i 0) lst (nth-cdr (cdr lst) (- i 1))))

(define (nth lst i) (car (nth-cdr lst i)))

(define (build-copies n nodes)
  ;; Returns a list of copy indices. Each copy has val set, next/random = -1.
  (define (loop i acc)
    (if (= i n)
        (reverse acc)
        (let ((nd (nth nodes i)))
          (loop (+ i 1) (cons i acc))))) ;; copy index == original index
  (loop 0 '()))

(define (solve n nodes)
  (if (= n 0)
      -1
      ;; copies[i] holds copy node; mapping orig-idx -> copy-idx is identity here.
      ;; We just need to assign next/random fields of each copy node.
      ;; We simulate fields via mutable association lists.
      (let ((nexts (build-init n -1))  ; alist of (idx . nextIdx) for copy nodes
            (rands (build-init n -1)))
        ;; wire next pointers
        (let loop1 ((i 0))
          (if (= i n)
              (begin
                ;; wire random pointers
                (let loop2 ((i 0))
                  (if (= i n)
                      0  ;; head index of copy = 0
                      (begin
                        (set-assoc! rands i (nth-cadr nodes i))
                        (loop2 (+ i 1))))))
              (begin
                (set-assoc! nexts i (nth-caddr nodes i))
                (loop1 (+ i 1))))))))

;; ---- helpers (kept self-contained; defined after their first use is fine
;; because Aura evaluates top-down but we only CALL after definitions)

(define (build-init n default)
  (let loop ((i (- n 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (cons i default) acc)))))

(define (nth-cadr nodes i) (car (cdr (cdr (nth nodes i)))))
(define (nth-caddr nodes i) (car (cdr (cdr (cdr (nth nodes i))))))

(define (set-assoc! alist key val)
  (define (loop p)
    (cond ((null? (cdr p))
           (set-cdr! p (cons (cons key val) '())))
          ((= (car (car (cdr p))) key)
           (set-car! (cdr (car (cdr p))) val))
          (else (loop (cdr p)))))
  (loop alist)
  alist)

;; ---- required harness output ----

;; CASE0
(display "CASE0=") (display (solve 0 '())) (newline)
;; CASE1
(display "CASE1=") (display (solve 1 '((10 -1 -1)))) (newline)
;; CASE2
(display "CASE2=") (display (solve 3 '((10 1 2) (20 2 -1) (30 -1 1)))) (newline)
;; CASE3
(display "CASE3=") (display (solve 5 '((10 -1 -1) (20 0 2) (30 1 -1) (40 2 0) (50 3 1)))) (newline)
;; CASE4
(display "CASE4=") (display (solve 4 '((1 1 2) (2 2 2) (3 3 0) (4 -1 -1)))) (newline)
;; CASE5
(display "CASE5=") (display (solve 2 '((5 1 1) (7 -1 -1)))) (newline)
;; CASE6
(display "CASE6=") (display (solve 6 '((1 1 -1) (2 2 4) (3 3 0) (4 4 2) (5 5 5) (6 -1 -1)))) (newline)
