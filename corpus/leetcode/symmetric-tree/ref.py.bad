import json
import sys

def parse_tree(s, i):
    """Parse a tree starting at index i. Returns (node, next_index)."""
    if s[i:i+4] == 'null':
        return None, i + 4
    if s[i] == '(':
        # find space
        j = s.index(' ', i+1)
        val = int(s[i+ound1:j])
        left, j = parse_tree(s, j+1)
        right, j = parse_tree(s, j+1)
        assert s[j] == ')', f"expected ) at {j}, got {s[j]!r} in {s!r}"
        return (val, left, right), j+1
    raise ValueError(f"unexpected at {i}: {s[i:i+10]!r}")

def full_parse(s):
    """Parse full line: 'CASE0=(... tree ...)#' """
    assert s.startswith('CASE0=')
    s = s[len('CASE0='):]
    assert s.endswith('#')
    s = s[:-1]
    node, _ = parse_tree(s, 0)
    return node

def is_mirror(a, b):
    if a is None and b is None:
        return True
    if a is None or b is None:
        return False
    if a[0] != b[0]:
        return False
    return is_mirror(a[1], b[2]) and is_mirror(a[2], b[1])

def is_symmetric(root):
    if root is None:
        return True
    return is_mirror(root[1], root[2])

def solve(root_str):
    root = full_parse(root_str)
    return is_symmetric(root)

CASES = [
    {"root": "CASE0=(1 (2 (3 # #) (4 # #)) (2 (4 # #) (3 # #)))#"},
    {"root": "CASE0=(1 (2 (null # #) (3 # #)) (2 (3 # #) (null # #)))#".replace("null ", "")},
    {"root": "CASE0=(1 (2 # #) (2 # #))#"},
    {"root": "CASE0=(1 (2 # (3 # #)) (2 (3 # #) null))#"},
    {"root": "CASE0=#"},
    {"root": "CASE0=(1 # #)#"},
    {"root": "CASE0=(1 (2 # #) (3 # #))#"},
    {"root": "CASE0=(1 (2 (3 # #) #) (2 (# #) 3))#".replace("(# #)", "null").replace(" (3 # #)) (2 null 3))#", " (3 # #)) (2 null 3))#")},
]

if __name__ == '__main__':
    out = []
    for i, c in enumerate(CASES):
        result = solve(c["root"])
        expected = json.dumps(result, separators=(',', ':'), ensure_ascii=False)
        out.append({"id": i, "input": c, "expected": expected})
    print(json.dumps(out, separators=(',', ':'), ensure_ascii=False))
