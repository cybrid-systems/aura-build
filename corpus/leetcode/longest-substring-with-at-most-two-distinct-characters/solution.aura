(define (length s) (string-length s))

(define (char-at s i)
  (string-ref s i))

(define (solve s)
  (let* ((n (length s))
         (left 0)
         (best 0)
         (c1 #\?)
         (c2 #\?)
         (cnt1 0)
         (cnt2 0)
         (result 0))
    (define (reset-counters)
      (set! c1 #\?)
      (set! c2 #\?)
      (set! cnt1 0)
      (set! cnt2 0))
    (define (adjust-left i)
      (let loop ((j left))
        (if (>= j i)
            (begin
              (set! left i)
              (reset-counters)
              (let inner ((k i))
                (if (< k i) 0 0)))
            (begin
              (let ((ch (char-at s j)))
                (cond
                  ((char=? ch c1) (set! cnt1 (- cnt1 1)))
                  ((char=? ch c2) (set! cnt2 (- cnt2 1)))
                  (else #f)))
              (loop (+ j 1))))))
    (let loop ((i 0))
      (if (>= i n)
          (begin
            (set! result best)
            result)
          (begin
            (let ((ch (char-at s i)))
              (cond
                ((or (char=? ch c1) (char=? ch c2))
                 (if (char=? ch c1) (set! cnt1 (+ cnt1 1)) (set! cnt2 (+ cnt2 1))))
                ((char=? c1 #\?) (set! c1 ch) (set! cnt1 1))
                ((char=? c2 #\?) (set! c2 ch) (set! cnt2 1))
                (else
                 (set! left (+ i 1))
                 (let ((prev (char-at s (- i 1))))
                   (set! c1 prev) (set! cnt1 1)
                   (set! c2 ch)  (set! cnt2 1)
                   (let shrink ((j left))
                     (if (>= j i)
                         '()
                         (if (char= (char-at s j) prev)
                             (begin
                               (set! cnt1 (+ cnt1 1))
                               (shrink (+ j 1)))
                             (begin
                               (set! left (+ j 1))
                               '())))))))
            (let ((curr (- i left -1)))
              (set! best (if (> curr best) curr best)))
            (loop (+ i 1))))))))

(define (display-result x)
  (display x)
  (newline))

(display "CASE0=") (display-result (solve "eceba"))
(display "CASE1=") (display-result (solve "ccaabbb"))
(display "CASE2=") (display-result (solve "a"))
(display "CASE3=") (display-result (solve "abcd"))
(display "CASE4=") (display-result (solve "aaaa"))
(display "CASE5=") (display-result (solve "ababab"))
(display "CASE6=") (display-result (solve "abcabcabc"))
(display "CASE7=") (display-result (solve "aabbaa"))
