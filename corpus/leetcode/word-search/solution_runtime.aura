; soft_leetcode_runtime slug=word-search path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-8 hits=6/8
; baseline_hits=0/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define string-length
    (lambda (s)
      (letrec ((loop (lambda (i)
          (if (string=?
              (substring
                s i (+
                  i 1)) "")
            i
            (loop (+
                i 1))))))
        (loop 0))))
  (define string-ref-impl
    (lambda (s i)
      (substring
        s i (+
          i 1))))
  (define board-ref
    (lambda (board n i j)
      (list-ref
        board (+
          (*
            i n) j))))
  (define set-list
    (lambda (lst idx val)
      (if (=
          idx 0)
        (cons
          val (cdr lst))
        (cons
          (car lst) (set-list
            (cdr lst) (-
              idx 1) val)))))
  (define dfs
    (lambda (board m n i j idx word visited wlen)
      (if (=
          idx wlen)
        #t
        (if (and
            (>=
              i 0) (<
              i m) (>=
              j 0) (<
              j n))
          (let ((pos (+
              (*
                i n) j)))
            (if (=
                (list-ref
                  visited pos) 0)
              (if (string=?
                  (board-ref
                    board n i j) (string-ref-impl
                    word idx))
                (let ((visited (set-list
                    visited pos 1)))
                  (if (or
                      (dfs
                        board m n (+
                          i 1) j (+
                          idx 1) word visited wlen) (dfs
                        board m n (-
                          i 1) j (+
                          idx 1) word visited wlen) (dfs
                        board m n i (+
                          j 1) (+
                          idx 1) word visited wlen) (dfs
                        board m n i (-
                          j 1) (+
                          idx 1) word visited wlen))
                    #t
                    #f))
                #f)
              #f))
          #f))))
  (define solve
    (lambda (m n board word)
      (let ((wlen (string-length word)))
        (if (=
            wlen 0)
          #t
          (letrec ((loop (lambda (i found)
              (if (or
                  found (>=
                    i m))
                found
                (letrec ((loop2 (lambda (j found)
                    (if (or
                        found (>=
                          j n))
                      (loop
                        (+
                          i 1) found)
                      (let ((visited (make-list
                          (*
                            m n) 0)))
                        (if (and
                            (string=?
                              (board-ref
                                board n i j) (string-ref-impl
                                word 0)) (dfs
                              board m n i j 0 word visited wlen))
                          (loop2
                            (+
                              j 1) #t)
                          (loop2
                            (+
                              j 1) found)))))))
                  (loop2
                    0 found))))))
            (loop
              0 #f))))))
  (define flatten-board
    (lambda (rows)
      (letrec ((loop (lambda (rows acc)
          (if (null? rows)
            (reverse acc)
            (loop
              (cdr rows) (append
                acc (car rows)))))))
        (loop
          rows (quote ())))))
  (define run-case
    (lambda (idx m n rows word)
      (let ((board (flatten-board rows)))
        (let ((result (solve
            m n board word)))
          (begin
            (display "CASE")
            (display idx)
            (display "=")
            (display (if result
                "YES"
                "NO"))
            (newline))))))
  (run-case
    0 3 4 (quote ("A"
        "B" "C" "E" "S" "F" "C" "S" "A" "D" "E" "E")) "ABCCED")
  (run-case
    1 3 4 (quote ("A"
        "B" "C" "E" "S" "F" "C" "S" "A" "D" "E" "E")) "SEE")
  (run-case
    2 3 4 (quote ("A"
        "B" "C" "E" "S" "F" "C" "S" "A" "D" "E" "E")) "ABCB")
  (run-case
    3 1 1 (quote ("A")) "A")
  (run-case
    4 1 1 (quote ("A")) "AA")
  (run-case
    5 2 2 (quote ("."
        "A" "B" "C")) "AC")
  (run-case
    6 3 3 (quote ("A"
        "B" "A" "B" "A" "B" "A" "B" "A")) "ABABABABA")
  (run-case
    7 2 2 (quote ("A"
        "B" "C" "D")) ""))
