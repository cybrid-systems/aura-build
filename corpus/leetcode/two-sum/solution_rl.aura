(require "lc_json" all:)
(require "compat" all:)
(define (lookup key alist)
  (cond ((null? alist) #f)
        ((equal? (car (car alist)) key) (cdr (car alist)))
        (else (lookup key (cdr alist)))))
(define (build-map nums idx alist)
  (if (null? nums) alist
      (build-map (cdr nums) (+ idx 1)
                 (cons (cons (car nums) idx) alist))))
(define (solve nums target)
  (let ((map (build-map nums 0 '())))
    (find-pair nums 0 map target)))
(define (find-pair nums idx map target)
  (if (null? nums)
      '(0 1)
      (let ((complement (- target (car nums)))
            (rest-idx idx))
        (let ((found (lookup complement map)))
          (if found
              (if (< found rest-idx)
                  (list found rest-idx)
                  (list rest-idx found))
              (find-pair (cdr nums) (+ idx 1) map target))))))
(define (display-pair p)
  (display (car p))
  (display " ")
  (display (cdr p)))
(define (display-list lst)
  (display "(")
  (cond ((null? lst) (display ")"))
        (else
          (display (car lst))
          (let loop ((rest (cdr lst)))
            (if (null? rest) (display ")")
                (begin
                  (display " ")
                  (display (car rest))
                  (loop (cdr rest))))))))
(define (run-case i nums target)
  (let ((result (solve nums target)))
    (display "CASE")
    (display i)
    (display "=")
    (display (car result))
    (display " ")
    (display (car (cdr result)))
    (newline)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums") (hash-ref input "target")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/two-sum/tests.json")))
