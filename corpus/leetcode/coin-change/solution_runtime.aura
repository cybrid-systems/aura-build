; soft_leetcode_runtime slug=coin-change path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-1 hits=3/8
; baseline_hits=1/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define min
    (lambda (a b)
      (if (<
          a b)
        a
        b)))
  (define make-list
    (lambda (n val)
      (if (<=
          n 0)
        (quote 0)
        (cons
          val (make-list
            (-
              n 1) val)))))
  (define list-ref-safe
    (lambda (lst i)
      (if (null? lst)
        #f
        (if (=
            i 0)
          (car lst)
          (list-ref-safe
            (cdr lst) (-
              i 1))))))
  (define list-set
    (lambda (lst i val)
      (if (null? lst)
        lst
        (if (=
            i 0)
          (cons
            val (cdr lst))
          (cons
            (car lst) (list-set
              (cdr lst) (-
                i 1) val))))))
  (define coin-change
    (lambda (denominations amount)
      (if (=
          amount 0)
        0
        (let ((n-d (length denominations)))
          (let ((size (+
              amount 1)))
            (let ((dp (make-list
                size size)))
              (begin
                (letrec ((loop-d (lambda (k dp)
                    (if (>=
                        k size)
                      dp
                      (loop-d
                        (+
                          k 1) (list-set
                          dp k 0))))))
                  (loop-d
                    0 dp))
                (let ((dp (letrec ((loop-d (lambda (k dpl)
                      (if (>=
                          k size)
                        dpl
                        (loop-d
                          (+
                            k 1) (list-set
                            dpl k 0))))))
                    (loop-d
                      0 dp))))
                  (letrec ((loop-i (lambda (i)
                      (if (>
                          i amount)
                        (let ((result (list-ref
                            dp amount)))
                          (if (>=
                              result size)
                            -1
                            result))
                        (begin
                          (letrec ((loop-d (lambda (ds best)
                              (if (null? ds)
                                (quote done)
                                (let ((d (car ds)))
                                  (let ((rest (cdr ds)))
                                    (if (and
                                        (>=
                                          i d) (<
                                          (+
                                            (list-ref
                                              dp (-
                                                i d)) 1) (list-ref
                                            best i)))
                                      (let ((cand (+
                                          (list-ref
                                            dp (-
                                              i d)) 1)))
                                        (begin
                                          (set! best (list-set
                                              best i cand))
                                          (loop-d
                                            rest best)))
                                      (loop-d
                                        rest best))))))))
                            (loop-d
                              denominations dp))
                          (loop-i (+
                              i 1)))))))
                    (loop-i 1))))))))))
  (define solve
    (lambda (denominations amount)
      (coin-change
        denominations amount)))
  (display "CASE0=")
  (display (solve
      (quote (1
          2 5)) 11))
  (newline)
  (display "CASE1=")
  (display (solve
      (quote (2)) 3))
  (newline)
  (display "CASE2=")
  (display (solve
      (quote (1
          2 5)) 0))
  (newline)
  (display "CASE3=")
  (display (solve
      (quote (1)) 1))
  (newline)
  (display "CASE4=")
  (display (solve
      (quote (5
          10 25)) 30))
  (newline)
  (display "CASE5=")
  (display (solve
      (quote (3 7)) 14))
  (newline)
  (display "CASE6=")
  (display (solve
      (quote (2
          5 10)) 1))
  (newline)
  (display "CASE7=")
  (display (solve
      (quote (1
          3 4)) 6))
  (newline))
