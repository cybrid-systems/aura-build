; soft_leetcode_runtime slug=coin-change path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-55 hits=8/8
; baseline_hits=3/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define min2
    (lambda (a b)
      (if (<
          a b)
        a
        b)))
  (define make-list
    (lambda (n val)
      (if (<=
          n 0)
        (quote ())
        (cons
          val (make-list
            (-
              n 1) val)))))
  (define list-ref-safe
    (lambda (lst i)
      (if (null? lst)
        #f
        (if (=
            i 0)
          (car lst)
          (list-ref-safe
            (cdr lst) (-
              i 1))))))
  (define list-set
    (lambda (lst i val)
      (if (null? lst)
        lst
        (if (=
            i 0)
          (cons
            val (cdr lst))
          (cons
            (car lst) (list-set
              (cdr lst) (-
                i 1) val))))))
  (define coin-change
    (lambda (denominations amount)
      (let ((size (+
          amount 1)))
        (let ((INF (+
            size 1)))
          (let ((dp (make-list
              size INF)))
            (begin
              (set! dp (list-set
                  dp 0 0))
              (letrec ((loop-i (lambda (i)
                  (if (>
                      i amount)
                    (quote done)
                    (begin
                      (letrec ((loop-d (lambda (ds)
                          (if (null? ds)
                            (quote done)
                            (let ((d (car ds)))
                              (let ((rest (cdr ds)))
                                (begin
                                  (if (>=
                                      i d)
                                    (let ((prev (list-ref-safe
                                        dp (-
                                          i d))))
                                      (begin
                                        (if (and
                                            (number? prev) (<
                                              prev INF))
                                          (let ((cand (+
                                              prev 1)))
                                            (let ((cur (list-ref-safe
                                                dp i)))
                                              (if (<
                                                  cand cur)
                                                (set! dp (list-set
                                                    dp i cand))
                                                (quote ok))))
                                          ())
                                        (quote ok)))
                                    (quote ok))
                                  (loop-d rest))))))))
                        (loop-d denominations))
                      (loop-i (+
                          i 1)))))))
                (loop-i 1))
              (let ((ans (list-ref-safe
                  dp amount)))
                (if (and
                    (number? ans) (<
                      ans INF))
                  ans
                  -1))))))))
  (define solve
    (lambda (denominations amount)
      (coin-change
        denominations amount)))
  (display "CASE0=")
  (display (solve
      (quote (1
          2 5)) 11))
  (newline)
  (display "CASE1=")
  (display (solve
      (quote (2)) 3))
  (newline)
  (display "CASE2=")
  (display (solve
      (quote (1
          2 5)) 0))
  (newline)
  (display "CASE3=")
  (display (solve
      (quote (1)) 1))
  (newline)
  (display "CASE4=")
  (display (solve
      (quote (5
          10 25)) 30))
  (newline)
  (display "CASE5=")
  (display (solve
      (quote (3 7)) 14))
  (newline)
  (display "CASE6=")
  (display (solve
      (quote (2
          5 10)) 1))
  (newline)
  (display "CASE7=")
  (display (solve
      (quote (1
          3 4)) 6))
  (newline))
