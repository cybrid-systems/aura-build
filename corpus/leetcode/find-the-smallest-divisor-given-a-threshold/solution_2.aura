(define (max-list lst)
  (cond ((null? (cdr lst)) (car lst))
        (else (let ((m (max-list (cdr lst))))
                (if (> m (car lst)) m (car lst))))))

(define (ceil-div a b)
  (quotient (+ a b -1) b))

(define (cost lst div)
  (cond ((null? lst) 0)
        (else (+ (ceil-div (car lst) div) (cost (cdr lst) div)))))

(define (solve nums threshold)
  (let ((n (length nums))
        (mx (max-list nums)))
    (if (< threshold n)
        -1
        (letrec ((search (lambda (lo hi)
          (if (> lo hi)
              (let ((c (cost nums hi))) (if (<= c threshold) hi -1))
              (let ((mid (quotient (+ lo hi) 2))
                    (c (cost nums (quotient (+ lo hi) 2)))))
                (if (<= c threshold)
                    (if (= lo hi) lo (search lo mid))
                    (search (+ mid 1) hi)))))))
          (search 1 mx)))))

(define (run-case i nums threshold)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums threshold))
  (newline))

(run-case 0 '(1 2 5) 9)
(run-case 1 '(2 1 0) 3)
(run-case 2 '(1 1 1) 3)
(run-case 3 '(100000) 1)
(run-case 4 '(10 20 30 40) 5)
(run-case 5 '(1) 1)
(run-case 6 '(4 4 4 4) 4)
(run-case 7 '(2 3 5 7 11) 8)
