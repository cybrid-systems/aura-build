(define (max-list lst)
  (cond ((null? lst) 0)
        (else (let ((rest-max (max-list (cdr lst))))
                (if (> (car lst) rest-max)
                    (car lst)
                    rest-max)))))

(define (cost lst divisor)
  (cond ((null? lst) 0)
        (else (+ (quotient (+ (car lst) divisor -1) divisor)
                 (cost (cdr lst) divisor)))))

(define (search lst threshold lo hi)
  (if (> lo hi)
          -1
          (let ((mid (quotient (+ lo hi) 2)))
            (let ((c (cost lst mid)))
              (cond ((<= c threshold)
                     (let ((prev (search lst threshold lo (- mid 1))))
                       (if (< prev 0) mid prev)))
                    (else (search lst threshold (+ mid 1) hi)))))))

(define (solve nums threshold)
  (let ((n (length nums)))
    (if (< threshold n)
        -1
        (let ((mx (max-list nums)))
          (search nums threshold 1 mx)))))

(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display result)
  (newline))

(define (run)
  (let ((c0 (solve '(1 2 5) 9)))
    (display-case 0 c0)
    (let ((c1 (solve '(2 1 0) 3)))
      (display-case 1 c1)
      (let ((c2 (solve '(1 1 1) 3)))
        (display-case 2 c2)
        (let ((c3 (solve '(100000) 1)))
          (display-case 3 c3)
          (let ((c4 (solve '(10 20 30 40) 5)))
            (display-case 4 c4)
            (let ((c5 (solve '(1) 1)))
              (display-case 5 c5)
              (let ((c6 (solve '(4 4 4 4) 4)))
                (display-case 6 c6)
                (let ((c7 (solve '(2 3 5 7 11) 8)))
                  (display-case 7 c7))))))))))

(run)
