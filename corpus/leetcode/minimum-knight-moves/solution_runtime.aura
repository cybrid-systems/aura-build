; soft_leetcode_runtime slug=minimum-knight-moves path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-2 hits=4/12
; baseline_hits=1/12
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define abs
    (lambda (n)
      (if (<
          n 0)
        (-
          0 n)
        n)))
  (define max2
    (lambda (a b)
      (if (>
          a b)
        a
        b)))
  (define min2
    (lambda (a b)
      (if (<
          a b)
        a
        b)))
  (define known-small
    (lambda (x y)
      (if (and
          (=
            x 0) (=
            y 0))
        0
        (if (and
            (=
              x 1) (=
              y 1))
          2
          (if (and
              (=
                x 2) (=
                y 2))
            4
            (if (and
                (=
                  x 1) (=
                  y 0))
              3
              (if (and
                  (=
                    x 0) (=
                    y 1))
                3
                (if (and
                    (=
                      x 2) (=
                      y 1))
                  1
                  (if (and
                      (=
                        x 1) (=
                        y 2))
                    1
                    -1)))))))))
  (define knight-moves
    (lambda (x y)
      (let ((k (known-small
          x y)))
        (if (>=
            k 0)
          k
          (let ((a (min2
              x y)))
            (let ((b (max2
                x y)))
              (let ((d (if (=
                    b 1)
                  0
                  (if (=
                      b 2)
                    2
                    (-
                      b 7)))))
                (if (=
                    b 1)
                  1
                  (if (=
                      b 2)
                    2
                    (if (<=
                        b 7)
                      (let ((max-val (max2
                          a (/
                            (-
                              d 1) 2))))
                        (+
                          d max-val))
                      (if (=
                          a d)
                        (-
                          (+
                            a d) 2)
                        (+
                          a d))))))))))))
  (define solve
    (lambda (x y)
      (knight-moves
        (abs x) (abs y))))
  (define run-case
    (lambda (i x y)
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display (solve
            x y))
        (newline))))
  (run-case
    0 0 0)
  (run-case
    1 1 1)
  (run-case
    2 2 2)
  (run-case
    3 1 0)
  (run-case
    4 2 1)
  (run-case
    5 -1 -2)
  (run-case
    6 5 5)
  (run-case
    7 -3 7)
  (run-case
    8 100 100)
  (run-case
    9 0 2)
  (run-case
    10 2 0)
  (run-case
    11 1 2))
