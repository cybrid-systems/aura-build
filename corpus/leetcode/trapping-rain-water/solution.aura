(define (min a b) (if (< a b) a b))
(define (max a b) (if (> a b) a b))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (solve heights)
  (let ((n (length heights)))
    (if (<= n 2) 0
      (letrec ((loop (lambda (l r lmax rmax acc)
                       (if (>= l r) acc
                         (if (<= (list-ref heights l) (list-ref heights r))
                             (let ((new-lmax (max lmax (list-ref heights l))))
                               (if (< new-lmax (list-ref heights l))
                                   acc
                                 (loop (+ l 1) r new-lmax rmax
                                       (+ acc (- new-lmax (list-ref heights l))))))
                             (let ((new-rmax (max rmax (list-ref heights r))))
                               (if (< new-rmax (list-ref heights r))
                                   acc
                                 (loop l (- r 1) lmax new-rmax
                                       (+ acc (- new-rmax (list-ref heights r)))))))))))
        (loop 0 (- n 1) 0 0 0)))))

(define (print-list lst)
  (display "[")
  (letrec ((loop (lambda (l first?)
                   (cond ((null? l) (display "]"))
                         (else
                          (if (not first?) (display ", "))
                          (display (car l))
                          (loop (cdr l) #f))))))
    (loop lst #t)))

(define (run-case name heights)
  (begin
    (display name)
    (display "=")
    (display (solve heights))
    (newline)))

(run-case "CASE0" '())
(run-case "CASE1" '(5))
(run-case "CASE2" '(5 0 5))
(run-case "CASE3" '(0 1 0 2 1 0 1 3 2 1 2 1))
(run-case "CASE4" '(4 2 0 3 2 5))
(run-case "CASE5" '(1 2 3 4 5))
(run-case "CASE6" '(5 4 3 2 1))
(run-case "CASE7" '(0 0 0 0))
