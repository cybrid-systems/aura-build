(define (max a b) (if (> a b) a b))
(define (min a b) (if (< a b) a b))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (trap heights)
  (let ((n (length heights)))
    (if (< n 2)
        0
        (let ((result 0)
              (left 0)
              (right (- n 1))
              (max-left 0)
              (max-right 0))
          (define (loop)
            (if (<= left right)
                (begin
                  (if (< (list-ref heights left) (list-ref heights right))
                      (begin
                        (if (> (list-ref heights left) max-left)
                            (set! max-left (list-ref heights left)))
                        (set! result (+ result (max 0 (- (min max-left max-right) (list-ref heights left))))))
                      (begin
                        (if (> (list-ref heights right) max-right)
                            (set! max-right (list-ref heights right)))
                        (set! result (+ result (max 0 (- (min max-left max-right) (list-ref heights right)))))))
                  (if (< (list-ref heights left) (list-ref heights right))
                      (set! left (+ left 1))
                      (set! right (- right 1)))
                  (loop))
                result))
          (loop)))))

(define (solve heights) (trap heights))

(define (display-list lst)
  (display "[")
  (define (loop l)
    (cond ((null? l) (display ""))
          (else
            (display (car l))
            (if (not (null? (cdr l))) (display ", "))
            (loop (cdr l)))))
  (loop lst)
  (display "]"))

(for-each
  (lambda (case)
    (let ((h (car case)) (idx (cdr case)))
      (let ((r (solve h)))
        (string-append "CASE" (number->string idx) "=")
        (display (string-append "CASE" (number->string idx)))
        (display "=")
        (display r)
        (newline))))
  (list (list '() 0)
        (list '(5) 1)
        (list '(5 0 5) 2)
        (list '(0 1 0 2 1 0 1 3 2 1 2 1) 3)
        (list '(4 2 0 3 2 5) 4)
        (list '(1 2 3 4 5) 5)
        (list '(5 4 3 2 1) 6)
        (list '(0 0 0 0) 7)))
