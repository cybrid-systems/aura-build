(require "lc_json" all:)
(require "compat" all:)
(define (solve n)
  (if (and (> n 0)
           (= 0 (modulo n 4))
           (let loop ((x 1))
             (cond ((= x n) #t)
                   ((> x n) #f)
                   (else (loop (* x 4))))))
      "true"
      "false"))
(define (display-case i result)
  (display "CASE")
  (display (number->string i))
  (display "=")
  (display result)
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/power-of-four/tests.json")))
