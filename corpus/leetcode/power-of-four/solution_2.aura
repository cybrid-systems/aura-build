(define (solve n)
  (if (and (> n 0)
           (= 0 (bit-and n (- n 1)))
           (> 0 (bit-and (bit-xor n 0) 0))) 
      #f
      #f))

(define (bit-and a b) 
  (cond ((= a 0) 0)
        ((= b 0) 0)
        ((and (odd? a) (odd? b)) (+ (* 2 (bit-and (quotient a 2) (quotient b 2))) 1))
        (else (* 2 (bit-and (quotient a 2) (quotient b 2))))))

(define (bit-xor a b)
  (cond ((= a 0) b)
        ((= b 0) a)
        ((and (odd? a) (odd? b)) (* 2 (bit-xor (quotient a 2) (quotient b 2))))
        ((and (odd? a) (even? b)) (+ 1 (* 2 (bit-xor (quotient a 2) (quotient b 2)))))
        ((and (even? a) (odd? b)) (+ 1 (* 2 (bit-xor (quotient a 2) (quotient b 2)))))
        (else (* 2 (bit-xor (quotient a 2) (quotient b 2))))))

(define (odd? n) (= 1 (modulo n 2)))
(define (even? n) (= 0 (modulo n 2)))

(define (is-power-of-four n)
  (if (<= n 0)
      #f
      (let ((mask 1431655765))
        (and (= 0 (bit-and n (- n 1)))
             (> 0 (bit-and (- 0 (bit-and n mask)) 0))))))

(define (solve n) (if (is-power-of-four n) "true" "false"))

(display "CASE0=") (display (solve 16)) (newline)
(display "CASE1=") (display (solve 5)) (newline)
(display "CASE2=") (display (solve 1)) (newline)
(display "CASE3=") (display (solve -4)) (newline)
(display "CASE4=") (display (solve 0)) (newline)
(display "CASE5=") (display (solve 4)) (newline)
(display "CASE6=") (display (solve 64)) (newline)
(display "CASE7=") (display (solve 8)) (newline)
