import sys
import json

def solve(case_id: int) -> str:
    """
    Determines whether all rooms are reachable starting from room 0.
    Uses BFS to explore rooms, tracking visited rooms.
    """
    line = CASES_DATA[case_id]
    parts = line.split('|')
    # Format: CASE0=N|room0|room1|...
    # Find N
    first_part = parts[0]
    # Extract N (after '=')
    N = int(first_part.split('=')[1])
    # Parse rooms
    visited = [False] * N
    from collections import deque
    queue = deque()
    visited[0] = True
    queue.append(0)
    
    # Index in parts: parts[1] is room 0, parts[2] is room 1, etc.
    # Parse all room data first to build adjacency
    rooms = []
    for i in range(N):
        room_data = parts[1 + i].strip()
        tokens = room_data.split()
        k = int(tokens[0])
        keys = [int(tokens[j]) for j in range(1, 1 + k)]
        rooms.append(keys)
    
    while queue:
        room = queue.popleft()
        for key in rooms[room]:
            if not visited[key]:
                visited[key] = True
                queue.append(key)
    
    return "True" if all(visited) else "False"


# Define test cases as raw input strings
CASES_RAW = [
    "3 | 3 1 2 | 0 1 | 0",       # True
    "2 | 1 1 | 1 0",              # True
    "2 | 1 0 | 1 1",              # True
    "3 | 1 1 | 1 2 | 1 0",        # True
    "3 | 1 1 | 1 2 | 0",          # False
    "1 | 0",                      # True
    "4 | 1 1 | 1 2 | 1 3 | 0",    # False
    "4 | 1 1 | 1 2 | 1 3 | 1 0", # True
    "5 | 0 | 1 1 | 1 2 | 1 3 | 1 4", # False
    "5 | 1 1 | 1 2 | 1 3 | 1 4 | 0", # True
]

CASES_DATA = CASES_RAW


def main():
    results = []
    for idx in range(len(CASES_RAW)):
        result = solve(idx)
        results.append({
            "id": idx,
            "input": {"case_line": CASES_RAW[idx]},
            "expected": json.dumps(result, ensure_ascii=False)
        })
    print(json.dumps(results, separators=(',', ':'), ensure_ascii=False))


if __name__ == '__main__':
    main()
