(require "lc_json" all:)
(require "compat" all:)
(define (divide-while n d)
  (if (= (modulo n d) 0)
      (divide-while (quotient n d) d)
      n))
(define (is-ugly n)
  (if (<= n 0)
      #f
      (let ((m (divide-while (divide-while (divide-while n 2) 3) 5)))
        (= m 1))))
(define (solve n)
  (is-ugly n))
(define (display-list xs)
  (display "(")
  (let loop ((xs xs))
    (if (null? xs)
        (display ")")
        (begin
          (display (car xs))
          (if (not (null? (cdr xs)))
              (display " "))
          (loop (cdr xs))))))
(define (display-value v)
  (cond
    ((null? v) (display "()"))
    ((boolean? v) (display (if v "#t" "#f")))
    ((number? v) (display v))
    ((string? v) (display v))
    ((pair? v) (display-list v))
    (else (display v))))
(define (run-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display-value (solve n))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/ugly-number/tests.json")))
