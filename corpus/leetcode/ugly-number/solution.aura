(define (divide-while n d)
  (if (= (modulo n d) 0)
      (divide-while (quotient n d) d)
      n))

(define (is-ugly n)
  (if (<= n 0)
      #f
      (let ((m (divide-while (divide-while (divide-while n 2) 3) 5)))
        (= m 1))))

(define (solve n)
  (is-ugly n))

(define (display-list xs)
  (display "(")
  (let loop ((xs xs))
    (if (null? xs)
        (display ")")
        (begin
          (display (car xs))
          (if (not (null? (cdr xs)))
              (display " "))
          (loop (cdr xs))))))

(define (display-value v)
  (cond
    ((null? v) (display "()"))
    ((boolean? v) (display (if v "#t" "#f")))
    ((number? v) (display v))
    ((string? v) (display v))
    ((pair? v) (display-list v))
    (else (display v))))

(define (run-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display-value (solve n))
  (newline))

(run-case 0 1)
(run-case 1 6)
(run-case 2 14)
(run-case 3 0)
(run-case 4 -6)
(run-case 5 25)
(run-case 6 27)
(run-case 7 30)
(run-case 8 7)
(run-case 9 1000000)
(run-case 10 999983)
(run-case 11 2)
(run-case 12 3)
(run-case 13 5)
(run-case 14 13)
