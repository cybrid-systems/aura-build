(define (divide-out n while-divisible-by)
  (if (= (modulo n while-divisible-by) 0)
      (divide-out (/ n while-divisible-by) while-divisible-by)
      n))

(define (ugly? n)
  (if (and (number? n) (> n 0) (integer? n))
      (= (divide-out (divide-out (divide-out n 2) 3) 5) 1)
      #f))

(define (solve n)
  (ugly? n))

(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display result)
  (newline))

(begin
  (display-case 0 (solve 1))
  (display-case 1 (solve 6))
  (display-case 2 (solve 14))
  (display-case 3 (solve 0))
  (display-case 4 (solve -6))
  (display-case 5 (solve 25))
  (display-case 6 (solve 27))
  (display-case 7 (solve 30))
  (display-case 8 (solve 7))
  (display-case 9 (solve 1000000))
  (display-case 10 (solve 999983))
  (display-case 11 (solve 2))
  (display-case 12 (solve 3))
  (display-case 13 (solve 5))
  (display-case 14 (solve 13)))
