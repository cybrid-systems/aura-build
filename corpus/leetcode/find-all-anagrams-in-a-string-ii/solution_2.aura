(define (string-ref s i)
  (substring s i (+ i 1)))

(define (string-length s)
  (let loop ((i 0))
    (if (= (string-ref s i) #\null) i (loop (+ i 1)))))

(define (make-arr n)
  (make-vector n 0))

(define (char->int c)
  (- (char->integer c) (char->integer #\a)))

(define (display-list xs)
  (display "[")
  (let loop ((rest xs))
    (if (null? rest)
        (display "]")
        (begin
          (display (car rest))
          (if (null? (cdr rest))
              (display "]")
              (begin
                (display ",")
                (loop (cdr rest))))))))

(define (solve s p)
  (let* ((n (string-length s))
         (m (string-length p))
         (need (make-arr 26))
         (have (make-arr 26))
         (result '()))
    (when (> m n)
      (set! result '()))
    (cond
      ((> m n) result)
      (else
       (let ((i 0))
         (set! i 0)
         (let fill-need ()
           (when (< i m)
             (let ((c (char->int (string-ref p i))))
               (vector-set! need c (+ (vector-ref need c) 1))
               (set! i (+ i 1))
               (fill-need)))))
       (let ((j 0))
         (set! j 0)
         (let fill-have ()
           (when (< j m)
             (let ((c (char->int (string-ref s j))))
               (vector-set! have c (+ (vector-ref have c) 1))
               (set! j (+ j 1))
               (fill-have)))))
       (letrec
         ((matches?
           (lambda ()
             (let loop ((k 0))
               (cond
                 ((= k 26) #t)
                 ((= (vector-ref have k) (vector-ref need k))
                  (loop (+ k 1)))
                 (else #f))))))
         (let scan ((start 0))
           (when (matches?)
             (set! result (append result (list start))))
           (when (< (+ start m) n)
             (let ((out-c (char->int (string-ref s start)))
                   (in-c  (char->int (string-ref s (+ start m)))))
               (vector-set! have out-c (- (vector-ref have out-c) 1))
               (vector-set! have in-c (+ (vector-ref have in-c) 1))
               (scan (+ start 1))))))
       result)))
