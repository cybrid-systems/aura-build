;; Aura program: Find All Anagrams in a String (Variant)
;; Sliding window with frequency counts.

;; --- list / string helpers ---

;; Build a list of n copies of x
(define (make-list n x)
  (if (= n 0)
      '()
      (cons x (make-list (- n 1) x))))

;; Build list of integers 0..n-1
(define (range n)
  (letrec ((loop (lambda (k acc)
                   (if (< k 0)
                       acc
                       (loop (- k 1) (cons k acc))))))
    (loop (- n 1) '())))

;; Get character at index i in string s
(define (char-at s i)
  (string-ref s i))

;; String length
(define (str-len s)
  (string-length s))

;; Append two lists
(define (append-list a b)
  (if (null? a)
      b
      (cons (car a) (append-list (cdr a) b))))

;; Display a list of integers as [a, b, c]
(define (display-int-list lst)
  (display "[")
  (letrec ((loop (lambda (xs first?)
                   (cond
                     ((null? xs) #t)
                     (else
                      (if first?
                          (display "")
                          (display ", "))
                      (display (car xs))
                      (loop (cdr xs) #f))))))
    (loop lst #t))
  (display "]")
  (newline))

;; --- frequency counting ---

;; Increment the count for character c (as char) in freq list
;; freq is a list of (char . count) pairs
(define (freq-inc freq c)
  (letrec ((loop (lambda (xs)
                   (cond
                     ((null? xs)
                      (list (cons c 1)))
                     ((char=? (car (car xs)) c)
                      (cons (cons c (+ (cdr (car xs)) 1)) (cdr xs)))
                     (else
                      (cons (car xs) (loop (cdr xs))))))))
    (loop freq)))

;; Convert character to a symbol key for the freq map (use char itself as key)
;; Build a frequency list from a string segment [lo, hi)
(define (build-freq s lo hi)
  (letrec ((loop (lambda (i acc)
                   (if (= i hi)
                       acc
                       (loop (+ i 1) (freq-inc acc (char-at s i)))))))
    (loop lo '())))

;; Compare two frequency lists for equality (same chars with same counts)
(define (freq-equal? a b)
  (cond
    ((and (null? a) (null? b)) #t)
    ((null? a) #f)
    ((null? b) #f)
    (else
     (let ((pa (car a)) (pb (car b)))
       (if (and (char=? (car pa) (car pb))
                (= (cdr pa) (cdr pb)))
           (freq-equal? (cdr a) (cdr b))
           #f)))))

;; --- sliding window ---

;; Compute the initial window frequency for s[0..plen)
;; and the target frequency for p.
;; Then slide and collect indices where they match.
(define (find-anagrams s p)
  (let ((slen (str-len s))
        (plen (str-len p)))
    (if (> plen slen)
        '()
        (let* ((target (build-freq p 0 plen))
               (window (build-freq s 0 plen))
               (match? (freq-equal? target window)))
          (letrec ((loop (lambda (i w acc match-flag)
                           (cond
                             ((> (+ i plen) slen)
                              acc)
                             (else
                              (let ((new-acc (if match-flag
                                                (cons i acc)
                                                acc)))
                                (if (= (+ i plen) slen)
                                    new-acc
                                    (let* ((out-c (char-at s i))
                                           (in-c (char-at s (+ i plen)))
                                           ;; decrement out-c
                                           (w2 (letrec ((lp (lambda (xs)
                                                              (cond
                                                                ((null? xs) xs)
                                                                ((char=? (car (car xs)) out-c)
                                                                 (let ((cnt (- (cdr (car xs)) 1)))
                                                                   (if (= cnt 0)
                                                                       (cdr xs)
                                                                       (cons (cons out-c cnt) (cdr xs)))))
                                                                (else
                                                                 (cons (car xs) (lp (cdr xs))))))))
                                                  (lp w)))
                                           ;; increment in-c
                                           (w3 (freq-inc w2 in-c))
                                           (new-match (freq-equal? target w3)))
                                      (loop (+ i 1) w3 new-acc new-match)))))))))
            (reverse (loop 0 window '() match?)))))))

;; --- solve wrapper ---

(define (solve s p)
  (find-anagrams s p))

;; --- test driver ---

(define (run-case i s p)
  (display "CASE")
  (display i)
  (display "=")
  (display-int-list (solve s p)))

(let ((cases (list
               (cons "cbaebabacd" "abc")
               (cons "abab" "ab")
               (cons "aaaaa" "aa")
               (cons "abcd" "efgh")
               (cons "abdc" "abcd")
               (cons "a" "a")
               (cons "a" "b")
               (cons "abcabcabc" "abc"))))
  (letrec ((loop (lambda (cs i)
                   (if (null? cs)
                       #t
                       (begin
                         (run-case i (car (car cs)) (cdr (car cs)))
                         (loop (cdr cs) (+ i 1)))))))
    (loop cases 0)))
