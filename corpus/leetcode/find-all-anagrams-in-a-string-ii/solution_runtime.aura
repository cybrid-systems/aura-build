; soft_leetcode_runtime slug=find-all-anagrams-in-a-string-ii path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-1 hits=8/8
; baseline_hits=5/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define make-list
    (lambda (n x)
      (if (=
          n 0)
        (quote 0)
        (cons
          x (make-list
            (-
              n 1) x)))))
  (define char->idx
    (lambda (c)
      (-
        (char->integer c) (char->integer 97))))
  (define str-len
    (lambda (s)
      (string-length s)))
  (define char-at
    (lambda (s i)
      (string-ref
        s i)))
  (define display-int-list
    (lambda (lst)
      (begin
        (display "[")
        (letrec ((loop (lambda (xs first?)
            (if (null? xs)
              #t
              (begin
                (if first?
                  (display "")
                  (display ", "))
                (display (car xs))
                (loop
                  (cdr xs) #f))))))
          (loop
            lst #t))
        (display "]")
        (newline))))
  (define zero-freq
    (lambda ()
      (make-list
        26 0)))
  (define freq-inc
    (lambda (freq c)
      (let ((idx (char->idx c)))
        (letrec ((loop (lambda (i xs)
            (if (=
                i idx)
              (cons
                (+
                  (car xs) 1) (cdr xs))
              (cons
                (car xs) (loop
                  (+
                    i 1) (cdr xs)))))))
          (loop
            0 freq)))))
  (define freq-dec
    (lambda (freq c)
      (let ((idx (char->idx c)))
        (letrec ((loop (lambda (i xs)
            (if (=
                i idx)
              (cons
                (-
                  (car xs) 1) (cdr xs))
              (cons
                (car xs) (loop
                  (+
                    i 1) (cdr xs)))))))
          (loop
            0 freq)))))
  (define build-freq
    (lambda (s lo hi)
      (letrec ((loop (lambda (i acc)
          (if (=
              i hi)
            acc
            (loop
              (+
                i 1) (freq-inc
                acc (char-at
                  s i)))))))
        (loop
          lo (zero-freq)))))
  (define freq-equal?
    (lambda (a b)
      (if (null? a)
        (null? b)
        (if (null? b)
          #f
          (if (not (=
                (car a) (car b)))
            #f
            (freq-equal?
              (cdr a) (cdr b)))))))
  (define find-anagrams
    (lambda (s p)
      (let ((slen (str-len s)))
        (let ((plen (str-len p)))
          (if (>
              plen slen)
            (quote 0)
            (let ((target (build-freq
                p 0 plen)))
              (let ((window (build-freq
                  s 0 plen)))
                (let ((match? (freq-equal?
                    target window)))
                  (letrec ((loop (lambda (i w mflag acc)
                      (if (>=
                          (+
                            i plen) slen)
                        (if mflag
                          (reverse (cons
                              i acc))
                          (reverse acc))
                        (let ((new-acc (if mflag
                            (cons
                              i acc)
                            acc)))
                          (let ((out-c (char-at
                              s i)))
                            (let ((in-c (char-at
                                s (+
                                  i plen))))
                              (let ((w2 (freq-dec
                                  w out-c)))
                                (let ((w3 (freq-inc
                                    w2 in-c)))
                                  (let ((new-mflag (freq-equal?
                                      target w3)))
                                    (loop
                                      (+
                                        i 1) w3 new-mflag new-acc)))))))))))
                    (loop
                      0 window match? (quote 0)))))))))))
  (define solve
    (lambda (s p)
      (find-anagrams
        s p)))
  (define run-case
    (lambda (i s p)
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display-int-list (solve
            s p)))))
  (let ((cases (list
      (cons
        "cbaebabacd" "abc") (cons
        "abab" "ab") (cons
        "aaaaa" "aa") (cons
        "abcd" "efgh") (cons
        "abdc" "abcd") (cons
        "a" "a") (cons
        "a" "b") (cons
        "abcabcabc" "abc"))))
    (letrec ((loop (lambda (cs i)
        (if (null? cs)
          #t
          (begin
            (run-case
              i (car (car cs)) (cdr (car cs)))
            (loop
              (cdr cs) (+
                i 1)))))))
      (loop
        cases 0))))
