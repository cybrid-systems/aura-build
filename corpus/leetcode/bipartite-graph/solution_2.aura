;; Bipartite graph checker using BFS/DFS 2-coloring
;; Adjacency list: list of lists of neighbors (1-indexed internally, but we'll use 0..n-1)

(define (make-adj n)
  ;; Build adjacency list as a list of n empty lists, then add edges
  (let ((adj '()))
    (let loop ((i 0))
      (if (= i n)
          adj
          (loop (+ i 1))))))

(define (cons-adj adj idx neighbor)
  ;; Returns updated adj where adj[idx] has neighbor consed
  (define before (take-list adj idx))
  (define after (drop-list adj (+ idx 1)))
  (append before (cons neighbor (car after)) (cdr after)))

(define (take-list lst k)
  (if (= k 0)
      '()
      (cons (car lst) (take-list (cdr lst) (- k 1)))))

(define (drop-list lst k)
  (if (= k 0)
      lst
      (drop-list (cdr lst) (- k 1))))

(define (append a b)
  (if (null? a)
      b
      (cons (car a) (append (cdr a) b))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (list-set lst i v)
  (if (= i 0)
      (cons v (cdr lst))
      (cons (car lst) (list-set (cdr lst) (- i 1) v))))

;; Build adjacency for a test case
(define (build-adj n edges)
  (let loop ((adj (make-adj n)) (es edges))
    (if (null? es)
        adj
        (let ((e (car es))
              (rest (cdr es)))
          (let ((u (- (car e) 1))
                (v (- (car (cdr e)) 1)))
            (loop (loop adj u v) rest))))))

(define (loop adj u v)
  (define a1 (cons-adj adj u v))
  (cons-adj a1 v u))

;; Iterative BFS to check bipartiteness starting from a component
;; Uses color array: 0 = uncolored, 1 or 2 = colored
(define (make-array n val)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        acc
        (loop (+ i 1) (cons val acc)))))

(define (arr-set arr i v)
  (if (= i 0)
      (cons v (cdr arr))
      (cons (car arr) (arr-set (cdr arr) (- i 1) v))))

(define (arr-get arr i)
  (if (= i 0)
      (car arr)
      (arr-get (cdr arr) (- i 1))))

;; Check bipartite for whole graph
(define (bipartite? n adj)
  (let ((colors (make-array n 0)))
    (let loop ((v 0))
      (cond
        ((= v n) #t)
        ((= (arr-get colors v) 0)
         (let ((result (bfs-check adj colors v 1)))
           (if (equal? result #f)
               #f
               (loop (+ v 1)))))
        (else (loop (+ v 1)))))))

(define (bfs-check adj colors start color)
  ;; Returns #t if bipartite in this component, #f otherwise
  (let ((queue (list start)))
    (set-colors colors start color)
    (let loop ((q queue))
      (cond
        ((null? q) #t)
        (else
         (let ((u (car q))
               (rest (cdr q)))
           (let ((neighbors (list-ref adj u)))
             (let inner ((ns neighbors) (new-rest rest) (cur-color (arr-get colors u)))
               (cond
                 ((null? ns)
                  (loop new-rest))
                 (else
                  (let ((nb (car ns)))
                    (let ((nc (arr-get colors nb)))
                      (cond
                        ((= nc 0)
                         (set-colors colors nb (- 3 cur-color))
                         (inner (cdr ns) (append new-rest (list nb)) cur-color))
                        ((= nc cur-color) #f)
                        (else (inner (cdr ns) new-rest cur-color)))))))))))))))

(define (set-colors arr i v)
  ;; Functional "set" by rebuilding - inefficient but correct
  (set-arr arr i v))

;; Since Aura has no real mutable arrays, simulate via cons pairs we treat as arrays.
;; Actually, we need mutation. Let's use global state via set! on a list variable.
;; Better approach: use a single mutable list via set!.

(define (solve n edges)
  (let ((adj (build-adj n edges)))
    (bipartite? n adj)))

;; BFS implementation using a mutable color list and set!
(define (bipartite2? n adj)
  (let ((colors (build-colors n)))
    (let loop ((v 0))
      (cond
        ((= v n) #t)
        ((= (list-ref colors v) 0)
         (begin
           (bfs-fill adj colors v 1)
           (loop (+ v 1))))
        (else (loop (+ v 1)))))))

(define (build-colors n)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        acc
        (loop (+ i 1) (cons 0 acc)))))

(define (bfs-fill adj colors start color)
  (set! colors (set-pos colors start color))
  (let ((queue (list start)))
    (let loop ((q queue))
      (cond
        ((null? q) #t)
        (else
         (let* ((u (car q))
                (rest-q (cdr q))
                (cur-c (list-ref colors u))
                (nb-list (list-ref adj u)))
           (let inner ((ns nb-list) (new-q rest-q))
             (cond
               ((null? ns) (loop new-q))
               (else
                (let* ((nb (car ns))
                       (nc (list-ref colors nb)))
                  (cond
                    ((= nc 0)
                     (set! colors (set-pos colors nb (- 3 cur-c)))
                     (inner (cdr ns) (append new-q (list nb))))
                    ((= nc cur-c) #f)
                    (else (inner (cdr ns) new-q))))))))))))))

(define (set-pos lst i v)
  (if (= i 0)
      (cons v (cdr lst))
      (cons (car lst) (set-pos (cdr lst) (- i 1) v))))

;; Final solve using bipartite2?
(define (solve n edges)
  (let ((adj (build-adj n edges)))
    (bipartite2? n adj)))

;; Main: run all test cases
(define (bool->str b) (if b "YES" "NO"))

(define (run-case n edges i)
  (display "CASE")
  (display i)
  (display "=")
  (display (bool->str (solve n edges)))
  (newline))

(run-case 3 '((1 2) (2 3) (1 3)) 0)
(run-case 4 '((1 2) (2 3) (3 4)) 1)
(run-case 1 '() 2)
(run-case 2 '((1 2)) 3)
(run-case 5 '() 4)
(run-case 5 '((1 2) (2 3) (3 4) (4 5) (5 1)) 5)
(run-case 6 '((1 2) (1 3) (2 4) (3 4) (5 6)) 6)
(run-case 4 '((1 2) (1 3) (1 4) (2 3) (2 4) (3 4)) 7)
