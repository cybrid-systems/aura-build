(define (length xs)
  (if (null? xs) 0 (+ 1 (length (cdr xs)))))

(define (list-ref xs i)
  (if (= i 0) (car xs) (list-ref (cdr xs) (- i 1))))

(define (list-set! xs i v)
  (set-car! (list-tail-ref xs i) v))

(define (list-tail-ref xs i)
  (if (= i 0) xs (list-tail-ref (cdr xs) (- i 1))))

(define (make-list n v)
  (if (= n 0) '() (cons v (make-list (- n 1) v))))

(define (solve nums)
  (let* ((n (length nums))
         (result (make-list n -1))
         (stack '()))
    (define (push x) (set! stack (cons x stack)))
    (define (pop) (set! stack (cdr stack)))
    (define (peek) (car stack))
    (define (empty?) (null? stack))
    (let loop ((i 0))
      (if (< i (* 2 n))
        (let* ((idx (modulo i n))
               (val (list-ref nums idx)))
          (begin
            (let pop-loop ()
              (if (not (empty?))
                (if (> val (list-ref nums (peek)))
                  (begin
                    (list-set! result (peek) val)
                    (pop)
                    (pop-loop))
                  '())
                '()))
            (push idx)
            (loop (+ i 1))))
        result))))

(define (display-list xs)
  (display "[")
  (let loop ((xs xs) (first? #t))
    (if (null? xs)
      (display "]")
      (begin
        (if first? (set! first? #f) (display ", "))
        (display (car xs))
        (loop (cdr xs) #f)))))

(define (display-result r)
  (if (or (number? r) (string? r) (equal? r #t) (equal? r #f))
    (display r)
    (display-list r)))

(display "CASE0=") (display-result (solve '(1 2 1))) (newline)
(display "CASE1=") (display-result (solve '(1 2 3 4 3))) (newline)
(display "CASE2=") (display-result (solve '())) (newline)
(display "CASE3=") (display-result (solve '(5))) (newline)
(display "CASE4=") (display-result (solve '(5 4 3 2 1))) (newline)
(display "CASE5=") (display-result (solve '(1 3 2 4))) (newline)
(display "CASE6=") (display-result (solve '(2 2 2 2))) (newline)
(display "CASE7=") (display-result (solve '(3 1 2 5 4))) (newline)
