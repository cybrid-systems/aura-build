(define (next-greater-circular nums)
  (let ((n (length nums)))
    (if (= n 0)
        '()
        (let ((result (make-list n -1))
              (stack '()))
          (let loop ((i 0))
            (cond
              ((>= i (* 2 n)) result)
              (else
               (let ((idx (modulo i n))
                     (val (list-ref nums idx)))
                 (cond
                   ((null? stack)
                    (set! stack (cons idx stack)))
                   (else
                    (let inner ()
                      (cond
                        ((null? stack) #t)
                        ((> val (list-ref nums (car stack)))
                         (let ((top-idx (car stack)))
                           (list-set! result top-idx val)
                           (set! stack (cdr stack))
                           (inner)))
                        (else #t))))
                    (set! stack (cons idx stack))))
                 (loop (+ i 1))))))))))

(define (list-ref lst i)
  (cond
    ((null? lst) (error "list-ref out of bounds"))
    ((= i 0) (car lst))
    (else (list-ref (cdr lst) (- i 1)))))

(define (list-set! lst i v)
  (cond
    ((null? lst) (error "list-set! out of bounds"))
    ((= i 0) (set-car! lst v))
    (else (list-set! (cdr lst) (- i 1) v))))

(define (make-list n val)
  (let loop ((k 0) (acc '()))
    (if (= k n)
        acc
        (loop (+ k 1) (cons val acc)))))

(define (solve nums)
  (next-greater-circular nums))

(define (display-list lst)
  (display "[")
  (let loop ((l lst) (first? #t))
    (cond
      ((null? l) (display "]"))
      (else
       (cond
         ((not first?) (display ", "))
         (else #t))
       (display (car l))
       (loop (cdr l) #f)))))

(display "CASE0=") (display-list (solve '(1 2 1))) (newline)
(display "CASE1=") (display-list (solve '(1 2 3 4 3))) (newline)
(display "CASE2=") (display-list (solve '())) (newline)
(display "CASE3=") (display-list (solve '(5))) (newline)
(display "CASE4=") (display-list (solve '(5 4 3 2 1))) (newline)
(display "CASE5=") (display-list (solve '(1 3 2 4))) (newline)
(display "CASE6=") (display-list (solve '(2 2 2 2))) (newline)
(display "CASE7=") (display-list (solve '(3 1 2 5 4))) (newline)
