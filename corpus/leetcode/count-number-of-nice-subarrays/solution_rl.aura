(require "lc_json" all:)
(require "compat" all:)
(define (odd? n)
  (= (modulo n 2) 1))
(define (at-most nums k)
  (define (helper lst left count result)
    (if (null? lst)
        result
        (let ((x (car lst)))
          (if (odd? x)
              (set! count (+ count 1))
              #f)
          ;; If count exceeds k, advance left pointer
          (let loop ()
            (if (> count k)
                (let ((lx (list-ref nums left)))
                  (set! left (+ left 1))
                  (if (odd? lx)
                      (set! count (- count 1))
                      #f)
                  (loop)
                  )
                #f))
          (set! result (+ result (- left) (- (length (cons x (cdr lst))) (length (cons x (cdr lst))))))
          ;; Actually: result += (right - left + 1) where right is current index
          ;; We need right index; let's track it
          #f)))
  ;; The above approach is getting complex with mutable state and index tracking.
  ;; Let me rewrite using indices and a loop-style helper.
  'unused)
(define (at-most2 nums n k)
  (define left 0)
  (define count 0)
  (define result 0)
  (define right 0)
  (define (step)
    (if (>= right n)
        result
        (let ((x (list-ref nums right)))
          (if (odd? x)
              (set! count (+ count 1))
              #f)
          ;; shrink while count > k
          (let shrink ()
            (if (> count k)
                (let ((lx (list-ref nums left)))
                  (set! left (+ left 1))
                  (if (odd? lx)
                      (set! count (- count 1))
                      #f)
                  (shrink))
                #f))
          ;; add subarrays ending at right
          (set! result (+ result (- right left -1)))
          ;; that was wrong: (right - left + 1) subarrays end at right
          (set! result (- result 1)) ;; compensate - actually set directly
          ;; Redo:
          #f)))
  ;; Cleanest: redo at-most from scratch
  result)
(define (at-most-k nums n k)
  (if (< k 0)
      0
      (let ((left 0)
            (count 0)
            (result 0)
            (right 0))
        (let loop ((r 0))
          (if (>= r n)
              result
              (begin
                (if (odd? (list-ref nums r))
                    (set! count (+ count 1))
                    '())
                ;; shrink while count > k
                (let shrink ((l left))
                  (if (> count k)
                      (begin
                        (if (odd? (list-ref nums l))
                            (set! count (- count 1))
                            '())
                        (set! left (+ left 1))
                        (shrink (+ l 1)))
                      '()))
                (set! result (+ result (- r left -1)))
                ;; fix: subarrays ending at r with window [left..r] valid => r-left+1
                (set! result (- result 1))  ;; undo and redo properly
                (set! result (+ result (- (- r left) 1)))
                ;; still messy. Let me just use straightforward math
                '()))))
        result))
(define (at-most nums n k)
  (if (< k 0)
      0
      (at-most-helper nums n k 0 0 0)))
(define (at-most-helper nums n k left count)
  ;; Iterates through right implicitly via accumulator; but we need 'result' too.
  ;; Let's pass result as parameter.
  (at-most-loop nums n k left count 0 0))
(define (at-most-loop nums n k left count right result)
  (if (>= right n)
      result
      (let ((x (list-ref nums right)))
        (set! count (if (odd? x) (+ count 1) count))
        (let ((new-left (shrink-left nums left count k)))
          (set! count (new-count-after-shrink nums left new-left count))
          (let ((new-count (count-after-shrink nums left new-left count)))
            (at-most-loop nums n k new-left new-count (+ right 1)
                          (+ result (- right new-left -1))))))))
(define (solve nums k)
  (let ((n (length nums)))
    (- (count-at-most nums n k)
       (count-at-most nums n (- k 1)))))
(define (count-at-most nums n k)
  (if (< k 0)
      0
      (cam-loop nums n k 0 0 0 0)))
(define (cam-loop nums n k left count right result)
  (if (>= right n)
      result
      (let* ((x (list-ref nums right))
             (new-count (if (odd? x) (+ count 1) count))
             (vals (shrink-helper nums left new-count k))
             (new-left (car vals))
             (final-count (cdr vals)))
        (cam-loop nums n k new-left final-count (+ right 1)
                  (+ result (- right new-left -1))))))
(define (shrink-helper nums left count k)
  (if (> count k)
      (let ((lx (list-ref nums left)))
        (shrink-helper nums (+ left 1)
                       (if (odd? lx) (- count 1) count)
                       k))
      (cons left count)))
(define (display-list lst)
  (display "(")
  (let loop ((l lst) (first #t))
    (cond
      ((null? l) (display ")"))
      (else
       (if first (set! first #f) (display " "))
       (display (car l))
       (loop (cdr l) #f)))))
(define (run-case i nums k)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums k))
  (newline))
(define (main)
  (run-case 0 '(1 1 2 1 2) 3)
  (run-case 1 '(2 2 2 1 2 2 1 2 2 2) 1)
  (run-case 2 '(2 2 2 2) 1)
  (run-case 3 '(1 1 1 1 1) 2)
  (run-case 4 '(1) 1)
  (run-case 5 '(1) 2)
  (run-case 6 '(1 2 3 4 5 6 7) 2)
  (run-case 7 '(2 4 6 8 10 12) 1))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums") (hash-ref input "k")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/count-number-of-nice-subarrays/tests.json")))
