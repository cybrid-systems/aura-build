(define (parse-input s)
  (let loop ((chars (string->list s))
             (cur '())
             (tokens '()))
    (cond
      ((null? chars)
       (if (null? cur)
               (reverse tokens)
               (reverse (cons (list->number (reverse cur)) tokens))))
      ((or (char=? (car chars) #\space) (char=? (car chars) #\tab) (char=? (car chars) #\newline))
       (if (null? cur)
           (loop (cdr chars) cur tokens)
           (loop (cdr chars) '() (cons (list->number (reverse cur)) tokens))))
      (else
       (loop (cdr chars) (cons (car chars) cur) tokens)))))

(define (list->number lst)
  (let loop ((lst lst) (acc 0))
    (if (null? lst)
        acc
        (loop (cdr lst) (+ (* acc 10) (- (char->integer (car lst)) (char->integer #\0)))))))

(define (char=? a b)
  (= (char->integer a) (char->integer b)))

(define (string->list s)
  (let loop ((i 0) (acc '()))
    (if (= i (string-length s))
        acc
        (loop (+ i 1) (cons (string-ref s i) acc)))))

(define (string-length s)
  (let loop ((i 0))
    (if (char=? (string-ref s i) #\null)
        i
        (loop (+ i 1)))))

(define (string-ref s i)
  ;; Simple vector-like access using a global table
  (vector-ref s i))

(define (char->integer c)
  (cond
    ((char=? c #\0) 0)
    ((char=? c #\1) 1)
    ((char=? c #\2) 2)
    ((char=? c #\3) 3)
    ((char=? c #\4) 4)
    ((char=? c #\5) 5)
    ((char=? c #\6) 6)
    ((char=? c #\7) 7)
    ((char=? c #\8) 8)
    ((char=? c #\9) 9)
    ((char=? c #\space) 32)
    ((char=? c #\tab) 9)
    ((char=? c #\newline) 10)
    ((char=? c #\null) 0)
    (else 0)))

(define (vector-ref v i)
  ;; For our purposes, we store strings as cons-lists; this is unused fallback
  (car (list-tail v i)))

(define (list-tail lst i)
  (if (= i 0)
      lst
      (list-tail (cdr lst) (- i 1))))

(define (vector-set! v i val)
  (set-car! (list-tail v i) val))

;; Override: represent string as list of chars internally via parse
;; To keep simple, we'll just track positions using a different representation.

;; Simpler approach: parse numbers directly from string using index arithmetic
(define (string-length-impl s)
  ;; s is a list of chars; length is its length
  (let loop ((l s) (n 0))
    (if (null? l) n (loop (cdr l) (+ n 1)))))

(define (string-ref-impl s i)
  (let loop ((l s) (j 0))
    (if (= j i) (car l) (loop (cdr l) (+ j 1)))))

(define (parse-numbers s)
  (let loop ((chars s) (cur '()) (tokens '()))
    (cond
      ((null? chars)
       (if (null? cur)
           (reverse tokens)
           (reverse (cons (chars->number (reverse cur)) tokens))))
      ((or (char=? (car chars) #\space) (char=? (car chars) #\tab) (char=? (car chars) #\newline))
       (if (null? cur)
           (loop (cdr chars) cur tokens)
           (loop (cdr chars) '() (cons (chars->number (reverse cur)) tokens))))
      (else
       (loop (cdr chars) (cons (car chars) cur) tokens)))))

(define (chars->number lst)
  (let loop ((lst lst) (acc 0))
    (if (null? lst)
        acc
        (loop (cdr lst) (+ (* acc 10) (- (char->integer (car lst)) (char->integer #\0)))))))

;; Binary search: find leftmost index k such that tails[k] >= x
;; tails is a list of numbers in increasing order (no guarantees about equality pattern beyond monotonically non-decreasing tails structure)
(define (lower-bound tails x)
  (let ((len (length tails)))
    (let loop ((lo 0) (hi len))
      (if (= lo hi)
          lo
          (let ((mid (quotient (+ lo hi) 2)))
            (if (>= (list-ref tails mid) x)
                (loop lo mid)
                (loop (+ mid 1) hi)))))))

(define (length lst)
  (let loop ((l lst) (n 0))
    (if (null? l) n (loop (cdr l) (+ n 1)))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (list-set! lst i val)
  (if (= i 0)
      (set-car! lst val)
      (list-set! (cdr lst) (- i 1) val)))

;; LIS using patience sort with mutable cons-list "array"
(define (lis-length nums)
  (let ((tails (list 0)))  ; placeholder; we'll manage a proper mutable list via set!
    ;; Actually, use a vector-like approach: cons-list of numbers with set-car!/set-cdr!
    ;; We'll use a helper: build tails as a linked list where we can replace elements.
    ;; For simplicity, use a list and rebuild when replacing (O(n) per op is fine for small n).
    ;; But we want O(n log n). Use an explicit cons list with mutators.
    ;; Use a list-of-cells approach:
    (let ((cells (list (cons 0 '()))))
      ;; cells is a list of cons cells; we can set-car! on them.
      (define (cell-ref cells idx)
        (if (= idx 0)
            (car cells)
            (cell-ref (cdr cells) (- idx 1))))
      (define (cell-set! cells idx val)
        (set-car! (cell-ref cells idx) val))
      (define (num-cells cells)
        (let loop ((c cells) (n 0))
          (if (null? c) n (loop (cdr c) (+ n 1)))))
      (let loop ((nums nums))
        (if (null? nums)
            (num-cells cells)
            (let* ((x (car nums))
                   (idx (lower-bound-cell cells x)))
              (if (= idx (num-cells cells))
                  ;; extend cells with a new cons cell holding x
                  (let loop2 ((c cells))
                    (if (null? (cdr c))
                        (begin (set-cdr! c (list (cons x '()))) (loop (cdr nums)))
                        (loop2 (cdr c)))))
                  (begin (cell-set! cells idx x) (loop (cdr nums))))))))))

(define (lower-bound-cell cells x)
  (let ((n (num-cells cells)))
    (let loop ((lo 0) (hi n))
      (if (= lo hi)
          lo
          (let ((mid (quotient (+ lo hi) 2)))
            (if (>= (car (cell-ref cells mid)) x)
                (loop lo mid)
                (loop (+ mid 1) hi)))))))

(define (solve args)
  (let* ((chars (string->chars args))
         (nums (parse-numbers chars)))
    (lis-length nums)))

(define (string->chars s)
  ;; Build a list of chars from string s (which is represented as a list of char codes internally? unclear).
  ;; We'll define args as a list of char codes actually passed via a wrapper.
  ;; For our embedded tests, we'll wrap each input.
  s)

;; We need a way to get char list from string literal. We'll use a helper that
;; takes the raw string as a list-of-chars (provided by the test harness).
;; Since Aura doesn't have native strings here, we accept args as a list of chars.

(define (lis-length-list nums)
  (if (null? nums)
      0
      (let ((cells (list (cons (car nums) '()))))
        (define (cell-ref cells idx)
          (if (= idx 0)
              (car cells)
              (cell-ref (cdr cells) (- idx 1))))
        (define (num-cells cells)
          (let loop ((c cells) (n 0))
            (if (null? c) n (loop (cdr c) (+ n 1)))))
        (define (cell-tail-val cells idx)
          (car (cell-ref cells idx)))
        (define (cell-set-val! cells idx val)
          (set-car! (cell-ref cells idx) val))
        (define (lower-bound cells x)
          (let ((n (num-cells cells)))
            (let loop ((lo 0) (hi n))
              (if (= lo hi)
                  lo
                  (let ((mid (quotient (+ lo hi) 2)))
                    (if (>= (cell-tail-val cells mid) x)
                        (loop lo mid)
                        (loop (+ mid 1) hi)))))))
        (define (append-cell! cells val)
          (let loop ((c cells))
            (if (null? (cdr c))
                (set-cdr! c (list (cons val '())))
                (loop (cdr c)))))
        (let loop ((nums (cdr nums)))
          (if (null? nums)
              (num-cells cells)
              (let* ((x (car nums))
                     (idx (lower-bound cells x)))
                (if (= idx (num-cells cells))
                    (begin (append-cell! cells x) (loop (cdr nums)))
                    (begin (cell-set-val! cells idx x) (loop (cdr nums)))))))))))

(define (solve args)
  (lis-length-list (parse-numbers args)))

;; Tests
(define (run-tests)
  (begin
    (display "CASE0=") (display (solve '(#\1 #\space #\3 #\space #\2 #\space #\4 #\space #\3 #\space #\5))) (newline)
    (display "CASE1=") (display (solve '(#\5 #\space #\4 #\space #\3 #\space #\2 #\space #\1))) (newline)
    (display "CASE2=") (display (solve '())) (newline)
    (display "CASE3=") (display (solve '(#\1 #\space #\2 #\space #\3 #\space #\4 #\space #\5))) (newline)
    (display "CASE4=") (display (solve '(#\5 #\space #\4 #\space #\3 #\space #\2 #\space #\1 #\space #\6))) (newline)
    (display "CASE5=") (display (solve '(#\2 #\space #\2 #\space #\2))) (newline)
    (display "CASE6=") (display (solve '(#\0))) (newline)
    (display "CASE7=") (display (solve '(#\3 #\space #\1 #\space #\4 #\space #\1 #\space #\5 #\space #\9 #\space #\2 #\space #\6 #\space #\5 #\space #\3))) (newline)))

(run-tests)
