(require "lc_json" all:)
(require "compat" all:)
(define (make-node v l r) (list v l r))
(define (build-tree lst)
  (define (helper lst idx)
    (if (or (null? lst) (>= idx (length lst)))
        '()
        (let ((v (list-ref lst idx)))
          (if (null? v)
              '()
              (let ((l (helper lst (+ (* idx 2) 1)))
                    (r (helper lst (+ (* idx 2) 2))))
                (make-node v l r))))))
  (helper lst 0))
(define (same? p q)
  (cond
    ((and (null? p) (null? q)) #t)
    ((or (null? p) (null? q)) #f)
    (else
      (let ((vp (car p)) (lp (car (cdr p))) (rp (car (cdr (cdr p))))
            (vq (car q)) (lq (car (cdr q))) (rq (car (cdr (cdr q)))))
        (if (equal? vp vq)
            (and (same? lp lq) (same? rp rq))
            #f)))))
(define (solve p q)
  (same? (build-tree p) (build-tree q)))
(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display result)
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "p") (hash-ref input "q")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/same-tree/tests.json")))
