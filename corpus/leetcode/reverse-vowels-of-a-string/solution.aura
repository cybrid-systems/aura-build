(define (vowel? c)
  (or (equal? c #\a)
      (equal? c #\e)
      (equal? c #\i)
      (equal? c #\o)
      (equal? c #\u)))

(define (list-set lst i v)
  (if (= i 0)
      (cons v (cdr lst))
      (cons (car lst) (list-set (cdr lst) (- i 1) v))))

(define (reverse-vowels-helper chars left right)
  (cond
    ((>= left right) chars)
    ((and (vowel? (list-ref chars left))
          (vowel? (list-ref chars right)))
     (let ((temp (list-ref chars left)))
       (reverse-vowels-helper
        (list-set (list-set chars left (list-ref chars right)) right temp)
        (+ left 1)
        (- right 1))))
    ((not (vowel? (list-ref chars left)))
     (reverse-vowels-helper chars (+ left 1) right))
    (else
     (reverse-vowels-helper chars left (- right 1)))))

(define (solve s)
  (let* ((len (string-length s))
         (chars (string->list s))
         (reversed-chars (reverse-vowels-helper chars 0 (- len 1))))
    (list->string reversed-chars)))

(define (display-list-result lst)
  (display lst))

(define CASE0_S "hello")
(define CASE1_S "leetcode")
(define CASE2_S "aA")
(define CASE3_S "")
(define CASE4_S "a")
(define CASE5_S "bcdfg")
(define CASE6_S "aeiou")
(define CASE7_S "a1e2i3o4u5")
(define CASE8_S "racecar")
(define CASE9_S "Design a program to reverse vowels")

(display "CASE0=") (display (solve CASE0_S)) (newline)
(display "CASE1=") (display (solve CASE1_S)) (newline)
(display "CASE2=") (display (solve CASE2_S)) (newline)
(display "CASE3=") (display (solve CASE3_S)) (newline)
(display "CASE4=") (display (solve CASE4_S)) (newline)
(display "CASE5=") (display (solve CASE5_S)) (newline)
(display "CASE6=") (display (solve CASE6_S)) (newline)
(display "CASE7=") (display (solve CASE7_S)) (newline)
(display "CASE8=") (display (solve CASE8_S)) (newline)
(display "CASE9=") (display (solve CASE9_S)) (newline)
