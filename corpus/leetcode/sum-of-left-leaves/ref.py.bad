import os, sys, json

def tokenize(s):
    """Split an S-expression string into tokens, keeping parens as tokens."""
    s = s.replace('(', ' ( ').replace(')', ' ) ')
    return [t for t in s.split() if t]

def parse(tokens):
    """Parse token list into nested lists (S-expression)."""
    if not tokens:
        return None
    tok = tokens.pop(0)
    if tok == '(':
        lst = []
        while tokens and tokens[0] != ')':
            lst.append(parse(tokens))
        tokens.pop(0)  # consume ')'
        return lst
    elif tok == ')':
        return None
    elif tok == 'nil':
        return None
    else:
        # number
        try:
            return int(tok)
        except ValueError:
            return tok

def build_tree(expr):
    """Convert parsed S-expression into (value, left, right) tuples."""
    if expr is None:
        return None
    # expr should be [value, left, right]
    if isinstance(expr, list) and len(expr) >= 1:
        val = expr[0]
        left = build_tree(expr[1]) if len(expr) > 1 else None
        right = build_tree(expr[2]) if len(expr) > 2 else None
        return (val, left, right)
    return None

def sum_left_leaves(node, is_left=False):
    """Recursively sum values of left leaves."""
    if node is None:
        return 0
    val, left, right = node
    # check if this node is a leaf
    is_leaf = (left is None and right is None)
    total = 0
    if is_leaf and is_left:
        total = val
    # Recurse: left child is a left child, right child is not
    total += sum_left_leaves(left, is_left=True)
    total += sum_left_leaves(right, is_left=False)
    return total

def solve(root):
    """Compute sum of all left leaves."""
    tree = build_tree(root)
    return sum_left_leaves(tree)

if __name__ == '__main__':
    # Get CASE0 env var, parse it
    case0 = os.environ.get('CASE0', '')
    # tokens format: ("(3" "(2" "(nil" "nil)" ...)
    tokens = tuple(case0.split())
    
    # Build S-expression string
    expr_str = ' '.join(tokens)
    toks = tokenize(expr_str)
    parsed = parse(toks)
    
    result = solve(parsed)
    print(f"{result}nil")
