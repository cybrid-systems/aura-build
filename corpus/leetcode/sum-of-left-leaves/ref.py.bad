import os
import json


def parse_tree_from_tokens(tokens):
    """Parse tokens into a tree where each node is [value, left, right] or None."""
    pos = [0]

    def parse():
        if pos[0] >= len(tokens):
            return None
        tok = tokens[pos[0]]
        pos[0] += 1
        if tok == 'nil':
            return None
        # node: ( value left right )
        value = int(tok)
        left = parse()
        right = parse()
        return [value, left, right]

    return parse()


def sum_left_leaves(root):
    """Compute sum of all left leaves using iterative DFS."""
    if root is None:
        return 0
    total = 0
    # Stack holds nodes to visit; for each, mark if it's a left child
    # Use tuple (node, is_left)
    stack = [(root, False)]
    while stack:
        node, is_left = stack.pop()
        if node is None:
            continue
        val, left, right = node[0], node[1], node[2]
        if left is None and right is None and is_left:
            total += val
        if right is not None:
            stack.append((right, False))
        if left is not None:
            stack.append((left, True))
    return total


def solve(case_str):
    """case_str: the raw CASE0 string like ('(3' '(2' ... '(nil' 'nil)))' ..."""
    tokens = case_str.split()
    # Remove parentheses from tokens
    cleaned = []
    for t in tokens:
        s = t.strip()
        if s.startswith('('):
            s = s[1:]
        if s.endswith(')'):
            s = s[:-1]
        if s == '':
            continue
        cleaned.append(s)
    root = parse_tree_from_tokens(cleaned)
    result = sum_left_leaves(root)
    print(f"{result}nil")


# CASES for testing - the actual tree S-expressions as strings
CASES = [
    {
        "input": "(3 (2 nil nil) (2 (5 nil nil) (6 nil nil)))",
    },
    {
        "input": "(1 (2 nil nil) (3 nil nil))",
    },
    {
        "input": "nil",
    },
    {
        "input": "(1 nil nil)",
    },
    {
        "input": "(1 (2 (4 nil nil) (5 nil nil)) (3 (6 nil nil) (7 nil nil)))",
    },
    {
        "input": "(5 (3 (2 nil nil) (4 nil nil)) (7 (6 nil nil) (8 nil nil)))",
    },
    {
        "input": "(1 (2 (3 nil nil) nil) nil)",
    },
    {
        "input": "(1 (2 nil (4 nil nil)) (3 nil nil))",
    },
]


if __name__ == '__main__':
    results = []
    for i, case in enumerate(CASES):
        inp = case["input"]
        # simulate the env-var input style: tokens split
        tokens = inp.split()
        cleaned = []
        for t in tokens:
            s = t.strip()
            if s.startswith('('):
                s = s[1:]
            if s.endswith(')'):
                s = s[:-1]
            if s == '':
                continue
            cleaned.append(s)
        root = parse_tree_from_tokens(cleaned)
        expected = sum_left_leaves(root)
        canonical = f"{expected}nil"
        results.append({
            "id": i,
            "input": {"case": inp},
            "expected": canonical,
        })
    print(json.dumps(results, separators=(',', ':'), ensure_ascii=False))
