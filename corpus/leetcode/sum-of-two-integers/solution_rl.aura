(require "compat" all:)
(define mask 4294967295)
(define (to32 x) (bit-and x mask))
(define (s32 x)
  (if (> x 2147483647)
      (- x 4294967296)
      x))

(define (add-bits a b)
  (if (= b 0)
      (s32 (to32 a))
      (add-bits (bit-xor a b) (arithmetic-shift (bit-and a b) 1))))

(define (solve a b)
  (add-bits a b))

(define (run-case i)
  (cond
    ((= i 0) (solve 2 3))
    ((= i 1) (solve -1 1))
    ((= i 2) (solve 0 0))
    ((= i 3) (solve -12 -8))
    ((= i 4) (solve 100 -200))
    ((= i 5) (solve 2147483647 0))
    ((= i 6) (solve -2147483648 -1))
    ((= i 7) (solve 123456789 -987654321))
    (else 0)))

(define (print-case i)
  (display "CASE")
  (display (number->string i))
  (display "=")
  (display (number->string (run-case i)))
  (newline))

(print-case 0)
(print-case 1)
(print-case 2)
(print-case 3)
(print-case 4)
(print-case 5)
(print-case 6)
(print-case 7)
