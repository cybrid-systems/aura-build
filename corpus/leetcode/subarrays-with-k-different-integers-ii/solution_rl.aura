(require "lc_json" all:)
(require "compat" all:)
(define (make-map) '())
(define (map-get m key)
  (let ((p (assoc key m)))
    (if p (cdr p) 0)))
(define (map-set m key val)
  (let ((p (assoc key m)))
    (if p
        (begin (set-cdr! p val) m)
        (cons (cons key val) m))))
(define (map-inc m key)
  (map-set m key (+ (map-get m key) 1)))
(define (map-dec m key)
  (map-set m key (- (map-get m key) 1)))
(define (count-distinct m)
  (let loop ((rest m) (c 0))
    (if (null? rest)
        c
        (loop (cdr rest) (+ c 1)))))
(define (at-most-k nums k)
  (if (<= k 0)
      0
      (let loop ((left 0) (right 0) (m (make-map)) (total 0))
        (if (>= right (length nums))
            total
            (let* ((r-val (list-ref nums right))
                   (m2 (map-inc m r-val)))
              (let shrink ((l left) (mm m2))
                (if (> (count-distinct mm) k)
                    (let* ((l-val (list-ref nums l))
                           (mm2 (map-dec mm l-val)))
                      (shrink (+ l 1) mm2))
                    (loop l (+ right 1) mm (+ total (- right l) 1)))))))))
(define (solve nums k)
  (at-most-k nums k))
(define (display-list xs)
  (display "(")
  (let loop ((rest xs) (first #t))
    (cond ((null? rest) (display ")"))
          (else
           (if first
               (set! first #f)
               (display " "))
           (display (car rest))
           (loop (cdr rest) first)))))
(define (display-result r)
  (display r))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums") (hash-ref input "k")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/subarrays-with-k-different-integers-ii/tests.json")))
