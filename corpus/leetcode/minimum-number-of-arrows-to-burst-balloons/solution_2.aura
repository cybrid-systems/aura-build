;; Minimum Number of Arrows to Burst Balloons - greedy solution

(define (length lst)
  (if (null? lst) 0
      (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (balloon-right b) (car (cdr b)))
(define (balloon-left b) (car b))

(define (balloon-<= b1 b2)
  (let ((r1 (balloon-right b1))
        (r2 (balloon-right b2)))
    (if (< r1 r2) #t
        (if (= r1 r2)
            (<= (balloon-left b1) (balloon-left b2))
            #f))))

;; Insert b into sorted list (by right endpoint, then left)
(define (insert-sorted lst b)
  (cond ((null? lst) (cons b '()))
        ((balloon-<= b (car lst))
         (cons b lst))
        (else (cons (car lst)
                    (insert-sorted (cdr lst) b)))))

(define (sort-by-right lst)
  (if (null? lst) '()
      (insert-sorted (cdr lst) (car lst))))

(define (solve points)
  (let* ((sorted (sort-by-right points))
         (n (length sorted)))
    (solve-helper sorted n 0 0)))

(define (solve-helper sorted n idx arrow-pos count)
  (if (>= idx n)
      count
      (let* ((b (list-ref sorted idx))
             (b-left (balloon-left b))
             (b-right (balloon-right b)))
        (if (and (> count 0)
                 (>= arrow-pos b-left)
                 (<= arrow-pos b-right))
            ;; arrow at arrow-pos already bursts this balloon
            (solve-helper sorted n (+ idx 1) arrow-pos count)
            ;; need a new arrow at the right endpoint
            (solve-helper sorted n (+ idx 1) b-right (+ count 1))))))

;; Test cases
(define case0 '((10 16) (2 8) (1 6) (7 12)))
(define case1 '((1 2) (3 4) (5 6) (7 8)))
(define case2 '((1 2) (2 3) (3 4) (4 5)))
(define case3 '((0 1)))
(define case4 '((1 10) (2 5) (6 9) (3 8)))
(define case5 '((-5 5) (-3 3) (-1 1) (0 2) (4 8)))
(define case6 '((1 2) (2 3) (2 4) (5 6)))
(define case7 '((1 3) (2 4) (3 5) (4 6)))

(display "CASE0=") (display (solve case0)) (newline)
(display "CASE1=") (display (solve case1)) (newline)
(display "CASE2=") (display (solve case2)) (newline)
(display "CASE3=") (display (solve case3)) (newline)
(display "CASE4=") (display (solve case4)) (newline)
(display "CASE5=") (display (solve case5)) (newline)
(display "CASE6=") (display (solve case6)) (newline)
(display "CASE7=") (display (solve case7)) (newline)
