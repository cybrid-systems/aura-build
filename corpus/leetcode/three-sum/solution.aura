;; Aura program for 3Sum

(define (sort-vec v)
  ;; Convert vector to list, sort, convert back
  (define (list-from-vec v i)
    (if (= i (vector-length v))
        '()
        (cons (vector-ref v i) (list-from-vec v (+ i 1)))))
  (define (sorted lst)
    (define (insert x sorted-lst)
      (cond ((null? sorted-lst) (cons x '()))
            ((<= x (car sorted-lst)) (cons x sorted-lst))
            (else (cons (car sorted-lst) (insert x (cdr sorted-lst))))))
    (define (loop lst acc)
      (if (null? lst)
          acc
          (loop (cdr lst) (insert (car lst) acc))))
    (loop lst '()))
  (define (vec-from-list lst)
    (define (loop lst i v)
      (if (null? lst)
          v
          (begin
            (vector-set! v i (car lst))
            (loop (cdr lst) (+ i 1) v))))
    (loop lst 0 (make-vector (length lst))))
  (vec-from-list (sorted (list-from-vec v 0))))

(define (solve nums)
  (let* ((n (vector-length nums))
         (sorted (sort-vec nums))
         (result (make-vector 0)))
    ;; Two-pointer 3Sum
    (define (two-sum i l r)
      (let loop ((l l) (r r))
        (cond ((>= l r) 'done)
              (else
                (let ((s (+ (vector-ref sorted i)
                            (+ (vector-ref sorted l)
                               (vector-ref sorted r))))))
                  (cond ((= s 0)
                         (vector-push-back! result 
                           (vector (vector-ref sorted i)
                                   (vector-ref sorted l)
                                   (vector-ref sorted r)))
                         ;; skip duplicates on l
                         (let loop-l ((ll l))
                           (if (or (>= ll r) (not (= (vector-ref sorted ll) (vector-ref sorted l))))
                               (loop (+ ll 1) (- r 1))
                               (loop-l (+ ll 1)))))
                        ((< s 0) (loop (+ l 1) r))
                        (else (loop l (- r 1)))))))))

    ;; Main anchor loop
    (let loop-i ((i 0))
      (cond ((>= i (- n 2)) 'done)
            (else
              ;; Skip duplicate anchors
              (if (and (> i 0) (= (vector-ref sorted i) (vector-ref sorted (- i 1))))
                  (loop-i (+ i 1))
                  (begin
                    (two-sum i (+ i 1) (- n 1))
                    (loop-i (+ i 1))))))))

    ;; Convert result to a vector of vectors (already is)
    result))

;; Helper to display result
(define (display-result res)
  (let ((n (vector-length res)))
    (let loop ((i 0))
      (cond ((>= i n) (display "[]"))
            (else
              (let ((t (vector-ref res i)))
                (display "[")
                (display (vector-ref t 0))
                (display ",")
                (display (vector-ref t 1))
                (display ",")
                (display (vector-ref t 2))
                (display "]")
                (newline)
                (loop (+ i 1))))))))

;; Helper for vector-push-back - need to define since Aura may not have it
;; Implement as: create new vector of size+1, copy, set
(define (vector-push-back! v x)
  (let* ((n (vector-length v))
         (new-v (make-vector (+ n 1))))
    (let loop ((i 0))
      (cond ((>= i n) 'done)
            (else
              (vector-set! new-v i (vector-ref v i))
              (loop (+ i 1)))))
    (vector-set! new-v n x)
    ;; Can't actually replace binding in Aura easily; 
    ;; So use a different approach: collect into a list first
    ))

;; Let me rewrite using a list-based approach instead

(define (solve nums)
  (let* ((n (vector-length nums))
         (sorted (sort-vec nums))
         (result-list '()))

    (define (two-sum i l r result-acc)
      ;; iterative using accumulator
      result-acc)

    ;; Recursive 3Sum using lists
    (define (three-sum-helper i result-acc)
      (if (>= i (- n 2))
          result-acc
          (let* ((anchor (vector-ref sorted i))
                 (next-i (+ i 1)))
            (cond
              ;; Skip duplicate anchors (but only after first)
              ((and (> i 0) (= anchor (vector-ref sorted (- i 1))))
               (three-sum-helper next-i result-acc))
              (else
               (let ((new-acc (find-triplets sorted i next-i (- n 1) anchor result-acc)))
                 (three-sum-helper next-i new-acc)))))))

    (define (find-triplets sorted i l r anchor acc)
      (cond ((>= l r) acc)
           (else
            (let* ((a (vector-ref sorted l))
                   (b (vector-ref sorted r))
                   (s (+ anchor (+ a b)))))
              (cond ((= s 0)
                     (let* ((triplet (list anchor a b))
                            (new-acc (cons triplet acc)))
                       (find-triplets sorted i (+ l 1) (- r 1) 
                                      anchor (skip-l sorted (+ l 1) (- r 1) a new-acc))))
                    ((< s 0) (find-triplets sorted i (+ l 1) r anchor acc))
                    (else (find-triplets sorted i l (- r 1) anchor acc)))))))

    (define (skip-l sorted l r a acc)
      (cond ((>= l r) (find-triplets sorted i l r anchor acc))
           ((= (vector-ref sorted l) a) (skip-l sorted (+ l 1) r a acc))
           (else (find-triplets sorted i l r anchor acc))))

    ;; Note: the above has a bug - skip-l doesn't call find-triplets correctly with updated i
    ;; Let me restructure with mutual recursion / accumulator properly

    result-list))

