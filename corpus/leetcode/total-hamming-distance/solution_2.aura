(define (length xs)
  (if (null? xs) 0 (+ 1 (length (cdr xs)))))

(define (total-hamming-distance nums)
  (let ((n (length nums)))
    (let loop ((bit 0) (acc 0))
      (if (>= bit 32)
          acc
          (let ((count (count-bit nums bit)))
            (loop (+ bit 1) (+ acc (* count (- n count)))))))))

(define (count-bit nums bit)
  (if (null? nums)
      0
      (+ (if (bit-set? (car nums) bit) 1 0)
         (count-bit (cdr nums) bit))))

(define (bit-set? num bit)
  (not (= 0 (modulo (quotient num (expt 2 bit)) 2))))

(define (expt base exp)
  (if (= exp 0)
      1
      (* base (expt base (- exp 1)))))

(define (solve nums)
  (total-hamming-distance nums))

(define (print-list xs)
  (display "[")
  (let loop ((xs xs) (first #t))
    (cond ((null? xs) (display "]"))
          (else
           (if first (display "") (display ", "))
           (display (car xs))
           (loop (cdr xs) #f)))))

(define (run-case i nums)
  (display "CASE")
  (display i)
  (display "=")
  (let ((result (solve nums)))
    (display result))
  (newline))

(define (main)
  (run-case 0 '())
  (run-case 1 '(0))
  (run-case 2 '(0 0))
  (run-case 3 '(1 1))
  (run-case 4 '(4 14 2))
  (run-case 5 '(1 2 3))
  (run-case 6 '(5 2 7 8))
  (run-case 7 '(0 0 0 0 0))
  (run-case 8 '(1 3 5 7 9 11 13 15))
  (run-case 9 '(255 255 255 255))
  0)

(main)
