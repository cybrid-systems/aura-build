(require "lc_json" all:)
(require "compat" all:)
(define (list->set lst)
  (let loop ((lst lst) (acc '()))
    (if (null? lst)
        acc
        (loop (cdr lst) (cons (car lst) acc)))))
(define (set-contains? s x)
  (cond ((null? s) #f)
        ((equal? (car s) x) #t)
        (else (set-contains? (cdr s) x))))
(define (substring-eq? s start len target)
  (let loop ((i 0))
    (cond ((= i len) #t)
          ((equal? (string-ref s (+ start i)) (string-ref target i)) (loop (+ i 1)))
          (else #f))))
(define (word-break? s word-set n)
  (let ((dp (make-vector (+ n 1) #f)))
    (vector-set! dp 0 #t)
    (let loop-i ((i 0))
      (if (> i n)
          (vector-ref dp n)
          (let ((cur (vector-ref dp i)))
            (if cur
                (let loop-w ((w word-set))
                  (if (null? w)
                      (loop-i (+ i 1))
                      (let ((wlen (string-length (car w))))
                        (if (and (<= (+ i wlen) n)
                                 (substring-eq? s i wlen (car w)))
                            (vector-set! dp (+ i wlen) #t))
                        (loop-w (cdr w)))))
                (loop-i (+ i 1))))))))
(define (solve s wordDict)
  (word-break? s (list->set wordDict) (string-length s)))
(define (bool->str b) (if b "#t" "#f"))
(define (run-case i s wd)
  (let ((r (solve s wd)))
    (display (string-append "CASE" (number->string i) "="))
    (display (bool->str r))
    (newline)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "s") (hash-ref input "wordDict")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/word-break/tests.json")))
