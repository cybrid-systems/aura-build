;; Online Election - prefix leaders + binary search

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (nth lst n)
  (if (= n 0)
      (car lst)
      (nth (cdr lst) (- n 1))))

;; Increment count for person in association list.
;; counts is ((id . count) ...) - linear search.
(define (count-vote counts person)
  (cond ((null? counts) (list (cons person 1)))
        ((= (car (car counts)) person)
         (cons (cons person (+ 1 (cdr (car counts)))) (cdr counts)))
        (else (cons (car counts) (count-vote (cdr counts) person)))))

;; Find leader: highest count, ties broken by smaller id
(define (find-leader counts best-id best-cnt)
  (if (null? counts)
      best-id
      (let* ((e (car counts))
             (p (car e))
             (c (cdr e)))
        (if (or (> c best-cnt)
                (and (= c best-cnt) (< p best-id)))
            (find-leader (cdr counts) p c)
            (find-leader (cdr counts) best-id best-cnt)))))

(define (current-leader counts)
  (if (null? counts)
      0
      (let ((f (car counts)))
        (find-leader (cdr counts) (car f) (cdr f)))))

(define (build-leaders votes-at votes-for)
  (letrec ((len (length votes-at))
           (loop (lambda (i counts acc)
                   (if (= i len)
                       acc
                       (let* ((person (nth votes-for i))
                              (new-c (count-vote counts person))
                              (leader (current-leader new-c)))
                         (loop (+ i 1) new-c (cons leader acc)))))))
    (reverse (loop 0 '() '()))))

;; Find largest index i such that votes-at[i] <= t
;; Returns -1 if t < votes-at[0]
(define (upper-bound votes-at len t)
  (letrec ((search (lambda (lo hi)
                     (if (= lo hi)
                         (- lo 1)
                         (let ((mid (quotient (+ lo hi) 2)))
                           (if (<= (nth votes-at mid) t)
                               (search (+ mid 1) hi)
                               (search lo mid)))))))
    (search 0 len)))

(define (query leaders votes-at t)
  (let* ((len (length votes-at))
         (idx (upper-bound votes-at len t)))
    (if (< idx 0)
        '()
        (nth leaders idx))))

(define (query-all leaders votes-at times)
  (letrec ((len (length times))
           (loop (lambda (i acc)
                   (if (= i len)
                       (reverse acc)
                       (loop (+ i 1)
                             (cons (query leaders votes-at (nth times i)) acc))))))
    (loop 0 '())))

(define (print-list lst)
  (display "[")
  (letrec ((loop (lambda (l)
                   (cond ((null? l) (display ""))
                         ((null? (cdr l))
                          (display (car l)))
                         (else
                          (display (car l))
                          (display ",")
                          (loop (cdr l)))))))
    (loop lst))
  (display "]"))

(define (solve votes-at votes-for times)
  (let ((leaders (build-leaders votes-at votes-for)))
    (print-list (query-all leaders votes-at times))))

(require "compat" all:)

;; CASE0
(let ((votes-at (list 0 5 10 15))
      (votes-for (list 1 2 2 1))
      (times (list 3 12 15 20)))
  (display "CASE0=")
  (display (solve votes-at votes-for times))
  (newline))

;; CASE1: t can be before first vote (return null)
(let ((votes-at (list 0 10 20))
      (votes-for (list 1 1 2))
      (times (list -5 0 5)))
  (display "CASE1=")
  (display (solve votes-at votes-for times))
  (newline))

;; CASE2
(let ((votes-at (list 0 1 2 3 4 5))
      (votes-for (list 1 2 3 4 5 1))
      (times (list 0 1 2 3 4 5)))
  (display "CASE2=")
  (display (solve votes-at votes-for times))
  (newline))
