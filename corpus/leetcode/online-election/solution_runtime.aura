; soft_leetcode_runtime slug=online-election
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; selected_explorer=null-sentinel hits=8/8
; baseline_hits=7/8
; Expected values used only for host scoring, not hardcoded into display.
(begin
  (define length
    (lambda (xs)
      (if (null? xs)
        0
        (+
          1 (length (cdr xs))))))
  (define nth
    (lambda (xs i)
      (if (=
          i 0)
        (car xs)
        (nth
          (cdr xs) (-
            i 1)))))
  (define count-vote
    (lambda (counts person)
      (if (null? counts)
        (list (cons
            person 1))
        (if (=
            (car (car counts)) person)
          (cons
            (cons
              person (+
                1 (cdr (car counts)))) (cdr counts))
          (cons
            (car counts) (count-vote
              (cdr counts) person))))))
  (define find-leader
    (lambda (counts best best-c)
      (if (null? counts)
        best
        (let ((p (car (car counts))))
          (let ((c (cdr (car counts))))
            (if (or
                (>
                  c best-c) (and
                  (=
                    c best-c) (<
                    p best)))
              (find-leader
                (cdr counts) p c)
              (find-leader
                (cdr counts) best best-c)))))))
  (define current-leader
    (lambda (counts)
      (if (null? counts)
        #f
        (find-leader
          (cdr counts) (car (car counts)) (cdr (car counts))))))
  (define build-leaders
    (lambda (votes-for)
      (letrec ((loop (lambda (i counts leaders)
          (if (=
              i (length votes-for))
            (reverse leaders)
            (let ((nc (count-vote
                counts (nth
                  votes-for i))))
              (loop
                (+
                  i 1) nc (cons
                  (current-leader nc) leaders)))))))
        (loop
          0 (quote 0) (quote 0)))))
  (define upper-bound
    (lambda (times t)
      (letrec ((loop (lambda (lo hi)
          (if (>=
              lo hi)
            lo
            (let ((mid (quotient
                (+
                  lo hi) 2)))
              (if (<=
                  (nth
                    times mid) t)
                (loop
                  (+
                    mid 1) hi)
                (loop
                  lo mid)))))))
        (loop
          0 (length times)))))
  (define query
    (lambda (leaders votes-at t)
      (if (null? votes-at)
        #f
        (if (<
            t (car votes-at))
          #f
          (let ((idx (-
              (upper-bound
                votes-at t) 1)))
            (if (<
                idx 0)
              #f
              (nth
                leaders idx)))))))
  (define query-all
    (lambda (leaders votes-at times)
      (letrec ((loop (lambda (i acc)
          (if (=
              i (length times))
            (reverse acc)
            (loop
              (+
                i 1) (cons
                (query
                  leaders votes-at (nth
                    times i)) acc))))))
        (loop
          0 (quote 0)))))
  (define solve
    (lambda (votes-at votes-for times)
      (query-all
        (build-leaders votes-for) votes-at times)))
  (define solve-zero-sentinel
    (lambda (votes-at votes-for times)
      (map
        (lambda (x)
          (if x
            x
            0)) (solve
          votes-at votes-for times))))
  (define disp-one
    (lambda (x)
      (if (not x)
        (display "null")
        (display x))))
  (define print-list
    (lambda (xs)
      (begin
        (display "[")
        (if (null? xs)
          (display "]")
          (begin
            (disp-one (car xs))
            (letrec ((loop (lambda (rest)
                (if (null? rest)
                  (display "]")
                  (begin
                    (display ",")
                    (disp-one (car rest))
                    (loop (cdr rest)))))))
              (loop (cdr xs))))))))
  (define run-case
    (lambda (n va vf times)
      (begin
        (display "CASE")
        (display n)
        (display "=")
        (print-list (solve
            va vf times))
        (newline))))
  (define run-cases
    (lambda ()
      (begin
        (run-case
          0 (quote (0
              5 10 15)) (quote (1
              2 2 1)) (quote (3
              12 15 20)))
        (run-case
          1 (quote (0
              10 20)) (quote (1
              1 2)) (quote (-5
              0 5)))
        (run-case
          2 (quote (0
              1 2 3)) (quote (5
              5 5 5)) (quote (0
              2 3 100)))
        (run-case
          3 (quote (0
              5 10)) (quote (1
              2 3)) (quote (0
              5 10 15)))
        (run-case
          4 (quote (0
              4 8 12 16 20)) (quote (2
              1 2 1 2 1)) (quote (1
              5 9 13 17 21)))
        (run-case
          5 (quote (0)) (quote (42)) (quote (0
              1 2)))
        (run-case
          6 (quote (0
              100 200 300)) (quote (3
              1 2 4)) (quote (50
              150 250 350)))
        (run-case
          7 (quote (0
              5 10 15)) (quote (2
              1 1 3)) (quote (3
              8 12 16))))))
  (run-cases))
