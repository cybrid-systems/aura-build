(require "lc_json" all:)
(require "compat" all:)
(define (solve s numRows)
  (let ((n (string-length s)))
    (cond
      ((or (= numRows 1) (<= numRows n))
       (if (= numRows 1)
           s
           ; When numRows >= n, each row has at most 1 char; result is just the chars in order
           (let loop ((i 0) (acc '()))
             (if (>= i n)
                 (list->string (reverse acc))
                 (loop (+ i 1) (cons (string-ref s i) acc))))))
      (else
       (let ((cycle (- (* 2 numRows) 2)))
         (let loop-row ((row 0) (acc '()))
           (if (= row numRows)
               (list->string (reverse acc))
               (let loop-col ((j 0) (row-acc '()))
                 (let ((idx (+ row (* j cycle))))
                   (cond
                     ((>= idx n) 
                      (loop-row (+ row 1) (cons (list->string (reverse row-acc)) acc)))
                     ((= row 0)
                      (loop-col (+ j 1) (cons (string-ref s idx) row-acc)))
                     ((= row (- numRows 1))
                      (loop-col (+ j 1) (cons (string-ref s idx) row-acc)))
                     (else
                      (let ((idx2 (+ idx (* 2 (- numRows 1 row)))))
                        (let ((new-acc (if (< idx2 n)
                                          (cons (string-ref s idx2) (cons (string-ref s idx) row-acc))
                                          (cons (string-ref s idx) row-acc))))
                          (loop-col (+ j 1) new-acc))))))))))))))
(define (list->string lst)
  (let loop ((l lst) (acc ""))
    (if (null? l)
        acc
        (loop (cdr l) (string-append acc (car l))))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "s") (hash-ref input "numRows")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/zigzag-conversion/tests.json")))
