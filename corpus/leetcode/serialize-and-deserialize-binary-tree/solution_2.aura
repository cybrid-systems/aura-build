(define null-marker "#")

(define (serialize root)
  (define (token-list node)
    (if (null? node)
        (list null-marker)
        (cons (number->string (car node))
              (append (token-list (cadr node))
                      (token-list (caddr node))))))
  (implode "," (token-list root)))

(define (implode sep lst)
  (cond ((null? lst) "")
        ((null? (cdr lst)) (car lst))
        (else (string-append (car lst) sep (implode sep (cdr lst))))))

(define (deserialize s)
  (define tokens (parse-tokens s))
  (if (null? tokens)
      '()
      (let* ((root-val (car tokens))
             (root (list (string->number-or-sym root-val) '() '()))
             (queue (list root))
             (rest (build-tree (cdr tokens) queue)))
        root)))

(define (build-tree tokens parents)
  (cond ((null? parents) tokens)
        ((null? tokens) tokens)
        (else
         (let* ((parent (car parents))
                (remaining-parents (cdr parents))
                (left-result (take-child tokens))
                (left-tok (car left-result))
                (tokens-after-left (cdr left-result))
                (right-result (take-child tokens-after-left))
                (right-tok (car right-result))
                (tokens-after-right (cdr right-result))
                (new-parents remaining-parents))
           (define (attach val children-pos)
             (if (equal? val null-marker)
                 '()
                 (let ((child (list (string->number-or-sym val) '() '())))
                   (set-car! (list-ref-pair parent children-pos) child)
                   (list child))))
           (let ((new-left (attach left-tok 1))
                 (new-right (attach right-tok 2)))
             (build-tree tokens-after-right
                         (append new-left new-right)))))))

(define (list-ref-pair lst n)
  (if (= n 0) (car lst) (list-ref-pair (cdr lst) (- n 1))))

(define (take-child tokens)
  (if (null? tokens)
      (cons null-marker '())
      (cons (car tokens) (cdr tokens))))

(define (string->number-or-sym s)
  (let ((n (string->number s)))
    (if n n s)))

(define (parse-tokens s)
  (if (equal? s "")
      '()
      (let loop ((str s) (acc '()))
        (let ((idx (string-index str ",")))
          (if (not idx)
              (reverse (cons str acc))
              (loop (substring str (+ idx 1))
                    (cons (substring str 0 idx) acc)))))))

(define (string-index str ch)
  (define len (string-length str))
  (let loop ((i 0))
    (cond ((= i len) #f)
          ((char=? (string-ref str i) ch) i)
          (else (loop (+ i 1))))))

(define (substring str start)
  (substring-helper str start (- (string-length str) 1)))

(define (substring-helper str start end)
  (let loop ((i start) (acc ""))
    (if (> i end)
        acc
        (loop (+ i 1) (string-append acc (string (string-ref str i)))))))

(define (string c) (make-string 1 c))

(define (solve root-list)
  (let ((root (build-from-list root-list 0 (length root-list))))
    (serialize root)))

(define (build-from-list lst idx len)
  (if (>= idx len)
      '()
      (let ((v (list-ref lst idx)))
        (if (or (equal? v "#") (equal? v '()))
            '()
            (let ((left (build-from-list lst (* 2 (+ idx 1) 0) len))
                  (right (build-from-list lst (+ (* 2 idx) 2) len)))
              (list v left right))))))

(define (list-ref lst idx)
  (if (= idx 0) (car lst) (list-ref (cdr lst) (- idx 1))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))
