;; Kth Smallest Element in a Sorted Matrix
;; Binary search on value, counting elements <= mid via row/column sortedness.

(define (count-leq matrix n mid)
  ;; Counts how many elements are <= mid by walking from top-right corner.
  (let loop ((row 0) (col (- n 1)) (count 0))
    (if (= row n)
        count
        (if (< (list-ref (list-ref matrix row) col) mid)
            ;; current row has (col+1) elements <= mid; jump down
            (loop (+ row 1) col (+ count (+ col 1)))
            (if (= col 0)
                ;; entire current row is > mid; but we should move down
                (loop (+ row 1) col count)
                (loop row (- col 1) count))))))

(define (count-leq2 matrix n mid)
  ;; Safer version: start top-right, if current <= mid then whole row 0..col works.
  (let loop ((row 0) (col (- n 1)) (count 0))
    (if (or (= row n) (< col 0))
        count
        (let ((v (list-ref (list-ref matrix row) col)))
          (if (<= v mid)
              (loop (+ row 1) col (+ count (+ col 1)))
              (loop row (- col 1) count))))))

(define (solve n matrix k)
  (let* ((low (list-ref (list-ref matrix 0) 0))
         (high (list-ref (list-ref matrix (- n 1)) (- n 1))))
    (let loop ((lo low) (hi high))
      (if (= lo hi)
          lo
          (let* ((mid (+ lo (quotient (- hi lo) 2)))
                 (c (count-leq2 matrix n mid)))
            (if (< c k)
                (loop (+ mid 1) hi)
                (loop lo mid)))))))

;; --- test harness ---

(define (display-list-of-lists m)
  ;; Pretty-print a matrix on one line per row.
  (let loop ((rows m))
    (if (null? rows)
        (begin (display "}") (newline))
        (let ((row (car rows)))
          (let inner ((r row) (first? #t))
            (if (null? r)
                (begin (display "]") (newline))
                (begin
                  (if first? (begin (display "[") (set! first? #f))
                          (display " "))
                  (display (car r))
                  (inner (cdr r) first?))))
          (loop (cdr rows))))))

(define (run-case i n matrix k)
  (let ((r (solve n matrix k)))
    (begin
      (display "CASE")
      (display i)
      (display "=")
      (display r)
      (newline))))

;; --- embedded cases ---

(define (cases)
  (begin
    (run-case 0 3 '((1 5 9) (10 11 13) (12 13 15)) 8)
    (run-case 1 2 '((1 2) (3 4)) 3)
    (run-case 2 1 '((42)) 1)
    (run-case 3 3 '((1 2 3) (4 5 6) (7 8 9)) 1)
    (run-case 4 3 '((1 2 3) (4 5 6) (7 8 9)) 9)
    (run-case 5 3 '((1 2 3) (4 5 6) (7 8 9)) 5)
    (run-case 6 3 '((1 5 9) (10 11 13) (12 13 15)) 1)
    (run-case 7 3 '((1 5 9) (10 11 13) (12 13 15)) 9)))

(cases)
