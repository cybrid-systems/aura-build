(define (make-node)
  (let ((children '())
        (weight -1))
    (list children weight)))

(define (node-children n) (car n))
(define (node-weight n) (car (cdr n)))
(define (set-node-weight! n w) (set-car! (cdr n) w))

(define (find-child n c)
  (let loop ((cs (node-children n)))
    (cond ((null? cs) #f)
          ((equal? (car (car cs)) c) (car cs))
          (else (loop (cdr cs))))))

(define (add-or-get-child n c)
  (let ((e (find-child n c)))
    (if e e
        (let ((new (cons c (make-node))))
          (set-car! (node-children n) (cons new (node-children n)))
          new))))

(define (insert-word root word idx)
  (let* ((n (string-length word))
         (s (make-string n)))
    (let ((_ (do ((i 0 (+ i 1))) ((= i n) #t) (string-set! s i (string-ref word i)))))
      (let loop ((i 0))
        (when (< i n)
          (let ((cur root))
            (let loop2 ((j i))
              (when (< j n)
                (set! cur (add-or-get-child cur (string-ref s j)))
                (when (> idx (node-weight cur))
                  (set-node-weight! cur idx))
                (loop2 (+ j 1))))
            (set! cur (add-or-get-child cur #\#))
            (when (> idx (node-weight cur))
              (set-node-weight! cur idx))
            (let loop3 ((j 0))
              (when (< j n)
                (set! cur (add-or-get-child cur (string-ref word j)))
                (when (> idx (node-weight cur))
                  (set-node-weight! cur idx))
                (loop3 (+ j 1))))
            (loop (+ i 1)))))))

(define (query-word root pref suff)
  (let ((cur root))
    (let loop1 ((i 0) (c cur))
      (cond ((= i (string-length suff)) (let ((c2 (add-or-get-child c #\#)))
                                          (let loop2 ((j 0) (cc c2))
                                            (if (= j (string-length pref))
                                                (node-weight cc)
                                                (let ((nx (find-child cc (string-ref pref j))))
                                                  (if nx (loop2 (+ j 1) nx) -1))))))
            (else
             (let ((nx (find-child c (string-ref suff i))))
               (if nx (loop1 (+ i 1) nx) -1)))))))

(define (make-pss hint)
  (let ((root (make-node)))
    (letrec ((inserter (lambda (w i) (insert-word root w i)))
             (querier (lambda (p s) (query-word root p s))))
      (list inserter querier))))

(define (run-case case-input)
  (let ((hint (car case-input))
        (ops (car (cdr case-input))))
    (let ((pss (make-pss hint)))
      (let ((ins (car pss))
            (qry (car (cdr pss))))
        (let loop ((rest ops) (qnum 0))
          (when (not (null? rest))
            (let ((op (car (car rest)))
                  (args (car (cdr (car rest)))))
              (cond ((equal? op "INSERT")
                     (ins (car (cdr args)) (car args)))
                    (else
                     (display "CASE")
                     (display qnum)
                     (display "=")
                     (display (qry (car args) (car (cdr args))))
                     (newline)
                     (set! qnum (+ qnum 1))))
            (loop (cdr rest) qnum)))))))

(define (solve)
  (run-case (list 10
                  (list (list "INSERT" (list 0 "apple"))
                        (list "INSERT" (list 1 "apply"))
                        (list "INSERT" (list 2 "ape"))
                        (list "INSERT" (list 3 "applet"))
                        (list "QUERY" (list "ap" "le"))
                        (list "QUERY" (list "a" "e"))
                        (list "QUERY" (list "b" "x")))))
  (run-case (list 5
                  (list (list "INSERT" (list 0 "a"))
                        (list "INSERT" (list 1 "aa"))
                        (list "INSERT" (list 2 "aaa"))
                        (list "QUERY" (list "" ""))
                        (list "QUERY" (list "a" "a"))
                        (list "QUERY" (list "aa" "aa"))
                        (list "QUERY" (list "aaa" "aaa")))))
  (run-case (list 3
                  (list (list "QUERY" (list "x" "y"))
                        (list "INSERT" (list 5 "abcabc"))
                        (list "QUERY" (list "abc" "abc"))
                        (list "QUERY" (list "a" "c"))
                        (list "QUERY" (list "abc" "c"))
                        (list "QUERY" (list "a" "abc")))))
  (run-case (list 5
                  (list (list "INSERT" (list 0 "test"))
                        (list "INSERT" (list 5 "test"))
                        (list "QUERY" (list "te" "st"))
                        (list "QUERY" (list "t" "t"))
                        (list "INSERT" (list 3 "team"))
                        (list "QUERY" (list "te" "m")))))
  (run-case (list 2
                  (list (list "INSERT" (list 0 "z"))
                        (list "QUERY" (list "" "z"))
                        (list "QUERY" (list "z" ""))
                        (list "QUERY" (list "" ""))))))
