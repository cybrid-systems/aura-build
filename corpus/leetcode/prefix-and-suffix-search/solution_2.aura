(define (solve input)
  (let ((ops (cdr (assq 'operations input)))
        (words '())
        (mp '()))
    (define (insert-word idx word)
      (let* ((n (string-length word))
             (new-words (cons (list idx word) words)))
        (set! words new-words)
        (let loop ((i 0))
          (when (<= i n)
            (let* ((pref (substring word 0 i))
                   (suff (substring word i n))
                   (key (string-append pref (string-append "#" suff)))
                   (existing (assq key mp))
                   (cur (if existing (cadr existing) -1)))
              (set! mp (cons (list key (max idx cur))
                             (remove-existing key mp)))
              (loop (+ i 1)))))))
    ...
