(define (square x) (* x x))

(define (sum-squares n)
  (if (= n 0)
      0
      (+ (square (modulo n 10))
         (sum-squares (quotient n 10)))))

(define (member? x lst)
  (cond ((null? lst) #f)
        ((= x (car lst)) #t)
        (else (member? x (cdr lst)))))

(define (happy-helper n seen)
  (cond ((= n 1) #t)
        ((member? n seen) #f)
        (else (happy-helper (sum-squares n) (cons n seen)))))

(define (solve n)
  (if (= n 1)
      #t
      (happy-helper (sum-squares n) '())))

(define (display-list lst)
  (cond ((null? lst) (display "()"))
        (else (display "(")
              (display (car lst))
              (display-list-helper (cdr lst)))))

(define (display-list-helper lst)
  (cond ((null? lst) (display ")"))
        (else (display " ")
              (display (car lst))
              (display-list-helper (cdr lst)))))

(solve 19)
(solve 2)
(solve 7)
(solve 1)
(solve 111111111)
(solve 0)
(solve 4)
(solve 100000000)

(display "CASE0=") (display (solve 19)) (newline)
(display "CASE1=") (display (solve 2)) (newline)
(display "CASE2=") (display (solve 7)) (newline)
(display "CASE3=") (display (solve 1)) (newline)
(display "CASE4=") (display (solve 111111111)) (newline)
(display "CASE5=") (display (solve 0)) (newline)
(display "CASE6=") (display (solve 4)) (newline)
(display "CASE7=") (display (solve 100000000)) (newline)
