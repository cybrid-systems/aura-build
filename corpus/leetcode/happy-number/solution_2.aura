(define (sum-of-squares-of-digits n)
  (let loop ((n n) (acc 0))
    (if (= n 0)
        acc
        (let ((d (modulo n 10)))
          (loop (quotient n 10) (+ acc (* d d)))))))

(define (happy? n seen)
  (cond
    ((= n 1) #t)
    ((member? n seen) #f)
    (else
      (let ((next (sum-of-squares-of-digits n)))
        (happy? next (cons n seen))))))

(define (member? x lst)
  (cond ((null? lst) #f)
        ((equal? x (car lst)) #t)
        (else (member? x (cdr lst)))))

(define (solve n)
  (happy? n '()))

(define (display-case i result)
  (display (string-append "CASE" (number->string i) "="))
  (display result)
  (newline))

(begin
  (display-case 0 (solve 19))
  (display-case 1 (solve 2))
  (display-case 2 (solve 7))
  (display-case 3 (solve 1))
  (display-case 4 (solve 111111111))
  (display-case 5 (solve 0))
  (display-case 6 (solve 4))
  (display-case 7 (solve 100000000)))
