(require "lc_json" all:)
(require "compat" all:)
(define (square x) (* x x))
(define (sum-squares n)
  (if (= n 0)
      0
      (+ (square (modulo n 10))
         (sum-squares (quotient n 10)))))
(define (member? x lst)
  (cond ((null? lst) #f)
        ((= x (car lst)) #t)
        (else (member? x (cdr lst)))))
(define (happy-helper n seen)
  (cond ((= n 1) #t)
        ((member? n seen) #f)
        (else (happy-helper (sum-squares n) (cons n seen)))))
(define (solve n)
  (if (= n 1)
      #t
      (happy-helper (sum-squares n) '())))
(define (display-list lst)
  (cond ((null? lst) (display "()"))
        (else (display "(")
              (display (car lst))
              (display-list-helper (cdr lst)))))
(define (display-list-helper lst)
  (cond ((null? lst) (display ")"))
        (else (display " ")
              (display (car lst))
              (display-list-helper (cdr lst)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/happy-number/tests.json")))
