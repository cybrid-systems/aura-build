;; Shortest subarray with sum at least K using prefix sums + monotonic deque
;; O(n) approach.

(define (make-list n)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        acc
        (loop (+ i 1) (cons i acc)))))

(define (list-ref-safe lst i)
  (if (null? lst)
      0
      (if (= i 0)
          (car lst)
          (list-ref-safe (cdr lst) (- i 0)))))

;; Convert a list of (a . b) pairs to two parallel lists
(define (caar p) (car (car p)))
(define (cdar p) (cdr (car p)))

;; Build prefix sum array: pref[i] = sum of nums[0..i-1], pref[0]=0
(define (build-prefix nums)
  (let loop ((ns nums) (acc '(0)))
    (if (null? ns)
        (reverse acc)
        (loop (cdr ns) (cons (+ (car acc) (car ns)) acc)))))

;; Minimum of two numbers
(define (min2 a b) (if (< a b) a b))

;; length of list
(define (len lst)
  (let loop ((l lst) (c 0))
    (if (null? l) c (loop (cdr l) (+ c 1)))))

;; index of nth element (0-based) in a list
(define (nth lst n)
  (if (= n 0)
      (car lst)
      (nth (cdr lst) (- n 1))))

;; Solve using prefix sums and a deque represented as a list of indices.
;; We maintain a list of indices whose prefix sums are increasing.
;; For each new prefix sum, we pop from front while pref[new] - pref[deque[0]] >= K,
;; updating answer with new - deque[0].
;; Then we pop from back while pref[new] <= pref[back] (maintain increasing).
;; Finally push new index.
(define (solve nums K)
  (let* ((pref (build-prefix nums))
         (n (+ (len pref) 0)))   ; length of pref = n+1 where n = len nums
  (let loop ((i 1)        ; current index in pref (1..n)
             (deq '())    ; deque of indices, increasing prefix sums
             (best 9999999))
    (if (> i n)
        (if (= best 9999999) -1 best)
        (let* ((pi (nth pref i))
               (deq1
                (let pop-front ((d deq) (b best))
                  (if (null? d)
                      d
                      (let* ((j (car d))
                             (pj (nth pref j)))
                        (if (>= (- pi pj) K)
                            (let ((nb (min2 b (- i j))))
                              (pop-front (cdr d) nb))
                            d))))))
          (let* ((deq2
                   (let pop-back ((d deq1) (acc '()))
                     (if (null? d)
                         (reverse acc)
                         (let* ((last (car (reverse d))))
                           (if (<= (nth pref last) pi)
                               (pop-back (reverse (cdr (reverse d))) acc)
                               (append (reverse acc) d)))))))
            (loop (+ i 1) (append deq2 (list i)) best)))))))

;; Parse a comma-separated string of integers into a list of ints.
(define (parse-int-list s)
  (let ((parts (string-split s ",")))
    (map (lambda (x) (string->number x)) parts)))

;; We won't actually read stdin; inputs are embedded.
(define (test-cases)
  (list
    (list (parse-int-list "2,-1,3,-2,4") 5)
    (list (parse-int-list "-1,2") 3)
    (list (parse-int-list "1") 1)
    (list (parse-int-list "1,2") 4)
    (list (parse-int-list "5,-10,3,2,1") 6)
    (list (parse-int-list "2,2,2,2,2") 3)
    (list (parse-int-list "-2,-3,-1") 1)
    (list (parse-int-list "1,-1,1,-1,1,-1,10") 5)))

(define (run-cases cases i)
  (if (null? cases)
      '()
      (let* ((c (car cases))
             (nums (car c))
             (K (car (cdr c)))
             (ans (solve nums K)))
        (display (string-append "CASE" (number->string i) "="))
        (display ans)
        (newline)
        (run-cases (cdr cases) (+ i 1)))))

(run-cases (test-cases) 0)
