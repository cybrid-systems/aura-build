(require "lc_json" all:)
(require "compat" all:)
(define (list-length xs)
  (if (null? xs) 0 (+ 1 (list-length (cdr xs)))))
(define (list-ref xs n)
  (if (= n 0) (car xs) (list-ref (cdr xs) (- n 1))))
(define (make-list n c)
  (if (= n 0) '() (cons c (make-list (- n 1) c))))
(define (repeat-chars n c)
  (if (= n 0) "" (string-append (make-string 1 c) (repeat-chars (- n 1) c))))
(define (char->string c)
  (make-string 1 c))
(define (process s k stack)
  (cond
    ((null? s)
     (let loop ((stk stack) (acc ""))
       (if (null? stk)
           acc
           (let ((frame (car stk)))
             (loop (cdr stk)
                   (string-append (repeat-chars (cdr frame) (car frame)) acc))))))
    (else
     (let* ((c (car s))
            (top (and (not (null? stack)) (car stack)))
            (same (and top (char=? c (car top))))
            (new-stack
              (cond
                ((and same (= (+ (cdr top) 1) k))
                 (cdr stack))
                (same
                 (cons (cons (car top) (+ (cdr top) 1)) (cdr stack)))
                (else
                 (cons (cons c 1) stack)))))
       (process (cdr s) k new-stack)))))
(define (solve s k)
  (process (string->list s) k '()))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "s") (hash-ref input "k")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/remove-all-adjacent-duplicates-in-string-ii/tests.json")))
