# Path Sum solver in Aura
# Tree node: pair of (val . (left . right)) or 'nil
# We'll represent node as a 3-tuple via (cons val (cons left right))
# nil is empty list '()

(define (make-node val left right)
  (cons val (cons left right)))

(define (node-val n) (car n))
(define (node-left n) (car (cdr n)))
(define (node-right n) (cdr (cdr n)))
(define (node-leaf? n)
  (and (null? (node-left n)) (null? (node-right n))))

(define (path-sum root target)
  (if (null? root)
      #f
      (let ((v (node-val root))
            (l (node-left root))
            (r (node-right root)))
        (if (and (null? l) (null? r))
            (= (+ target v) 0) ; reached a leaf; need running sum == 0
            ; otherwise, continue; remaining target = target + v
            (or (and (not (null? l)) (path-sum l (+ target v)))
                (and (not (null? r)) (path-sum r (+ target v))))))))

; Actually we want to subtract the node value each step. Let's rewrite cleanly.
(define (path-sum2 root target)
  (if (null? root)
      #f
      (let ((rem (- target (node-val root))))
        (if (and (null? (node-left root)) (null? (node-right root)))
            (= rem 0)
            (or (path-sum2 (node-left root) rem)
                (path-sum2 (node-right root) rem))))))

(define (solve root target)
  (path-sum2 root target))

; ----- Tree builder from level-order tokens -----
; tokens: list of strings like "5", "null", "-3", etc.
; returns root node or '() if empty

(define (token-null? s)
  (or (equal? s "null") (equal? s "Nil") (equal? s "nil") (equal? s "")))

(define (string->int s)
  (let ((n (string-length s)))
    (let loop ((i 0) (sign 1) (acc 0))
      (cond
        ((= i n) (* sign acc))
        ((char=? (string-ref s i) #\-) (loop (+ i 1) -1 acc))
        ((char=? (string-ref s i) #\+) (loop (+ i 1) sign acc))
        (else (loop (+ i 1) sign (+ (* acc 10) (- (char->int (string-ref s i)) (char->int #\0)))))))))

; We'll just embed the cases directly. The harness's "case" string is the tree in level-order.

; CASE0: "-10 9 20 null null 15 7"
; Build: -10
;   L: 9 (leaf)
;   R: 20
;       L: 15 (leaf)
;       R: 7  (leaf)

(define t0
  (make-node -10
    (make-node 9 '() '())
    (make-node 20
      (make-node 15 '() '())
      (make-node 7 '() '()))))

; CASE1: "1 2 3"
(define t1
  (make-node 1
    (make-node 2 '() '())
    (make-node 3 '() '())))

; CASE2: "" -> empty tree
(define t2 '())

; CASE3: "5 4 8 11 null 13 4 7 2 null null null 1"
; Build it explicitly:
;    5
;   / \
;  4   8
; / \ / \
;11  . 13 4
;   / \  / \
;  7  2 .  . 1   (the "1" is right child of the second '4'? Wait careful.)
; Let's parse tokens:
; 5, 4, 8, 11, null, 13, 4, 7, 2, null, null, null, 1
; Positions (1-indexed):
; 1:5
; 2:4
; 3:8
; 4:11 (left of 4)
; 5:null (right of 4)
; 6:13 (left of 8)
; 7:4 (right of 8)
; 8:7 (left of 11)
; 9:2 (right of 11)
; 10:null (left of 13)
; 11:null (right of 13)
; 12:null (left of second 4)
; 13:1 (right of second 4)
(define t3
  (make-node 5
    (make-node 4
      (make-node 11
        (make-node 7 '() '())
        (make-node 2 '() '()))
      '())
    (make-node 8
      (make-node 13 '() '())
      (make-node 4
        '()
        (make-node 1 '() '())))))

; CASE4: "1 2" -> 1 with left=2 (right null)
(define t4
  (make-node 1
    (make-node 2 '() '())
    '()))

; CASE5: same tree, sum=3 -> true
; (already constructed t4)

; CASE6: "0" -> just node 0
(define t6 (make-node 0 '() '()))

; CASE7: "-3" -> just node -3
(define t7 (make-node -3 '() '()))

; CASE8: "-2 null -3"
; -2
;   L: null
;   R: -3 (leaf)
(define t8
  (make-node -2
    '()
    (make-node -3 '() '())))

; Now run each case and print CASEi=<result>
(define (print-boolean b)
  (display (if b "true" "false")))

(display "CASE0=") (display (if (solve t0 22) "true" "false")) (newline)
(display "CASE1=") (display (if (solve t1 5) "true" "false")) (newline)
(display "CASE2=") (display (if (solve t2 0) "true" "false")) (newline)
(display "CASE3=") (display (if (solve t3 22) "true" "false")) (newline)
(display "CASE4=") (display (if (solve t4 1) "true" "false")) (newline)
(display "CASE5=") (display (if (solve t4 3) "true" "false")) (newline)
(display "CASE6=") (display (if (solve t6 0) "true" "false")) (newline)
(display "CASE7=") (display (if (solve t7 -3) "true" "false")) (newline)
(display "CASE8=") (display (if (solve t8 -5) "true" "false")) (newline)
