from typing import Optional, List
import json

class TreeNode:
    def __init__(self, val: int = 0, left: 'Optional[TreeNode]' = None, right: 'Optional[TreeNode]' = None):
        self.val = val
        self.left = left
        self.right = right

def build_tree(level_order: List[Optional[int]]) -> Optional[TreeNode]:
    if not level_order or level_order[0] is None:
        return None
    root = TreeNode(level_order[0])
    queue: List[TreeNode] = [root]
    i = 1
    while queue and i < len(level_order):
        node = queue.pop(0)
        if i < len(level_order) and level_order[i] is not None:
            node.left = TreeNode(level_order[i])
            queue.append(node.left)
        i += 1
        if i < len(level_order) and level_order[i] is not None:
            node.right = TreeNode(level_order[i])
            queue.append(node.right)
        i += 1
    return root

def solve(root: Optional[TreeNode], targetSum: int) -> bool:
    if root is None:
        return False
    # If leaf, check exact match
    if root.left is None and root.right is None:
        return root.val == targetSum
    remaining = targetSum - root.val
    return solve(root.left, remaining) or solve(root.right, remaining)

def parse_case(s: str):
    # Format: "<level-order>,sum=<K>"
    parts = s.split(',sum=')
    tree_part = parts[0].strip()
    sum_part = int(parts[1].strip())
    if tree_part == '':
        tokens = []
    else:
        tokens = [t for t in tree_part.split(',')]
    level_order = []
    for t in tokens:
        t = t.strip()
        if t == '' or t.lower() == 'null':
            level_order.append(None)
        else:
            level_order.append(int(t))
    root = build_tree(level_order)
    return root, sum_part

CASES = [
    {"case": "-10 9 20 null null 15 7,sum=22", "expected": True},
    {"case": "1 2 3,sum=5", "expected": False},
    {"case": ",sum=0", "expected": False},
    {"case": "5 4 8 11 null 13 4 7 2 null null null 1,sum=22", "expected": True},
    {"case": "1 2,sum=1", "expected": False},
    {"case": "-2,null,-3,sum=-5", "expected": True},
    {"case": "1,-2,-3,null,null,null,sum=-2", "expected": False},
    {"case": "0,sum=0", "expected": True},
]

def main():
    results = []
    for idx, c in enumerate(CASES):
        root, target = parse_case(c["case"])
        actual = solve(root, target)
        results.append({
            "id": idx,
            "input": {"raw": c["case"], "targetSum": target},
            "expected": json.dumps(actual, separators=(',', ':'))
        })
    print(json.dumps(results, separators=(',', ':')))

if __name__ == '__main__':
    main()
