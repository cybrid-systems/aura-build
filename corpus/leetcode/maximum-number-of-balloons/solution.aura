;; Maximum Number of "balloon" - count chars, take min of (b,a,l/2,o/2,n)

(define (count-char s ch)
  (if (null? s) 0
      (+ (if (char=? (car s) ch) 1 0)
         (count-char (cdr s) ch))))

(define (string->list s)
  (if (= (string-length s) 0) '()
      (cons (string-ref s 0) (string->list (substring s 1 (string-length s))))))

(define (count-letters s b a l o n)
  (let ((b-c (count-char s #\b))
        (a-c (count-char s #\a))
        (l-c (count-char s #\l))
        (o-c (count-char s #\o))
        (n-c (count-char s #\n)))
    (let ((l2 (quotient l-c 2))
          (o2 (quotient o-c 2)))
      (min b-c a-c l2 o2 n-c))))

(define (solve text)
  (if (= (string-length text) 0) 0
      (count-letters (string->list text) 0 0 0 0 0)))

;; Test harness
(let ((cases (list "balloonballoon"
                   "bababnlnonlno"
                   "zzz"
                   "balon"
                   "balloon"
                   "bbaallllooonn"
                   "loonbalxballoon"
                   "")))
  (define (run i cases)
    (if (null? cases) '()
        (begin
          (display "CASE")
          (display (number->string i))
          (display "=")
          (display (number->string (solve (car cases))))
          (newline)
          (run (+ i 1) (cdr cases)))))
  (run 0 cases))
