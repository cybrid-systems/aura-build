(define (solve candidates target)
  (let* ((sorted (sort-vec candidates))
         (result '()))
    (define (backtrack start remaining current)
      (cond
        ((= remaining 0)
         (set! result (cons (reverse current) result)))
        ((< remaining 0) '())
        (else
         (let loop ((i start)
                    (len (length sorted)))
           (if (>= i len)
               '()
               (let ((c (list-ref sorted i)))
                 (if (> c remaining)
                     '()
                     (begin
                       (backtrack i (- remaining c) (cons c current))
                       (loop (+ i 1) len)))))))))
    (backtrack 0 target '())
    (map (lambda (combo)
           (map (lambda (x) x) combo))
         result)))

(define (sort-vec lst)
  (let* ((arr (list->vector lst))
         (n (vector-length arr)))
    (define (qs lo hi)
      (if (>= lo hi)
          '()
          (let ((pivot (vector-ref arr hi))
                (i (- lo 1)))
            (let loop ((j lo))
              (if (>= j hi)
                  (begin
                    (set! i (+ i 1))
                    (let ((tmp (vector-ref arr i)))
                      (vector-set! arr i (vector-ref arr hi))
                      (vector-set! arr hi tmp))
                    (qs lo (- i 1))
                    (qs (+ i 1) hi))
                  (if (<= (vector-ref arr j) pivot)
                      (begin
                        (set! i (+ i 1))
                        (let ((tmp (vector-ref arr i)))
                          (vector-set! arr i (vector-ref arr j))
                          (vector-set! arr j tmp))
                        (loop (+ j 1)))
                      (loop (+ j 1)))))))))
    (qs 0 (- n 1))
    (vector->list arr)))

(define (print-combo combo)
  (display "[")
  (let loop ((rest combo))
    (cond
      ((null? rest) (display "]"))
      (else
       (display (car rest))
       (if (null? (cdr rest))
           '()
           (display ","))
       (loop (cdr rest))))))

(define (print-combos combos)
  (display "[")
  (let loop ((rest combos))
    (cond
      ((null? rest) (display "]"))
      (else
       (print-combo (car rest))
       (if (null? (cdr rest))
           '()
           (display ","))
       (loop (cdr rest))))))

(define (display-result combos)
  (print-combos combos))

(solve (list 2 3 6 7) 7)
(solve (list 2 3 5) 8)
(solve (list 2) 1)
(solve (list 1) 1)
(solve (list 1) 5)
(solve (list 3 5 8 10) 11)
(solve (list 2 4 6 8) 16)
(solve (list 7 3 2 6) 7)

(display "CASE0=") (display-result (solve (list 2 3 6 7) 7)) (newline)
(display "CASE1=") (display-result (solve (list 2 3 5) 8)) (newline)
(display "CASE2=") (display-result (solve (list 2) 1)) (newline)
(display "CASE3=") (display-result (solve (list 1) 1)) (newline)
(display "CASE4=") (display-result (solve (list 1) 5)) (newline)
(display "CASE5=") (display-result (solve (list 3 5 8 10) 11)) (newline)
(display "CASE6=") (display-result (solve (list 2 4 6 8) 16)) (newline)
(display "CASE7=") (display-result (solve (list 7 3 2 6) 7)) (newline)
