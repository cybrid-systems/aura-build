(require "compat" all:)

(define (solve heights)
  (let ((n (length heights))
        (hs (append heights '(0))))
    ;; Use a helper that takes index, heights-with-sentinel, stack, best-area
    ;; Stack stores (cons idx height) pairs
    (define (iter i hs st best)
      (cond
        ((null? hs) best)
        ((or (null? st) (< (car hs) (cdr (car st))))
         ;; Current height is smaller than stack top, OR stack is empty
         ;; If stack top height > current, pop and compute area first
         ;; Otherwise just push
         (if (and (not (null? st)) (>= (car hs) (cdr (car st))))
             ;; push
             (iter (+ i 1) (cdr hs) (cons (cons i (car hs)) st) best)
             ;; pop top, compute area with width (i - idx)
             (let* ((top (car st))
                    (idx (car top))
                    (h (cdr top))
                    (area (* h (- i idx)))
                    (new-best (if (> area best) area best)))
               (iter i hs (cdr st) new-best))))
        (else
         (iter (+ i 1) (cdr hs) (cons (cons i (car hs)) st) best))))
    (iter 0 hs '() 0)))

(define (run-tests)
  (begin
    (display "CASE0=") (display (solve '(2 1 5 6 2 3))) (newline)
    (display "CASE1=") (display (solve '(2 4))) (newline)
    (display "CASE2=") (display (solve '(0 0))) (newline)
    (display "CASE3=") (display (solve '(1))) (newline)
    (display "CASE4=") (display (solve '(1 1 1 1))) (newline)
    (display "CASE5=") (display (solve '(4 2 0 3 2 5))) (newline)
    (display "CASE6=") (display (solve '(0))) (newline)
    (display "CASE7=") (display (solve '(6 7 5 2 4 5 9 3))) (newline)))

(run-tests)
