(define (solve heights)
  (let* ((n (length heights))
         (extended (append heights (list 0)))
         (stack '())
         (max-area 0))
    (define (process i h)
      ;; Pop while current height < stack top height, compute areas
      (let loop ((acc-max max-area) (stk stack) (idx i) (cur-h h))
        (if (and (not (null? stk))
                 (< h (list-ref extended (car stk))))
            (let* ((top (car stk))
                   (top-h (list-ref extended top))
                   (prev (if (null? (cdr stk)) -1 (car (cdr stk))))
                   (width (- idx prev 1))
                   (area (* top-h width)))
              (set! acc-max (if (> area acc-max) area acc-max))
              (loop acc-max (cdr stk) idx cur-h))
            (cons acc-max (cons h (cons stk '()))))))
    (define (final-result state)
      (car state))
    ;; Actually, let me rewrite this more cleanly using set! for mutation
    '()))

;; Cleaner implementation
(define (solve heights)
  (let* ((extended (append heights (list 0)))
         (stack '())
         (max-area 0))
    (let loop ((i 0))
      (if (= i (length extended))
          max-area
          (let* ((h (list-ref extended i))
                 (new-max (let pop-loop ((m max-area) (stk stack) (idx i) (cur-h h))
                            (if (and (not (null? stk))
                                     (< cur-h (list-ref extended (car stk))))
                                (let* ((top (car stk))
                                       (top-h (list-ref extended top))
                                       (prev (if (null? (cdr stk)) -1 (car (cdr stk))))
                                       (width (- idx prev 1))
                                       (area (* top-h width)))
                                  (set! m (if (> area m) area m))
                                  (pop-loop m (cdr stk) idx cur-h))
                                (begin
                                  (set! stack (cons idx (cons cur-h (list 'stk-marker))))
                                  ;; Actually we need to store indices only
                                  m)))))
            (loop (+ i 1))))))

;; Let me simplify - just store indices in the stack
(define (solve heights)
  (let ((extended (append heights (list 0)))
        (stack '())
        (max-area 0))
    (let loop ((i 0))
      (if (>= i (length extended))
          max-area
          (let ((h (list-ref extended i)))
            ;; Pop and compute areas while current < stack top height
            (let pop-loop ((stk stack) (idx i) (cur-h h) (m max-area))
              (if (and (not (null? stk))
                       (< cur-h (list-ref extended (car stk))))
                  (let* ((top (car stk))
                         (top-h (list-ref extended top))
                         (new-stk (cdr stk))
                         (prev-idx (if (null? new-stk) -1 (car new-stk)))
                         (width (- idx prev-idx 1))
                         (area (* top-h width))
                         (new-m (if (> area m) area m)))
                    (pop-loop new-stk idx cur-h new-m))
                  (begin
                    (set! max-area m)
                    (set! stack (cons idx stk))
                    (loop (+ i 1))))))))))

(define (display-list lst)
  (display "[")
  (let loop ((l lst) (first #t))
    (if (null? l)
        (display "]")
        (begin
          (if first (set! first #f) (display ", "))
          (display (car l))
          (loop (cdr l) #f)))))

;; Run test cases
(let ((cases (list
              (list 0 '(2 1 5 6 2 3))
              (list 1 '(2 4))
              (list 2 '(0 0))
              (list 3 '(1))
              (list 4 '(1 1 1 1))
              (list 5 '(4 2 0 3 2 5))
              (list 6 '(0))
              (list 7 '(6 7 5 2 4 5 9 3)))))
  (let run ((cs cases))
    (if (null? cs)
        'done
        (let* ((c (car cs))
               (idx (car c))
               (heights (car (cdr c)))
               (result (solve heights)))
          (display "CASE")
          (display idx)
          (display "=")
          (display result)
          (newline)
          (run (cdr cs))))))
