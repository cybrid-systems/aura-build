(define (largest-rectangle heights)
  ;; Use monotonic increasing stack with sentinel
  (let ((stack '())
        (max-area 0)
        (n (length heights))
        (heights-with-sentinel (append heights '(0))))
    (define (push-pair idx h)
      (set! stack (cons (cons idx h) stack)))
    (define (stack-empty?) (null? stack))
    (define (stack-top) (car stack))
    (define (stack-pop!) (let ((t (car stack))) (set! stack (cdr stack)) t))
    
    ;; We'll use an iterative approach with set! on local variables
    ;; But let* doesn't allow mutation across iterations easily in a pure functional way
    ;; Let's use a recursive helper
    (define (loop i hs st best)
      (if (null? hs)
          best
          (let ((h (car hs))
                (rest (cdr hs)))
            (cond
              ((or (null? st) (< h (cdr (car st))))
               ;; push i, h onto stack
               (loop (+ i 1) rest (cons (cons i h) st) best))
              ((>= h (cdr (car st)))
               ;; Just push
               (loop (+ i 1) rest (cons (cons i h) st) best))
              (else
               ;; Pop and compute area
               (let* ((top (car st))
                      (idx (car top))
                      (height (cdr top))
                      (new-st (cdr st))
                      (width i)
                      (area (* height width))
                      (new-best (if (> area best) area best)))
                 ;; Don't advance i, retry with same h on new stack
                 (loop i rest new-st new-best)))))))
    (loop 0 heights-with-sentinel '() 0)))

(define (solve heights)
  (largest-rectangle heights))

;; Test harness
(define (run-tests)
  (begin
    (display "CASE0=") (display (solve '(2 1 5 6 2 3))) (newline)
    (display "CASE1=") (display (solve '(2 4))) (newline)
    (display "CASE2=") (display (solve '(0 0))) (newline)
    (display "CASE3=") (display (solve '(1))) (newline)
    (display "CASE4=") (display (solve '(1 1 1 1))) (newline)
    (display "CASE5=") (display (solve '(4 2 0 3 2 5))) (newline)
    (display "CASE6=") (display (solve '(0))) (newline)
    (display "CASE7=") (display (solve '(6 7 5 2 4 5 9 3))) (newline)))

(run-tests)
