(require "lc_json" all:)
(require "compat" all:)
(define (env-lookup name)
  (let ((e (getenv name)))
    (if (equal? e "") 0 (read-from-string e))))
(define (read-int s)
  ;; Parse first integer found in string s
  (let ((len (string-length s)))
    (let loop ((i 0) (sign 1) (acc 0))
      (cond ((>= i len) acc)
            ((char=? (string-ref s i) #\-)
             (loop (+ i 1) -1 0))
            ((char>=? (string-ref s i) #\0) (char<=? (string-ref s i) #\9))
             (loop (+ i 1) sign (+ (* acc 10)
                                    (- (char->integer (string-ref s i))
                                       (char->integer #\0)))))
            (else (loop (+ i 1) sign acc)))))
(define (parse-int s)
  (let ((len (string-length s)))
    (let loop ((i 0) (acc 0))
      (cond ((>= i len) acc)
            ((char>=? (string-ref s i) #\0)
             (char<=? (string-ref s i) #\9))
             (loop (+ i 1)
                   (+ (* acc 10)
                      (- (char->integer (string-ref s i))
                         (char->integer #\0)))))
            (else (loop (+ i 1) acc)))))
(define (get-n)
  (let ((s (getenv name))))
  )
(define (gen n)
  (let ((result '()))
    (letrec ((go (lambda (open-used close-used acc)
                   (cond
                     ((= open-used n)
                      ;; fill remaining with close brackets
                      (let fill ((k (- n close-used)) (s acc))
                        (if (= k 0)
                            (set! result (cons s result))
                            (fill (- k 1) (string-append s ")")))))
                     ((= close-used n)
                      ;; must place an open bracket if we still can
                      (go (+ open-used 1) close-used
                          (string-append acc "(")))
                     (else
                      (go (+ open-used 1) close-used
                          (string-append acc "("))
                      (if (> open-used close-used)
                          (go open-used (+ close-used 1)
                              (string-append acc ")"))
                          '()))))))
      (go 0 0 "")
      result)))
(define (solve n)
  (gen n))
(define (display-string s)
  (display s))
(define (display-list-of-strings lst)
  (display "[")
  (let loop ((rest lst) (first? #t))
    (cond ((null? rest) (display "]"))
          (else
           (if first? (set! first? #f) (display ","))
           (display "\"")
           (display (car rest))
           (display "\"")
           (loop (cdr rest) #f)))))
(define (run-case idx)
  (let ((name (string-append "CASE" (number->string idx))))
    (let ((raw (getenv name)))
      (let ((n (parse-int raw)))
        (let ((res (solve n)))
          (display (string-append "CASE" (number->string idx)))
          (display "=")
          (display-list-of-strings res)
          (newline))))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/generate-parentheses/tests.json")))
