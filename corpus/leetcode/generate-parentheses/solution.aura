;; Generate all well-formed parenthesis combinations for n pairs.
;; Reads CASE0 environment variable, parses integer N, solves for each test case.

(define (env-lookup name)
  (let ((e (getenv name)))
    (if (equal? e "") 0 (read-from-string e))))

(define (read-int s)
  ;; Parse first integer found in string s
  (let ((len (string-length s)))
    (let loop ((i 0) (sign 1) (acc 0))
      (cond ((>= i len) acc)
            ((char=? (string-ref s i) #\-)
             (loop (+ i 1) -1 0))
            ((char>=? (string-ref s i) #\0) (char<=? (string-ref s i) #\9))
             (loop (+ i 1) sign (+ (* acc 10)
                                    (- (char->integer (string-ref s i))
                                       (char->integer #\0)))))
            (else (loop (+ i 1) sign acc))))))

;; Simpler parser using char->integer works for our digits.
(define (parse-int s)
  (let ((len (string-length s)))
    (let loop ((i 0) (acc 0))
      (cond ((>= i len) acc)
            ((char>=? (string-ref s i) #\0)
             (char<=? (string-ref s i) #\9))
             (loop (+ i 1)
                   (+ (* acc 10)
                      (- (char->integer (string-ref s i))
                         (char->integer #\0)))))
            (else (loop (+ i 1) acc))))))

(define (get-n)
  (let ((s (getenv name))))
  ) ; placeholder, replaced below

;; --- core algorithm ---

;; Build all well-formed parenthesis strings of length 2*n using backtracking.
;; We collect results into a list (built by cons in reverse order is fine).
(define (gen n)
  (let ((result '()))
    (letrec ((go (lambda (open-used close-used acc)
                   (cond
                     ((= open-used n)
                      ;; fill remaining with close brackets
                      (let fill ((k (- n close-used)) (s acc))
                        (if (= k 0)
                            (set! result (cons s result))
                            (fill (- k 1) (string-append s ")")))))
                     ((= close-used n)
                      ;; must place an open bracket if we still can
                      (go (+ open-used 1) close-used
                          (string-append acc "(")))
                     (else
                      (go (+ open-used 1) close-used
                          (string-append acc "("))
                      (if (> open-used close-used)
                          (go open-used (+ close-used 1)
                              (string-append acc ")"))
                          '()))))))
      (go 0 0 "")
      result)))

(define (solve n)
  (gen n))

;; --- I/O for test harness ---

(define (display-string s)
  (display s))

(define (display-list-of-strings lst)
  (display "[")
  (let loop ((rest lst) (first? #t))
    (cond ((null? rest) (display "]"))
          (else
           (if first? (set! first? #f) (display ","))
           (display "\"")
           (display (car rest))
           (display "\"")
           (loop (cdr rest) #f)))))

;; Parse N from the environment. Our embedded cases set CASE0..CASE7.
;; For each case, call solve and print result.

(define (run-case idx)
  (let ((name (string-append "CASE" (number->string idx))))
    (let ((raw (getenv name)))
      (let ((n (parse-int raw)))
        (let ((res (solve n)))
          (display (string-append "CASE" (number->string idx)))
          (display "=")
          (display-list-of-strings res)
          (newline))))))

(run-case 0)
(run-case 1)
(run-case 2)
(run-case 3)
(run-case 4)
(run-case 5)
(run-case 6)
(run-case 7)
