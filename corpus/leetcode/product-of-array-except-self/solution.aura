(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (nth n lst)
  (if (= n 0) (car lst) (nth (- n 1) (cdr lst))))

(define (set-nth n v lst)
  (if (= n 0)
      (cons v (cdr lst))
      (cons (car lst) (set-nth (- n 1) v (cdr lst)))))

(define (make-list n v)
  (if (= n 0)
      '()
      (cons v (make-list (- n 1) v))))

(define (update n v lst)
  (set-nth n v lst))

(define (count-zeros nums)
  (let ((len (length nums)))
    (let loop ((i 0) (acc 0))
      (if (= i len)
          acc
          (loop (+ i 1) (if (= (nth i nums) 0) (+ acc 1) acc))))))

(define (product-non-zero nums)
  (let ((len (length nums)))
    (let loop ((i 0) (acc 1))
      (if (= i len)
          acc
          (let ((v (nth i nums)))
            (loop (+ i 1) (if (= v 0) acc (* acc v))))))))

(define (solve nums)
  (let ((len (length nums)))
    (if (= len 0)
        '()
        (let ((zeros (count-zeros nums)))
          (cond
            ((>= zeros 2) (make-list len 0))
            ((= zeros 1)
             (let ((p (product-non-zero nums)))
               (let loop ((i 0) (acc '()))
                 (if (= i len)
                     (reverse acc)
                     (loop (+ i 1)
                           (cons (if (= (nth i nums) 0) p 0) acc))))))
            (else
             (let ((left (make-list len 1))
                   (right (make-list len 1)))
               (let ((i-loop (lambda (i)
                              (if (< i len)
                                  (begin
                                    (if (> i 0)
                                        (update i (* (nth (- i 1) left) (nth (- i 1) nums)) left)
                                        (update 0 1 left))
                                    (i-loop (+ i 1)))))))
                 (i-loop 0))
               (let ((j-loop (lambda (j)
                              (if (>= j 0)
                                  (begin
                                    (if (< j (- len 1))
                                        (update j (* (nth (+ j 1) right) (nth (+ j 1) nums)) right)
                                        (update (- len 1) 1 right))
                                    (j-loop (- j 1)))))))
                 (j-loop (- len 1)))
               (let loop ((k 0) (acc '()))
                 (if (= k len)
                     (reverse acc)
                     (loop (+ k 1)
                           (cons (* (nth k left) (nth k right)) acc)))))))))))

(define (display-list lst)
  (let loop ((first? #t) (l lst))
    (if (null? l)
        '()
        (begin
          (if (not first?) (display " "))
          (display (car l))
          (loop #f (cdr l))))))

(display "CASE0=") (display-list (solve '(2 1 3 4))) (newline)
(display "CASE1=") (display-list (solve '(0 4 0))) (newline)
(display "CASE2=") (display-list (solve '(-1 1 0 -3 3))) (newline)
(display "CASE3=") (display-list (solve '(1 2 3 4))) (newline)
(display "CASE4=") (display-list (solve '(0 0))) (newline)
(display "CASE5=") (display-list (solve '(5))) (newline)
(display "CASE6=") (display-list (solve '(-2 -3 4 -1))) (newline)
(display "CASE7=") (display-list (solve '(1 0 2 0 3))) (newline)
