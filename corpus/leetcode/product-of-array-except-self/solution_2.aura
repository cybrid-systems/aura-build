;; Product of Array Except Self - O(n) without division
;; Uses left-pass and right-pass approach with lists.

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (nth lst n)
  (if (= n 0) (car lst) (nth (cdr lst) (- n 1))))

(define (set-nth lst n v)
  (if (= n 0) (cons v (cdr lst)) (cons (car lst) (set-nth (cdr lst) (- n 1) v))))

(define (zero-count lst)
  (if (null? lst) 0
      (+ (if (= (car lst) 0) 1 0) (zero-count (cdr lst)))))

(define (build-list n val)
  (if (= n 0) '() (cons val (build-list (- n 1) val))))

(define (reverse-helper lst acc)
  (if (null? lst) acc (reverse-helper (cdr lst) (cons (car lst) acc))))

(define (reverse lst)
  (reverse-helper lst '()))

(define (map f lst)
  (if (null? lst) '() (cons (f (car lst)) (map f (cdr lst)))))

(define (solve nums)
  (let* ((n (length nums))
         (zc (zero-count nums)))
    (cond
      ((>= zc 2) (build-list n 0))
      (else
       ;; Find the zero index (if any)
       (let ((zero-idx (find-zero nums 0)))
         (if (= zc 1)
             (build-list-with-zero n zero-idx)
             ;; No zero: standard left/right pass
             (let* ((left (left-pass nums 1 1 '()))
                    (rev-nums (reverse nums))
                    (right (right-pass rev-nums 1 1 '()))
                    (right-rev (reverse right)))
               (combine nums left right-rev 0))))))))

(define (find-zero lst i)
  (cond ((null? lst) -1)
        ((= (car lst) 0) i)
        (else (find-zero (cdr lst) (+ i 1)))))

(define (build-list-with-zero n zero-idx)
  (let loop ((i 0) (acc '()))
    (if (= i n) (reverse acc)
        (loop (+ i 1) (cons (if (= i zero-idx) (product-of-rest 0 n) 0) acc)))))

(define (product-of-rest dummy n)
  ;; When there's exactly one zero, the output at the zero's index is the product of all others.
  ;; We need to compute product of nums excluding the zero. But we don't have nums here.
  ;; Actually, this approach is wrong - let's restructure.
  dummy)

;; Better approach: compute everything explicitly
(define (solve nums)
  (let* ((n (length nums))
         (zc (zero-count nums)))
    (cond
      ((>= zc 2) (build-list n 0))
      ((= zc 1)
       ;; Output is all zeros except at the zero index, where it's the product of all other elements.
       (let ((zi (find-zero nums 0)))
         (let ((prod (product-skip-zero nums 1)))
             (fill-with-zero n zi prod))))
      (else
       (let* ((left (left-pass nums 1 1 '()))
              (rev (reverse nums))
              (right (right-pass rev 1 1 '()))
              (right-rev (reverse right)))
         (combine nums left right-rev 0))))))

(define (product-skip-zero lst prod)
  (if (null? lst) prod
      (product-skip-zero (cdr lst) (if (= (car lst) 0) prod (* prod (car lst))))))

(define (fill-with-zero n zi prod)
  (let loop ((i 0) (acc '()))
    (if (= i n) (reverse acc)
        (loop (+ i 1) (cons (if (= i zi) prod 0) acc)))))

(define (left-pass nums i acc)
  (if (null? nums) (reverse acc)
      (let ((new-acc (cons acc-head nums i '())))
        (left-pass (cdr nums) (+ i 1) (cons (left-step acc i) acc)))))

(define (left-step acc i) 
  ;; acc is reversed list of left products so far
  (if (= i 1) 1 (* (car acc) (prev-val i))))

;; Too complicated. Let me redo cleanly.

;; Clean implementation:
(define (solve nums)
  (let* ((n (length nums))
         (zc (zero-count nums)))
    (cond
      ((>= zc 2) (build-list n 0))
      (else
       (let ((zi (find-zero nums 0)))
         (if (= zc 1)
             (let ((prod (product-excluding-zero nums)))
               (make-list-with n 0 zi prod))
             (let* ((lp (make-left-products nums))
                    (rp (make-right-products nums)))
               (merge-lists nums lp rp 0))))))))

(define (product-excluding-zero lst)
  (product-excluding-zero-helper lst 1))

(define (product-excluding-zero-helper lst p)
  (if (null? lst) p
      (if (= (car lst) 0)
          (product-excluding-zero-helper (cdr lst) p)
          (product-excluding-zero-helper (cdr lst) (* p (car lst))))))

(define (make-list-with n default-val special-idx special-val)
  (make-list-with-helper n 0 default-val special-idx special-val '()))

(define (make-list-with-helper n i dv sidx sv acc)
  (if (= i n) (reverse acc)
      (make-list-with-helper n (+ i 1) dv sidx sv
                             (cons (if (= i sidx) sv dv) acc))))

(define (make-left-products nums)
  (make-left-products-helper nums 1 '()))

(define (make-left-products-helper nums p acc)
  (if (null? nums) (reverse acc)
      (let ((new-acc (cons p acc)))
        (make-left-products-helper (cdr nums) (* p (car nums)) new-acc))))

(define (make-right-products nums)
  (make-right-products-helper (reverse nums) 1 '()))

(define (make-right-products-helper nums p acc)
  (if (null? nums) (reverse acc)
      (let ((new-acc (cons p acc)))
        (make-right-products-helper (cdr nums) (* p (car nums)) new-acc))))

(define (merge-lists nums lp rp i)
  (if (null? nums) '()
      (cons (* (car lp) (car rp)) (merge-lists (cdr nums) (cdr lp) (cdr rp) (+ i 1)))))

;; Helpers
(define (display-list lst)
  (cond ((null? lst) (display ""))
        ((null? (cdr lst)) (display (car lst)))
        (else (display (car lst)) (display " ") (display-list (cdr lst)))))

;; Main: process inputs and print CASE lines
(define (run-cases cases i)
  (if (null? cases) '()
      (begin
        (display "CASE") (display i) (display "=")
        (display-list (solve (car cases)))
        (newline)
        (run-cases (cdr cases) (+ i 1)))))

(run-cases 
  (list 
    (list 2 1 3 4)
    (list 0 4 0)
    (list -1 1 0 -3 3)
    (list 1 2 3 4)
    (list 0 0)
    (list 5)
    (list -2 -3 4 -1)
    (list 1 0 2 0 3))
  0)
