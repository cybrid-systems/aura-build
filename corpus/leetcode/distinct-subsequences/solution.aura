(define MOD 1000000007)

(define (mod+ a b)
  (modulo (+ a b) MOD))

(define (list-length lst)
  (if (null? lst)
      0
      (+ 1 (list-length (cdr lst)))))

(define (string->list-of-chars str)
  (let* ((len (string-length str))
         (loop (lambda (i acc)
                 (if (< i 0)
                     acc
                     (loop (- i 1)
                           (cons (string-ref str i) acc))))))
    (loop (- len 1) '())))

(define (make-row n)
  (let loop ((i 0) (acc '()))
    (if (>= i n)
        acc
        (loop (+ i 1) (cons 0 acc)))))

(define (row-get row i)
  (list-ref row i))

(define (row-set row i v)
  (let loop ((idx 0) (lst row) (acc '()))
    (if (null? lst)
        (reverse acc)
        (if (= idx i)
            (loop (+ idx 1) (cdr lst) (cons v acc))
            (loop (+ idx 1) (cdr lst) (cons (car lst) acc))))))

(define (solve s t)
  (let* ((s-chars (string->list-of-chars s))
         (t-chars (string->list-of-chars t))
         (n (list-length s-chars))
         (m (list-length t-chars)))
    (if (> m n)
        0
        (let* ((dp (make-row (+ m 1)))
               (set-base (lambda (i v) (row-set dp i v))))
          (set-base 0 1)
          (let outer ((si 0))
            (if (= si n)
                (row-get dp m)
                (let ((sc (list-ref s-chars si))
                      (update (lambda (j val)
                                (let ((cur (row-get dp j)))
                                  (set-base j (mod+ cur val))))))
                  (let inner ((j 1) (matched 0))
                    (if (> j m)
                        (begin)
                        (let ((tc (list-ref t-chars (- j 1))))
                          (if (char=? sc tc)
                              (let ((prev-match (row-get dp (- j 1))))
                                (if (= matched 0)
                                    (begin)
                                    (update j prev-match)))
                              (begin))
                          (if (= matched 0)
                              (inner (+ j 1) 1)
                              (inner (+ j 1) (+ matched 1))))))
                  (outer (+ si 1)))))))))

(define (char=? a b)
  (string=? (make-string 1 a) (make-string 1 b)))

(define (test-case s t)
  (let ((result (solve s t)))
    (display "CASE")
    (display (number->string result))
    (newline)))

(let ((cases '(("rabbbit" . "rabbit")
               ("babgbag" . "bag")
               ("" . "")
               ("" . "a")
               ("a" . "a")
               ("a" . "b")
               ("aa" . "a")
               ("aaa" . "aa")
               ("abcdef" . "fed")
               ("zxyzxyz" . "xyz"))))
  (let loop ((cs cases) (i 0))
    (if (null? cs)
        (begin)
        (let* ((pair (car cs))
               (s (car pair))
               (t (cdr pair))
               (result (solve s t)))
          (display "CASE")
          (display (number->string i))
          (display "=")
          (display (number->string result))
          (newline)
          (loop (cdr cs) (+ i 1))))))
