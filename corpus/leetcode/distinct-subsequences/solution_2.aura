(define MOD 1000000007)

(define (string-length s)
  (let loop ((i 0))
    (if (string=? (substring s i (+ i 1)) "")
        i
        (loop (+ i 1)))))

(define (string-ref-safe s i)
  (substring s i (+ i 1)))

(define (solve s t)
  (let* ((n (string-length s))
         (m (string-length t))
         (dp (make-vector (+ m 1) 0)))
    (vector-set! dp 0 1)
    (let loop-i ((i 0))
      (if (= i n)
          (vector-ref dp m)
          (begin
            (let loop-j ((j (min m (+ i 1))))
              (if (= j 0)
                  (loop-i (+ i 1))
                  (let* ((tj-1 (string-ref-safe t (- j 1)))
                         (si (string-ref-safe s i))
                         (cur (vector-ref dp j))
                         (prev (vector-ref dp (- j 1)))
                         (new-val (if (string=? tj-1 si)
                                      (modulo (+ cur prev) MOD)
                                      cur)))
                    (vector-set! dp j new-val)
                    (loop-j (- j 1))))
            )))))

(define (display-list xs)
  (display "[")
  (let loop ((rest xs) (first #t))
    (cond ((null? rest) (display "]"))
          (else
           (if first (set! first #f) (display " "))
           (display (car rest))
           (loop (cdr rest) #f)))))

(define (run-case i s t)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve s t))
  (newline))

(run-case 0 "rabbbit" "rabbit")
(run-case 1 "babgbag" "bag")
(run-case 2 "" "")
(run-case 3 "" "a")
(run-case 4 "a" "a")
(run-case 5 "a" "b")
(run-case 6 "aa" "a")
(run-case 7 "aaa" "aa")
(run-case 8 "abcdef" "fed")
(run-case 9 "zxyzxyz" "xyz")
