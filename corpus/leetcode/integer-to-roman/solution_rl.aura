(require "lc_json" all:)
(require "compat" all:)
(define (solve n)
  (let ((values '(1000 900 500 400 100 90 50 40 10 9 5 4 1))
        (symbols '("M" "CM" "D" "CD" "C" "XC" "L" "XL" "X" "IX" "V" "IV" "I")))
    (let loop ((v values) (s symbols) (num n) (acc ""))
      (cond
        ((null? v) acc)
        ((>= num (car v))
         (loop v s (- num (car v)) (string-append acc (car s))))
        (else
         (loop (cdr v) (cdr s) num acc))))))
(define (run-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/integer-to-roman/tests.json")))
