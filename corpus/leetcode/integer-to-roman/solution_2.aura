(define (solve n)
  (let* ((values '(1000 900 500 400 100 90 50 40 10 9 5 4 1))
         (symbols '("M" "CM" "D" "CD" "C" "XC" "L" "XL" "X" "IX" "V" "IV" "I")))
    (letrec ((convert
              (lambda (vals syms n acc)
                (if (or (= n 0) (null? vals))
                    (apply string-append (reverse acc))
                    (let ((v (car vals))
                          (s (car syms)))
                      (if (>= n v)
                          (convert vals syms (- n v) (cons s acc))
                          (convert (cdr vals) (cdr syms) n acc)))))))
      (convert values symbols n '()))))

(define (display-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n))
  (newline))

(display-case 0 58)
(display-case 1 1994)
(display-case 2 9)
(display-case 3 3999)
(display-case 4 4)
(display-case 5 40)
(display-case 6 90)
(display-case 7 400)
(display-case 8 900)
(display-case 9 1)
(display-case 10 3888)
