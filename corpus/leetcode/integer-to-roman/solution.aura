(define (solve n)
  (let ((values '(1000 900 500 400 100 90 50 40 10 9 5 4 1))
        (symbols '("M" "CM" "D" "CD" "C" "XC" "L" "XL" "X" "IX" "V" "IV" "I")))
    (let loop ((v values) (s symbols) (num n) (acc ""))
      (cond
        ((null? v) acc)
        ((>= num (car v))
         (loop v s (- num (car v)) (string-append acc (car s))))
        (else
         (loop (cdr v) (cdr s) num acc))))))

(define (run-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n))
  (newline))

(run-case 0 58)
(run-case 1 1994)
(run-case 2 9)
(run-case 3 3999)
(run-case 4 4)
(run-case 5 40)
(run-case 6 90)
(run-case 7 400)
(run-case 8 900)
(run-case 9 1)
(run-case 10 3888)
