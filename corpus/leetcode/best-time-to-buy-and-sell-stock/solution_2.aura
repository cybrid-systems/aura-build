(define (solve prices)
  (let loop ((xs prices) (min-so-far 100000000) (best 0))
    (if (null? xs)
        best
        (let ((p (car xs)))
          (let ((new-min (if (< p min-so-far) p min-so-far))
                (profit (if (< min-so-far p) (- p min-so-far) 0)))
            (let ((new-best (if (> profit best) profit best)))
              (loop (cdr xs) new-min new-best)))))))

(define (run-case i prices)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve prices))
  (newline))

(run-case 0 (list 7 1 5 3 6 4))
(run-case 1 (list 7 6 4 3 1))
(run-case 2 (list 1))
(run-case 3 (list 2 4 1))
(run-case 4 (list 3 2 6 5 0 3))
(run-case 5 (list 1 2 3 4 5))
(run-case 6 (list 5 4 3 2 1))
(run-case 7 (list 0 0 0 0))
