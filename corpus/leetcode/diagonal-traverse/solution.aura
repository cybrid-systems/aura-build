(define (max a b) (if (> a b) a b))
(define (min a b) (if (< a b) a b))

(define (solve m n grid)
  (define result '())
  (let ((limit (+ m n -2)))
    (let loop ((s 0))
      (if (> s limit)
          result
          (begin
            (set! result
              (append result
                (let ((diagonal '()))
                  (let ((i (max 0 (- s n -1)))
                        (j (min s (- n 1))))
                    (let inner ((i i) (j j))
                      (if (or (>= i m) (< j 0))
                          diagonal
                          (begin
                            (set! diagonal (append diagonal (list (list-ref (list-ref grid i) j))))
                            (inner (+ i 1) (- j 1))))))
                  (if (even? s)
                      (reverse diagonal)
                      diagonal))))
            (loop (+ s 1)))))))

(define (even? x) (= (modulo x 2) 0))

(define (display-result lst)
  (let loop ((l lst) (first #t))
    (cond ((null? l) (newline))
          (else
           (if first (display (car l)) (begin (display " ") (display (car l))))
           (loop (cdr l) #f)))))

(define (reverse lst)
  (let loop ((acc '()) (l lst))
    (if (null? l) acc (loop (cons (car l) acc) (cdr l)))))

(define (append a b)
  (if (null? a) b (cons (car a) (append (cdr a) b))))

(let ((g0 (list (list 1 2 3) (list 4 5 6) (list 7 8 9))))
  (display "CASE0=") (display-result (solve 3 3 g0)))

(let ((g1 (list (list 1 2) (list 3 4))))
  (display "CASE1=") (display-result (solve 2 2 g1)))

(let ((g2 (list (list 42))))
  (display "CASE2=") (display-result (solve 1 1 g2)))

(let ((g3 (list (list 1 2 3 4))))
  (display "CASE3=") (display-result (solve 1 4 g3)))

(let ((g4 (list (list 1) (list 2) (list 3) (list 4))))
  (display "CASE4=") (display-result (solve 4 1 g4)))

(let ((g5 (list (list 1 2 3) (list 4 5 6))))
  (display "CASE5=") (display-result (solve 2 3 g5)))

(let ((g6 (list (list 1 2) (list 3 4) (list 5 6))))
  (display "CASE6=") (display-result (solve 3 2 g6)))

(let ((g7 (list (list -1 -2 -3 -4 -5) (list -6 -7 -8 -9 -10) (list -11 -12 -13 -14 -15) (list -16 -17 -18 -19 -20) (list -21 -22 -23 -24 -25))))
  (display "CASE7=") (display-result (solve 5 5 g7)))
