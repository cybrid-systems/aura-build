(define (min a b) (if (< a b) a b))
(define (max a b) (if (> a b) a b))

(define (reverse-list lst)
  (define (rev acc rest)
    (if (null? rest) acc (rev (cons (car rest) acc) (cdr rest))))
  (rev '() lst))

(define (append-all lst suffix)
  (if (null? lst)
      suffix
      (cons (car lst) (append-all (cdr lst) suffix))))

(define (grid-ref grid i j)
  (list-ref (list-ref grid i) j))

(define (collect-diagonal grid m n s)
  (let ((start-i (max 0 (- s (- n 1))))
        (start-j (min s (- n 1))))
    (define (loop i j acc)
      (if (or (>= i m) (< j 0))
          acc
          (loop (+ i 1) (- j 1) (cons (grid-ref grid i j) acc))))
    (loop start-i start-j '())))

(define (solve m n grid)
  (define (loop s acc)
    (if (> s (+ m n -2))
        (apply append (map (lambda (x) (list x)) '()))  ; not used
        (let ((d (collect-diagonal grid m n s)))
          (loop (+ s 1) (append-all acc d)))))
  (let loop-s ((s 0) (acc '()))
    (if (> s (+ m n -2))
        acc
        (let ((d (collect-diagonal grid m n s)))
          (if (even? s)
              (loop-s (+ s 1) (append-all (reverse-list d) acc))
              (loop-s (+ s 1) (append-all d acc)))))))

(define (display-list lst)
  (define (loop rest first?)
    (if (null? rest)
        '()
        (begin
          (if (not first?) (begin (display " ") '()) '())
          (display (car rest))
          (loop (cdr rest) #f))))
  (loop lst #t))

(let ((m 3) (n 3) (grid (list (list 1 2 3) (list 4 5 6) (list 7 8 9))))
  (display "CASE0=")
  (display-list (solve m n grid))
  (newline))

(let ((m 2) (n 2) (grid (list (list 1 2) (list 3 4))))
  (display "CASE1=")
  (display-list (solve m n grid))
  (newline))

(let ((m 1) (n 1) (grid (list (list 42))))
  (display "CASE2=")
  (display-list (solve m n grid))
  (newline))

(let ((m 1) (n 4) (grid (list (list 1 2 3 4))))
  (display "CASE3=")
  (display-list (solve m n grid))
  (newline))

(let ((m 4) (n 1) (grid (list (list 1) (list 2) (list 3) (list 4))))
  (display "CASE4=")
  (display-list (solve m n grid))
  (newline))

(let ((m 2) (n 3) (grid (list (list 1 2 3) (list 4 5 6))))
  (display "CASE5=")
  (display-list (solve m n grid))
  (newline))

(let ((m 3) (n 2) (grid (list (list 1 2) (list 3 4) (list 5 6))))
  (display "CASE6=")
  (display-list (solve m n grid))
  (newline))

(let ((m 5) (n 5) (grid (list (list -1 -2 -3 -4 -5)
                              (list -6 -7 -8 -9 -10)
                              (list -11 -12 -13 -14 -15)
                              (list -16 -17 -18 -19 -20)
                              (list -21 -22 -23 -24 -25))))
  (display "CASE7=")
  (display-list (solve m n grid))
  (newline))
