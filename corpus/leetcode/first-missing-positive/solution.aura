(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (list-set! lst i v)
  (define (helper lst i)
    (if (= i 0)
        (set-car! lst v)
        (helper (cdr lst) (- i 1))))
  (helper lst i))

(define (swap! lst i j)
  (let ((a (list-ref lst i)) (b (list-ref lst j)))
    (list-set! lst i b)
    (list-set! lst j a)))

(define (solve arr)
  (let ((n (length arr)))
    (define (place i)
      (if (>= i n) 'done
          (let ((v (list-ref arr i)))
            (if (and (>= v 1) (<= v n) (not (= (list-ref arr (- v 1)) v)))
                (begin
                  (swap! arr i (- v 1))
                  (place i))
                (place (+ i 1))))))
    (place 0)
    (define (scan i)
      (if (>= i n) (+ n 1)
          (if (= (list-ref arr i) (+ i 1))
              (scan (+ i 1))
              (+ i 1))))
    (scan 0)))

(define (run-cases)
  (let* ((case0 (list 3 4 -1 1))
         (case1 (list 1 2 0))
         (case2 (list -5 -1 0))
         (case3 (list 1 2 3 4))
         (case4 (list 2 2 2 2))
         (case5 (list 7 8 9 11 12))
         (case6 (list 1))
         (case7 (list 2)))
    (display "CASE0=") (display (solve case0)) (newline)
    (display "CASE1=") (display (solve case1)) (newline)
    (display "CASE2=") (display (solve case2)) (newline)
    (display "CASE3=") (display (solve case3)) (newline)
    (display "CASE4=") (display (solve case4)) (newline)
    (display "CASE5=") (display (solve case5)) (newline)
    (display "CASE6=") (display (solve case6)) (newline)
    (display "CASE7=") (display (solve case7)) (newline)))

(run-cases)
