(define (solve m n)
  ; Find common prefix of m and n by shifting both right until equal
  (let loop ((shift 0)
             (a m)
             (b n))
    (if (= a b)
        ; Shift back left to restore position
        (let loop2 ((s shift) (v a))
          (if (= s 0)
              v
              (loop2 (- s 1) (* v 2))))
        (loop (+ shift 1) (quotient a 2) (quotient b 2)))))

(define (print-case i m n)
  (display "CASE")
  (display i)
  (display "=m=")
  (display m)
  (display ",n=")
  (display n)
  (newline)
  (let ((ans (solve m n)))
    (display "ANS")
    (display i)
    (display "=")
    (display ans)
    (newline)))

(print-case 0 5 7)
(print-case 1 0 0)
(print-case 2 1 9223372036854775808)
(print-case 3 9223372036854775808 9223372036854775808)
(print-case 4 0 18446744073709551615)
(print-case 5 0 1)
(print-case 6 12 15)
(print-case 7 9223372036854775808 18446744073709551615)
