(require "lc_json" all:)
(require "compat" all:)
(define (solve m n)
  ; Find common prefix of m and n by shifting both right until equal
  (let loop ((shift 0)
             (a m)
             (b n))
    (if (= a b)
        ; Shift back left to restore position
        (let loop2 ((s shift) (v a))
          (if (= s 0)
              v
              (loop2 (- s 1) (* v 2))))
        (loop (+ shift 1) (quotient a 2) (quotient b 2)))))
(define (print-case i m n)
  (display "CASE")
  (display i)
  (display "=m=")
  (display m)
  (display ",n=")
  (display n)
  (newline)
  (let ((ans (solve m n)))
    (display "ANS")
    (display i)
    (display "=")
    (display ans)
    (newline)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "m") (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/bitwise-and-of-numbers-range/tests.json")))
