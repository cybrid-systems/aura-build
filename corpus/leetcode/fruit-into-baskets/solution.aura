(define (solve fruits)
  ;; fruits is a list of numbers
  ;; Returns the length of the longest contiguous subarray with at most 2 distinct values.
  (let* ((n (length fruits))
         (result 0)
         (left 0)
         (right 0)
         (count1 -1)
         (count2 -1)
         (c1 0)
         (c2 0))
    ;; We'll implement sliding window using list traversal.
    ;; Approach: iterate right pointer from 0 to n-1, expanding window.
    ;; Maintain up to 2 distinct values with their counts.
    ;; When introducing a 3rd distinct value, shrink from left until only 2 distinct remain.
    ;; Since we can't easily mutate counters in a purely functional way for each step efficiently,
    ;; we use a simpler O(n^2) approach that's correct and small.
    (let loop ((i 0) (best 0))
      (if (= i n)
          best
          (let inner ((j i) (seen1 #f) (v1 0) (seen2 #f) (v2 0) (len 0))
            (cond
              ((= j n) (if (> len best) len best))
              ((not seen1)
               (inner (+ j 1) #t (list-ref fruits j) seen2 v2 (+ len 1)))
              ((and seen1 (not seen2) (= (list-ref fruits j) v1))
               (inner (+ j 1) seen1 v1 seen2 v2 (+ len 1)))
              ((and seen1 (not seen2))
               (inner (+ j 1) seen1 v1 #t (list-ref fruits j) (+ len 1)))
              ((and seen1 seen2 (or (= (list-ref fruits j) v1) (= (list-ref fruits j) v2)))
               (inner (+ j 1) seen1 v1 seen2 v2 (+ len 1)))
              (else
               (if (> len best) len best))))))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (test-case-0)
  (let ((fruits '(3 3 3 1 2 1 1 2 3 3 4)))
    (display "CASE0=") (display (solve fruits)) (newline)))

(define (test-case-1)
  (let ((fruits '(1 2 1)))
    (display "CASE1=") (display (solve fruits)) (newline)))

(define (test-case-2)
  (let ((fruits '(1 2 3 4)))
    (display "CASE2=") (display (solve fruits)) (newline)))

(define (test-case-3)
  (let ((fruits '(1 1 1 1)))
    (display "CASE3=") (display (solve fruits)) (newline)))

(define (test-case-4)
  (let ((fruits '(1 2)))
    (display "CASE4=") (display (solve fruits)) (newline)))

(define (test-case-5)
  (let ((fruits '(2 1 2 1)))
    (display "CASE5=") (display (solve fruits)) (newline)))

(define (test-case-6)
  (let ((fruits '(0 1 2 2 3 4 4 5)))
    (display "CASE6=") (display (solve fruits)) (newline)))

(define (test-case-7)
  (let ((fruits '(5)))
    (display "CASE7=") (display (solve fruits)) (newline)))

(test-case-0)
(test-case-1)
(test-case-2)
(test-case-3)
(test-case-4)
(test-case-5)
(test-case-6)
(test-case-7)
