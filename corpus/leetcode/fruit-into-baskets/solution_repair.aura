(define (solve fruits)
  (let* ((n (length fruits))
         (left 0)
         (right 0)
         (best 0)
         (v1 -1) (c1 0) (v2 -1) (c2 0))
    (define (add-val! x)
      (cond
        ((= c1 0) (set! v1 x) (set! c1 1))
        ((= v1 x) (set! c1 (+ c1 1)))
        ((= c2 0) (set! v2 x) (set! c2 1))
        ((= v2 x) (set! c2 (+ c2 1)))
        (else
         ;; shouldn't happen if we shrink first
         (set! v1 x) (set! c1 1)
         (set! v2 -1) (set! c2 0))))
    (define (shrink-until-two!)
      ;; shrink left until c1=0 or c2=0 (a basket becomes empty)
      (let shrink ()
        (cond
          ((or (= c1 0) (= c2 0)) #t)
          ((and (= c1 1) (= c2 0)) #t)
          (else
           (let ((x (list-ref fruits left)))
             (set! left (+ left 1))
             (cond
               ((= x v1)
                (set! c1 (- c1 1))
                (if (= c1 0) (set! v1 -1)))
               ((= x v2)
                (set! c2 (- c2 1))
                (if (= c2 0) (set! v2 -1))))
             (shrink))))))
    ;; main loop
    (let loop ((r 0))
      (if (= r n) best
          (begin
            (add-val! (list-ref fruits r))
            ;; now possibly 3 distinct; ensure at most 2
            (cond
              ((and (> c1 0) (> c2 0))
               ;; ok, two distinct active
               (set! best (if (> (- r left -1) best) (- r left -1) best))
               (loop (+ r 1)))
              (else
               ;; need to check
               (shrink-until-two!)
               (set! best (if (> (- r left -1) best) (- r left -1) best))
               (loop (+ r 1)))))))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (run-test idx fruits)
  (display "CASE") (display idx) (display "=")
  (display (solve fruits)) (newline))

(run-test 0 '(3 3 3 1 2 1 1 2 3 3 4))
(run-test 1 '(1 2 1))
(run-test 2 '(1 2 3 4))
(run-test 3 '(1 1 1 1))
(run-test 4 '(1 2))
(run-test 5 '(2 1 2 1))
(run-test 6 '(0 1 2 2 3 4 4 5))
(run-test 7 '(5))
