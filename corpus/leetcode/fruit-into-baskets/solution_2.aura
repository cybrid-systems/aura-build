(define (length xs)
  (if (null? xs) 0 (+ 1 (length (cdr xs)))))

(define (solve fruits)
  (let* ((n (length fruits))
         (result 0)
         (left 0)
         (counts '())
         (distinct 0))
    (define (add-count! k)
      (let ((pair (assq k counts)))
        (if pair
            (set-cdr! pair (+ 1 (cdr pair)))
            (begin
              (set! counts (cons (cons k 1) counts))
              (set! distinct (+ distinct 1))))))
    (define (sub-count! k)
      (let ((pair (assq k counts)))
        (when pair
          (set-cdr! pair (- (cdr pair) 1))
          (when (= (cdr pair) 0)
            (set! counts (remove-assq k counts))
            (set! distinct (- distinct 1))))))
    (define (remove-assq k lst)
      (cond ((null? lst) '())
            ((eq? (car (car lst)) k) (cdr lst))
            (else (cons (car lst) (remove-assq k (cdr lst))))))
    (define (i-loop i)
      (if (= i n)
          result
          (let ((x (list-ref fruits i)))
            (add-count! x)
            (let shrink ()
              (if (> distinct 2)
                  (begin
                    (sub-count! (list-ref fruits left))
                    (set! left (+ left 1))
                    (shrink))
                  (begin
                    (set! result (max result (- (+ i 1) left)))
                    (i-loop (+ i 1)))))))))
    (i-loop 0)))

(define (list-ref xs i)
  (if (= i 0) (car xs) (list-ref (cdr xs) (- i 1))))

(define (max a b) (if (> a b) a b))

(define (display-list lst)
  (display "[")
  (let loop ((xs lst) (first #t))
    (cond ((null? xs) (display "]"))
          (else
           (if first (set! first #f) (display " "))
           (display (car xs))
           (loop (cdr xs) #f)))))

(let ((cases
       (list
        (list 0 '(3 3 3 1 2 1 1 2 3 3 4))
        (list 1 '(1 2 1))
        (list 2 '(1 2 3 4))
        (list 3 '(1 1 1 1))
        (list 4 '(1 2))
        (list 5 '(2 1 2 1))
        (list 6 '(0 1 2 2 3 4 4 5))
        (list 7 '(5)))))
  (let loop ((cs cases))
    (if (null? cs)
        '()
        (begin
          (let* ((c (car cs))
                 (id (car c))
                 (fruits (car (cdr c)))
                 (res (solve fruits)))
            (display "CASE")
            (display id)
            (display "=")
            (display res)
            (newline))
          (loop (cdr cs))))))
