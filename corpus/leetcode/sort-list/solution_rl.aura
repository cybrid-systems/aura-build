(require "lc_json" all:)
(require "compat" all:)
(define (merge a b)
  (cond ((null? a) b)
        ((null? b) a)
        (else
         (if (<= (car a) (car b))
             (cons (car a) (merge (cdr a) b))
             (cons (car b) (merge a (cdr b)))))))
(define (split-list lst)
  (if (or (null? lst) (null? (cdr lst)))
      (cons lst '())
      (let ((slow lst)
            (fast (cdr lst)))
        ;; Walk fast forward until end, advance slow too
        (define (walk s f)
          (cond ((null? f) s)
                ((null? (cdr f)) s)
                (else (walk (cdr s) (cdr (cdr f))))))
        (let ((mid (walk slow fast)))
          (cons (lst-take lst (mid-len lst mid))
                (lst-drop lst (mid-len lst mid)))))))
(define (split-helper lst)
  (define (go s f acc)
    (cond ((null? f) (cons (reverse acc) (cons s '())))
          ((null? (cdr f)) (cons (reverse (cons s acc)) (cons (cdr f) '())))
          (else (go (cdr s) (cdr (cdr f)) (cons s acc)))))
  (if (or (null? lst) (null? (cdr lst)))
      (cons lst '())
      (go lst (cdr lst) '())))
(define (mergesort lst)
  (if (or (null? lst) (null? (cdr lst)))
      lst
      (let ((split (split-helper lst)))
        (let ((left (car split))
              (right (cdr split)))
          (merge (mergesort left) (mergesort right))))))
(define (solve head)
  (mergesort head))
(define (display-list lst)
  (display "[")
  (let ((loop (lambda (l first?)
                (if (null? l)
                    (display "]")
                    (begin
                      (if (not first?) (display " "))
                      (display (car l))
                      (loop (cdr l) #f))))))
    (loop lst #t)))
(define (run-test case-n input)
  (let ((head input))
    (let ((result (solve head)))
      (display "CASE")
      (display case-n)
      (display "=")
      (display-list result)
      (newline))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "head")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/sort-list/tests.json")))
