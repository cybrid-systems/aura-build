;; Tree node built from flat list '(left right) attached to a value
;; null in input -> the special symbol 'null

(define (parse-tokens s)
  ;; Tokenize a string like "[2,null,3]" into tokens: '(2 null 3)
  (let ((chars (string->list s)))
    (parse-loop chars '() '())))

(define (parse-loop chars buf acc)
  (cond
    ((null? chars)
     (reverse (if (null? buf) acc (cons (list->atom (reverse buf)) acc))))
    (else
     (let ((c (car chars)))
       (cond
         ((or (char=? c #\[) (char=? c #\]) (char=? c #\,) (char=? c #\space))
          (if (null? buf)
              (parse-loop (cdr chars) '() acc)
              (parse-loop (cdr chars) '() (cons (list->atom (reverse buf)) acc))))
         ((char=? c #\n)
          (parse-loop (cdr chars) '() acc))
         (else
          (parse-loop (cdr chars) (cons c buf) acc)))))))

(define (list->atom lst)
  ;; Convert list of chars to string, then if it's "null" return 'null,
  ;; otherwise parse as integer.
  (let ((s (list->string (reverse lst))))
    (if (or (string=? s "null") (string=? s "None"))
        'null
        (string->number s))))

(define (build-tree arr)
  ;; arr is a list of values (numbers or 'null). Build tree as nested pairs.
  ;; Node representation: (value left right) or 'null
  (if (null? arr)
      'null
      (let ((root (cons (car arr) (cons 'null (cons 'null '())))))
        (build-tree-helper (cdr arr) root '() 0))))

(define (build-tree-helper arr root queue idx)
  ;; queue holds nodes whose children we still need to fill, in order.
  (cond
    ((null? arr) root)
    ((null? queue)
     ;; shouldn't happen if input well-formed
     root)
    (else
     (let* ((parent (car queue))
            (restq (cdr queue))
            (left-val (car arr))
            (right-val (if (and (not (null? (cdr arr)))) (cadr arr) 'null))
            (new-queue restq))
       (let ((new-parent parent))
         (define new-parent #f)
         (set! new-parent
               (cond
                 ((= idx 0)
                  (set-car! (cdr parent) (make-node left-val))
                  (if (not (eq? right-val 'null))
                      (begin
                        (set-car! (cddr parent) (make-node right-val))
                        (cons (car (cdr parent)) (cons (car (cddr parent)) restq)))
                      (begin
                        (set-car! (cddr parent) 'null)
                        (if (not (eq? left-val 'null))
                            (cons (car (cdr parent)) restq)
                            restq))))
                 ((= idx 1)
                  (set-car! (cddr parent) (make-node left-val))
                  (cons (car (cddr parent)) restq))
                 (else parent)))
         (build-tree-helper
          (if (not (eq? right-val 'null))
              (cddr arr)
              (cdr arr))
          root new-parent 0))))))

(define (make-node v)
  (if (eq? v 'null)
      'null
      (cons v (cons 'null (cons 'null '())))))

;; Simpler approach: parse array directly into tree structure
(define (build-tree-simple arr)
  (if (null? arr)
      'null
      (let ((n (length arr)))
        ;; Create node list (or 'null for each position)
        (let ((nodes (map (lambda (v) (if (eq? v 'null) 'null (cons v (cons 'null (cons 'null '()))))) arr)))
          ;; Link parent at index i: left child at 2i+1, right at 2i+2
          (link-tree nodes 0 n)
          (car nodes)))))

(define (link-tree nodes i n)
  (cond
    ((>= i n) #t)
    ((eq? (list-ref nodes i) 'null) (link-tree nodes (+ i 1) n))
    (else
     (let ((li (+ (* 2 i) 1)))
       (let ((ri (+ (* 2 i) 2)))
         (if (< li n)
             (set-car! (cdr (list-ref nodes i)) (list-ref nodes li))
             #t)
         (if (< ri n)
             (set-car! (cddr (list-ref nodes i)) (list-ref nodes ri))
             #t)
         (link-tree nodes (+ i 1) n))))))

(define (list-ref lst i)
  (cond
    ((null? lst) (error "out of bounds"))
    ((= i 0) (car lst))
    (else (list-ref (cdr lst) (- i 1)))))

(define (list-set! lst i v)
  ;; Not directly available; we use set-car! on cdr chains
  (error "unused"))

;; Validate BST: each node must be strictly within (min, max) bounds
(define (valid-bst? node)
  (valid-helper node #f #f))

(define (valid-helper node lo hi)
  (cond
    ((eq? node 'null) #t)
    (else
     (let ((v (car node)))
       (let ((l (cadr node)) (r (caddr node)))
         (cond
           ((and lo (>= lo v)) #f)
           ((and hi (<= hi v)) #f)
           (else
            (and (valid-helper l lo v) (valid-helper r v hi)))))))))

(define (solve arr)
  (let ((root (build-tree-simple arr)))
    (if (valid-bst? root) #t #f)))

(define (print-list lst)
  (display "[")
  (print-list-helper lst)
  (display "]"))

(define (print-list-helper lst)
  (cond
    ((null? lst) #t)
    (else
     (display (car lst))
     (if (not (null? (cdr lst)))
         (display ", "))
     (print-list-helper (cdr lst)))))

(define (run-case i arr)
  (let ((result (solve arr)))
    (display "CASE")
    (display i)
    (display "=")
    (if result (display "true") (display "false"))
    (newline)))

;; Embedded test cases
(run-case 0 '())
(run-case 1 '(2 1 3))
(run-case 2 '(5 1 4 null null 3 6))
(run-case 3 '(1))
(run-case 4 '(1 1))
(run-case 5 '(2 2 2))
(run-case 6 '(5 3 7 1 4 6 8))
(run-case 7 '(3 2 4 1 null null null))
