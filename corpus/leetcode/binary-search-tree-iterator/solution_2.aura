(define (parse-val s)
  (if (equal? s "null") '() (list (string->number s))))

(define (split-comma s)
  (define (helper i acc)
    (cond ((>= i (string-length s)) (reverse acc))
          (else
           (let loop ((j i) (brace 0))
             (cond ((>= j (string-length s))
                    (helper (+ j 1) (cons (substring s i j) acc)))
                   ((char=? (string-ref s j) #\[) (loop (+ j 1) (+ brace 1)))
                   ((char=? (string-ref s j) #\]) (loop (+ j 1) (- brace 1)))
                   ((and (= brace 0) (char=? (string-ref s j) #\,))
                    (helper (+ j 1) (cons (substring s i j) acc)))
                   (else (loop (+ j 1) brace)))))))
  (helper 0 '()))

(define (build-tree arr)
  (let ((vals (map parse-val arr)))
    (define (helper idx)
      (if (or (>= idx (length vals)) (null? (list-ref vals idx)))
          '()
          (list (car (list-ref vals idx)) (helper (+ idx 1)) (helper (+ idx 2)))))
    (if (null? vals) '() (helper 0))))

(define (push-lefts stack node)
  (if (null? node) stack
      (push-lefts (cons node stack) (cadr node))))

(define (it-next it)
  (let ((node (car it)) (stack (cdr it)))
    (let ((val (car node))
          (new-stack (push-lefts stack (caddr node))))
      (cons val new-stack))))

(define (it-has-next it) (not (null? it)))

(define (make-iterator root) (push-lefts '() root))

(define (reset-iterator root) (make-iterator root))

(define (process-case lines)
  (define (run it lines)
    (cond ((null? lines) 'done)
          (else
           (let ((line (car lines)))
             (cond
               ((substring-contains? line "OP:next")
                (let ((result (it-next it)))
                  (display "OUT=")
                  (display (car result))
                  (newline)
                  (run (cdr result) (cdr lines))))
               ((substring-contains? line "OP:has_next")
                (display "OUT=")
                (display (if (it-has-next it) "true" "false"))
                (newline)
                (run it (cdr lines))))
               ((substring-contains? line "OP:reset")
                (run (reset-iterator (car *current-tree*)) (cdr lines))))
               (else (run it (cdr lines))))))))
  (let ((tree-line (car lines)))
    (let ((tree-arr (split-comma (substring tree-line 6 (string-length tree-line)))))
      (let ((root (build-tree tree-arr)))
        (set! *current-tree* (cons root '()))
        (run (make-iterator root) (cdr lines))))))

(define *current-tree* (cons '() '()))

(define (substring-contains? s sub)
  (let ((sl (string-length s)) (subl (string-length sub)))
    (define (helper i)
      (cond ((> (+ i subl) sl) #f)
            ((string=? (substring s i (+ i subl)) sub) #t)
            (else (helper (+ i 1)))))
    (helper 0)))

(define (solve case-lines)
  (process-case case-lines))

(define (run-case i case-lines)
  (display "CASE")
  (display i)
  (display "=")
  (solve case-lines)
  (newline))

(run-case 0 '("CASE0=TREE:[7,3,15,null,null,9,20]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(run-case 1 '("CASE0=TREE:[]" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:end"))
(run-case 2 '("CASE0=TREE:[5]" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(run-case 3 '("CASE0=TREE:[5,4,null,3,null,2,null,1]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(run-case 4 '("CASE0=TREE:[1,null,2,null,3,null,4,null,5]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(run-case 5 '("CASE0=TREE:[10,5,15,3,7,12,20]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:reset" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:end"))
(run-case 6 '("CASE0=TREE:[4,2,6,1,3,5,7]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
