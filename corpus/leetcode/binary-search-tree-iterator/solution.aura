(define (make-node v l r) (cons v (cons l r)))
(define (node-val n) (car n))
(define (node-left n) (car (cdr n)))
(define (node-right n) (cdr (cdr n)))
(define (node? x) (and (pair? x) (pair? (cdr x))))

(define (build-tree lst)
  (if (or (null? lst) (equal? (car lst) 'null))
      '()
      (let ((root (make-node (car lst) '() '())))
        (define (build-from-level nodes vals)
          (cond ((or (null? nodes) (null? vals)) '())
                (else
                 (let ((first-val (car vals))
                       (rest-vals (cdr vals))
                       (first-node (car nodes))
                       (rest-nodes (cdr nodes)))
                   (define after-first
                     (if (and (not (null? rest-vals))
                              (not (equal? (car rest-vals) 'null)))
                         (begin
                           (set-cdr! (cdr first-node)
                                     (cons (make-node (car rest-vals) '() '()) '()))
                           (cons (cdr (cdr first-node)) rest-nodes))
                         rest-nodes))
                   (let ((tail after-first)
                         (rvals (cdr rest-vals)))
                     (if (or (null? tail) (null? rvals))
                         '()
                         (let ((second-val (car rvals))
                               (second-node (car tail)))
                           (if (and (not (equal? second-val 'null))
                                    (not (null? second-node)))
                               (begin
                                 (set-car! (cdr second-node) (make-node second-val '() '()))
                                 (build-from-level (cdr tail) (cdr rvals)))
                               (build-from-level (cdr tail) (cdr rvals))))))))))
        (if (null? (cdr lst))
            root
            (begin
              (build-from-level (list root) (cdr lst))
              root)))))

(define stack '())
(define current-tree '())

(define (push-lefts node stk)
  (if (null? node)
      stk
      (push-lefts (node-left node) (cons node stk))))

(define (iter-reset root)
  (set! stack (push-lefts root '())))

(define (iter-has-next) (not (null? stack)))

(define (iter-next)
  (let ((node (car stack)))
    (set! stack (cdr stack))
    (set! stack (push-lefts (node-right node) stack))
    (node-val node)))

(define (parse-op line)
  (if (and (>= (string-length line) 8)
           (string=? (substring line 0 8) "CASE0=OP"))
      (let ((colon (substring line 10 (- (string-length line) 0))))
        (substring colon 0 (string-length colon)))
      ""))

(define (parse-tree-str s)
  (define n (string-length s))
  (let loop ((i 0) (acc '()))
    (cond ((>= i n) (reverse acc))
          ((char=? (string-ref s i) #\[) (loop (+ i 1) acc))
          ((char=? (string-ref s i) #\]) (reverse acc))
          ((char=? (string-ref s i) #\,) (loop (+ i 1) acc))
          ((char=? (string-ref s i) #\space) (loop (+ i 1) acc))
          (else
           (let ((j i))
             (let scan ((k i))
               (if (and (< k n) (not (char=? (string-ref s k) #\,))
                        (not (char=? (string-ref s k) #\]))
                        (not (char=? (string-ref s k) #\space)))
                   (scan (+ k 1))
                   k))
             (let ((tok (substring s i j)))
               (loop j
                     (cons (if (string=? tok "null")
                               'null
                               (string->number tok))
                           acc))))))))

(define (parse-tree-line line)
  (let ((idx (substring line 10 (- (string-length line) 0))))
    (parse-tree-str idx)))

(define (reset-with-tree tree)
  (set! current-tree tree)
  (iter-reset tree))

(define (display-result r)
  (cond ((eq? r #t) (display "true"))
        ((eq? r #f) (display "false"))
        ((number? r) (display (number->string r)))
        (else (display r))))

(define (solve input-lines)
  (define n (length input-lines))
  (let loop ((i 0) (initialized? #f))
    (cond ((>= i n) 'done)
          ((and (not initialized?) (= i 0))
           (let ((line (car input-lines)))
             (when (and (>= (string-length line) 10)
                        (string=? (substring line 0 10) "CASE0=TREE"))
               (let ((tree (build-tree (parse-tree-line line))))
                 (reset-with-tree tree))))
           (loop (+ i 1) #t))
          (else
           (let ((line (list-ref input-lines i)))
             (cond ((and (>= (string-length line) 10)
                         (string=? (substring line 0 10) "CASE0=TREE"))
                    (let ((tree (build-tree (parse-tree-line line))))
                      (reset-with-tree tree)))
                   (else
                    (let ((op (parse-op line)))
                      (cond ((string=? op "next")
                             (let ((v (iter-next)))
                               (display "CASE") (display "0")
                               (display "=") (display-result v)
                               (newline)))
                            ((string=? op "has_next")
                             (display "CASE") (display "0")
                             (display "=") (display-result (iter-has-next))
                             (newline))
                            ((string=? op "reset")
                             (iter-reset current-tree))
                            (else '())))))
             (loop (+ i 1) #t))))))

(solve '("CASE0=TREE:[7,3,15,null,null,9,20]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(solve '("CASE0=TREE:[]" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:end"))
(solve '("CASE0=TREE:[5]" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(solve '("CASE0=TREE:[5,4,null,3,null,2,null,1]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(solve '("CASE0=TREE:[1,null,2,null,3,null,4,null,5]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
(solve '("CASE0=TREE:[10,5,15,3,7,12,20]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:reset" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:end"))
(solve '("CASE0=TREE:[4,2,6,1,3,5,7]" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:next" "CASE0=OP:has_next" "CASE0=OP:end"))
