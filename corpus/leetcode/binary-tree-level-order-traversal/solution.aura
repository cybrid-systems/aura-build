(define (token->val tok)
  (if (equal? tok "#") 'null (string->number tok)))

(define (build-tree tokens)
  (if (null? tokens)
      'null
      (let ((root (token->val (car tokens))))
        (if (null? root)
            'null
            (let ((rest (cdr tokens)))
              (let loop ((queue (list root)) (tokens rest) (idx 0))
                (if (null? queue)
                    (begin
                      (if (null? tokens)
                          #t
                          (loop (list 'null) (cdr tokens) (+ idx 1))))
                    (let* ((node (car queue))
                           (qrest (cdr queue))
                           (left-tok (if (null? tokens) "#" (car tokens)))
                           (left-rest (if (null? tokens) tokens (cdr tokens)))
                           (right-tok (if (null? left-rest) "#" (car left-rest)))
                           (right-rest (if (null? left-rest) left-rest (cdr left-rest))))
                      (let ((left-val (token->val left-tok))
                            (right-val (token->val right-tok)))
                        (set-car! (car queue) 'ignored)
                        (loop (append qrest (list left-val right-val)) right-rest (+ idx 2)))))))))))

(define (bfs-levels tokens)
  (let ((root (token->val (car tokens))))
    (if (equal? root 'null)
        (list (list))
        (let loop ((queue (list root)) (result '()))
          (if (null? queue)
              (reverse result)
              (let ((level-size (length queue)))
                (let collect ((i 0) (q queue) (level '()))
                  (if (= i level-size)
                      (loop q (cons (reverse level) result))
                      (let* ((node (car q))
                             (qrest (cdr q))
                             (new-level (if (equal? node 'null) level (cons node level))))
                        (let ((kids '()))
                          (if (equal? node 'null)
                              (collect (+ i 1) qrest new-level)
                              (collect (+ i 1) (append qrest (list (cons 'L node) (cons 'R node))) new-level))))))))))))

(define (solve tokens)
  (let ((levels (bfs-levels tokens)))
    (let ((clean
            (map (lambda (lvl)
                   (let ((x (car lvl)))
                     (if (and (pair? x) (equal? (car x) 'L)) (cdr x) x)))
                 levels)))
      (map (lambda (lvl)
             (filter (lambda (x) (not (equal? x 'null))) lvl))
           clean))))

(define (display-list lst)
  (cond ((null? lst) (display ""))
        ((null? (cdr lst)) (display (car lst)))
        (else (display (car lst)) (display " ") (display-list (cdr lst)))))

(define (display-result result)
  (cond ((null? result)
         (newline))
        ((null? (car result))
         (display "")
         (newline)
         (display-result (cdr result)))
        (else
         (display-list (car result))
         (newline)
         (display-result (cdr result)))))

(let ((cases (list
   (list "3" "9" "20" "#" "#" "15" "7")
   (list "#")
   (list "1")
   (list "1" "2" "3" "4" "5" "#" "6")
   (list "1" "2" "#" "3" "#" "4" "#" "5")
   (list "5" "4" "7" "3" "#" "2" "#" "#" "#" "#" "1")
   (list "1" "#" "2" "#" "3" "#" "4")
   (list "1" "2" "3" "#" "#" "4" "5" "#" "6" "#" "7"))))
  (let loop ((i 0) (cs cases))
    (if (null? cs)
        'done
        (begin
          (display "CASE")
          (display i)
          (display "=")
          (let ((r (solve (car cs))))
            (display-result r))
          (loop (+ i 1) (cdr cs))))))
