(require "lc_json" all:)
(require "compat" all:)
(define (xor-list lst)
  (let loop ((rest lst) (acc 0))
    (if (null? rest)
        acc
        (loop (cdr rest) (bitwise-xor acc (car rest))))))
(define (length lst)
  (let loop ((rest lst) (n 0))
    (if (null? rest)
        n
        (loop (cdr rest) (+ n 1)))))
(define (odd? n)
  (= (modulo n 2) 1))
(define (solve arr1 arr2 arr3)
  (let* ((n (length arr1))
         (m (length arr2))
         (k (length arr3))
         (x1 (xor-list arr1))
         (x2 (xor-list arr2))
         (x3 (xor-list arr3))
         (result 0))
    (begin
      (if (and (odd? n) (odd? m))
          (set! result (bitwise-xor result x3)))
      (if (and (odd? n) (odd? k))
          (set! result (bitwise-xor result x2)))
      (if (and (odd? m) (odd? k))
          (set! result (bitwise-xor result x1)))
      result)))
(define (run-case arr1 arr2 arr3)
  (let ((r (solve arr1 arr2 arr3)))
    (begin
      (display "CASE0=") (display r) (newline))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "arr1") (hash-ref input "arr2") (hash-ref input "arr3")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/bitwise-xor-of-all-pairings/tests.json")))
