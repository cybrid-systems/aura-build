(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (list-set! lst i v)
  (set-car! (list-tail-ptr lst i) v))

(define (list-tail-ptr lst i)
  (if (= i 0) lst (list-tail-ptr (cdr lst) (- i 1))))

(define (alist-get lst key)
  (cond ((null? lst) #f)
        ((equal? (car (car lst)) key) (cdr (car lst)))
        (else (alist-get (cdr lst) key))))

(define (alist-set lst key val)
  (cons (cons key val) lst))

(define (alist-del lst key)
  (cond ((null? lst) '())
        ((equal? (car (car lst)) key) (cdr lst))
        (else (cons (car lst) (alist-del (cdr lst) key)))))

(define new-set (lambda () (cons '() '())))

(define (rs-insert! s v)
  (let ((state (car s))
        (lst (cdr s)))
    (if (alist-get state v)
        #f
        (begin
          (set-car! s (alist-set state v (length lst)))
          (set-cdr! s (append lst (list v)))
          #t))))

(define (rs-remove! s v)
  (let ((state (car s))
        (lst (cdr s)))
    (let ((idx (alist-get state v)))
      (if (not idx)
          #f
          (let ((last-idx (- (length lst) 1))
                (last-val (car (list-tail-ptr lst last-idx))))
            (begin
              (set-car! (list-tail-ptr lst idx) last-val)
              (set-car! s (alist-set (alist-del state v) last-val idx))
              (set-cdr! s (list-take lst last-idx))
              #t))))))

(define (list-take lst n)
  (if (= n 0) '() (cons (car lst) (list-take (cdr lst) (- n 1)))))

(define (rs-getRandom s)
  (let ((lst (cdr s)))
    (let ((n (length lst)))
      (list-ref lst (random n)))))

(define (bool->str b) (if b "true" "false"))

(define (run-ops ops args)
  (let ((s (new-set))
        (results '()))
    (define (loop ops args)
      (if (null? ops)
          (reverse results)
          (let ((op (car ops))
                (arg (car args)))
            (let ((r (cond ((equal? op "insert") (rs-insert! s (car arg)))
                           ((equal? op "remove") (rs-remove! s (car arg)))
                           ((equal? op "getRandom") (rs-getRandom s))
                           (else #f))))
              (loop (cdr ops) (cdr args))
              (set! results (cons r results))))))
    (loop ops args)))

(define (display-list lst)
  (cond ((null? lst) (display "nil"))
        ((pair? lst)
         (begin
           (display (car lst))
           (display " ")
           (display-list (close lst))))))

(define (solve)
  (display "CASE0=")
  (let ((r0 (run-ops '("insert" "remove" "insert" "getRandom" "remove")
                     '((1) (2) (2) () (1)))))
    (display (bool->str (list-ref r0 0)))
    (display " ")
    (display (bool->str (list-ref r0 1)))
    (display " ")
    (display (bool->str (list-ref r0 2)))
    (display " ")
    (display (list-ref r0 3))
    (display " ")
    (display (bool->str (list-ref r0 4)))
    (newline))
  (display "CASE1=")
  (let ((r1 (run-ops '("insert" "insert" "getRandom" "remove" "getRandom")
                     '((0) (1) () (0) ()))))
    (display (bool->str (list-ref r1 0)))
    (display " ")
    (display (bool->str (list-ref r1 1)))
    (display " ")
    (display (list-ref r1 2))
    (display " ")
    (display (bool->str (list-ref r1 3)))
    (display " ")
    (display (list-ref r1 4))
    (newline))
  (display "CASE2=")
  (let ((r2 (run-ops '("insert" "insert" "insert" "remove" "remove" "remove")
                     '((1) (2) (3) (2) (1) (3)))))
    (display (bool->str (list-ref r2 0)))
    (display " ")
    (display (bool->str (list-ref r2 1)))
    (display " ")
    (display (bool->str (list-ref r2 2)))
    (display " ")
    (display (bool->str (list-ref r2 3)))
    (display " ")
    (display (bool->str (list-ref r2 4)))
    (display " ")
    (display (bool->str (list-ref r2 5)))
    (newline))
  (display "CASE3=")
  (let ((r3 (run-ops '("insert" "remove" "remove")
                     '((5) (5) (5)))))
    (display (bool->str (list-ref r3 0)))
    (display " ")
    (display (bool->str (list-ref r3 1)))
    (display " ")
    (display (bool->str (list-ref r3 2)))
    (newline))
  (display "CASE4=")
  (let ((r4 (run-ops '("insert" "insert" "insert" "getRandom")
                     '((10) (20) (30) ()))))
    (display (bool->str (list-ref r4 0)))
    (display " ")
    (display (bool->str (list-ref r4 1)))
    (display " ")
    (display (bool->str (list-ref r4 2)))
    (display " ")
    (display (list-ref r4 3))
    (newline)))

(solve)
