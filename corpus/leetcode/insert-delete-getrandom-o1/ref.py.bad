import random
import json

class RandomizedSet:
    def __init__(self):
        self.idx = {}
        self.arr = []

    def insert(self, val: int) -> bool:
        if val in self.idx:
            return False
        self.idx[val] = len(self.arr)
        self.arr.append(val)
        return True

    def remove(self, val: int) -> bool:
        if val not in self.idx:
            return False
        i = self.idx[val]
        last = self.arr[-1]
        if i != len(self.arr) - 1:
            self.arr[i] = last
            self.idx[last] = i
        self.arr.pop()
        del self.idx[val]
        return True

    def getRandom(self) -> int:
        return random.choice(self.arr)


def solve(operations, args):
    rs = RandomizedSet()
    results = []
    for op, a in zip(operations, args):
        if op == "insert":
            results.append(rs.insert(int(a[0])))
        elif op == "remove":
            results.append(rs.remove(int(a[0])))
        elif op == "getRandom":
            results.append(rs.getRandom())
    return results


CASES = [
    {
        "operations": ["insert", "remove", "insert", "getRandom", "remove", "insert", "getRandom"],
        "args": [[1], [2], [2], [], [1], [2], []],
    },
    {
        "operations": ["insert", "insert", "remove", "getRandom", "remove", "getRandom"],
        "args": [[0], [1], [0], [], [0], []],
    },
    {
        "operations": ["insert", "insert", "insert", "remove", "remove", "getRandom"],
        "args": [[1], [2], [3], [2], [3], []],
    },
    {
        "operations": ["insert", "remove", "insert", "insert", "getRandom", "remove", "remove", "insert", "getRandom"],
        "args": [[5], [5], [5], [10], [], [10], [5], [7], []],
    },
    {
        "operations": ["insert", "getRandom", "remove", "getRandom"],
        "args": [[42], [], [42], []],
    },
    {
        "operations": ["insert", "insert", "insert", "insert", "getRandom", "getRandom", "getRandom", "getRandom", "remove", "remove", "remove", "remove", "getRandom"],
        "args": [[10], [20], [30], [40], [], [], [], [], [10], [20], [30], [40], []],
    },
    {
        "operations": ["insert", "remove", "remove", "insert", "remove", "insert", "remove"],
        "args": [[1], [1], [2], [2], [2], [3], [3]],
    },
    {
        "operations": ["insert", "insert", "insert", "getRandom", "getRandom", "getRandom"],
        "args": [[-1], [-2], [-3], [], [], []],
    },
]


if __name__ == "__main__":
    out = []
    for i, c in enumerate(CASES):
        res = solve(c["operations"], c["args"])
        out.append({
            "id": i,
            "input": {"operations": c["operations"], "args": c["args"]},
            "expected": json.dumps(res, separators=(",", ":"), ensure_ascii=False),
        })
    print(json.dumps(out, separators=(",", ":"), ensure_ascii=False))
