import random
import json
from typing import List

class RandomizedSet:
    def __init__(self):
        self.idx = {}
        self.arr = []

    def insert(self, val: int) -> bool:
        if val in self.idx:
            return False
        self.idx[val] = len(self.arr)
        self.arr.append(val)
        return True

    def remove(self, val: int) -> bool:
        if val not in self.idx:
            return False
        i = self.idx.pop(val)
        last = self.arr[-1]
        if i != len(self.arr) - 1:
            self.arr[i] = last
            self.idx[last] = i
        self.arr.pop()
        return True

    def getRandom(self) -> int:
        return random.choice(self.arr)


def solve(operations: List[str], args: List[List[int]]) -> list:
    rs = RandomizedSet()
    results = []
    for op, a in zip(operations, args):
        if op == 'insert':
            results.append(bool(rs.insert(a[0])))
        elif op == 'remove':
            results.append(bool(rs.remove(a[0])))
        elif op == 'getRandom':
            results.append(int(rs.getRandom()))
    return results


CASES = [
    {
        "operations": ["insert", "remove", "insert", "getRandom", "remove", "insert", "getRandom"],
        "args": [[1], [2], [2], [], [1], [2], []],
    },
    {
        "operations": ["insert", "insert", "remove", "remove", "insert", "getRandom", "remove", "getRandom"],
        "args": [[0], [1], [0], [0], [0], [], [0], []],
    },
    {
        "operations": ["getRandom"],
        "args": [[]],
    },
    {
        "operations": ["insert", "insert", "insert", "insert", "remove", "remove", "remove", "remove", "getRandom"],
        "args": [[1], [2], [3], [4], [4], [3], [2], [1], []],
    },
    {
        "operations": ["insert", "remove", "remove", "insert", "getRandom"],
        "args": [[5], [5], [5], [5], []],
    },
    {
        "operations": ["insert", "insert", "insert", "getRandom", "getRandom", "getRandom"],
        "args": [[10], [20], [30], [], [], []],
    },
]


if __name__ == '__main__':
    out = []
    for i, c in enumerate(CASES):
        r = solve(c["operations"], c["args"])
        encoded_input = {
            "operations": c["operations"],
            "args": c["args"],
        }
        out.append({
            "id": i,
            "input": encoded_input,
            "expected": json.dumps(r, separators=(',', ':'), ensure_ascii=False),
        })
    print(json.dumps(out, separators=(',', ':'), ensure_ascii=False))
