(require "lc_json" all:)
(require "compat" all:)
(define (caar p) (car (car p)))
(define (cdar p) (cdr (car p)))
(define (insert-sorted x lst)
  (cond ((null? lst) (list x))
        ((< x (car lst)) (cons x lst))
        (else (cons (car lst) (insert-sorted x (cdr lst))))))
(define (remove-first x lst)
  (cond ((null? lst) lst)
        ((= x (car lst)) (cdr lst))
        (else (cons (car lst) (remove-first x (cdr lst))))))
(define (advantage-shuffle A B)
  (let* ((n (length B))
         (sorted-a (sort-list A <))
         (indexed-b
          (let loop ((i 0) (bs B) (acc '()))
            (if (null? bs) acc
                (loop (+ i 1) (cdr bs) (append acc (list (cons i (car bs)))))))))
    (let ((sorted-b (sort-list indexed-b
                                (lambda (x y) (< (cdr x) (cdr y))))))
      (let loop ((avail sorted-a) (bs sorted-b) (result (make-list n 0)))
        (if (null? bs)
            result
            (let* ((bi (car bs))
                   (bval (cdr bi))
                   (idx (car bi))
                   (best (find-beat avail bval)))
              (if best
                  (let ((new-avail (remove-first best avail)))
                    (loop new-avail (cdr bs)
                          (list-set result idx best)))
                  (let ((waste (car avail)))
                    (loop (cdr avail) (cdr bs)
                          (list-set result idx waste))))))))))
(define (find-beat avail target)
  (cond ((null? avail) #f)
        ((> (car avail) target) (car avail))
        (else (find-beat (cdr avail) target))))
(define (list-set lst i v)
  (cond ((null? lst) lst)
        ((= i 0) (cons v (cdr lst)))
        (else (cons (car lst) (list-set (cdr lst) (- i 1) v)))))
(define (sort-list lst cmp)
  (let loop ((unproc lst) (acc '()))
    (if (null? unproc) acc
        (let ((x (car unproc)))
          (loop (cdr unproc) (insert-sorted-cmp acc x cmp))))))
(define (insert-sorted-cmp lst x cmp)
  (cond ((null? lst) (list x))
        ((cmp x (car lst)) (cons x lst))
        (else (cons (car lst) (insert-sorted-cmp (cdr lst) x cmp)))))
(define (solve A B)
  (advantage-shuffle A B))
(define (list->display lst)
  (display "[")
  (let loop ((l lst) (first #t))
    (cond ((null? l) (display "]"))
          (else
           (if first (display "") (display ", "))
           (display (car l))
           (loop (cdr l) #f)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "A") (hash-ref input "B")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/advantage-shuffle/tests.json")))
