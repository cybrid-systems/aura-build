(define (solve nums k)
  (let loop ((left 0) (right 0) (sum 0) (best 0) (len (length nums)))
    (cond
      ((>= right len) best)
      (else
       (let ((new-sum (+ sum (list-ref nums right))))
         (let shrink ((l left) (s new-sum))
           (cond
             ((and (< s k) (= l right))
              (loop (+ l 1) (+ right 1) s (max best (- (+ right 1) l)) len))
             ((and (> s k) (< l right))
              (shrink l (- s (list-ref nums l))))
             ((= s k)
              (loop (+ l 1) (+ right 1) 0 (max best (- (+ right 1) l)) len))
             (else
              (loop (+ left 1) (+ right 1) new-sum (max best (- (+ right 1) left)) len)))))))))

(define (max a b) (if (> a b) a b))

(display "CASE0=") (display (solve '(1 2 3 4 5) 8)) (newline)
(display "CASE1=") (display (solve '(1 2 3 4 5) 15)) (newline)
(display "CASE2=") (display (solve '(5 5 5 5 5) 10)) (newline)
(display "CASE3=") (display (solve '(1 1 1 1 1) 3)) (newline)
(display "CASE4=") (display (solve '() 5)) (newline)
(display "CASE5=") (display (solve '(0 0 0 0) -1)) (newline)
(display "CASE6=") (display (solve '(3) 3)) (newline)
(display "CASE7=") (display (solve '(4) 3)) (newline)
(display "CASE8=") (display (solve '(2 2 2 2 2) 0)) (newline)
