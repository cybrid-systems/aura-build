(define (rearrange-string s k)
  (let* ((n (string-length s))
         (counts (make-vector 26 0))
         (result '())
         (cooldown '())
         (pq '()))
    (begin
      (do-counts s 0 counts)
      (build-pq pq counts)
      (let loop ()
        (if (null? pq)
            (list->string (reverse result))
            (let* ((top (car pq))
                   (rest-pq (cdr pq))
                   (ch (car top))
                   (cnt (cdr top))
                   (next-pq (insert-pq rest-pq ch (- cnt 1))))
              (begin
                (set! result (cons ch result))
                (set! cooldown (cons (cons ch (- n 1)) cooldown))
                (if (> cnt 1)
                    (set! pq (cons (cons ch (- cnt 1)) next-pq))
                    (set! pq next-pq))
                (set! cooldown (decrement-cooldown cooldown))
                (set! pq (release-from-cooldown cooldown pq))
                (loop))))))))

(define (do-counts s i counts)
  (if (< i (string-length s))
      (begin
        (vector-set! counts (- (char->integer (string-ref s i)) 97)
                     (+ (vector-ref counts (- (char->integer (string-ref s i)) 97)) 1))
        (do-counts s (+ i 1) counts))
      '()))

(define (build-pq pq counts)
  (let loop ((i 0))
    (if (< i 26)
        (begin
          (if (> (vector-ref counts i) 0)
              (set! pq (insert-pq pq (+ i 97) (vector-ref counts i)))
              '())
          (loop (+ i 1)))
        pq)))

(define (insert-pq pq ch cnt)
  (if (<= cnt 0)
      pq
      (let loop ((l pq))
        (cond
          ((null? l) (cons (cons ch cnt) l))
          ((< (cdr (car l)) cnt) (cons (cons ch cnt) l))
          (else (cons (car l) (loop (cdr l))))))))

(define (decrement-cooldown cooldown)
  (map (lambda (p) (cons (car p) (- (cdr p) 1))) cooldown))

(define (release-from-cooldown cooldown pq)
  (foldl (lambda (p acc)
           (if (<= (cdr p) 0)
               (insert-pq acc (car p) 1)
               acc))
         pq
         cooldown))

(define (solve s k)
  (let ((n (string-length s)))
    (begin
      (do-checks s n k)
      (rearrange-string s k))))

(define (do-checks s n k)
  (let ((counts (make-vector 26 0)))
    (begin
      (do-counts s 0 counts)
      (let loop ((i 0))
        (if (< i 26)
            (begin
              (if (> (vector-ref counts i) (/ (+ n (- k 1)) k))
                  (display "")
                  '())
              (loop (+ i 1)))
            '())))))

(let ((s0 "aabbcc") (k0 3))
  (display "CASE0=") (display (solve s0 k0)) (newline))
(let ((s1 "aaabc") (k1 3))
  (display "CASE1=") (display (solve s1 k1)) (newline))
(let ((s2 "aabbccdde") (k2 3))
  (display "CASE2=") (display (solve s2 k2)) (newline))
(let ((s3 "a") (k3 1))
  (display "CASE3=") (display (solve s3 k3)) (newline))
(let ((s4 "aa") (k4 2))
  (display "CASE4=") (display (solve s4 k4)) (newline))
(let ((s5 "aabb") (k5 2))
  (display "CASE5=") (display (solve s5 k5)) (newline))
(let ((s6 "aaaa") (k6 2))
  (display "CASE6=") (display (solve s6 k6)) (newline))
(let ((s7 "abcdefghij") (k7 3))
  (display "CASE7=") (display (solve s7 k7)) (newline))
