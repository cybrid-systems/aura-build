(define (make-adj n edges)
  (let loop ((i 0) (adj '()) (es edges))
    (if (= i n)
        adj
        (loop (+ i 1) (cons '() adj) es))))

(define (add-edge! adj u v)
  (let ((cell (list-ref adj u)))
    (set-car! cell (cons v (car cell)))))

(define (len xs)
  (let loop ((xs xs) (n 0))
    (if (null? xs) n (loop (cdr xs) (+ n 1)))))

(define (ref xs i)
  (if (= i 0) (car xs) (ref (cdr xs) i)))

(define (valid-tree? n edges)
  (cond
    ((= n 0) #t)
    ((not (= (len edges) (- n 1))) #f)
    (else
      (let* ((adj (make-adj n edges))
             (adj (let loop ((es edges))
                    (if (null? es)
                        adj
                        (let* ((e (car es)) (u (car e)) (v (car (cdr e))))
                          (begin
                            (add-edge! adj u v)
                            (add-edge! adj v u)
                            (loop (cdr es))))))))
        (let* ((visited (make-vector n #f))
               (stack (list (cons 0 -1))))
          (let loop ()
            (if (null? stack)
                (let check-all ((i 0))
                  (if (= i n) #t
                      (if (vector-ref visited i) (check-all (+ i 1)) #f)))
                (let* ((top (car stack))
                       (node (car top))
                       (parent (cdr top)))
                  (set! stack (cdr stack))
                  (if (vector-ref visited node)
                      #f
                      (begin
                        (vector-set! visited node #t)
                        (let neigh-loop ((ns (ref adj node)))
                          (if (null? ns) #t
                              (let ((nb (car ns)))
                                (if (or (vector-ref visited nb) (= nb parent))
                                    (neigh-loop (cdr ns))
                                    (begin
                                      (set! stack (cons (cons nb node) stack))
                                      (neigh-loop (cdr ns)))))))
                        (loop))))))))))

(define (solve n edges)
  (if (valid-tree? n edges) #t #f))

;; Run test cases
(display "CASE0=") (display (solve 5 '((0 1) (0 2) (0 3) (1 4)))) (newline)
(display "CASE1=") (display (solve 5 '((0 1) (1 2) (2 3) (1 3) (1 4)))) (newline)
(display "CASE2=") (display (solve 0 '())) (newline)
(display "CASE3=") (display (solve 1 '())) (newline)
(display "CASE4=") (display (solve 2 '((0 1)))) (newline)
(display "CASE5=") (display (solve 2 '())) (newline)
(display "CASE6=") (display (solve 4 '((0 1) (2 3)))) (newline)
(display "CASE7=") (display (solve 4 '((0 1) (1 2) (2 0)))) (newline)
