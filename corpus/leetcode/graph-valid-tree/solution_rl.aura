(require "lc_json" all:)
(require "compat" all:)
(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))
(define (make-adj n edges)
  (let ((adj (make-vector n '())))
    (let loop ((es edges))
      (if (null? es) adj
        (let* ((e (car es))
               (u (car e))
               (v (car (cdr e))))
          (vector-set! adj u (cons v (vector-ref adj u)))
          (vector-set! adj v (cons u (vector-ref adj v)))
          (loop (cdr es)))))))
(define (dfs adj n visited)
  (let loop ((stack (list (cons 0 -1))))
    (if (null? stack) visited
      (let* ((p (car stack))
             (node (car p))
             (parent (cdr p)))
        (if (vector-ref visited node)
            visited
          (vector-set! visited node #t)
          (let loop2 ((nbrs (vector-ref adj node)) (rest (cdr stack)))
            (if (null? nbrs) (loop rest)
              (let ((nb (car nbrs)))
                (loop2 (cdr nbrs)
                  (if (= nb parent) rest (cons (cons nb node) rest)))))))))))
(define (valid-tree n edges)
  (if (< n 2)
      #t
      (let ((ec (length edges)))
        (if (not (= ec (- n 1)))
            #f
            (let ((adj (make-adj n edges))
                  (visited (make-vector n #f)))
              (dfs adj n visited)
              (let loop ((i 0))
                (if (= i n) #t
                  (if (not (vector-ref visited i)) #f (loop (+ i 1))))))))))
(define (solve n edges)
  (valid-tree n edges))
(define (bool->str b) (if b "True" "False"))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n") (hash-ref input "edges")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/graph-valid-tree/tests.json")))
