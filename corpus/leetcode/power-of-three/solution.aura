(define (solve n)
  (if (<= n 0)
      #f
      (let loop ((x n))
        (cond
          ((= x 1) #t)
          ((= (modulo x 3) 0) (loop (quotient x 3)))
          (else #f)))))

(define (display-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n))
  (newline))

(define (run-cases)
  (let ((cases (list 27 0 45 1 3 9 -3 1162261467 1162261466 3486784401)))
    (let loop ((xs cases) (i 0))
      (if (null? xs)
          '()
          (begin
            (display-case i (car xs))
            (loop (cdr xs) (+ i 1)))))))

(run-cases)
