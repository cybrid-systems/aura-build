(require "lc_json" all:)
(require "compat" all:)
(define (solve n)
  (if (<= n 0)
      #f
      (let loop ((x n))
        (cond
          ((= x 1) #t)
          ((= (modulo x 3) 0) (loop (quotient x 3)))
          (else #f)))))
(define (display-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n))
  (newline))
(define (run-cases)
  (let ((cases (list 27 0 45 1 3 9 -3 1162261467 1162261466 3486784401)))
    (let loop ((xs cases) (i 0))
      (if (null? xs)
          '()
          (begin
            (display-case i (car xs))
            (loop (cdr xs) (+ i 1)))))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/power-of-three/tests.json")))
