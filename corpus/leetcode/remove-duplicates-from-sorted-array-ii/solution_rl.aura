(require "lc_json" all:)
(require "compat" all:)
(define (len xs)
  (if (null? xs) 0 (+ 1 (len (cdr xs)))))
(define (ref xs i)
  (if (= i 0) (car xs) (ref (cdr xs) (- i 1))))
(define (set-ref! xs i v)
  (if (= i 0)
      (set-car! xs v)
      (set-ref! (cdr xs) (- i 1) v)))
(define (solve nums)
  (let ((n (len nums)))
    (if (<= n 2)
        n
        (let loop ((slow 2))
          (if (>= slow n)
              slow
              (let ((v (ref nums slow)))
                (if (equal? v (ref nums (- slow 2)))
                    (loop (+ slow 1))
                    (begin
                      (set-ref! nums slow v)
                      (loop (+ slow 1))))))))))
(define (display-list xs)
  (display "[")
  (let loop ((first? #t) (xs xs))
    (cond ((null? xs) (display "]"))
          (else
           (if first? (set! first? #f) (begin (display ", ") #f))
           (display (car xs))
           (loop #f (cdr xs))))))
(define (run-case i nums)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/remove-duplicates-from-sorted-array-ii/tests.json")))
