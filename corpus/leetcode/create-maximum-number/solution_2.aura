(define (len xs)
  (if (null? xs) 0 (+ 1 (len (cdr xs)))))

(define (nth xs i)
  (if (= i 0) (car xs) (nth (cdr xs) (- i 1))))

(define (slice xs start end)
  (let ((res '()))
    (define (loop i acc)
      (if (>= i end) (reverse acc)
        (loop (+ i 1) (cons (nth xs i) acc))))
    (loop start '())))

(define (take xs n)
  (if (= n 0) '()
    (cons (car xs) (take (cdr xs) (- n 1)))))

(define (drop xs n)
  (if (= n 0) xs (drop (cdr xs) (- n 1))))

(define (last-pair xs)
  (if (null? (cdr xs)) xs (last-pair (cdr xs))))

(define (but-last xs)
  (if (null? (cdr xs)) '() (cons (car xs) (but-last (cdr xs)))))

(define (append2 a b)
  (if (null? a) b (cons (car a) (append2 (cdr a) b))))

(define (max a b) (if (> a b) a b))

(define (min2 a b) (if (< a b) a b))

(define (max-subseq nums t)
  (let ((n (len nums)) (drop-count (- n t)) (stack '()))
    (define (loop i)
      (cond ((>= i n) stack)
            (else
              (let ((x (nth nums i)))
                (define (pop-loop st dc)
                  (cond ((null? st) st)
                        ((and (> dc 0) (> (car st) x))
                           (pop-loop (cdr st) (- dc 1)))
                        (else st)))
                (let ((new-stack (append2 (pop-loop stack drop-count) (list x))))
                  (loop (+ i 1)))))))
    (loop 0)
    (take (loop 0) t)))

(define (greater-remaining? a b p1 p2)
  (cond ((>= p1 (len a)) #f)
        ((>= p2 (len b)) #t)
        ((> (nth a p1) (nth b p2)) #t)
        ((< (nth a p1) (nth b p2)) #f)
        (else (greater-remaining? a b (+ p1 1) (+ p2 1)))))

(define (merge-max a b)
  (let ((res '()) (p1 0) (p2 0))
    (define (loop p1 p2 acc)
      (cond ((and (>= p1 (len a)) (>= p2 (len b))) (reverse acc))
            ((>= p1 (len a)) (loop p1 (+ p2 1) (cons (nth b p2) acc)))
            ((>= p2 (len b)) (loop (+ p1 1) p2 (cons (nth a p1) acc)))
            ((greater-remaining? a b p1 p2)
               (loop p1 (+ p2 1) (cons (nth b p2) acc)))
            (else (loop (+ p1 1) p2 (cons (nth a p1) acc)))))
    (loop 0 0 '())))

(define (greater-list? a b)
  (cond ((and (null? a) (null? b)) #f)
        ((null? a) #f)
        ((null? b) #t)
        ((> (car a) (car b)) #t)
        ((< (car a) (car b)) #f)
        (else (greater-list? (cdr a) (cdr b)))))

(define (solve nums1 nums2 k)
  (let ((n1 (len nums1)) (n2 (len nums2)) (best '()))
    (define (try-i i)
      (let ((t1 i) (t2 (- k i))
            (s1 (max-subseq nums1 i))
            (s2 (max-subseq nums2 (- k i))))
        (let ((merged (merge-max s1 s2)))
          (if (or (null? best) (greater-list? merged best))
            (set! best merged)
            best))))
    (define (loop i)
      (if (> i (min2 k n1)) best
        (begin (try-i i) (loop (+ i 1)))))
    (loop (max2 0 (- k n2)))
    best))

(define (max2 a b) (if (> a b) a b))

(define (display-list xs)
  (display "(")
  (define (loop rest)
    (cond ((null? rest) (display ")"))
          (else (display (car rest))
                (if (null? (cdr rest)) (display ")")
                  (begin (display ", ") (loop (cdr rest)))))))
  (loop xs))

(display "CASE0=") (display-list (solve '(3 4 6 5) '(9 1 2 5 8 3) 5)) (newline)
(display "CASE1=") (display-list (solve '(6 7) '(6 0 4) 5)) (newline)
(display "CASE2=") (display-list (solve '(3 9) '(8 9) 3)) (newline)
(display "CASE3=") (display-list (solve '(1 2 3 4 5) '() 3)) (newline)
(display "CASE4=") (display-list (solve '(9 1 2 5 8 3) '(3 4 6 5) 5)) (newline)
(display "CASE5=") (display-list (solve '(5 5 1) '(4 0 1) 3)) (newline)
(display "CASE6=") (display-list (solve '(2 5 6 4 4 0) '(7 3 8 0 6 5 7 6 2) 15)) (newline)
(display "CASE7=") (display-list (solve '(1) '(2) 2)) (newline)
