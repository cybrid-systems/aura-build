(define (solve nums target)
  (let ((n (length nums)))
    (if (= n 0)
        #f
        (let loop ((lo 0) (hi (- n 1)))
          (if (> lo hi)
              #f
              (let* ((mid (+ lo (quotient (- hi lo) 2)))
                     (mn (list-ref nums mid))
                     (ln (list-ref nums lo))
                     (rn (list-ref nums hi)))
                (cond
                  ((= mn target) #t)
                  ((and (= ln mn) (= rn mn))
                   (loop (+ lo 1) (- hi 1)))
                  ((<= ln mn)
                   (if (and (>= target ln) (< target mn))
                       (loop lo (- mid 1))
                       (loop (+ mid 1) hi)))
                  (else
                   (if (and (> target mn) (<= target rn))
                       (loop (+ mid 1) hi)
                       (loop lo (- mid 1)))))))))))

(define (runeq-case i nums target)
  (let ((result (solve nums target)))
    (display "CASE")
    (display (number->string i))
    (display "=")
    (display (if result "true" "false"))
    (newline)))

(runeq-case 0 '(4 5 6 7 0 1 2) 0)
(runeq-case 1 '(4 5 6 7 0 1 2) 3)
(runeq-case 2 '(2 5 6 0 0 1 2) 0)
(runeq-case 3 '(2 5 6 0 0 1 2) 3)
(runeq-case 4 '(1) 0)
(runeq-case 5 '(1) 1)
(runeq-case 6 '() 5)
(runeq-case 7 '(1 1 1 1 1) 1)
(runeq-case 8 '(1 1 1 1 1) 2)
(runeq-case 9 '(3 1) 1)
