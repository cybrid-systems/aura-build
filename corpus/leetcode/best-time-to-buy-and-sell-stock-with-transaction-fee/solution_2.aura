(define (max a b) (if (> a b) a b))

(define (solve prices fee)
  (letrec ((len (length prices))
           (helper (lambda (i cash hold)
                     (if (= i len)
                         cash
                         (let ((p (list-ref prices i)))
                           (if (= hold 1)
                               (max (helper (+ i 1) cash 1)
                                    (helper (+ i 1) (+ cash (- p fee)) 0))
                               (max (helper (+ i 1) cash 0)
                                    (helper (+ i 1) (- cash p) 1))))))))
    (helper 0 0 0)))

(define (run-case label prices fee)
  (display label)
  (display "=")
  (display (solve prices fee))
  (newline))

(run-case "CASE0" (list 1 3 2 8 4 9) 2)
(run-case "CASE1" (list 1 3 7 5 10 3) 3)
(run-case "CASE2" (list 1) 1)
(run-case "CASE3" (list 5 5 5 5) 1)
(run-case "CASE4" (list 9 8 7 6 5 4 3 2 1) 0)
(run-case "CASE5" (list 1 2 3 4 5) 0)
(run-case "CASE6" (list 4 5 2 3 7 1 5) 2)
(run-case "CASE7" (list 0 1 0 1 0 1) 1)
