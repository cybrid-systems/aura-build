;; CASE 7
(define c7-ops
  (list
    (list "MyLinkedList")
    (list "addAtHead" 4)
    (list "addAtHead" 1)
    (list "addAtTail" 5)
    (list "addAtIndex" 1 2)
    (list "addAtIndex" 4 3)
    (list "get" 0)
    (list "get" 1)
    (list "get" 2)
    (list "get" 3)))
(define r7 (solve 10 c7-ops))
(display "CASE7=") (display-list r7) (newline)
