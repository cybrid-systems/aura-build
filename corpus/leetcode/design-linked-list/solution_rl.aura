(require "compat" all:)
;; Singly Linked List Design

(define (make-list) (list 'list '() 0 '()))

(define (list-head L) (cadr L))
(define (list-size L) (caddr L))
(define (list-tail-ref L) (cadddr L))

(define (set-head! L h) (set-car! (cdr L) h))
(define (set-size! L s) (set-car! (cddr L) s))
(define (set-tail! L t) (set-car! (cdddr L) t))

(define (len-chain p)
  (if (null? p) 0 (+ 1 (len-chain (cdr p)))))

(define (last-node p)
  (if (null? (cdr p)) p (last-node (cdr p))))

(define (get-val L index)
  (cond
    ((< index 0) -1)
    ((>= index (list-size L)) -1)
    (else
      (let ((p (list-head L)))
        (let loop ((p p) (i 0))
          (if (= i index)
              (car p)
              (loop (cdr p) (+ i 1))))))))

(define (add-at-head L val)
  (let ((new-node (list val (list-head L))))
    (set-head! L new-node)
    (set-size! L (+ (list-size L) 1))
    (if (= (list-size L) 1)
        (set-tail! L new-node)
        '())))

(define (add-at-tail L val)
  (let ((new-node (list val '())))
    (if (null? (list-head L))
        (begin
          (set-head! L new-node)
          (set-tail! L new-node))
        (let ((t (list-tail-ref L)))
          (set-cdr! t new-node)
          (set-tail! L new-node)))
    (set-size! L (+ (list-size L) 1))))

(define (add-at-index L index val)
  (cond
    ((<= index 0) (add-at-head L val))
    ((= index (list-size L)) (add-at-tail L val))
    ((> index (list-size L)) '())
    (else
      (let loop ((p (list-head L)) (i 0))
        (if (= i (- index 1))
            (let ((new-node (list val (cdr p))))
              (set-cdr! p new-node)
              (set-size! L (+ (list-size L) 1)))
            (loop (cdr p) (+ i 1)))))))

(define (delete-at-index L index)
  (cond
    ((< index 0) '())
    ((>= index (list-size L)) '())
    ((= index 0)
     (let ((h (list-head L)))
       (set-head! L (cdr h))
       (set-size! L (- (list-size L) 1))
       (if (= (list-size L) 0)
           (set-tail! L '())
           '())))
    (else
      (let loop ((p (list-head L)) (i 0))
        (if (= i (- index 1))
            (let ((target (cdr p)))
              (set-cdr! p (cdr target))
              (set-size! L (- (list-size L) 1))
              (if (null? (cdr target))
                  (set-tail! L p)
                  '()))
            (loop (cdr p) (+ i 1)))))))

(define (op-name op) (car op))
(define (op-arg1 op) (if (>= (length op) 2) (cadr op) '()))
(define (op-arg2 op) (if (>= (length op) 3) (caddr op) '()))

(define (process-ops ops)
  (let ((L (make-list)))
    (let loop ((ops ops) (acc '()))
      (if (null? ops)
          (reverse acc)
          (let ((op (car ops)))
            (let ((name (op-name op)))
              (cond
                ((equal? name "get")
                 (loop (cdr ops) (cons (get-val L (op-arg1 op)) acc)))
                ((equal? name "addAtHead")
                 (add-at-head L (op-arg1 op))
                 (loop (cdr ops) acc))
                ((equal? name "addAtTail")
                 (add-at-tail L (op-arg1 op))
                 (loop (cdr ops) acc))
                ((equal? name "addAtIndex")
                 (add-at-index L (op-arg1 op) (op-arg2 op))
                 (loop (cdr ops) acc))
                ((equal? name "deleteAtIndex")
                 (delete-at-index L (op-arg1 op))
                 (loop (cdr ops) acc))
                (else (loop (cdr ops) acc)))))))))

(define (solve n ops)
  (process-ops ops))

(define (display-list lst)
  (display "[")
  (let loop ((l lst) (first? #t))
    (cond
      ((null? l) (display "]"))
      (first?
       (display (number->string (car l)))
       (loop (cdr l) #f))
      (else
       (display ",")
       (display (number->string (car l)))
       (loop (cdr l) #f)))))

;; CASE 0
(define c0-ops
  (list
    (list "MyLinkedList")
    (list "addAtHead" 1)
    (list "addAtTail" 3)
    (list "addAtIndex" 1 2)
    (list "get" 1)
    (list "deleteAtIndex" 1)
    (list "get" 1)))
(define r0 (solve 7 c0-ops))
(display "CASE0=") (display-list r0) (newline)

;; CASE 1
(define c1-ops
  (list
    (list "MyLinkedList")
    (list "addAtHead" 1)
    (list "addAtTail" 2)
    (list "get" 0)))
(define r1 (solve 4 c1-ops))
(display "CASE1=") (display-list r1) (newline)

;; CASE 2
