    (list "addAtHead" 2)
    (list "deleteAtIndex" 1)
    (list "get" 0)
    (list "addAtHead" 3)
    (list "get" 0)))
(define r2 (solve 6 c2-ops))
(display "CASE2=") (display-list r2) (newline)

;; CASE 3
(define c3-ops
