(define (solve nums)
  ;; Phase 1: find intersection
  (let ((slow (car nums))
        (fast (car nums)))
    (let loop ()
      (set! slow (list-ref nums (- slow 1)))
      (set! fast (list-ref nums (- (list-ref nums (- fast 1)) 1)))
      (if (= slow fast)
          (begin
            ;; Phase 2: find cycle entrance
            (set! slow (car nums))
            (let loop2 ()
              (if (= slow fast)
                  slow
                  (begin
                    (set! slow (list-ref nums (- slow 1)))
                    (set! fast (list-ref nums (- fast 1)))
                    (loop2)))))
          (loop)))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (display-num n) (display n))

;; --- Test harness ---
(define test-data
  (list
    (list 1 3 4 2 2)
    (list 3 1 3 4 2 5 6 7)
    (list 1 1)
    (list 1 1 2)
    (list 2 2 2 2 2)
    (list 4 2 1 3 4)
    (list 1 2 3 4 5 6 7 8 9 5)
    (list 3 4 1 2 5 5 6 7)))

(define (run-all lst i)
  (if (null? lst)
      'done
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display-num (solve (car lst)))
        (newline)
        (run-all (cdr lst) (+ i 1)))))

(run-all test-data 0)
