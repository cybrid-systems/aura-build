(define (len lst)
  (if (null? lst) 0 (+ 1 (len (cdr lst)))))

(define (clean-queue q lo)
  (cond ((null? q) '())
     ((< (car q) lo) (clean-queue (cdr q) lo))
     (else q)))

(define (process ops)
  (letrec ((helper (lambda (q ops acc)
         (if (null? ops)
             (reverse acc)
             (let* ((t (car ops))
                (new-q (clean-queue q (- t 3000)))
                (new-q (cons t new-q)))
               (helper new-q (cdr ops) (cons (len new-q) acc)))))))
    (helper '() ops '())))

(define (solve n op-seq)
  (process op-seq))

(define (display-list lst)
  (letrec ((helper (lambda (lst)
             (if (null? lst)
                 (begin (display " ") '())
                 (begin (display " ")
                    (display (car lst))
                    (helper (cdr lst)))))))
    (helper lst)))

(define (run-case i n op-seq)
  (let ((result (solve n op-seq)))
    (display "CASE")
    (display i)
    (display "=")
    (display-list result)
    (newline)))

(run-case 0 4 '(1 100 3001 3002))
(run-case 1 1 '(1))
(run-case 2 3 '(1 2 3))
(run-case 3 5 '(1 100 1000 3001 3100))
(run-case 4 6 '(10 20 3010 3020 6000 6001))
(run-case 5 4 '(3000 3001 3002 5999))
(run-case 6 3 '(1 3001 3002))
(run-case 7 2 '(2999 3000))
