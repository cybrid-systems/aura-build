(define (at-most nums k)
  (let ((n (length nums))
        (count 0)
        (left 0)
        (freq '())
        (distinct 0))
    (define (inc-key key alist)
      (let ((pair (assq key alist)))
        (if pair
            (let ((old (cdr pair)))
              (cons (cons key (+ old 1))
                    (assq-remove key alist)))
            (cons (cons key 1) alist))))
    (define (dec-key key alist)
      (let ((pair (assq key alist)))
        (let ((new-val (- (cdr pair) 1)))
          (if (= new-val 0)
              (assq-remove key alist)
              (cons (cons key new-val)
                    (assq-remove key alist))))))
    (let loop ((right 0))
      (if (= right n)
          count
          (let* ((x (list-ref nums right))
                 (pair (assq x freq))
                 (freq-new (if pair
                               (cons (cons x (+ (cdr pair) 1))
                                     (assq-remove x freq))
                               (cons (cons x 1) freq)))
                 (distinct-new (if pair distinct (+ distinct 1))))
            (let shrink ((left left)
                         (freq-c freq-new)
                         (distinct-c distinct-new))
              (if (and (> distinct-c k) (< left n))
                  (let* ((lx (list-ref nums left))
                         (pair-l (assq lx freq-c))
                         (new-val (- (cdr pair-l) 1))
                         (freq-c2 (if (= new-val 0)
                                      (assq-remove lx freq-c)
                                      (cons (cons lx new-val)
                                            (assq-remove lx freq-c))))
                         (distinct-c2 (- distinct-c 1)))
                    (shrink (+ left 1) freq-c2 distinct-c2))
                  (let* ((count-new (if (> distinct-c k)
                                        count
                                        (+ count (- right left -1)))))
                    (loop (+ right 1)))))))))))

(define (assq-remove key alist)
  (cond ((null? alist) '())
        ((eq? (car (car alist)) key) (cdr alist))
        (else (cons (car alist) (assq-remove key (cdr alist))))))

(define (solve nums k)
  (let ((a (at-most nums k))
        (b (if (= k 0) 0 (at-most nums (- k 1)))))
    (- a b)))

(define (run-case i nums k)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums k))
  (newline))

(run-case 0 '(1 2 1 2 3) 2)
(run-case 1 '(1 2 1 2 3) 1)
(run-case 2 '(1 2 1 2 3) 3)
(run-case 3 '(1 2 1 2 3) 0)
(run-case 4 '(1) 1)
(run-case 5 '(1 1 1 1) 1)
(run-case 6 '(1 2 3 4 5) 2)
(run-case 7 '(1 2 3 4 5) 5)
