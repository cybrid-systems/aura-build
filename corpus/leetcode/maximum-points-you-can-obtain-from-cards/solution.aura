(define (sum lst)
  (let loop ((l lst) (acc 0))
    (if (null? l)
        acc
        (loop (cdr l) (+ acc (car l))))))

(define (min-subarray-of-length xs len)
  (let ((n (length xs)))
    (if (= len n)
        (sum xs)
        (let ((window-size len)
              (total n))
          (let loop ((i 0)
                     (window-sum (let init-loop ((j 0) (s 0))
                                   (if (= j window-size)
                                       s
                                       (init-loop (+ j 1) (+ s (list-ref xs j))))))
                     (best (let init-loop ((j 0) (s 0))
                             (if (= j window-size)
                                 s
                                 (init-loop (+ j 1) (+ s (list-ref xs j)))))))
            (let rec ((i i) (w window-sum) (b best))
              (if (= (+ i window-size) total)
                  b
                  (let ((new-w (- (+ w (list-ref xs (+ i window-size)))
                                  (list-ref xs i)))
                        (new-b (min b (- (+ w (list-ref xs (+ i window-size)))
                                         (list-ref xs i)))))
                    (rec (+ i 1) new-w new-b)))))))))

(define (solve cp k)
  (let ((n (length cp))
        (total (sum cp)))
    (let ((skip (- n k)))
      (- total (min-subarray-of-length cp skip)))))

;; I/O helpers using file ports
(define (read-file path)
  (let ((p (open-input-file path)))
    (let ((r (read p)))
      (close-input-port p)
      r)))

(define (write-file path val)
  (let ((p (open-output-file path)))
    (display val p)
    (newline p)
    (close-output-port p)))

(define (run-case i cp k)
  (let ((ans (solve cp k)))
    (write-file (string-append "CASE" (number->string i) ".out") ans)
    (display (string-append "CASE" (number->string i) "="))
    (display ans)
    (newline)))

(run-case 0 '(1 2 3 4 5 6 1) 3)
(run-case 1 '(2 2 2) 2)
(run-case 2 '(9 7 5 3 1) 5)
(run-case 3 '(1 2 3 4 5) 1)
(run-case 4 '(1 2 3 4 5) 4)
(run-case 5 '(-1 -2 -3 -4 -5) 2)
(run-case 6 '(100 0 -100 0 100) 2)
(run-case 7 '(1) 1)
