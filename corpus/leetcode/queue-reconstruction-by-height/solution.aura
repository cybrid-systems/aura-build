(define (solve people)
  ;; Sort people by h descending, then by k ascending
  (define sorted
    (let loop ((lst people) (acc '()))
      (if (null? lst)
          acc
          (loop (cdr lst)
                (insert-sorted (car lst) acc)))))

  (define (insert-sorted p lst)
    (cond
      ((null? lst) (cons p '()))
      ((or (> (car p) (caar lst))
           (and (= (car p) (caar lst))
                (< (cadr p) (cadr (car lst)))))
       (cons p lst))
      (else (cons (car lst) (insert-sorted p (cdr lst))))))

  (define result '())
  (define (insert-at lst p idx)
    (if (= idx 0)
        (cons p lst)
        (cons (car lst) (insert-at (cdr lst) p (- idx 1)))))

  (let loop ((remaining sorted))
    (if (null? remaining)
        result
        (let ((p (car remaining)))
          (set! result (insert-at result p (cadr p)))
          (loop (cdr remaining))))))

(define (run-case i people)
  (let ((res (solve people)))
    (display "CASE")
    (display i)
    (display "=")
    (display-list res)
    (newline)))

(define (display-list lst)
  (cond
    ((null? lst)
     (display "()"))
    ((pair? lst)
     (display "(")
     (display-list (car lst))
     (display-list-cdr (cdr lst))))
    (else
     (display " ")
     (display lst))))

(define (display-list-cdr lst)
  (cond
    ((null? lst) (display ")"))
    ((pair? lst)
     (display " ")
     (display-list (car lst))
     (display-list-cdr (cdr lst))))
    (else
     (display " . ")
     (display lst)
     (display ")"))))

;; Helper: create a vector-like pair from a list of two numbers
;; Aura doesn't have vectors natively, so we represent pairs as (h . k) pairs via cons
;; But input is given as pairs; we need to convert nested vectors to cons cells
;; Since Aura doesn't have vector support, we treat inputs as already nested lists

;; Actually inputs come in as lists of lists of pairs
;; Let's adapt: convert each [h k] list to a cons cell

(define (vec->pair v)
  (cons (car v) (cadr v)))

(define (convert-input people)
  (map vec->pair people))

(run-case 0 (convert-input '((7 0) (4 4) (7 1) (5 0) (6 1) (5 2))))
(run-case 1 (convert-input '()))
(run-case 2 (convert-input '((1 0))))
(run-case 3 (convert-input '((5 0) (4 0) (3 0) (2 0) (1 0))))
(run-case 4 (convert-input '((6 0) (5 1) (4 2) (3 3) (2 4) (1 5))))
(run-case 5 (convert-input '((10 0) (10 1) (10 2) (10 3))))
(run-case 6 (convert-input '((100 0) (90 1) (80 2) (70 3) (60 4))))
(run-case 7 (convert-input '((5 0) (5 1) (5 2) (4 0) (4 1) (4 2) (3 0))))
