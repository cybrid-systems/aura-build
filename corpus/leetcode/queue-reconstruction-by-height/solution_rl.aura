(require "lc_json" all:)
(require "compat" all:)
(define (solve people)
  ;; Sort people by h descending, then by k ascending
  (define sorted
    (let loop ((lst people) (acc '()))
      (if (null? lst)
          acc
          (loop (cdr lst)
                (insert-sorted (car lst) acc)))))

  (define (insert-sorted p lst)
    (cond
      ((null? lst) (cons p '()))
      ((or (> (car p) (caar lst))
           (and (= (car p) (caar lst))
                (< (cadr p) (cadr (car lst)))))
       (cons p lst))
      (else (cons (car lst) (insert-sorted p (cdr lst))))))

  (define result '())
  (define (insert-at lst p idx)
    (if (= idx 0)
        (cons p lst)
        (cons (car lst) (insert-at (cdr lst) p (- idx 1)))))

  (let loop ((remaining sorted))
    (if (null? remaining)
        result
        (let ((p (car remaining)))
          (set! result (insert-at result p (cadr p)))
          (loop (cdr remaining))))))
(define (run-case i people)
  (let ((res (solve people)))
    (display "CASE")
    (display i)
    (display "=")
    (display-list res)
    (newline)))
(define (display-list lst)
  (cond
    ((null? lst)
     (display "()"))
    ((pair? lst)
     (display "(")
     (display-list (car lst))
     (display-list-cdr (cdr lst))))
    (else
     (display " ")
     (display lst)))
(define (display-list-cdr lst)
  (cond
    ((null? lst) (display ")"))
    ((pair? lst)
     (display " ")
     (display-list (car lst))
     (display-list-cdr (cdr lst))))
    (else
     (display " . ")
     (display lst)
     (display ")")))
(define (vec->pair v)
  (cons (car v) (cadr v)))
(define (convert-input people)
  (map vec->pair people))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "people")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/queue-reconstruction-by-height/tests.json")))
