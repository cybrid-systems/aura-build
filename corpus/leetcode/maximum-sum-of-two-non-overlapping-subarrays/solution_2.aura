(define (sum-range nums lo hi)
  ;; sum of nums[lo..hi-1]
  (let loop ((i lo) (s 0))
    (if (= i hi) s
        (loop (+ i 1) (+ s (list-ref nums i))))))

(define (max-sum-one-order nums a b)
  ;; assume first window of length a comes BEFORE window of length b
  ;; for each window of length b, track best preceding window of length a
  (let* ((n (length nums))
         (best-a -1000000000000)
         (result -1000000000000))
    ;; initial window of length a at position 0
    (set! best-a (sum-range nums 0 a))
    ;; slide window of length b
    (let loop ((i 0))
      (if (> (+ i b) n) result
          (let ((b-sum (sum-range nums i (+ i b))))
            (begin
              (if (> (+ best-a b-sum) result)
                  (set! result (+ best-a b-sum)))
              ;; advance best-a: the window of length a ending at position (i + 1)
              ;; is valid for future b windows starting at index >= a
              (let ((next-a-end (+ i 1 a)))
                (if (<= next-a-end n)
                    (let ((next-a-sum (sum-range nums (+ i 1) next-a-end)))
                      (if (> next-a-sum best-a)
                          (set! best-a next-a-sum)))))
              (loop (+ i 1))))))))

(define (max-sum-both-orders nums a b)
  (let ((r1 (max-sum-one-order nums a b))
        (r2 (max-sum-one-order nums b a)))
    (if (> r1 r2) r1 r2)))

(define (solve nums firstLen secondLen)
  (max-sum-both-orders nums firstLen secondLen))

;; ---- test harness ----
(define (run-case i nums fl sl)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve nums fl sl))
  (newline))

(run-case 0 '(0 6 5 2 2 5 1 9 4) 1 2)
(run-case 1 '(3 8 1 3 2 1 4 4) 2 3)
(run-case 2 '(2 1 5 6 0 9 5 0 3 8) 1 1)
(run-case 3 '(1 2 3 4 5) 2 3)
(run-case 4 '(5 5 5 5 5) 2 2)
(run-case 5 '(1) 1 1)
(run-case 6 '(0 6 5 2 2 5 1 9 4) 2 3)
(run-case 7 '(3 8 1 3 2 1 4 4) 3 2)
