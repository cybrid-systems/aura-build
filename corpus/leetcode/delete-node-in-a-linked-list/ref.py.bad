import json

class ListNode:
    __slots__ = ('val', 'next')
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

def solve(node):
    node.val = node.next.val
    node.next = node.next.next

def build_list_and_node(values, idx):
    if not values:
        return None, None
    head = ListNode(values[0])
    cur = head
    nodes = [head]
    for v in values[1:]:
        cur.next = ListNode(v)
        cur = cur.next
        nodes.append(cur)
    return head, nodes[idx]

def list_to_array(head):
    out = []
    cur = head
    while cur is not None:
        out.append(cur.val)
        cur = cur.next
    return out

CASES = [
    {"values": [4, 5, 1, 9], "idx": 1},
    {"values": [1, 2, 3, 4, 5], "idx": 0},
    {"values": [1, 2, 3, 4, 5], "idx": 3},
    {"values": [42], "idx": 0},
    {"values": [7, 8], "idx": 0},
    {"values": [7, 8], "idx": 1},
    {"values": [10, 20, 30, 40, 50, 60], "idx": 2},
    {"values": [1, 2], "idx": 0},
]

if __name__ == '__main__':
    results = []
    for i, case in enumerate(CASES):
        head, node = build_list_and_node(case["values"], case["idx"])
        solve(node)
        out = list_to_array(head)
        results.append({
            "id": i,
            "input": {"values": case["values"], "idx": case["idx"]},
            "expected": json.dumps(out, separators=(',', ':'), ensure_ascii=False)
        })
    print(json.dumps(results, separators=(',', ':'), ensure_ascii=False))
