import json


class Node:
    __slots__ = ('val', 'next')

    def __init__(self, val, nxt=None):
        self.val = val
        self.next = nxt


def build_list(values):
    head = None
    tail = None
    for v in values:
        n = Node(v)
        if head is None:
            head = n
            tail = n
        else:
            tail.next = n
            tail = n
    return head


def list_to_values(head):
    out = []
    cur = head
    # After mutation, we may have a cycle if we aren't careful;
    # but with at most one delete and the contract that node is not tail,
    # the result is a finite list.
    visited = 0
    while cur is not None:
        out.append(cur.val)
        cur = cur.next
        visited += 1
        if visited > 10000:
            break
    return out


def solve(node):
    # Standard trick: copy next node's value into this node,
    # then skip over the next node.
    nxt = node.next
    node.val = nxt.val
    node.next = nxt.next


def run_case(values, idx):
    head = build_list(values)
    # Walk to the target node
    cur = head
    for _ in range(idx):
        cur = cur.next
    solve(cur)
    return list_to_values(head)


CASES = [
    {"values": [4, 5, 1, 9], "idx": 1},
    {"values": [4, 5, 1, 9], "idx": 0},
    {"values": [4, 5, 1, 9], "idx": 2},
    {"values": [1, 2], "idx": 0},
    {"values": [7, 7, 7, 7], "idx": 1},
    {"values": [1, 2, 3, 4, 5], "idx": 3},
    {"values": [10], "idx": 0},  # single node — but constraints say not tail; harness may still send this; delete would fail since node.next is None
    {"values": [-3, 0, -1, 2, 8], "idx": 4},
]


if __name__ == '__main__':
    results = []
    for i, c in enumerate(CASES):
        result = run_case(c["values"], c["idx"])
        results.append({
            "id": i,
            "input": c,
            "expected": json.dumps(result, separators=(',', ':'), ensure_ascii=False),
        })
    print(json.dumps(results, ensure_ascii=False))
