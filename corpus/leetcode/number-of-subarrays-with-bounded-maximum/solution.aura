(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (solve nums left right)
  (let ((n (length nums)))
    (let loop ((i 0) (result 0) (last-too-big -1) (last-in-range -1))
      (if (= i n)
          result
          (let ((x (list-ref nums i)))
            (cond
              ((> x right) (loop (+ i 1) result i -1))
              ((< x left) (loop (+ i 1) result last-too-big last-in-range))
              (else
                (let ((new-last-in-range i))
                  (let ((new-result (+ result (- new-last-in-range last-too-big))))
                    (loop (+ i 1) new-result last-too-big new-last-in-range))))))))))

(define (display-list lst)
  (display "(")
  (let loop ((l lst) (first? #t))
    (if (null? l)
        (display ")")
        (begin
          (if first? (set! first? #f) (display " "))
          (display (car l))
          (loop (cdr l) #f)))))

(define (run-case i nums left right)
  (let ((result (solve nums left right)))
    (begin
      (display "CASE")
      (display i)
      (display "=")
      (display result)
      (newline))))

(run-case 0 '(2 1 4 3) 2 3)
(run-case 1 '(2 9 2 5 6) 2 8)
(run-case 2 '(1 2 3 4) 2 3)
(run-case 3 '(1 4 2 3) 3 3)
(run-case 4 '(0) 0 0)
(run-case 5 '(-1 -2 -3) -2 -1)
(run-case 6 '(5 5 5 5) 5 5)
(run-case 7 '(10 1 2 3 4 5) 1 9)
