(require "lc_json" all:)
(require "compat" all:)
(define (min2 a b) (if (< a b) a b))
(define (max2 a b) (if (> a b) a b))
(define (len lst)
  (if (null? lst) 0 (+ 1 (len (cdr lst)))))
(define (nth lst i)
  (if (= i 0) (car lst) (nth (cdr lst) (- i 1))))
(define (list->vector lst n)
  (let ((v (make-vector n 0)))
    (let loop ((i 0) (xs lst))
      (if (null? xs)
          v
          (begin
            (vector-set! v i (car xs))
            (loop (+ i 1) (cdr xs)))))))
(define (vector-n v i) (vector-ref v i))
(define (vector-set-n! v i x) (vector-set! v i x))
(define (solve heights)
  (let ((n (len heights)))
    (let ((v (list->vector heights n)))
      (let loop ((l 0) (r (- n 1)) (best 0))
        (if (>= l r)
            best
            (let ((hl (vector-n v l))
                  (hr (vector-n v r))
                  (width (- r l)))
              (let ((area (* width (min2 hl hr))))
                (let ((new-best (max2 best area)))
                  (if (< hl hr)
                      (loop (+ l 1) r new-best)
                      (loop l (- r 1) new-best))))))))))
(define (display-list xs)
  (display "[")
  (let loop ((rest xs) (first #t))
    (cond
      ((null? rest) (display "]"))
      (first
        (display (car rest))
        (loop (cdr rest) #f))
      (else
        (display " ")
        (display (car rest))
        (loop (cdr rest) #f)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "heights")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/container-with-most-water/tests.json")))
