```aura
;; Container With Most Water - two-pointer O(n) solution

(define (min2 a b) (if (< a b) a b))
(define (max2 a b) (if (> a b) a b))

(define (len lst)
  (if (null? lst) 0 (+ 1 (len (cdr lst)))))

(define (nth lst i)
  (if (= i 0) (car lst) (nth (cdr lst) (- i 1))))

;; Convert a list to a vector (mutable) for indexed access
(define (list->vector lst n)
  (let ((v (make-vector n 0)))
    (let loop ((i 0) (xs lst))
      (if (null? xs)
          v
          (begin
            (vector-set! v i (car xs))
            (loop (+ i 1) (cdr xs)))))))

(define (vector-n v i) (vector-ref v i))
(define (vector-set-n! v i x) (vector-set! v i x))

(define (solve heights)
  (let ((n (len heights)))
    (let ((v (list->vector heights n)))
      (let loop ((l 0) (r (- n 1)) (best 0))
        (if (>= l r)
            best
            (let ((hl (vector-n v l))
                  (hr (vector-n v r))
                  (width (- r l)))
              (let ((area (* width (min2 hl hr))))
                (let ((new-best (max2 best area)))
                  (if (< hl hr)
                      (loop (+ l 1) r new-best)
                      (loop l (- r 1) new-best))))))))))

(define (display-list xs)
  (display "[")
  (let loop ((rest xs) (first #t))
    (cond
      ((null? rest) (display "]"))
      (first
        (display (car rest))
        (loop (cdr rest) #f))
      (else
        (display " ")
        (display (car rest))
        (loop (cdr rest) #f)))))

;; --- Test harness ---
(display "CASE0=") (display (solve '(1 8 6 2 5 4 8 3 7))) (newline)
(display "CASE1=") (display (solve '(1 1))) (newline)
(display "CASE2=") (display (solve '(4 3 2 1 4))) (newline)
(display "CASE3=") (display (solve '(1 2 1))) (newline)
(display "CASE4=") (display (solve '(2 3 4 5 18 17 6))) (newline)
(display "CASE5=") (display (solve '(0 0 0 0))) (newline)
(display "CASE6=") (display (solve '(5 4 3 2 1))) (newline)
