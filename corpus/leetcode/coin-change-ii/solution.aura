(define (make-list n init)
  (if (= n 0)
      '()
      (cons init (make-list (- n 1) init))))

(define (list-set! lst i v)
  (if (= i 0)
      (set-car! lst v)
      (list-set! (cdr lst) (- i 1) v)))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

(define (solve amount coins)
  (let ((dp (make-list (+ amount 1) 0)))
    (list-set! dp 0 1)
    (define (loop-coins cs)
      (if (null? cs)
          (list-ref dp amount)
          (let ((c (car cs)))
            (define (loop-amt a)
              (if (> a amount)
                  (loop-coins (cdr cs))
                  (begin
                    (list-set! dp a (+ (list-ref dp a) (list-ref dp (- a c))))
                    (loop-amt (+ a 1)))))
            (loop-amt c))))
    (loop-coins coins)))

(define (main)
  (display "CASE0=") (display (solve 5 '(1 2 5))) (newline)
  (display "CASE1=") (display (solve 3 '(2))) (newline)
  (display "CASE2=") (display (solve 10 '(1 5 10 25))) (newline)
  (display "CASE3=") (display (solve 0 '(1 2 5))) (newline)
  (display "CASE4=") (display (solve 100 '(1 5 10 25 50))) (newline)
  (display "CASE5=") (display (solve 0 '())) (newline)
  (display "CASE6=") (display (solve 7 '(2 3))) (newline)
  (display "CASE7=") (display (solve 4 '(1 2 3))) (newline))

(main)
