(require "compat" all:)

; Single Number II: count bits mod 3 across 32 bits, sign-extend by treating top bit specially.
; Uses arithmetic-shift and logand from compat for reliable bit ops.

(define (logand2 a b) (bitwise-and a b))
(define (ash2 v n) (arithmetic-shift v n))

(define (bit-set? v i)
  ; Bit i of v's two's-complement 32-bit representation
  (cond
    ((= i 31) (= 1 (logand2 1 (ash2 v -31))))
    (else (= 1 (logand2 1 (ash2 v (- i)))))))

(define (bit-count-at nums i)
  (let loop ((xs nums) (s 0))
    (if (null? xs)
        s
        (let ((v (car xs)))
          (loop (cdr xs) (+ s (if (bit-set? v i) 1 0)))))))

(define (single-number nums)
  (let loop ((i 0) (result 0))
    (if (= i 32)
        result
        (let ((ones (modulo (bit-count-at nums i) 3)))
          (loop (+ i 1) (+ result (* ones (ash2 1 i))))))))

(define (solve nums)
  (single-number nums))

(define (display-value v)
  (cond
    ((number? v) (display v))
    ((null? v) (display "()"))
    ((pair? v)
     (display "(")
     (display (car v))
     (let loop ((rest (cdr v)))
       (cond
         ((null? rest) (display ")"))
         (else
          (display " ")
          (display (car rest))
          (loop (cdr rest))))))
    (else (display v))))

(begin
  (define case0 '(2 2 3 2))
  (define case1 '(0 1 0 1 0 1 99))
  (define case2 '(-5 -5 -5 -3))
  (define case3 '(1))
  (define case4 '(7 7 7 5 5 5 9))
  (define case5 '(4 4 4 4 4 4 42))
  (define case6 '(-1 -1 -1 2))
  (define case7 '(3 3 3 -3 -3 -3 8 8 8 100))

  (display "CASE0=") (display-value (solve case0)) (newline)
  (display "CASE1=") (display-value (solve case1)) (newline)
  (display "CASE2=") (display-value (solve case2)) (newline)
  (display "CASE3=") (display-value (solve case3)) (newline)
  (display "CASE4=") (display-value (solve case4)) (newline)
  (display "CASE5=") (display-value (solve case5)) (newline)
  (display "CASE6=") (display-value (solve case6)) (newline)
  (display "CASE7=") (display-value (solve case7)) (newline))
