(require "lc_json" all:)
(require "compat" all:)
(define (length xs)
  (if (null? xs) 0 (+ 1 (length (cdr xs)))))
(define (append xs ys)
  (if (null? xs) ys (cons (car xs) (append (cdr xs) ys))))
(define (take n xs)
  (if (= n 0) '()
      (if (null? xs) '()
          (cons (car xs) (take (- n 1) (cdr xs))))))
(define (drop n xs)
  (if (= n 0) xs
      (if (null? xs) '()
          (drop (- n 1) (cdr xs)))))
(define (solve head k)
  (let ((n (length head)))
    (if (= n 0) '()
        (let ((m (modulo k n)))
          (if (= m 0) head
              (let ((cut (- n m)))
                (append (drop cut head) (take cut head))))))))
(define (display-list xs)
  (if (null? xs) (display "")
      (begin
        (display (car xs))
        (if (not (null? (cdr xs))) (display " "))
        (display-list (cdr xs)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "head") (hash-ref input "k")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/rotate-list/tests.json")))
