(define MOD 1000000007)

(define (max a b) (if (> a b) a b))

(define (kadane xs)
  (let loop ((xs xs) (best -1000000000000) (cur -1000000000000))
    (cond ((null? xs) best)
          (else
           (let ((v (car xs)))
             (set! cur (max v (+ cur v)))
             (set! best (max best cur))
             (loop (cdr xs) best cur))))))

(define (max-prefix xs)
  (let loop ((xs xs) (best -1000000000000) (cur 0))
    (cond ((null? xs) best)
          (else
           (set! cur (+ cur (car xs)))
           (set! best (max best cur))
           (loop (cdr xs) best cur)))))

(define (max-suffix xs)
  (let loop ((xs xs) (best -1000000000000) (cur 0))
    (cond ((null? xs) best)
          (else
           (set! cur (+ cur (car xs)))
           (set! best (max best cur))
           (loop (cdr xs) best cur)))))

(define (total-sum xs)
  (let loop ((xs xs) (s 0))
    (if (null? xs) s (loop (cdr xs) (+ s (car xs))))))

(define (solve a k)
  (let* ((n (length a))
         (single-max (kadane a))
         (pref (max-prefix a))
         (suff (max-suffix a))
         (tot (total-sum a)))
    (let ((ans
           (cond ((<= k 1) single-max)
                 ((> tot 0)
                  (max single-max (+ suff pref (* tot (- k 2)))))
                 (else
                  (max single-max (+ suff pref))))))
      (let ((v (modulo ans MOD)))
        (if (< v 0) (+ v MOD) v)))))

(define (run-case i a k)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve a k))
  (newline))

(run-case 0 '(1 -2 1 2 -2 1 -2 1) 3)
(run-case 1 '(-1 -2) 5)
(run-case 2 '(1 2 3) 1)
(run-case 3 '(1 2 3) 3)
(run-case 4 '(1 -1 1) 2)
(run-case 5 '(5 -2 3) 4)
(run-case 6 '(0 0 0) 10)
(run-case 7 '(-5 -2 -3) 2)
