(require "lc_json" all:)
(require "compat" all:)
(define (member? x lst)
  (cond
    ((null? lst) #f)
    ((equal? (car lst) x) #t)
    (else (member? x (cdr lst)))))
(define (get-cell board r c)
  (car (list-ref (list-ref board r) c)))
(define (list-ref lst i)
  (cond
    ((= i 0) (car lst))
    (else (list-ref (cdr lst) (- i 1)))))
(define (check-seq lst)
  (let loop ((seq lst) (seen '()))
    (cond
      ((null? seq) #t)
      ((equal? (car seq) ".") (loop (cdr seq) seen))
      ((member? (car seq) seen) #f)
      (else (loop (cdr seq) (cons (car seq) seen))))))
(define (get-row board r)
  (list-ref board r))
(define (get-col board c)
  (let loop ((r 0) (acc '()))
    (if (= r 9)
        (reverse acc)
        (loop (+ r 1) (cons (get-cell board r c) acc)))))
(define (get-box board br bc)
  (let loop ((r 0) (acc '()))
    (cond
      ((= r 3) (reverse acc))
      (else
       (let inner ((c 0) (row-acc '()))
         (if (= c 3)
             (loop (+ r 1) (append acc row-acc))
             (inner (+ c 1) (cons (get-cell board (+ (* br 3) r) (+ (* bc 3) c)) row-acc))))))))
(define (append a b)
  (cond ((null? a) b) (else (cons (car a) (append (cdr a) b)))))
(define (reverse lst)
  (let loop ((src lst) (acc '()))
    (if (null? src) acc (loop (cdr src) (cons (car src) acc)))))
(define (solve board)
  (let ((row-ok (let loop ((r 0))
                  (cond
                    ((= r 9) #t)
                    ((check-seq (get-row board r)) (loop (+ r 1)))
                    (else #f)))))
    (let ((col-ok (let loop ((c 0))
                    (cond
                      ((= c 9) #t)
                      ((check-seq (get-col board c)) (loop (+ c 1)))
                      (else #f)))))
      (let ((box-ok (let loop-r ((br 0))
                      (cond
                        ((= br 9) #t)
                        (else
                         (let loop-c ((bc 0))
                           (cond
                             ((= bc 9) #t)
                             ((check-seq (get-box board (/ br 3) (/ bc 3)))
                              (loop-c (+ bc 3)))
                             (else #f))))))))
        (and row-ok col-ok box-ok)))))
