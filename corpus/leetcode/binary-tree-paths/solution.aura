(define (null? x) (if (eq? x '()) #t #f))

(define (caar p) (car (car p)))
(define (cadr p) (car (cdr p)))
(define (cddr p) (cdr (cdr p)))
(define (caddr p) (car (cdr (cdr p))))

(define (parse-tree lst)
  (if (null? lst)
      '()
      (let ((n (car lst)))
        (if (eq? n 'null)
                '()
                (let ((rest (cdr lst))
                      (left-list (parse-tree (cdr lst)))
                      (right-list (parse-tree (cdr (cdr lst)))))
                  (cons (cons n (cons (car left-list) (cons (car right-list) '()))) '()))))))

(define (build-tree lst)
  (if (null? lst)
      '()
      (let ((first (car lst)))
        (if (eq? first 'null)
            '()
            (let ((rest (cdr lst)))
              (let ((left (build-helper rest 0 '()))
                    (right (build-helper rest 1 '())))
                (cons first (cons left (cons right '())))))))))

(define (build-helper lst idx acc)
  (if (null? lst)
      '()
      (if (= idx 0)
          (car lst)
          (build-helper (cdr lst) (- idx 1) acc))))

(define (build-tree2 lst)
  (if (null? lst)
      '()
      (let ((first (car lst)))
        (if (eq? first 'null)
            '()
            (let ((left-lst (take-nth lst 0))
                  (right-lst (take-nth lst 1)))
              (cons first (cons (build-tree2 left-lst) (cons (build-tree2 right-lst) '()))))))))

(define (take-nth lst n)
  (if (null? lst)
      '()
      (if (= n 0)
          (cons (car lst) (take-nth (cdr (cdr lst)) 0))
          (take-nth (cdr lst) (- n 1)))))

(define (make-tree lst)
  (if (null? lst)
      '()
      (let ((v (car lst)))
        (if (eq? v 'null)
            '()
            (let ((l (car (make-tree-pair (cdr lst) 0)))
                  (r (car (cdr (make-tree-pair (cdr lst) 1)))))
              (cons v (cons l (cons r '()))))))))

(define (make-tree-pair lst i)
  (if (null? lst)
      (cons '() (cons '() '()))
      (if (= i 0)
          (let ((v (car lst)))
            (if (eq? v 'null)
                (cons '() (cons (make-tree (cdr lst)) '()))
                (cons (make-tree-pair (cdr lst) 0) (cons '() '()))))
          (cons '() (cons (make-tree-pair lst (- i 1)) '()))))

(define (solve root)
  (paths root '()))

(define (paths node path)
  (if (null? node)
      '()
      (let ((v (car node))
            (l (car (cdr node)))
            (r (car (cdr (cdr node)))))
        (let ((new-path (append-val path v)))
          (if (and (null? l) (null? r))
              (list (path-to-string new-path))
              (append (paths l new-path) (paths r new-path)))))))

(define (append-val path v)
  (append path (list v)))

(define (append a b)
  (if (null? a)
      b
      (cons (car a) (append (cdr a) b))))

(define (path-to-string path)
  (let ((n (number->string (car path)))
        (rest (cdr path)))
    (if (null? rest)
        n
        (string-append n (string-append "->" (path-to-string rest))))))

(define (format-result lst)
  (display "[")
  (format-list lst)
  (display "]"))

(define (format-list lst)
  (if (null? lst)
      (display "")
      (begin
        (display "\"")
        (display (car lst))
        (display "\"")
        (if (null? (cdr lst))
            (display "")
            (begin
              (display " ")
              (format-list (cdr lst)))))))

(define (run-case n lst)
  (display "CASE")
  (display n)
  (display "=")
  (let ((tree (make-tree lst)))
    (format-result (solve tree)))
  (newline))

;; Embedded test inputs - using representative cases from the problem
(run-case 0 (list 1 2 3 'null 5))
(run-case 1 (list 1))
(run-case 2 '())
(run-case 3 (list 1 2 3 4 5 6 7))
(run-case 4 (list 1 2 'null 3 'null 4 'null 5))
(run-case 5 '())
(run-case 6 '())
(run-case 7 '())
