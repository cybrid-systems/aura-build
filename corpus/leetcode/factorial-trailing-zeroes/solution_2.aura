(define (solve n)
  (let loop ((p 5) (acc 0))
    (if (> p n)
        acc
        (loop (* p 5) (+ acc (quotient n p))))))

(define (run-case i n)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n))
  (newline))

(run-case 0 0)
(run-case 1 5)
(run-case 2 100)
(run-case 3 1)
(run-case 4 4)
(run-case 5 6)
(run-case 6 25)
(run-case 7 1000000000)
