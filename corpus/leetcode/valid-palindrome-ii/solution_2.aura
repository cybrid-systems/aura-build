;; Check if substring is palindrome using indexes into list of chars
(define (is-pal-range chars left right)
  (let loop ((l left) (r right))
    (if (>= l r)
        #t
        (if (equal? (list-ref chars l) (list-ref chars r))
            (loop (+ l 1) (- r 1))
            #f))))

(define (solve s)
  (let* ((len (string-length s))
         (chars (string->list s)))
    (if (<= len 1)
        #t
        (let check ((l 0) (r (- len 1)))
          (cond
            ((>= l r) #t)
            ((equal? (list-ref chars l) (list-ref chars r))
             (check (+ l 1) (- r 1)))
            (else
             (if (or (is-pal-range chars (+ l 1) r)
                     (is-pal-range chars l (- r 1)))
                 #t
                 #f)))))))

;; Process test cases
(define (run-case i s)
  (display (string-append "CASE" (number->string i) "="))
  (display (if (solve s) "true" "false"))
  (newline))

(run-case 0 "aba")
(run-case 1 "abca")
(run-case 2 "abc")
(run-case 3 "")
(run-case 4 "a")
(run-case 5 "ab")
(run-case 6 "abbaa")
(run-case 7 "racecar")
(run-case 8 "deeee")
(run-case 9 "abdcba")
(run-case 10 "abcdba")
