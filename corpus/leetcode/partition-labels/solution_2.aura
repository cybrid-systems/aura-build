;; Partition Labels - greedy two-pointer using last occurrences
;; Reads a string from stdin, partitions so each letter appears in at most one part,
;; maximizing the number of parts. Prints the lengths separated by spaces.

(define (string-length s)
  (let loop ((i 0) (c s))
    (if (null? c) i (loop (+ i 1) (cdr c)))))

(define (list-ref lst n)
  (if (= n 0) (car lst) (list-ref (cdr lst) (- n 1))))

(define (string-ref s i)
  (list-ref s i))

;; Build a vector (list) of last-occurrence index for each letter a..z.
;; Returned as a list of 26 numbers, index 0 = 'a'.
(define (compute-last s)
  (let ((len (string-length s)))
    (let loop ((i 0) (last '()) )
      (if (= i 26) last
          (loop (+ i 1) (cons -1 last))))))

(define (set-last! last-vec ch-idx idx)
  ;; ch-idx in 0..25, last-vec is mutable via global mutation? Aura has set!.
  ;; We'll just recompute using a fresh cons-based replacement via helper.
  '())

;; We'll implement a pure recursive last-occurrence builder instead.
(define (build-last s i n)
  ;; postorder: compute last positions for chars 0..25
  ;; returns a list of 26 numbers where j-th (from front, j=0..25) is last index of chr('a'+j)
  (let loop-j ((j 0) (acc '()))
    (if (= j 26)
        (begin
          ;; we'll return acc reversed-once via rev-help
          (reverse-acc acc '()))
        (let loop-i ((k 0) (last-idx -1))
          (if (= k n)
              (loop-j (+ j 1) (cons last-idx acc))
              (loop-i (+ k 1)
                      (if (= (char-index (string-ref s k)) j) k last-idx)))))))

(define (char-index ch)
  ;; ch is a symbol-like char; here chars are exposed as symbols by Aura's reader.
  ;; Convert symbol name to index. We'll assume chars are single-char symbols
  ;; whose symbol-name is a 1-char string.
  (let ((nm (symbol->string ch)))
    (let ((s0 (string-ref (symbol->string ch) 0)))
      (- (char->integer s0) (char->integer #\a)))))

;; Unfortunately Aura likely lacks symbol->string in this minimal env.
;; Since the problem only uses lowercase ASCII letters, we can compare char
;; symbols via equality with 'a, 'b, etc. To avoid reliance on symbol->string,
;; let's instead encode the input string as a list of integers 0..25 by walking.

;; We'll instead read input and convert to integer codes via a helper that
;; accepts a runtime Aura value. For embedded tests we don't actually use stdin
;; parsing; we hard-code the calls below. But to follow problem spec ("reads
;; from stdin") we'll provide a fallback that reads a line and converts via
;; char->integer. We'll attempt to use char->integer which is in standard Scheme.

;; Implementation strategy for solve:
;;  - s as a list of integer codes 0..25 (or original chars). Use integer codes.
;;  - Compute last[i] = last index where char i appears.
;;  - Sweep with start=0, end=0, expanding end to max(last[c]) for each c seen
;;    in current partition; when i == end, push length (end-start+1), start=i+1.

(define (make-last n s)
  ;; n: length, s: list of integer codes 0..25
  ;; Returns list of 26 ints (index 0 first element).
  (let loop-j ((j 0) (acc '()))
    (if (= j 26)
        acc
        (let loop-i ((k 0) (last-idx -1))
          (if (= k n)
              (loop-j (+ j 1) (cons last-idx acc))
              (loop-i (+ k 1)
                      (if (= (list-ref s k) j) k last-idx)))))))

(define (solve s)
  ;; s is a list of integer codes 0..25
  (let ((n (length s)))
    (if (= n 0) '()
        (let ((last (make-last n s)))
          (let loop ((i 0) (start 0) (end 0) (acc '()))
            (if (= i n)
                (reverse acc)
                (let ((ci (list-ref s i)))
                  (let ((new-end (max end (list-ref last ci))))
                    (if (= i new-end)
                        (loop (+ i 1)
                              (+ i 1)
                              (+ i 1)
                              (cons (- new-end start -1) ; length
                                    ; length should be new-end - start + 1, with start=0 initially
                                    ; but we overwrote start above. Recompute properly:
                                    acc))
                        (loop (+ i 1) start new-end acc))))))))))

;; The above has a bug: when we close a partition, we set start = i+1 but then
;; also push length using new-end - start. Need to capture original start.
;; Let's restructure cleanly.

(define (solve s)
  (let ((n (length s)))
    (if (= n 0) '()
        (let ((last (make-last n s)))
          (let loop ((i 0) (start 0) (end 0) (acc '()))
            (if (= i n)
                (reverse acc)
                (let ((ci (list-ref s i)))
                  (let ((new-end (max end (list-ref last ci))))
                    (if (= i new-end)
                        (loop (+ i 1)
                              (+ i 1)
                              (+ i 1)
                              (cons (+ (- new-end start) 1) acc))
                        (loop (+ i 1) start new-end acc))))))))))

;; --- Convert an Aura string (list of chars or runtime string) to integer codes ---
;; To keep this self-contained and avoid symbol->string issues, we provide a
;; convert procedure that uses the built-in primitive char->integer if chars
;; are true chars. If the runtime passes a Scheme string, we index it with
;; string-ref. We'll write a small dispatcher.

(define (string->codes s)
  ;; Try: if s is a string, iterate over it; else treat as list of chars.
  ;; In Aura, strings are typically first-class. We'll attempt (string-length s)
  ;; via guarded call. Since we can't truly branch on type, we just assume s
  ;; is a Scheme string here.
  (let ((n (string-length s)))
    (let loop ((k 0) (acc '()))
      (if (= k n)
          (reverse acc)
          (loop (+ k 1)
                (cons (- (char->integer (string-ref s k))
                         (char->integer #\a))
                      acc))))))

(define (display-list lst)
  (let loop ((first? #t) (l lst))
    (cond ((null? l) #t)
          (else
           (if (not first?) (display " "))
           (display (car l))
           (loop #f (cdr l))))))

;; Main: read a line from stdin, partition, print lengths separated by spaces.
;; Per problem spec we read the string from stdin. For embedded CASE tests
;; below we still call solve with the given strings.

;; Note: This stub program avoids actual stdin to remain valid in no-stdin env.
;; We instead evaluate each test case by constructing codes via string->codes
;; against a hard-coded Scheme string literal where available.

;; However, embedded tests pass Python-style strings; we as Aura don't have
;; those literally. To handle this, we eval each test by inlining the literal
;; as a Scheme string. We'll write each case explicitly.

(define (run-case s)
  (let ((codes (string->codes s)))
    (let ((result (solve codes)))
      (display-list result)
      (newline))))

;; Embedded test cases:
;; CASE0
(display "CASE0=")
(run-case "ababcbacadefegdehijhklij")
;; CASE1
(display "CASE1=")
(run-case "caedbdedda")
;; CASE2
(display "CASE2=")
(run-case "a")
;; CASE3
(display "CASE3=")
(run-case "aa")
;; CASE4
(display "CASE4=")
(run-case "ab")
;; CASE5
(display "CASE5=")
(run-case "abcabc")
;; CASE6
(display "CASE6=")
(run-case "abcd")
;; CASE7
(display "CASE7=")
(run-case "eccbbbbdec")
