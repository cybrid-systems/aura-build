(require "lc_json" all:)
(require "compat" all:)
(define (make-vector n val)
  (let ((v '()))
    (let loop ((i 0))
      (if (= i n)
          (list->vector (reverse v))
          (loop (+ i 1))))))
(define vec-set
  (lambda (v i val)
    (vector-set! v i val)))
(define vec-ref
  (lambda (v i)
    (vector-ref v i)))
(define (build-graph N prereqs)
  (let ((adj (make-vector N '())))
    (let loop ((ps prereqs))
      (if (null? ps)
          adj
          (let ((p (car ps)))
            (let ((a (car p)) (b (cadr p)))
              (vec-set adj b (cons a (vec-ref adj b)))
              (loop (cdr ps))))))))
(define (has-cycle? adj N)
  (let ((color (make-vector N 0))
        (result #f))
    (define (dfs u)
      (vec-set color u 1)
      (let ((neighbors (vec-ref adj u)))
        (let nloop ((ns neighbors))
          (if (and (not result) (not (null? ns)))
              (let ((v (car ns)))
                (let ((c (vec-ref color v)))
                  (cond
                    ((= c 1) (set! result #t))
                    ((= c 0)
                     (dfs v)
                     (nloop (cdr ns))))
                    (else (nloop (cdr ns))))))
              'done))))
    (let outer ((u 0))
      (cond
        ((or result (= u N)) result)
        ((= (vec-ref color u) 0)
         (dfs u)
         (outer (+ u 1)))
        (else (outer (+ u 1))))))
(define (solve N prereqs)
  (let ((adj (build-graph N prereqs)))
    (if (has-cycle? adj N) #f #t)))
(define (display-bool b)
  (display (if b "true" "false")))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "N") (hash-ref input "prereqs")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/course-schedule/tests.json")))
