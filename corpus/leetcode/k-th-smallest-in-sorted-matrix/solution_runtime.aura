; soft_leetcode_runtime slug=k-th-smallest-in-sorted-matrix path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-0 hits=8/8
; baseline_hits=3/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define heap-insert
    (lambda (heap val)
      (begin
        (define ins
          (lambda (h v)
            (if (null? h)
              (cons
                v (quote ()))
              (if (<
                  (car v) (car (car h)))
                (cons
                  v h)
                (cons
                  (car h) (ins
                    (cdr h) v))))))
        (ins
          heap val))))
  (define solve
    (lambda (matrix k)
      (begin
        (define n (length matrix))
        (define row-elt
          (lambda (r i)
            (letrec ((loop (lambda (r idx)
                (if (=
                    idx i)
                  (car r)
                  (loop
                    (cdr r) (+
                      idx 1))))))
              (loop
                r 0))))
        (define build-initial
          (lambda (idx heap)
            (if (>=
                idx n)
              heap
              (let ((row (list-ref
                  matrix idx)))
                (build-initial
                  (+
                    idx 1) (heap-insert
                    heap (list
                      (row-elt
                        row 0) idx 0)))))))
        (define heap (build-initial
            0 (quote ())))
        (define pop-k
          (lambda (h step)
            (if (null? h)
              #f
              (if (=
                  step k)
                (car (car h))
                (let ((top (car h)))
                  (let ((rest (cdr h)))
                    (let ((val (car top)))
                      (let ((row (cadr top)))
                        (let ((col (caddr top)))
                          (let ((next-col (+
                              col 1)))
                            (if (>=
                                next-col n)
                              (pop-k
                                rest (+
                                  step 1))
                              (let ((row-list (list-ref
                                  matrix row)))
                                (pop-k
                                  (heap-insert
                                    rest (list
                                      (row-elt
                                        row-list next-col) row next-col)) (+
                                    step 1))))))))))))))
        (pop-k
          heap 1))))
  (define display-case
    (lambda (i result)
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display result)
        (newline))))
  (display-case
    0 (solve
      (quote ((1
            5 9)
          (10
            11 13) (12
            13 15))) 8))
  (display-case
    1 (solve
      (quote ((-5))) 1))
  (display-case
    2 (solve
      (quote ((1 2) (3 4))) 1))
  (display-case
    3 (solve
      (quote ((1 2) (3 4))) 4))
  (display-case
    4 (solve
      (quote ((1
            3 5)
          (2
            4 6) (7
            8 9))) 5))
  (display-case
    5 (solve
      (quote ((1
            5 9 11)
          (10
            11 13 15) (12
            13 15 17) (14
            16 18 20))) 7))
  (display-case
    6 (solve
      (quote ((2
            2 3)
          (2
            3 3) (3
            3 4))) 6))
  (display-case
    7 (solve
      (quote ((1))) 1)))
