(define (my-sqrt x)
  (let ((lo 0)
        (hi x))
    (let loop ((left lo) (right hi) (ans 0))
      (if (> left right)
          ans
          (let ((mid (+ left (quotient (- right left) 2))))
            (if (<= mid (quotient x mid))
                (loop (+ mid 1) right mid)
                (loop left (- mid 1) ans)))))))

(define (solve x)
  (my-sqrt x))

(define (run-case i x)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve x))
  (newline))

(run-case 0 0)
(run-case 1 1)
(run-case 2 4)
(run-case 3 8)
(run-case 4 9)
(run-case 5 15)
(run-case 6 16)
(run-case 7 2147395599)
