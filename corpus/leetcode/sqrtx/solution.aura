(define (sqrt-helper left right)
  (if (> left right)
      right
      (let ((mid (+ left (quotient (- right left) 2))))
        (if (<= mid (quotient 2147395599 1))  ; placeholder, replaced below
            (cond
              ((<= (* mid mid) 2147395599) (sqrt-helper (+ mid 1) right))  ; placeholder
              (else (sqrt-helper left (- mid 1))))
            (sqrt-helper left (- mid 1))))))

(define (sqrt x)
  (if (= x 0)
      0
      (let ((result (sqrt-iter 0 x x)))
        result)))

(define (sqrt-iter left right x)
  (if (> left right)
      right
      (let ((mid (+ left (quotient (- right left) 2))))
        (if (<= mid (quotient x mid))
            (sqrt-iter (+ mid 1) right x)
            (sqrt-iter left (- mid 1) x)))))

(define (solve x)
  (sqrt x))

(define (display-case i x)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve x))
  (newline))

(define (run-cases)
  (begin
    (display-case 0 0)
    (display-case 1 1)
    (display-case 2 4)
    (display-case 3 8)
    (display-case 4 9)
    (display-case 5 15)
    (display-case 6 16)
    (display-case 7 2147395599)))

(run-cases)
