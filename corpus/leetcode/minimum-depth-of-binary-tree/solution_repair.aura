;; Minimum Depth of Binary Tree - Aura solution

;; A tree node is represented as a list: (val left right)
;; 'null represents None.

(define (make-node val left right)
  (list val left right))

(define (node? x)
  (and (pair? x) (not (eq? x 'null))))

(define (node-val n) (car n))
(define (node-left n) (car (cdr n)))
(define (node-right n) (car (cdr (cdr n))))

;; list-ref helper
(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

;; Parse level-order list into nested-list tree.
(define (parse-tree lst)
  (if (null? lst)
      'null
      (build-tree lst 0 (length lst))))

(define (build-tree lst i n)
  (if (>= i n)
      'null
      (let ((v (list-ref lst i)))
        (if (eq? v 'null)
            'null
            (let ((left (build-tree lst (+ (* 2 i) 1) n))
                  (right (build-tree lst (+ (* 2 i) 2) n)))
              (list v left right))))))

;; Solve: compute minimum depth
(define (solve root)
  (min-depth (if (null? root) 'null (car root))))

(define (min a b) (if (< a b) a b))

(define (min-depth node)
  (cond
    ((eq? node 'null) 0)
    ((and (eq? (node-left node) 'null) (eq? (node-right node) 'null))
     1)
    (else
     (let ((ld (min-depth (node-left node)))
           (rd (min-depth (node-right node))))
       (cond
         ((eq? (node-left node) 'null) (+ rd 1))
         ((eq? (node-right node) 'null) (+ ld 1))
         (else (+ 1 (min ld rd))))))))

;; --- Test cases ---
(display "CASE0=") (display (solve (list (parse-tree (list 3 9 20 'null 'null 15 7))))) (newline)
(display "CASE1=") (display (solve (list (parse-tree (list))))) (newline)
(display "CASE2=") (display (solve (list (parse-tree (list 1))))) (newline)
(display "CASE3=") (display (solve (list (parse-tree (list 1 2))))) (newline)
(display "CASE4=") (display (solve (list (parse-tree (list 1 'null 2))))) (newline)
(display "CASE5=") (display (solve (list (parse-tree (list 1 2 3 4 5))))) (newline)
(display "CASE6=") (display (solve (list (parse-tree (list 1 2 'null 3 'null 4 'null 5))))) (newline)
(display "CASE7=") (display (solve (list (parse-tree (list 1 'null 2 'null 3 'null 4 'null 5))))) (newline)
