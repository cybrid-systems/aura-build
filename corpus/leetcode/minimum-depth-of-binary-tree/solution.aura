;; Minimum Depth of Binary Tree - Aura solution

;; A tree node is represented as a list:
;;   ()             -> empty list (not used)
;;   'null          -> null marker
;;   (val left right) -> node
;; We'll use 'null to represent None.

(define (make-node val left right)
  (list val left right))

(define (node? x)
  (and (pair? x) (not (eq? x 'null))))

(define (node-val n) (car n))
(define (node-left n) (car (cdr n)))
(define (node-right n) (car (cdr (cdr n))))

;; Parse level-order list (with 'null for missing nodes) into nested-list tree.
;; Input is an Aura list representation of the input array using numbers and 'null.
;; We'll accept a list literal like (list 3 9 20 'null 'null 15 7).
(define (parse-tree lst)
  (if (null? lst)
      'null
      (let ((n (length lst)))
        (build-tree lst 0 n))))

(define (build-tree lst i n)
  (if (>= i n)
      'null
      (let ((v (list-ref lst i)))
        (if (eq? v 'null)
            'null
            (let ((left (build-tree lst (+ (* 2 i) 1) n))
                  (right (build-tree lst (+ (* 2 i) 2) n)))
              (list v left right))))))

;; list-ref helper
(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

;; Solve: compute minimum depth
(define (solve root)
  (let ((r (if (null? root) 'null (car root))))
    (min-depth r)))

(define (min-depth node)
  (cond
    ((eq? node 'null) 0)
    ((and (eq? (node-left node) 'null) (eq? (node-right node) 'null))
     1)
    (else
     (let ((ld (min-depth (node-left node)))
           (rd (min-depth (node-right node))))
       (cond
         ((eq? (node-left node) 'null) (+ rd 1))
         ((eq? (node-right node) 'null) (+ ld 1))
         (else (+ 1 (min ld rd))))))))

(define (min a b) (if (< a b) a b))

;; Helper to display result
(define (display-result n)
  (display n)
  (newline))

;; --- Test cases ---
;; CASE0: [3, 9, 20, null, null, 15, 7]
(define case0-root (parse-tree (list 3 9 20 'null 'null 15 7)))
(display "CASE0=") (display-result (solve (list case0-root)))

;; CASE1: []
(define case1-root (parse-tree (list)))
(display "CASE1=") (display-result (solve (list case1-root)))

;; CASE2: [1]
(define case2-root (parse-tree (list 1)))
(display "CASE2=") (display-result (solve (list case2-root)))

;; CASE3: [1, 2]
(define case3-root (parse-tree (list 1 2)))
(display "CASE3=") (display-result (solve (list case3-root)))

;; CASE4: [1, null, 2]
(define case4-root (parse-tree (list 1 'null 2)))
(display "CASE4=") (display-result (solve (list case4-root)))

;; CASE5: [1, 2, 3, 4, 5]
(define case5-root (parse-tree (list 1 2 3 4 5)))
(display "CASE5=") (display-result (solve (list case5-root)))

;; CASE6: [1, 2, null, 3, null, 4, null, 5]
(define case6-root (parse-tree (list 1 2 'null 3 'null 4 'null 5)))
(display "CASE6=") (display-result (solve (list case6-root)))

;; CASE7: [1, null, 2, null, 3, null, 4, null, 5]
(define case7-root (parse-tree (list 1 'null 2 'null 3 'null 4 'null 5)))
(display "CASE7=") (display-result (solve (list case7-root)))
