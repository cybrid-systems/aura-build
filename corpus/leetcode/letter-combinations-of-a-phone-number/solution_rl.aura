(require "lc_json" all:)
(require "compat" all:)
(define (digit-letters d)
  (cond ((equal? d #\2) "abc")
        ((equal? d #\3) "def")
        ((equal? d #\4) "ghi")
        ((equal? d #\5) "jkl")
        ((equal? d #\6) "mno")
        ((equal? d #\7) "pqrs")
        ((equal? d #\8) "tuv")
        ((equal? d #\9) "wxyz")
        (else "")))
(define (backtrack digits i acc results)
  (if (= i (string-length digits))
      (begin
        (set! results (cons acc results))
        results)
      (let ((letters (digit-letters (string-ref digits i)))
            (new-results results))
        (let ((j 0)
              (ll (string-length letters)))
          (let loop ()
            (if (< j ll)
                (begin
                  (set! new-results (backtrack digits (+ i 1) (string-append acc (substring letters j (+ j 1))) new-results))
                  (set! j (+ j 1))
                  (loop))
                new-results))))))
(define (solve digits)
  (if (= 0 (string-length digits))
      '()
      (let ((result (backtrack digits 0 "" '())))
        ;; Reverse because we cons'd in reverse order
        (define (rev lst)
          (define (rev-acc lst acc)
            (if (null? lst) acc (rev-acc (cdr lst) (cons (car lst) acc))))
          (rev-acc lst '()))
        (rev result))))
(define (display-results results)
  (if (null? results)
      (display "")
      (begin
        (display (car results))
        (display "\n")
        (display-results (cdr results)))))
(define digits "")

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "digits")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/letter-combinations-of-a-phone-number/tests.json")))
