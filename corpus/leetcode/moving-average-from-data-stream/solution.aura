(define (solve ops)
  (letrec (
    (k-of (lambda (p) (car p)))
    (sum-of (lambda (p) (car (cdr p))))
    (queue-of (lambda (p) (car (cdr (cdr p))))))
    (letrec (
      (process (lambda (ops state results)
        (cond
          ((null? ops) (reverse results))
          (else
            (let ((op (car ops)))
              (cond
                ((equal? (car op) "M")
                 (process (cdr ops)
                   (cons (string->number (car (cdr op))) (cons 0 (cons '() 0)))
                   results))
                ((equal? (car op) "N")
                 (let* ((v (string->number (car (cdr op))))
                        (cur-k (k-of state))
                        (cur-sum (sum-of state))
                        (cur-queue (car (cdr (cdr state))))
                        (cur-len (cdr (cdr (cdr state))))
                        (new-len (+ cur-len 1))
                        (new-sum (+ cur-sum v))
                        (new-queue (cons v cur-queue))
                        (final-sum (if (> new-len cur-k)
                                     (- new-sum (car (car (reverse new-queue))))
                                     new-sum))
                        (final-queue (if (> new-len cur-k)
                                      (cdr (reverse (reverse (cdr (reverse new-queue)))))
                                      new-queue))
                        (final-len (if (> new-len cur-k) cur-k new-len))
                        (avg-trunc (if (= final-len 0) 0
                                    (let ((n final-sum) (d final-len))
                                      (if (>= (* n d) 0)
                                        (quotient n d)
                                        (quotient (+ n (- d 1)) d)))))
                        (new-state (cons cur-k (cons final-sum (cons final-queue final-len))))
                        (new-results (cons avg-trunc results)))
                   (process (cdr ops) new-state new-results)))
                ((equal? (car op) "G")
                 (let* ((cur-k (k-of state))
                        (cur-sum (sum-of state))
                        (cur-len (cdr (cdr (cdr state))))
                        (avg-trunc (if (= cur-len 0) 0
                                    (let ((n cur-sum) (d cur-len))
                                      (if (>= (* n d) 0)
                                        (quotient n d)
                                        (quotient (+ n (- d 1)) d))))))
                   (process (cdr ops) state (cons avg-trunc results)))))))))))
      (process ops (cons 0 (cons 0 (cons '() 0))) '()))))

(define (display-list lst)
  (cond ((null? lst) (display "()"))
        (else (display "(")
              (display (car lst))
              (display-list-helper (cdr lst)))))

(define (display-list-helper lst)
  (cond ((null? lst) (display ")"))
        (else (display " ") (display (car lst)) (display-list-helper (cdr lst)))))

(display "CASE0=") (display (solve '(("M" "3") ("N" "1") ("N" "10") ("N" "3") ("G") ("N" "5")))) (newline)
(display "CASE1=") (display (solve '(("M" "1") ("N" "5") ("N" "10") ("G") ("N" "-3")))) (newline)
(display "CASE2=") (display (solve '(("M" "5") ("G") ("N" "2") ("G") ("N" "4") ("N" "-1") ("N" "0") ("N" "7")))) (newline)
(display "CASE3=") (display (solve '(("M" "3") ("N" "2") ("N" "4") ("N" "6") ("N" "8") ("N" "10")))) (newline)
(display "CASE4=") (display (solve '(("M" "2") ("N" "-1") ("N" "-2") ("N" "-3")))) (newline)
(display "CASE5=") (display (solve '(("M" "10") ("N" "1") ("N" "1") ("N" "1") ("G")))) (newline)
(display "CASE6=") (display (solve '(("M" "3") ("N" "0") ("N" "0") ("N" "0") ("G") ("N" "0")))) (newline)
(display "CASE7=") (display (solve '(("M" "4") ("N" "7") ("N" "-3") ("N" "2") ("N" "-1") ("N" "5") ("N" "4")))) (newline)
