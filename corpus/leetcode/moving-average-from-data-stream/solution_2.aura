(define (trunc-div a b)
  ;; Truncate toward zero: handles negative sum correctly
  (let ((q (quotient a b))
        (r (modulo a b)))
    (if (or (= r 0) (>= (* a b) 0))
        q
        (- q 1))))

(define (trunc-avg sum count)
  (trunc-div sum count))

(define (build-data lst)
  ;; Convert list of ops into a structure: (k queue sum total)
  (cond ((null? lst) (list 0 '() 0 0))
        (else
         (let* ((op (car lst))
                (tag (car op))
                (rest-ops (cdr lst))
                (state (build-data rest-ops)))
           (cond ((equal? tag "M")
                  (list (string->number (cadr op)) '() 0 0))
                 ((equal? tag "N")
                  (let* ((k (car state))
                         (queue (cadr state))
                         (sum (caddr state))
                         (total (cadddr state))
                         (v (string->number (cadr op)))
                         (new-queue (append queue (list v)))
                         (new-sum (+ sum v))
                         (new-total (+ total 1))
                         (len (length new-queue)))
                    (if (> len k)
                        (let* ((dropped (car new-queue))
                               (final-queue (cdr new-queue))
                               (final-sum (- new-sum dropped)))
                          (cons (trunc-avg final-sum k)
                                (list k final-queue final-sum new-total)))
                        (cons (trunc-avg new-sum (min k new-total))
                              (list k new-queue new-sum new-total)))))
                 ((equal? tag "G")
                  (let* ((k (car state))
                         (queue (cadr state))
                         (sum (caddr state))
                         (total (cadddr state)))
                    (cons (trunc-avg sum (length queue))
                          (list k queue sum total)))))))))

(define (solve ops)
  ;; ops is a list of operation tokens like ("M" "3") or ("N" "1") or ("G")
  (let ((results (build-data ops)))
    (if (null? results)
        '()
        (cons (car results) (cdr results)))))

(define (run-case case-num ops)
  (display "CASE")
  (display case-num)
  (display "=")
  (let ((results (solve ops)))
    (display-list results))
  (newline))

(define (display-list lst)
  (cond ((null? lst) (display "[]"))
        (else
         (display "[")
         (display (car lst))
         (let loop ((rest (cdr lst)))
           (cond ((null? rest) (display "]"))
                 (else
                  (display ",")
                  (display (car rest))
                  (loop (cdr rest))))))))

;; Run all test cases
(run-case 0 '(("M" "3") ("N" "1") ("N" "10") ("N" "3") ("G") ("N" "5")))
(run-case 1 '(("M" "1") ("N" "5") ("N" "10") ("G") ("N" "-3")))
(run-case 2 '(("M" "5") ("G") ("N" "2") ("G") ("N" "4") ("N" "-1") ("N" "0") ("N" "7")))
(run-case 3 '(("M" "3") ("N" "2") ("N" "4") ("N" "6") ("N" "8") ("N" "10")))
(run-case 4 '(("M" "2") ("N" "-1") ("N" "-2") ("N" "-3")))
(run-case 5 '(("M" "10") ("N" "1") ("N" "1") ("N" "1") ("G")))
(run-case 6 '(("M" "3") ("N" "0") ("N" "0") ("N" "0") ("G") ("N" "0")))
(run-case 7 '(("M" "4") ("N" "7") ("N" "-3") ("N" "2") ("N" "-1") ("N" "5") ("N" "4")))
