(define (sum-list lst)
  (if (null? lst)
      0
      (+ (car lst) (sum-list (cdr lst)))))

(define (take n lst)
  (if (= n 0)
      '()
      (cons (car lst) (take (- n 1) (cdr lst)))))

(define (drop n lst)
  (if (= n 0)
      lst
      (drop (- n 1) (cdr lst))))

(define (length-list lst)
  (if (null? lst)
      0
      (+ 1 (length-list (cdr lst)))))

(define (solve gas cost)
  (let* ((total-gas (sum-list gas))
         (total-cost (sum-list cost))
         (n (length-list gas)))
    (if (< total-gas total-cost)
        -1
        ;; classic linear scan: track running tank, find index where tank is minimum
        ;; then answer is (min-index + 1) mod n
        (find-start gas cost n 0 0 0 0)
        )))

(define (find-start gas cost n tank min-tank min-idx idx)
  (if (= idx n)
      ;; done: candidate is (min-idx + 1) mod n
      (modulo (+ min-idx 1) n)
      (let* ((diff (- (list-ref gas idx) (list-ref cost idx)))
             (new-tank (+ tank diff)))
        (if (< new-tank min-tank)
            (find-start gas cost n new-tank new-tank idx (+ idx 1))
            (find-start gas cost n new-tank min-tank min-idx (+ idx 1))))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

;; Embedded test inputs
(define case0-gas '(1 2 3))
(define case0-cost '(2 1 0))
(define case1-gas '(1 1 1))
(define case1-cost '(2 2 2))
(define case2-gas '(5))
(define case2-cost '(5))
(define case3-gas '(3))
(define case3-cost '(5))
(define case4-gas '(0 0 0))
(define case4-cost '(0 0 0))
(define case5-gas '(2 3 4))
(define case5-cost '(3 4 3))
(define case6-gas '(0 0 5 0 1 2 3 0 0 1))
(define case6-cost '(1 2 0 3 0 0 1 5 0 1))
(define case7-gas '(2 2 2 2))
(define case7-cost '(1 3 1 3))

(display "CASE0=") (display (solve case0-gas case0-cost)) (newline)
(display "CASE1=") (display (solve case1-gas case1-cost)) (newline)
(display "CASE2=") (display (solve case2-gas case2-cost)) (newline)
(display "CASE3=") (display (solve case3-gas case3-cost)) (newline)
(display "CASE4=") (display (solve case4-gas case4-cost)) (newline)
(display "CASE5=") (display (solve case5-gas case5-cost)) (newline)
(display "CASE6=") (display (solve case6-gas case6-cost)) (newline)
(display "CASE7=") (display (solve case7-gas case7-cost)) (newline)
