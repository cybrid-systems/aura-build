(define (solve s t)
  (letrec ((helper
    (lambda (i stmap tsmap)
      (if (= i (string-length s))
          #t
          (let ((sc (substring s i (+ i 1)))
                (tc (substring t i (+ i 1))))
            (let ((existing-t (assoc sc stmap))
                  (existing-s (assoc tc tsmap)))
              (cond
                ((and existing-t existing-s)
                 (if (and (equal? (cdr existing-t) tc)
                          (equal? (cdr existing-s) sc))
                     (helper (+ i 1) stmap tsmap)
                     #f))
                ((and (not existing-t) (not existing-s))
                 (helper (+ i 1)
                         (cons (cons sc tc) stmap)
                         (cons (cons tc sc) tsmap)))
                (else #f)))))))
    (helper 0 '() '())))

(define (display-list xs)
  (display "(")
  (let loop ((rest xs) (first #t))
    (if (null? rest)
        (begin (display ")") #t)
        (begin
          (if first (set! first #f) (display " "))
          (display (car rest))
          (loop (cdr rest) first)))))

(define (display-result r)
  (cond
    ((equal? r #t) (display "#t"))
    ((equal? r #f) (display "#f"))
    ((number? r) (display r))
    ((string? r) (display r))
    ((list? r) (display-list r))
    (else (display r))))

(define (run-case i s t)
  (display "CASE")
  (display i)
  (display "=")
  (display-result (solve s t))
  (newline))

(run-case 0 "egg" "add")
(run-case 1 "foo" "bar")
(run-case 2 "paper" "title")
(run-case 3 "ab" "aa")
(run-case 4 "" "")
(run-case 5 "a" "a")
(run-case 6 "abc" "abcd")
(run-case 7 "badc" "baba")
