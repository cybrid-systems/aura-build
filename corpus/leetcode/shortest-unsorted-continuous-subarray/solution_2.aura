;; Shortest Unsorted Continuous Subarray - Aura solution

(define (list-len xs)
  (if (null? xs) 0 (+ 1 (list-len (cdr xs)))))

;; solve: takes a list of numbers, returns the length of the shortest
;; unsorted continuous subarray (0 if already sorted).
(define (solve nums)
  (let* ((n (list-len nums))
         (arr (list->vector nums)))
    (if (< n 2)
        0
        (letrec ((find-left
                   (lambda (i max-so-far)
                     (cond ((>= i n) n)
                           ((< (vector-ref arr i) max-so-far) i)
                           (else (find-left (+ i 1) (if (> (vector-ref arr i) max-so-far)
                                                         (vector-ref arr i)
                                                         max-so-far))))))
                 (find-right
                   (lambda (i min-so-far)
                     (cond ((< i 0) -1)
                           ((> (vector-ref arr i) min-so-far) i)
                           (else (find-right (- i 1) (if (< (vector-ref arr i) min-so-far)
                                                          (vector-ref arr i)
                                                          min-so-far)))))))
          (let* ((left-result (find-left 1 (vector-ref arr 0)))
                 (right-result (find-right (- n 2) (vector-ref arr (- n 1))))
                 (l (if (>= left-result n) -1 left-result))
                 (r (if (< right-result 0) -1 right-result)))
            (if (or (= l -1) (= r -1))
                0
                (+ (- r l) 1)))))))

;; Convert list to vector (Aura has list->vector)
;; Actually let's implement it manually since list->vector may not exist.
;; Fallback: build vector using make-vector + set!
(define (list->vector xs)
  (let* ((n (list-len xs))
         (v (make-vector n 0)))
    (letrec ((fill (lambda (i rest)
                     (if (null? rest)
                         v
                         (begin
                           (vector-set! v i (car rest))
                           (fill (+ i 1) (cdr rest)))))))
      (fill 0 xs))))

;; Print a single integer result (already a number from solve)
(define (print-result i result)
  (display "CASE")
  (display (number->string i))
  (display "=")
  (display (number->string result))
  (newline))

;; Main: run all test cases
(begin
  (print-result 0 (solve (list 2 6 4 8 10 9 15)))
  (print-result 1 (solve (list 1 2 3 4)))
  (print-result 2 (solve (list 1)))
  (print-result 3 (solve (list 2 1)))
  (print-result 4 (solve (list 1 3 2 4)))
  (print-result 5 (solve (list 5 4 3 2 1)))
  (print-result 6 (solve (list 1 2 3 5 4)))
  (print-result 7 (solve (list -1 0 -2 -3)))
  )
