import heapq
from collections import Counter
import json

def solve(nums, k):
    if not nums or k == 0:
        return []
    
    lo = []  # max-heap (store negatives) - lower half
    hi = []  # min-heap - upper half
    delayed = Counter()
    
    def prune(heap):
        while heap:
            if isinstance(heap, list) and heap is lo:
                # max-heap stored as negatives
                key = -heap[0]
            else:
                key = heap[0]
            if delayed.get(key, 0) > 0:
                delayed[key] -= 1
                if delayed[key] == 0:
                    del delayed[key]
                heapq.heappop(heap)
            else:
                break
    
    def rebalance():
        # Ensure len(lo) >= len(hi) and len(lo) - len(hi) <= 1
        if len(lo) > len(hi) + 1:
            heapq.heappush(hi, -heapq.heappop(lo))
            prune(lo)
        elif len(lo) < len(hi):
            heapq.heappush(lo, -heapq.heappop(hi))
            prune(hi)
        prune(lo)
        prune(hi)
    
    result = []
    n = len(nums)
    
    for i in range(n):
        num = nums[i]
        # Insert
        if not lo or num <= -lo[0]:
            heapq.heappush(lo, -num)
        else:
            heapq.heappush(hi, num)
        
        # Remove outgoing element
        if i >= k:
            out = nums[i - k]
            delayed[out] = delayed.get(out, 0) + 1
        
        # Balance
        if len(lo) > len(hi) + 1:
            heapq.heappush(hi, -heapq.heappop(lo))
        elif len(lo) < len(hi):
            heapq.heappush(lo, -heapq.heappop(hi))
        
        prune(lo)
        prune(hi)
        
        if i >= k - 1:
            if k % 2 == 1:
                result.append(-lo[0])
            else:
                result.append(-lo[0] + hi[0])
    
    return result


CASES = [
    {"nums": [1, 3, -1, -3, 5, 3, 6, 7], "k": 3},
    {"nums": [1, 2, 3, 4, 5], "k": 1},
    {"nums": [1, 2, 3, 4, 5], "k": 5},
    {"nums": [1, 2, 3, 4, 5], "k": 2},
    {"nums": [2, 2, 2, 2], "k": 3},
    {"nums": [5, 4, 3, 2, 1], "k": 3},
    {"nums": [1], "k": 1},
    {"nums": [-1, -2, -3, -4, -5], "k": 2},
]


if __name__ == '__main__':
    out = []
    for i, c in enumerate(CASES):
        res = solve(c["nums"], c["k"])
        out.append({
            "id": i,
            "input": c,
            "expected": json.dumps(res, separators=(',', ':'), ensure_ascii=False)
        })
    print(json.dumps(out, separators=(',', ':'), ensure_ascii=False))
