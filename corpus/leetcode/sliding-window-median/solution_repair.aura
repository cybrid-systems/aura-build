(require "compat" all:)

;; Sorted list helpers
(define (sl-insert sl x)
  (let loop ((rest sl) (acc '()))
    (cond ((null? rest) (append (reverse acc) (list x)))
          ((<= x (car rest)) (append (reverse acc) (cons x rest)))
          (else (loop (cdr rest) (cons (car rest) acc))))))

(define (sl-remove-first sl x)
  (let loop ((rest sl))
    (cond ((null? rest) sl)
          ((= (car rest) x) (cdr rest))
          (else (cons (car rest) (loop (cdr rest)))))))

(define (list-last xs)
  (if (null? (cdr xs)) (car xs) (list-last (cdr xs))))

(define (list-init xs)
  (if (null? (cdr xs)) '()
      (cons (car xs) (list-init (cdr xs)))))

;; Delayed deletion alist
(define (al-get al key)
  (let loop ((al al))
    (cond ((null? al) 0)
          ((= (car (car al)) key) (cdr (car al)))
          (else (loop (cdr al))))))

(define (al-add al key delta)
  (let loop ((al al) (acc '()))
    (cond ((null? al)
           (if (= delta 0) (append (reverse acc) al)
               (append (reverse acc) (list (cons key delta)))))
          ((= (car (car al)) key)
           (let ((new-c (+ (cdr (car al)) delta)))
             (if (= new-c 0)
                 (append (reverse acc) (cdr al))
                 (append (reverse acc) (cons (cons key new-c) (cdr al))))))
          (else (loop (cdr al) (cons (car al) acc))))))

(define (solve nums k)
  (let* ((n (length nums))
         (low '())
         (high '())
         (delayed '())
         (result '())
         (odd? (= (modulo k 2) 1))
         (target-low (if odd? (+ (quotient k 2) 1) (quotient k 2)))
         (target-high (quotient k 2)))

    (define (prune-low)
      (let loop ()
        (if (and (not (null? low))
                 (> (al-get delayed (list-last low)) 0))
            (begin
              (set! delayed (al-add delayed (list-last low) -1))
              (set! low (list-init low))
              (loop))
            #t)))

    (define (prune-high)
      (let loop ()
        (if (and (not (null? high))
                 (> (al-get delayed (car high)) 0))
            (begin
              (set! delayed (al-add delayed (car high) -1))
              (set! high (cdr high))
              (loop))
            #t)))

    (define (rebalance)
      ;; Move from high to low if low too small
      (let loop ()
        (cond
          ((< (length low) target-low)
           (prune-high)
           (if (null? high) (begin #t)
               (let ((v (car high)))
                 (set! high (cdr high))
                 (set! low (sl-insert low v))
                 (loop))))
          ((> (length low) target-low)
           (prune-low)
           (let ((v (list-last low)))
             (set! low (list-init low))
             (set! high (sl-insert high v))
             (loop)))
          (else #t))))

    (let loop ((i 0))
      (cond ((>= i n)
             (reverse result))
            (else
             (let ((x (list-ref nums i)))
               (if (or (null? low) (<= x (list-last low)))
                   (set! low (sl-insert low x))
                   (set! high (sl-insert high x)))
               (rebalance)
               (if (>= i (- k 1))
                   (begin
                     (prune-low)
                     (prune-high)
                     (let ((m (if odd?
                                  (list-last low)
                                  (+ (list-last low) (car high)))))
                       (set! result (cons m result))
                       ;; Remove outgoing element nums[i-k+1]
                       (let ((out (list-ref nums (- i (- k 1)))))
                         (set! delayed (al-add delayed out 1))
                         (prune-low)
                         (prune-high)
                         (rebalance)))
                       #t))
               (loop (+ i 1))))))))
