(define (stack-push s x) (cons x s))
(define (stack-pop s) (cdr s))
(define (stack-top s) (car s))
(define (stack-empty? s) (null? s))

(define (transfer in out)
  (if (stack-empty? in)
      out
      (transfer (stack-pop in) (stack-push out (stack-top in)))))

(define (ensure-out! q)
  (let ((in (car q)) (out (cdr q)))
    (if (stack-empty? out)
        (cons in (transfer in out))
        q)))

(define (enqueue q x)
  (let ((in (car q)) (out (cdr q)))
    (cons (stack-push in x) out)))

(define (dequeue q)
  (let ((q2 (ensure-out! q)))
    (let ((in (car q2)) (out (cdr q2)))
      (cons in (list (stack-pop out) (stack-top out))))))

(define (peek q)
  (let ((q2 (ensure-out! q)))
    (stack-top (cdr q2))))

(define (empty? q)
  (and (stack-empty? (car q)) (stack-empty? (cdr q))))

;; Split a string on a character (returns list of strings)
(define (split-str s ch)
  (let ((len (string-length s)))
    (let loop ((i 0) (start 0) (acc '()))
      (if (= i len)
          (reverse (cons (substring s start i) acc))
          (if (char=? (string-ref s i) ch)
              (loop (+ i 1) (+ i 1) (cons (substring s start i) acc))
              (loop (+ i 1) start acc))))))

(define (trim s)
  (let ((len (string-length s)))
    (let loop ((i 0))
      (cond ((= i len) "")
            ((char-whitespace? (string-ref s i)) (loop (+ i 1)))
            (else
             (let loop2 ((j len))
               (cond ((= j i) (substring s i j))
                     ((char-whitespace? (string-ref s (- j 1))) (loop2 (- j 1)))
                     (else (substring s i j)))))))))

(define (split-lines s)
  (split-str s #\newline))

(define (parse-int s)
  (let ((len (string-length s)))
    (if (= len 0) 0
            (let loop ((i 0) (neg #f) (start 0))
              (cond ((= i len) 0)
                    ((char=? (string-ref s i) #\-)
                     (loop (+ i 1) #t (+ i 1)))
                    (else
                     (let loop2 ((j i) (acc 0))
                       (if (= j len) acc
                           (loop2 (+ j 1) (+ (* acc 10) (- (char->integer (string-ref s j)) (char->integer #\0))))))))))))

(define (bool->str b) (if b "TRUE" "FALSE"))

(define (process-commands lines)
  (let loop ((ls lines) (q (cons '() '())))
    (if (null? ls)
        '()
        (let* ((line (trim (car ls)))
               (parts (split-str line #\space))
               (cmd (if (null? parts) "" (car parts))))
          (cond ((string=? cmd "ENQUEUE")
                 (let ((arg (if (null? (cdr parts)) "" (cadr parts))))
                   (loop (cdr ls) (enqueue q (parse-int arg)))))
                ((string=? cmd "DEQUEUE")
                 (let ((q2 (ensure-out! q)))
                   (if (stack-empty? (cdr q2))
                       (cons "ERROR" (loop (cdr ls) q2))
                       (let ((out (cdr q2)))
                         (cons (number->string (stack-top out))
                               (loop (cdr ls) (cons (car q2) (stack-pop out))))))))
                ((string=? cmd "PEEK")
                 (let ((q2 (ensure-out! q)))
                   (if (stack-empty? (cdr q2))
                       (cons "ERROR" (loop (cdr ls) q2))
                       (cons (number->string (stack-top (cdr q2))) (loop (cdr ls) q)))))
                ((string=? cmd "EMPTY")
                 (cons (bool->str (empty? q)) (loop (cdr ls) q)))
                (else (loop (cdr ls) q)))))))

(define (print-results results)
  (let loop ((rs results) (first #t))
    (cond ((null? rs) (newline))
          (else
           (if first (display "CASE0=") (begin (display "CASE0=") #f))
           (display (car rs))
           (newline)
           (loop (cdr rs) #f)))))

(define (solve input)
  (let* ((lines (split-lines input))
         (results (process-commands lines)))
    results))

;; For each test case, call solve and print result
(define (run-case i input)
  (let ((results (solve input)))
    (display (string-append "CASE" (number->string i)))
    (display "=")
    (display (car results))
    (newline)))

(run-case 0 "ENQUEUE 1\nENQUEUE 2\nENQUEUE 3\nDEQUEUE\nPEEK\nEMPTY\n")
(run-case 1 "DEQUEUE\nPEEK\nEMPTY\n")
(run-case 2 "ENQUEUE 10\nENQUEUE 20\nENQUEUE 30\nENQUEUE 40\nDEQUEUE\nDEQUEUE\nDEQUEUE\nDEQUEUE\nDEQUEUE\n")
(run-case 3 "ENQUEUE 5\nENQUEUE 6\nPEEK\nDEQUEUE\nENQUEUE 7\nPEEK\nDEQUEUE\nDEQUEUE\nEMPTY\n")
(run-case 4 "ENQUEUE 1\nDEQUEUE\nENQUEUE 2\nENQUEUE 3\nPEEK\nEMPTY\nDEQUEUE\nDEQUEUE\nDEQUEUE\n")
(run-case 5 "ENQUEUE 100\nENQUEUE 200\nDEQUEUE\nENQUEUE 300\nPEEK\nDEQUEUE\nPEEK\nDEQUEUE\nDEQUEUE\nEMPTY\n")
(run-case 6 "")
(run-case 7 "ENQUEUE -1\nENQUEUE -2\nENQUEUE -3\nDEQUEUE\nDEQUEUE\nDEQUEUE\nDEQUEUE\nEMPTY\n")
