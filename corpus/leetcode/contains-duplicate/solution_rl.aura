(require "lc_json" all:)
(require "compat" all:)
(define (make-set) '())
(define (set-contains? s x)
  (cond ((null? s) #f)
        ((equal? (car (car s)) x) #t)
        (else (set-contains? (cdr s) x))))
(define (set-add s x) (cons (cons x #t) s))
(define (contains-dup-helper nums seen)
  (cond ((null? nums)
         #f)
        ((set-contains? seen (car nums))
         #t)
        (else
         (contains-dup-helper (cdr nums)
                              (set-add seen (car nums))))))
(define (solve nums)
  (contains-dup-helper nums (make-set)))
(define (display-bool b)
  (display (if b "#t" "#f"))
  (newline))
(define (range-list n)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        acc
        (loop (+ i 1) (cons i acc)))))
(define big-input (range-list 10000))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/contains-duplicate/tests.json")))
