;; Contains Duplicate - O(n) using a real hash table
(require "compat" all:)

(define (solve nums)
  (let ((seen (make-hash)))
    (let loop ((ns nums))
      (cond ((null? ns) #f)
            ((hash-has-key? seen (car ns)) #t)
            (else
             (hash-set! seen (car ns) #t)
             (loop (cdr ns)))))))

;; Helper to display a boolean as #t/#f
(define (display-bool b)
  (display (if b "#t" "#f"))
  (newline))

;; --- Test cases ---

(display "CASE0=")
(display-bool (solve (list 1 2 3 1)))

(display "CASE1=")
(display-bool (solve (list 1 2 3 4)))

(display "CASE2=")
(display-bool (solve (list 1 1 1 3 3 4 5 2 2)))

(display "CASE3=")
(display-bool (solve (list 1)))

(display "CASE4=")
(display-bool (solve (list 0 0)))

(display "CASE5=")
(display-bool (solve (list -1 -2 -3 -1)))

(display "CASE6=")
(display-bool (solve (list 5 4 3 2 1)))

;; CASE7: list of 0..9999 -> no duplicates, should return #f
(define (range-list n)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        acc
        (loop (+ i 1) (cons i acc)))))

(define big-input (range-list 10000))

(display "CASE7=")
(display-bool (solve big-input))
