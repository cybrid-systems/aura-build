(define (fizzbuzz i n)
  (if (> i n)
      '()
      (let ((s (cond ((and (= (modulo i 3) 0) (= (modulo i 5) 0)) "FizzBuzz")
                     ((= (modulo i 3) 0) "Fizz")
                     ((= (modulo i 5) 0) "Buzz")
                     (else (number->string i)))))
        (cons s (fizzbuzz (+ i 1) n)))))

(define (solve n)
  (fizzbuzz 1 n))

(define (print-list lst)
  (if (null? lst)
      '()
      (begin
        (display (car lst))
        (newline)
        (print-list (cdr lst)))))

(define (run-case n)
  (let ((result (solve n)))
    (display "CASE_OUT=")
    (newline)
    (print-list result)))

(run-case 1)
(run-case 3)
(run-case 5)
(run-case 15)
(run-case 30)
(run-case 0)
(run-case 100)
(run-case 7)
