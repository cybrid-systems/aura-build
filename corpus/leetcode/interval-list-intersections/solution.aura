(define (car-pair p) (car p))
(define (cdr-pair p) (cdr p))
(define (caar p) (car (car p)))
(define (cadr p) (car (cdr p)))
(define (cdar p) (cdr (car p)))
(define (cddr p) (cdr (cdr p)))
(define (caddr p) (car (cdr (cdr p))))
(define (cdddr p) (cdr (cdr (cdr p))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) (- i 1))))

(define (parse-interval s)
  (let ((rest s))
    (define (split space-str)
      (let ((len (string-length space-str)))
        (define (find-space idx)
          (cond ((= idx len) idx)
                ((char=? (string-ref space-str idx) #\space) idx)
                (else (find-space (+ idx 1)))))
        (let ((pos (find-space 0)))
          (list (substring space-str 0 pos)
                (substring space-str (+ pos 1) len)))))
    (let ((parts (split rest)))
      (list (string->number (car parts))
            (string->number (car (cdr parts)))))))

(define (parse-interval-list lst)
  (if (null? lst) '()
      (cons (parse-interval (car lst))
            (parse-interval-list (cdr lst)))))

(define (end-of iv) (cadr iv))
(define (start-of iv) (car iv))

(define (max a b) (if (> a b) a b))
(define (min a b) (if (< a b) a b))

(define (intersect a b)
  (let ((s (max (start-of a) (start-of b)))
        (e (min (end-of a) (end-of b))))
    (if (<= s e) (list s e) '())))

(define (merge-into result iv)
  (cond ((null? result) (list iv))
        (else
         (let ((last-iv (car result))
               (rest-res (cdr result)))
           (if (<= (end-of last-iv) (start-of iv))
               (cons iv result)
               (cons (list (start-of last-iv) (max (end-of last-iv) (end-of iv)))
                     rest-res))))))

(define (intersections a b)
  (let ((la (length a)) (lb (length b)))
    (define (loop i j acc)
      (cond ((or (>= i la) (>= j lb)) acc)
            (else
             (let ((iv-a (list-ref a i))
                   (iv-b (list-ref b j))
                   (inter (intersect (list-ref a i) (list-ref b j))))
               (let ((new-acc (if (null? inter) acc (merge-into acc inter))))
                 (if (< (end-of iv-a) (end-of iv-b))
                     (loop (+ i 1) j new-acc)
                     (loop i (+ j 1) new-acc)))))))
    (reverse (loop 0 0 '()))))

(define (solve a b)
  (intersections (parse-interval-list a) (parse-interval-list b)))

(define (display-list lst)
  (display "[")
  (cond ((null? lst) (display "]"))
        (else
         (display (car lst))
         (display " ")
         (display-list (cdr lst)))))

(define (display-vector lst)
  (display "[")
  (cond ((null? lst) (display "]"))
        (else
         (display-list (car lst))
         (display "]")
         (let ((rest (cdr lst)))
           (if (null? rest) (display "")
               (begin (display " ")
                      (display-vector rest)))))))

(define (display-result v)
  (display "[")
  (cond ((null? v) (display "]"))
        (else
         (display (car (car v)))
         (display " ")
         (display (car (cdr (car v))))
         (display "]")
         (let ((rest (cdr v)))
           (if (null? rest) (display "")
               (begin (display " ")
                      (display-result rest)))))))

(display "CASE0=") (display-result (solve '() '())) (newline)
(display "CASE1=") (display-result (solve '("0 0") '("0 0"))) (newline)
(display "CASE2=") (display-result (solve '("0 5") '("3 8"))) (newline)
(display "CASE3=") (display-result (solve '("0 2" "5 10" "13 23" "24 25") '("1 5" "8 12" "15 24" "25 26"))) (newline)
(display "CASE4=") (display-result (solve '("1 2" "3 4") '("2 3"))) (newline)
(display "CASE5=") (display-result (solve '("0 5" "7 10") '("5 7"))) (newline)
(display "CASE6=") (display-result (solve '("0 10") '("2 5" "11 12"))) (newline)
(display "CASE7=") (display-result (solve '("1 3" "5 7" "9 11") '("2 4" "6 8" "10 12"))) (newline)
