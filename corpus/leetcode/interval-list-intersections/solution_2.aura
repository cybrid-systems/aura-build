;; Helper: parse "start end" string into (start . end) pair
(define (parse-interval s)
  (let ((sp (string-split s #\space)))
    (cons (string->number (car sp)) (string->number (cadr sp)))))

(define (string-split s ch)
  (let ((len (string-length s)))
    (define (loop i acc start)
      (cond ((= i len)
             (reverse (cons (substring s start i) acc)))
            ((char=? (string-ref s i) ch)
             (loop (+ i 1) (cons (substring s start i) acc) (+ i 1)))
            (else (loop (+ i 1) acc start))))
    (loop 0 '() 0)))

(define (string-ref s i) (substring s i (+ i 1)))

;; Solve: two-pointer intersection with merging of touching intervals
(define (solve a b)
  (let ((na (length a)) (mb (length b)))
    (define (intersect p q)
      (let ((ps (car p)) (pe (cdr p))
            (qs (car q)) (qe (cdr q)))
        (cons (max ps qs) (min pe qe))))
    (define (overlap? p q)
      (let ((ps (car p)) (pe (cdr p))
            (qs (car q)) (qe (cdr q)))
        (and (<= ps qe) (<= qs pe))))
    (define (loopy i j result)
      (cond
        ((or (= i na) (= j mb))
         (merge-result result))
        (else
         (let ((pa (list-ref a i)) (pb (list-ref b j)))
           (cond
             ((overlap? pa pb)
              (let ((inter (intersect pa pb)))
                (cond
                  ((< (cdr pa) (cdr pb))
                   (loopy (+ i 1) j (cons inter result)))
                  ((> (cdr pa) (cdr pb))
                   (loopy i (+ j 1) (cons inter result)))
                  (else
                   (loopy (+ i 1) (+ j 1) (cons inter result))))))
             ((< (cdr pa) (cdr pb))
              (loopy (+ i 1) j result))
             (else
              (loopy i (+ j 1) result)))))))
    (loopy 0 0 '())))

;; Merge touching/overlapping intersections
(define (merge-result lst)
  (let ((rev (reverse lst)))
    (if (null? rev) '()
        (let ((first (car rev)) (rest (cdr rev)))
          (define (merge-all current remaining acc)
            (cond
              ((null? remaining)
               (reverse (cons current acc)))
              (else
               (let ((next (car remaining)) (rst (cdr remaining)))
                 (if (<= (car next) (+ (cdr current) 0))
                     (merge-all (cons (car current) (max (cdr current) (cdr next))) rst acc)
                     (merge-all next rst (cons current acc)))))))
          (merge-all first rest '())))))

;; Display vector as [[a b] [c d] ...]
(define (display-pair p)
  (begin
    (display "[")
    (display (car p))
    (display " ")
    (display (cdr p))
    (display "]")))

(define (display-list-of-pairs lst)
  (display "[")
  (cond ((null? lst) (display ""))
        (else
         (display-pair (car lst))
         (define (dloop rest)
           (cond ((null? rest) (display ""))
                 (else
                  (display " ")
                  (display-pair (car rest))
                  (dloop (cdr rest)))))
         (dloop (cdr lst))))
  (display "]"))

;; Test cases
(define (run-case a-strs b-strs)
  (let ((a (map parse-interval a-strs))
        (b (map parse-interval b-strs)))
    (display-list-of-pairs (solve a b))))

(begin
  (display "CASE0=") (run-case '() '()) (newline)
  (display "CASE1=") (run-case '("0 0") '("0 0")) (newline)
  (display "CASE2=") (run-case '("0 5") '("3 8")) (newline)
  (display "CASE3=") (run-case '("0 2" "5 10" "13 23" "24 25") '("1 5" "8 12" "15 24" "25 26")) (newline)
  (display "CASE4=") (run-case '("1 2" "3 4") '("2 3")) (newline)
  (display "CASE5=") (run-case '("0 5" "7 10") '("5 7")) (newline)
  (display "CASE6=") (run-case '("0 10") '("2 5" "11 12")) (newline)
  (display "CASE7=") (run-case '("1 3" "5 7" "9 11") '("2 4" "6 8" "10 12")) (newline))
