(require "lc_json" all:)
(require "compat" all:)
(define (make-node v n) (cons v n))
(define (node-val n) (car n))
(define (node-next n) (cdr n))
(define (set-next! n v) (set-cdr! n v))
(define (build-list lst)
  (if (null? lst) '()
      (let ((rest (build-list (cdr lst))))
        (cons (cons (car lst) rest) '()))))
(define (vals n)
  (if (null? n) '()
      (cons (car n) (vals (cdr n)))))
(define (solve head m n)
  (let ((dummy (cons 0 head))
        (count 0))
    (let ((pre dummy)
          (cur head))
      ;; advance to node at position m-1 (pre) and position m (cur)
      (begin
        (set! count (- m 1))
        (let loop ((c count) (p dummy) (cv head))
          (if (= c 0) (begin (set! pre p) (set! cur cv))
              (loop (- c 1) cv (node-next cv)))))
      ;; now pre points to node just before m, cur points to m
      ;; Reverse the segment from cur to position n
      (let loop1 ((prev cur) (curr (node-next cur)) (k (- n m)))
        (if (= k 0)
            (begin
              ;; attach reversed segment
              (set-next! pre prev)
              ;; attach tail of reversed segment
              (set-next! prev curr)
              (cdr dummy))
            (loop1 curr (node-next curr) (- k 1)))))))
(define cases
  (list
    (list (build-list (list 1 2 3 4 5)) 2 4)
    (list (build-list (list 1 2 3 4 5)) 1 5)
    (list (build-list (list 5)) 1 1)
    (list (build-list (list 1 2 3 4 5)) 3 3)
    (list (build-list (list 1 2 3 4 5)) 1 1)
    (list (build-list (list 1 2 3 4 5)) 4 5)
    (list '() 1 1)
    (list (build-list (list 10 20 30 40 50 60 70)) 2 6)))
(define (print-list n)
  (display "(")
  (let loop ((node n) (first #t))
    (if (null? node)
        (display ")")
        (begin
          (if first (set! first #f) (begin (display ",") (display " ")))
          (display (car node))
          (loop (cdr node) #f)))))
(define (run-cases cs i)
  (if (null? cs) '()
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (print-list (vals (solve (car (car cs)) (car (cdr (car cs))) (car (cdr (cdr (car cs)))))))
        (newline)
        (run-cases (cdr cs) (+ i 1)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "head") (hash-ref input "m") (hash-ref input "n")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/reverse-linked-list-ii/tests.json")))
