;; Set Matrix Zeroes in O(1) space
;; matrix is a flat list, we return a flat list

(define (nth lst i)
  (if (= i 0)
      (car lst)
      (nth (cdr lst) (- i 1))))

(define (set-nth lst i v)
  (if (= i 0)
      (cons v (cdr lst))
      (cons (car lst) (set-nth (cdr lst) (- i 1) v))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

(define (ref mat m n i j)
  (nth mat (+ (* i n) j)))

(define (mut! mat m n i j v)
  (set! mat (set-nth mat (+ (* i n) j) v)))

;; Check if any zero in first column (column 0)
(define (col-has-zero? mat m n)
  (define (loop i)
    (cond
      ((>= i m) #f)
      ((= (ref mat m n i 0) 0) #t)
      (else (loop (+ i 1)))))
  (loop 0))

;; Check if any zero in first row (row 0)
(define (row-has-zero? mat m n)
  (define (loop j)
    (cond
      ((>= j n) #f)
      ((= (ref mat m n 0 j) 0) #t)
      (else (loop (+ j 1)))))
  (loop 0))

;; Mark first row/column based on zeros (skip top-left)
(define (mark! mat m n)
  (define (loopi i)
    (if (>= i m) mat
        (let ((jloop (lambda (j)
                       (if (>= j n) #f
                           (begin
                             (if (= (ref mat m n i j) 0)
                                 (begin
                                   (set! mat (set-nth mat (* i n) 0))
                                   (set! mat (set-nth mat j 0))))
                             (jloop (+ j 1)))))))
          (jloop 1)
          (loopi (+ i 1)))))
  (loopi 1))

;; Zero out cells based on markers in row 0 and column 0
(define (zero-based-on-markers! mat m n)
  (define (loopi i)
    (if (>= i m) mat
        (let ((jloop (lambda (j)
                       (if (>= j n) #f
                           (begin
                             (if (and (not (= i 0)) (not (= j 0)) (= (ref mat m n i 0) 0))
                                 (set! mat (set-nth mat (+ (* i n) j) 0)))
                             (if (and (not (= i 0)) (not (= j 0)) (= (ref mat m n 0 j) 0))
                                 (set! mat (set-nth mat (+ (* i n) j) 0)))
                             (jloop (+ j 1)))))))
          (jloop 1)
          (loopi (+ i 1)))))
  (loopi 1))

;; Zero first column if needed
(define (maybe-zero-first-col! mat m n first-col-zero)
  (if first-col-zero
      (let ((loopi (lambda (i)
                     (if (>= i m) #f
                         (begin
                           (set! mat (set-nth mat (* i n) 0))
                           (loopi (+ i 1)))))))
        (loopi 0)
        mat)
      mat))

;; Zero first row if needed
(define (maybe-zero-first-row! mat m n first-row-zero)
  (if first-row-zero
      (let ((loopj (lambda (j)
                     (if (>= j n) #f
                         (begin
                           (set! mat (set-nth mat j 0))
                           (loopj (+ j 1)))))))
        (loopj 0)
        mat)
      mat))

(define (solve mat m n)
  (let ((fc (col-has-zero? mat m n))
        (fr (row-has-zero? mat m n)))
    (begin
      (set! mat (mark! mat m n))
      (set! mat (zero-based-on-markers! mat m n))
      (set! mat (maybe-zero-first-col! mat m n fc))
      (set! mat (maybe-zero-first-row! mat m n fr))
      mat)))

;; Display a flat list as [a,b,c,...]
(define (display-list lst)
  (display "[")
  (let ((loop (lambda (l first?)
                (cond
                  ((null? l) (display "]"))
                  (else
                   (if (not first?) (display ","))
                   (display (car l))
                   (loop (cdr l) #f))))))
    (loop lst #t)))

;; --- Test cases ---
(display "CASE0=") (display-list (solve (list 1 2 3 4 0 6 7 8 9 10 11 12) 3 4)) (newline)
(display "CASE1=") (display-list (solve (list 0 1 2 3) 1 4)) (newline)
(display "CASE2=") (display-list (solve (list 1 2 3 4) 4 1)) (newline)
(display "CASE3=") (display-list (solve (list 1 2 3 4 5 6 7 8 9) 3 3)) (newline)
(display "CASE4=") (display-list (solve (list 0 0 0 0) 2 2)) (newline)
(display "CASE5=") (display-list (solve (list 1 0) 1 2)) (newline)
(display "CASE6=") (display-list (solve (list 1 0 3 4 5 6) 2 3)) (newline)
(display "CASE7=") (display-list (solve (list 1) 1 1)) (newline)
