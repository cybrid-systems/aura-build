(define (list-length xs)
  (if (null? xs) 0 (+ 1 (list-length (cdr xs)))))

(define (list-ref xs i)
  (if (= i 0)
      (car xs)
      (list-ref (cdr xs) (- i 1))))

(define (search-insert nums target)
  (let ((n (list-length nums)))
    (let loop ((lo 0) (hi n))
      (if (>= lo hi)
          lo
          (let ((mid (quotient (+ lo hi) 2)))
            (let ((mv (list-ref nums mid)))
              (if (= mv target)
                  mid
                  (if (< mv target)
                      (loop (+ mid 1) hi)
                      (loop lo mid))))))))

(define (solve nums target)
  (search-insert nums target))

(define (run-case i nums target)
  (display "CASE")
  (display (number->string i))
  (display "=")
  (display (number->string (solve nums target)))
  (newline))

(run-case 0 (list 1 3 5 6) 5)
(run-case 1 (list 1 3 5 6) 2)
(run-case 2 (list 1 3 5 6) 7)
(run-case 3 (list 1 3 5 6) 0)
(run-case 4 (list 1) 0)
(run-case 5 (list 1) 1)
(run-case 6 (list 1) 2)
(run-case 7 '() 0)
