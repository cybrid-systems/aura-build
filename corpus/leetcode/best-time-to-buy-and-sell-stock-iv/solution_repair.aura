(require "compat" all:)

(define (list-length xs)
  (if (null? xs) 0 (+ 1 (list-length (cdr xs)))))

(define (list-ref xs i)
  (if (= i 0) (car xs) (list-ref (cdr xs) (- i 1))))

(define (reverse xs)
  (let loop ((xs xs) (acc '()))
    (if (null? xs) acc (loop (cdr xs) (cons (car xs) acc)))))

(define (max a b) (if (> a b) a b))

(define (make-vec n fill)
  (let loop ((i 0) (acc '()))
    (if (>= i n) (reverse acc)
        (loop (+ i 1) (cons fill acc)))))

(define (vec-ref v i) (list-ref v i))
(define (vec-set v i val)
  (let loop ((j 0) (xs v) (acc '()))
    (cond ((null? xs) (reverse acc))
          ((= j i) (loop (+ j 1) (cdr xs) (cons val acc)))
          (else (loop (+ j 1) (cdr xs) (cons (car xs) acc))))))

;; Greedy: sum positive diffs for unlimited transactions
(define (unlimited-profit prices n)
  (let loop ((i 1) (profit 0))
    (if (>= i n) profit
        (let ((cur (list-ref prices i))
              (prev (list-ref prices (- i 1))))
          (loop (+ i 1) (if (> cur prev) (+ profit (- cur prev)) profit))))))

(define (solve prices k)
  (let ((n (list-length prices)))
    (cond
      ((or (= n 0) (= k 0)) 0)
      ((>= k (quotient n 2)) (unlimited-profit prices n))
      (else
       (let* ((k1 (+ k 1))
              ;; hold[j] = -prices[0] for j >= 1, hold[0] = -infinity
              ;; cash[j] = 0 for all j
              (neg-inf (- 0 (* 1000000 1000000)))
              (init-hold
               (let loop ((j 0) (acc '()))
                 (if (>= j k1) (reverse acc)
                     (if (= j 0)
                         (loop (+ j 1) (cons neg-inf acc))
                         (loop (+ j 1) (cons (- 0 (list-ref prices 0)) acc))))))
              (init-cash (make-vec k1 0)))
         (let day-loop ((i 1) (hold init-hold) (cash init-cash))
           (if (>= i n) (list-ref cash k)
               (let ((price (list-ref prices i)))
                 ;; First compute new-cash using previous day's hold
                 (let ((new-cash
                        (let loop ((j 0) (acc '()))
                          (if (>= j k1) (reverse acc)
                              (let ((cval (list-ref cash j))
                                    (hval (list-ref hold j)))
                                (loop (+ j 1)
                                      (cons (max cval (+ hval price)) acc)))))))
                   ;; Then compute new-hold: hold[j] uses previous day's cash[j-1]
                   ;; hold[0] stays as -infinity (can't hold with 0 transactions - but we set to -inf)
                   ;; Actually hold[j] = max(prev_hold[j], prev_cash[j] - price) for j >= 1
                   ;; For j=0: hold[0] = max(prev_hold[0], -price) - but with 0 transactions
                   ;; Standard: hold[j] = max(prev_hold[j], prev_cash[j] - price) for j in [0..k]
                   ;; where prev_cash[0] = 0 baseline... actually the standard formulation:
                   ;; hold[j] = max(prev_hold[j], prev_cash[j] - price) when j counts total transactions allowed
                   ;; With prev_cash[-1] = -inf for j=0
                   (let ((new-hold
                          (let loop ((j 0) (acc '()))
                            (if (>= j k1) (reverse acc)
                                (let* ((hval (list-ref hold j))
                                       (pc (if (= j 0) neg-inf (list-ref cash (- j 1)))))
                                  (loop (+ j 1)
                                        (cons (max hval (- pc price)) acc)))))))
                     (day-loop (+ i 1) new-hold new-cash)))))))))))

(define (run-case i prices k)
  (let ((result (solve prices k)))
    (display "CASE")
    (display i)
    (display "=")
    (display result)
    (newline)))

(let ((p0 (list 2 4 1 7 5 3 6 4)))
  (run-case 0 p0 2))
(let ((p1 (list 3 2 6 5 0 3)))
  (run-case 1 p1 2))
(let ((p2 (list 1 2 3 4 5)))
  (run-case 2 p2 2))
(run-case 3 '() 2)
(let ((p4 (list 1 2)))
  (run-case 4 p4 0))
(run-case 5 (list 1) 1)
(let ((p6 (list 1 5 2 8 3 9)))
  (run-case 6 p6 3))
(let ((p7 (list 5 4 3 2 1)))
  (run-case 7 p7 2))
(let ((p8 (list 1 2 4 2 5 7 2 4 9 0)))
  (run-case 8 p8 3))
