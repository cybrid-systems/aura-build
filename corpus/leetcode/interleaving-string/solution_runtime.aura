; soft_leetcode_runtime slug=interleaving-string path=llm
; materialize=proposed_source_fallback worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-40 hits=7/8
; baseline_hits=0/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(define (solve s1 s2 s3)
  (let* ((n1 (string-length s1))
         (n2 (string-length s2))
         (n3 (string-length s3)))
    (if (not (= (+ n1 n2) n3))
        #f
        (let* ((dp (make-vector (+ n1 1) #f))
               (row (make-vector (+ n2 1) #f)))
          (vector-set! dp 0 #t)
          (vector-set! row 0 #t)
          ;; initialize first row using s1
          (let loop-i ((i 1))
            (if (> i n1)
                #t
                (begin
                  (vector-set! row i
                    (and (vector-ref row (- i 1))
                         (char=? (string-ref s1 (- i 1))
                                 (string-ref s3 (- i 1)))))
                  (loop-i (+ i 1)))))
          ;; for each row j from 1..n2
          (let loop-j ((j 1))
            (if (> j n2)
                (vector-ref row n2)
                (begin
                  (vector-set! row 0
                    (and (vector-ref dp 0)
                         (char=? (string-ref s2 (- j 1))
                                 (string-ref s3 (- j 1)))))
                  (let loop-i ((i 1))
                    (if (> i n1)
                        #t
                        (begin
                          (let* ((c1 (and (vector-ref dp i)
                                          (char=? (string-ref s1 (- i 1))
                                                  (string-ref s3 (+ i j -1)))))
                                 (c2 (and (vector-ref row (- i 1))
                                          (char=? (string-ref s2 (- j 1))
                                                  (string-ref s3 (+ i j -1)))))
                                 (val (or c1 c2)))
                            (vector-set! row i val)
                            (vector-set! dp (- i 1) (vector-ref row (- i 1)))))
                          (loop-i (+ i 1))))
                  (vector-set! dp j (vector-ref row j))
                  (loop-j (+ j 1)))))))))

;; print CASE lines based on solve results for each embedded input
(let ((cases '(("aabcc" "dbbca" "aadbbcbcac")
               ("aabcc" "dbbca" "aadbbbaccc")
               ("" "" "")
               ("" "abc" "abc")
               ("" "abc" "ab")
               ("abc" "" "abc")
               ("a" "b" "ab")
               ("a" "b" "ba"))))
  (let loop ((k 0) (cs cases))
    (if (null? cs)
        'done
        (begin
          (let* ((c (car cs))
                 (s1 (list-ref c 0))
                 (s2 (list-ref c 1))
                 (s3 (list-ref c 2))
                 (r (solve s1 s2 s3))
                 (out (if r "true" "false")))
            (display (string-append "CASE" (number->string k) "="))
            (display out)
            (newline))
          (loop (+ k 1) (cdr cs))))))

