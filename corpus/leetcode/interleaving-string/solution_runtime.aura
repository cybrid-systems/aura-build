; soft_leetcode_runtime slug=interleaving-string path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-9 hits=7/8
; baseline_hits=5/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define solve
    (lambda (s1 s2 s3)
      (let ((n1 (string-length s1)))
        (let ((n2 (string-length s2)))
          (let ((n3 (string-length s3)))
            (if (not (=
                  (+
                    n1 n2) n3))
              #f
              (let ((dp (make-vector
                  (+
                    n2 1) #f)))
                (begin
                  (vector-set!
                    dp 0 #t)
                  (letrec ((loop-j (lambda (j)
                      (if (>
                          j n2)
                        #t
                        (begin
                          (vector-set!
                            dp j (and
                              (vector-ref
                                dp (-
                                  j 1)) (char=?
                                (string-ref
                                  s2 (-
                                    j 1)) (string-ref
                                  s3 (-
                                    j 1)))))
                          (loop-j (+
                              j 1)))))))
                    (loop-j 1))
                  (letrec ((loop-i (lambda (i)
                      (if (>
                          i n1)
                        (vector-ref
                          dp n2)
                        (begin
                          (vector-set!
                            dp 0 (and
                              (vector-ref
                                dp 0) (char=?
                                (string-ref
                                  s1 (-
                                    i 1)) (string-ref
                                  s3 (-
                                    i 1)))))
                          (letrec ((loop-j (lambda (j)
                              (if (>
                                  j n2)
                                #t
                                (begin
                                  (let ((from-s1 (and
                                      (vector-ref
                                        dp j) (char=?
                                        (string-ref
                                          s1 (-
                                            i 1)) (string-ref
                                          s3 (+
                                            i j -1))))))
                                    (let ((from-s2 (and
                                        (vector-ref
                                          dp (-
                                            j 1)) (char=?
                                          (string-ref
                                            s2 (-
                                              j 1)) (string-ref
                                            s3 (+
                                              i j -1))))))
                                      (let ((val (or
                                          from-s1 from-s2)))
                                        (vector-set!
                                          dp j val))))
                                  (loop-j (+
                                      j 1)))))))
                            (loop-j 1))
                          (loop-i (+
                              i 1)))))))
                    (loop-i 1))))))))))
  (let ((cases (quote (("aabcc"
          "dbbca" "aadbbcbcac")
        ("aabcc"
          "dbbca" "aadbbbaccc") (""
          "" "") (""
          "abc" "abc") (""
          "abc" "ab") ("abc"
          "" "abc") ("a"
          "b" "ab") ("a"
          "b" "ba")))))
    (letrec ((loop (lambda (k cs)
        (if (null? cs)
          (quote done)
          (begin
            (let ((c (car cs)))
              (let ((s1 (list-ref
                  c 0)))
                (let ((s2 (list-ref
                    c 1)))
                  (let ((s3 (list-ref
                      c 2)))
                    (let ((r (solve
                        s1 s2 s3)))
                      (let ((out (if r
                          "true"
                          "false")))
                        (begin
                          (display (string-append
                              "CASE" (number->string k) "="))
                          (display out)
                          (newline))))))))
            (loop
              (+
                k 1) (cdr cs)))))))
      (loop
        0 cases))))
