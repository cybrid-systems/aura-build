(define (str-len s)
  (let loop ((i 0) (s s))
    (if (null? s) i (loop (+ i 1) (cdr s)))))

(define (str-ref s i)
  (let loop ((i i) (s s))
    (if (= i 0) (car s) (loop (- i 1) (cdr s)))))

(define (make-list n val)
  (let loop ((i 0) (acc '()))
    (if (= i n) acc (loop (+ i 1) (cons val acc)))))

(define (list-set! lst i val)
  (let loop ((i i) (lst lst))
    (cond ((null? lst) '())
          ((= i 0) (set-car! lst val) lst)
          (else (loop (- i 1) (cdr lst)) (loop (- i 1) lst)))))

(define (dp-get dp i j m)
  (let loop ((j j) (row (list-ref dp i)))
    (if (= j 0) (car row) (loop (- j 1) (cdr row)))))

(define (dp-set! dp i j m val)
  (let ((row (list-ref dp i)))
    (list-set! row j val)))

(define (bool->string b)
  (if b "true" "false"))

(define (interleave s1 s2 s3)
  (let ((n1 (str-len s1))
        (n2 (str-len s2))
        (n3 (str-len s3)))
    (if (not (= (+ n1 n2) n3))
        #f
        (let ((m (+ n2 1))
              (dp (make-list (+ n1 1) (make-list (+ n2 1) #f))))
          (let ((row0 (list-ref dp 0)))
            (let loop ((j 0))
              (when (<= j n2)
                (let ((cur (dp-get dp 0 j m)))
                  (if (or (= j 0)
                          (and cur
                               (equal? (str-ref s2 (- j 1))
                                       (str-ref s3 (- j 1)))))
                      (dp-set! dp 0 j m #t)
                      (dp-set! dp 0 j m #f)))
                  (loop (+ j 1))))))
          (let loop-i ((i 1))
            (when (<= i n1)
              (let ((row (list-ref dp i)))
                (let loop-j ((j 0))
                  (when (<= j n2)
                    (let ((c1 (and (> i 0)
                                   (dp-get dp (- i 1) j m)
                                   (equal? (str-ref s1 (- i 1))
                                           (str-ref s3 (- (+ i j) 1)))))
                          (c2 (and (> j 0)
                                   (dp-get dp i (- j 1) m)
                                   (equal? (str-ref s2 (- j 1))
                                           (str-ref s3 (- (+ i j) 1))))))
                      (dp-set! dp i j m (or c1 c2)))
                    (loop-j (+ j 1)))))
              (loop-i (+ i 1))))
          (dp-get dp n1 n2 m)))))

(define (solve s1 s2 s3)
  (interleave s1 s2 s3))

(display "CASE0=") (display (bool->string (solve "aabcc" "dbbca" "aadbbcbcac"))) (newline)
(display "CASE1=") (display (bool->string (solve "aabcc" "dbbca" "aadbbbaccc"))) (newline)
(display "CASE2=") (display (bool->string (solve "" "" ""))) (newline)
(display "CASE3=") (display (bool->string (solve "" "abc" "abc"))) (newline)
(display "CASE4=") (display (bool->string (solve "" "abc" "ab"))) (newline)
(display "CASE5=") (display (bool->string (solve "abc" "" "abc"))) (newline)
(display "CASE6=") (display (bool->string (solve "a" "b" "ab"))) (newline)
(display "CASE7=") (display (bool->string (solve "a" "b" "ba"))) (newline)
