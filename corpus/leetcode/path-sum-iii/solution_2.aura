(define (make-tree arr)
  (let ((n (length arr)))
    (if (= n 0) '()
        (let* ((nodes (list->vector (build-list n (lambda (i) '()))))
               (build (lambda (i)
                        (if (>= i n) '()
                            (let ((v (list-ref arr i)))
                              (if (eqv? v 'null) '()
                                  (let ((node (list v '() '())))
                                    (vector-set! nodes i node)
                                    (set-car! (cdr node) (build (+ (* i 2) 1)))
                                    (set-car! (cddr node) (build (+ (* i 2) 2)))
                                    node)))))))
          (build 0)))))

(define (count-paths root target)
  (let ((count 0))
    (define (path-from node curr-sum)
      (if (eqv? node '()) '()
          (begin
            (set! count (+ count (if (= (+ curr-sum (car node)) target) 1 0)))
            (path-from (cadr node) (+ curr-sum (car node)))
            (path-from (caddr node) (+ curr-sum (car node))))))
    (define (dfs node)
      (if (eqv? node '()) '()
          (begin
            (path-from node 0)
            (dfs (cadr node))
            (dfs (caddr node)))))
    (dfs root)
    count))

(define (solve root target)
  (count-paths root target))

(define (parse-arr s)
  (let loop ((i 0) (acc '()))
    (cond
      ((>= i (string-length s)) (reverse acc))
      ((char=? (string-ref s i) #\space) (loop (+ i 1) acc))
      ((char=? (string-ref s i) #\[) (loop (+ i 1) acc))
      ((char=? (string-ref s i) #\]) (reverse acc))
      ((char=? (string-ref s i) #\,) (loop (+ i 1) acc))
      (else
        (let loop2 ((j i) (c (string-ref s i)))
          (cond
            ((>= j (string-length s)) (loop j (cons (substring s i j) acc)))
            ((or (char=? (string-ref s j) #\,) (char=? (string-ref s j) #\]))
             (loop (+ j 1) (cons (substring s i j) acc)))
            (else (loop2 (+ j 1) (string-ref s j)))))))))

(define (to-num s)
  (let ((n (string-length s)))
    (let loop ((i 0) (sign 1) (val 0))
      (cond
        ((>= i n) (* sign val))
        ((char=? (string-ref s i) #\-) (loop (+ i 1) -1 val))
        (else (loop (+ i 1) sign (+ (* val 10) (- (char->integer (string-ref s i)) (char->integer #\0)))))))))

(define (convert arr-str)
  (let ((tokens (parse-arr arr-str)))
    (map (lambda (t)
           (if (or (string=? t "null") (string=? t "None")) 'null (to-num t)))
         tokens)))

(define (run-case arr-str target-str)
  (let* ((arr (convert arr-str))
         (root (make-tree arr))
         (target (to-num target-str))
         (result (solve root target)))
    (display "CASE")
    (display result)
    (newline)))

(run-case "[]" "1")
(run-case "[0]" "0")
(run-case "[1,2,3,4,5,6,7]" "7")
(run-case "[1,-2,-3,1,3,-2,null,-1]" "1")
(run-case "[5,3,2,4,null,null,null,1]" "8")
(run-case "[1,2]" "0")
(run-case "[-1,-2,-3,-4,-5,-6,-7]" "-7")
(run-case "[10,5,-3,3,2,null,11,3,-2,null,1]" "8")
