(define (string-length s)
  (let loop ((i 0) (s s))
    (if (null? s) i (loop (+ i 1) (cdr s)))))

(define (string-ref s i)
  (if (= i 0) (car s) (string-ref (cdr s) (- i 1))))

(define (substring-from s i)
  (if (= i 0) s (substring-from (cdr s) (- i 1))))

(define (make-table m n)
  (let loop ((i 0) (rows '()))
    (if (= i m)
        rows
        (let loop2 ((j 0) (row '()))
          (if (= j n)
              (loop (+ i 1) (cons row rows))
              (loop2 (+ j 1) (cons #f row)))))))

(define (table-get t i j)
  (let loop ((rows t) (idx 0))
    (cond ((null? rows) #f)
          ((= idx i) (let loop2 ((row (car rows)) (jdx 0))
                       (cond ((null? row) #f)
                             ((= jdx j) (car row))
                             (else (loop2 (cdr row) (+ jdx 1))))))
          (else (loop (cdr rows) (+ idx 1))))))

(define (table-set! t i j v)
  (let loop ((rows t) (idx 0))
    (cond ((null? rows) #f)
          ((= idx i)
           (let loop2 ((row (car rows)) (jdx 0))
             (cond ((null? row) #f)
                   ((= jdx j) (set-car! row v) #t)
                   (else (loop2 (cdr row) (+ jdx 1))))))
          (else (loop (cdr rows) (+ idx 1))))))

(define (solve s p)
  (let* ((ls (string-length s))
         (lp (string-length p))
         (dp (make-table (+ ls 1) (+ lp 1))))
    (table-set! dp 0 0 #t)
    (let loop-j ((j 1))
      (if (<= j lp)
          (let ((pj (string-ref p (- j 1))))
            (when (and (> j 1) (char=? pj #\*))
              (table-set! dp 0 j (table-get dp 0 (- j 2))))
            (loop-j (+ j 1)))
          #f))
    (let loop-i ((i 1))
      (if (<= i ls)
          (begin
            (let loop-j2 ((j 1))
              (if (<= j lp)
                  (let ((pi (string-ref s (- i 1)))
                        (pj (string-ref p (- j 1))))
                    (if (char=? pj #\*)
                        (let ((prev (table-get dp i (- j 2)))
                              (curr (table-get dp (- i 1) j))
                              (prev-match
                               (let ((pp (string-ref p (- j 2))))
                                 (or (char=? pj pp)
                                     (char=? pp #\.)))))
                          (table-set! dp i j
                                      (or (and prev-match curr) prev)))
                        (let ((match (or (char=? pj pi) (char=? pj #\.))))
                          (table-set! dp i j
                                      (and match (table-get dp (- i 1) (- j 1))))))
                    (loop-j2 (+ j 1)))
                  #f))
            (loop-i (+ i 1)))
          #f)))
    (table-get dp ls lp)))

(define (char=? a b) (equal? a b))

(display "CASE0=") (display (solve "aa" "a")) (newline)
(display "CASE1=") (display (solve "aa" "a*")) (newline)
(display "CASE2=") (display (solve "ab" ".*")) (newline)
(display "CASE3=") (display (solve "aab" "c*a*b")) (newline)
(display "CASE4=") (display (solve "mississippi" "mis*is*p*.")) (newline)
(display "CASE5=") (display (solve "" "")) (newline)
(display "CASE6=") (display (solve "" "a*")) (newline)
(display "CASE7=") (display (solve "ab" ".*c")) (newline)
(display "CASE8=") (display (solve "aaa" "a*a")) (newline)
(display "CASE9=") (display (solve "a" "ab*")) (newline)
