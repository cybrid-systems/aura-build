(define (list-ref lst i)
  (if (= i 0) (car lst) (list-ref (cdr lst) i)))

(define (string-length s)
  (if (string=? s "") 0
      (+ 1 (string-length (substring s 1 (string-length s))))))

(define (char-at s i)
  (string-ith s i))

(define (digit->int c)
  (- (char->integer c) (char->integer #\0)))

(define (solve secret guess)
  (let* ((n (string-length secret))
         (bulls 0)
         (counts (make-vector 10 0))
         (guess-counts (make-vector 10 0))
         (i 0))
    (let loop ((bulls 0) (i 0))
      (if (= i n)
          (let loop2 ((cows 0) (d 0))
            (if (= d 10) cows
                (loop2 (+ cows (min (vector-ref counts d) (vector-ref guess-counts d)))
                       (+ d 1))))
          (let ((sc (char-at secret i))
                (gc (char-at guess i)))
            (if (char=? sc gc)
                (begin
                  (vector-set! counts (digit->int sc) (+ (vector-ref counts (digit->int sc)) 1))
                  (vector-set! guess-counts (digit->int gc) (+ (vector-ref guess-counts (digit->int gc)) 1))
                  (loop (+ bulls 1) (+ i 1)))
                (begin
                  (vector-set! counts (digit->int sc) (+ (vector-ref counts (digit->int sc)) 1))
                  (vector-set! guess-counts (digit->int gc) (+ (vector-ref guess-counts (digit->int gc)) 1))
                  (loop bulls (+ i 1)))))))))

(define (solve-final secret guess)
  (let* ((n (string-length secret))
         (bulls 0)
         (counts (make-vector 10 0))
         (guess-counts (make-vector 10 0))
         (i 0))
    (let loop ((bulls 0) (i 0))
      (if (= i n)
          (let ((cows 0) (d 0))
            (let cows-loop ((cows cows) (d 0))
              (if (= d 10) (cons bulls cows)
                  (cows-loop (+ cows (min (vector-ref counts d) (vector-ref guess-counts d)))
                             (+ d 1)))))
          (let ((sc (char-at secret i))
                (gc (char-at guess i)))
            (if (char=? sc gc)
                (begin
                  (vector-set! counts (digit->int sc) (+ (vector-ref counts (digit->int sc)) 1))
                  (vector-set! guess-counts (digit->int gc) (+ (vector-ref guess-counts (digit->int gc)) 1))
                  (loop (+ bulls 1) (+ i 1)))
                (begin
                  (vector-set! counts (digit->int sc) (+ (vector-ref counts (digit->int sc)) 1))
                  (vector-set! guess-counts (digit->int gc) (+ (vector-ref guess-counts (digit->int gc)) 1))
                  (loop bulls (+ i 1))))))))))

(define (print-pair p)
  (display "(")
  (display (car p))
  (display ",")
  (display (cdr p))
  (display ")"))

(define (run-case i secret guess)
  (display "CASE")
  (display i)
  (display "=")
  (print-pair (solve-final secret guess))
  (newline))

(run-case 0 "1807" "7810")
(run-case 1 "1123" "0111")
(run-case 2 "0123" "0123")
(run-case 3 "0000" "1111")
(run-case 4 "1234" "4321")
(run-case 5 "9999" "9999")
(run-case 6 "102030405060708090" "001122334455667788")
(run-case 7 "111111" "111111")
(run-case 8 "0123456789" "9876543210")
