(require "lc_json" all:)
(require "compat" all:)
(define (alnum? c)
  (let ((code (char->integer c)))
    (or (and (>= code 48) (<= code 57))   ;; 0-9
        (and (>= code 65) (<= code 90))   ;; A-Z
        (and (>= code 97) (<= code 122))  ;; a-z
        #f)))
(define (to-lower c)
  (let ((code (char->integer c)))
    (if (and (>= code 65) (<= code 90))
        (integer->char (+ code 32))
        c)))
(define (palin? lst)
  (letrec ((len (lambda (l) (if (null? l) 0 (+ 1 (len (cdr l))))))
           (rev-tail (lambda (l n)
                       (if (= n 0) l
                           (rev-tail (cdr l) (- n 1)))))
           (check (lambda (l r)
                    (cond
                      ((null? l) #t)
                      ((null? r) #t)
                      (else
                       (if (equal? (to-lower (car l)) (to-lower (car r)))
                           (check (cdr l) (cdr r))
                           #f))))))
    (let ((n (len lst)))
      (check lst (rev-tail lst (quotient n 2))))))
(define (normalize s)
  (letrec ((loop (lambda (acc rest)
                   (if (null? rest)
                       (reverse acc)
                       (let ((c (car rest)))
                         (if (alnum? c)
                             (loop (cons c acc) (cdr rest))
                             (loop acc (cdr rest))))))))
    (loop '() (string->list s))))
(define (solve s)
  (let ((chars (normalize s)))
    (palin? chars)))
(define (display-result i result)
  (display (string-append "CASE" (number->string i) "="))
  (display (if result "True" "False"))
  (newline))
(define (main)
  (display-result 0 (solve "A man, a plan, a canal: Panama"))
  (display-result 1 (solve "race a car"))
  (display-result 2 (solve " "))
  (display-result 3 (solve "0P"))
  (display-result 4 (solve ""))
  (display-result 5 (solve "abba"))
  (display-result 6 (solve "abc"))
  (display-result 7 (solve "Was it a car or a cat I saw?")))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "s")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/valid-palindrome/tests.json")))
