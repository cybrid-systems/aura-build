(define (climb n)
  (let loop ((i 2) (a 1) (b 1))
    (if (> i n)
        b
        (loop (+ i 1) b (+ a b)))))

(define (solve n)
  (climb n))

(display "CASE0=") (display (solve 1)) (newline)
(display "CASE1=") (display (solve 2)) (newline)
(display "CASE2=") (display (solve 3)) (newline)
(display "CASE3=") (display (solve 4)) (newline)
(display "CASE4=") (display (solve 5)) (newline)
(display "CASE5=") (display (solve 10)) (newline)
(display "CASE6=") (display (solve 44)) (newline)
(display "CASE7=") (display (solve 45)) (newline)
