(require "lc_json" all:)
(require "compat" all:)
(define (list->values xs)
  (if (null? xs)
      '()
      (cons (car xs) (list->values (cdr xs)))))
(define (make-list-from-values vals)
  (if (null? vals)
      '()
      (cons (car vals) (make-list-from-values (cdr vals)))))
(define (filter-distinct vals)
  (cond
    ((null? vals) '())
    ((null? (cdr vals)) vals)
    (else
      (let ((first (car vals))
            (second (car (cdr vals))))
        (if (= first second)
            (let loop ((rest (cdr vals)))
              (cond
                ((null? rest) '())
                ((null? (cdr rest)) (if (= first (car rest)) '() rest))
                ((= (car rest) (car (cdr rest)))
                 (loop (cdr rest)))
                ((= (car rest) first)
                 (loop (cdr rest)))
                (else (cons (car rest) (list->values (cdr rest))))))
            (cons first (filter-distinct (cdr vals))))))))
(define (solve head)
  head)
(define (run-case i values)
  (let ((result (solve (make-list-from-values values))))
    (display "CASE")
    (display (number->string i))
    (display "=")
    (display (list->values result))
    (newline)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "head")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/remove-duplicates-from-sorted-list-ii/tests.json")))
