(require "lc_json" all:)
(require "compat" all:)
(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))
(define (append-list a b)
  (if (null? a) b (cons (car a) (append-list (cdr a) b))))
(define (reverse-helper lst acc)
  (if (null? lst) acc (reverse-helper (cdr lst) (cons (car lst) acc))))
(define (reverse lst) (reverse-helper lst '()))
(define (list-eq? a b)
  (cond ((and (null? a) (null? b)) #t)
        ((or (null? a) (null? b)) #f)
        ((and (number? (car a)) (number? (car b)) (= (car a) (car b)))
         (list-eq? (cdr a) (cdr b)))
        (else #f)))
(define (set-eq? a b)
  (cond ((null? a)
         (cond ((null? b) #t) (else #f)))
        (else
         (let ((rest-result
                (set-eq? (cdr a)
                         (remove-first (car a) b))))
           rest-result))))
(define (remove-first x lst)
  (cond ((null? lst) '())
        ((= x (car lst)) (cdr lst))
        (else (cons (car lst) (remove-first x (cdr lst))))))
(define (subsets nums)
  (let ((n (length nums)))
    (let ((total (* n n)))
      (let ((total-sets (expt-helper 2 n 1)))
        (let ((rev (reverse nums)))
          (generate rev '() total-sets))))))
(define (expt-helper base exp acc)
  (if (= exp 0) acc (expt-helper base (- exp 1) (* base acc))))
(define (generate nums current total-sets)
  (let ((remaining (- total-sets (length current))))
    (if (= remaining 0)
        (cond ((null? nums) (cons current '()))
              (else (cons current '())))
        (cons current (generate (cdr nums) (cons (car nums) current) total-sets)))))
(define (solve nums)
  (let ((rev (reverse nums)))
    (backtrack rev '())))
(define (backtrack nums current)
  (cons current
        (if (null? nums)
            '()
            (append-list
              (backtrack (cdr nums) (cons (car nums) current))
              (backtrack (cdr nums) current)))))
(define (display-list lst)
  (cond ((null? lst) (display "()"))
        (else
         (display "(")
         (display-list-inner lst)
         (display ")"))))
(define (display-list-inner lst)
  (cond ((null? lst) (display ""))
        (else
         (display (car lst))
         (if (null? (cdr lst))
             (display "")
             (display " "))
         (display-list-inner (cdr lst)))))
(define (display-list-of-lists lst)
  (cond ((null? lst) (display "()"))
        (else
         (display "(")
         (display-fol-inner lst)
         (display ")"))))
(define (display-fol-inner lst)
  (cond ((null? lst) (display ""))
        (else
         (display-list (car lst))
         (if (null? (cdr lst))
             (display "")
             (display " "))
         (display-fol-inner (cdr lst)))))
(define result0 (solve '(1 2 3)))
(define result1 (solve '(0)))
(define result2 (solve '()))
(define result3 (solve '(1)))
(define result4 (solve '(1 2)))
(define result5 (solve '(1 2 3 4)))
(define result6 (solve '(-1 0 1)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/subsets/tests.json")))
