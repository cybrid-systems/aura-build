(define (member? x lst)
  (cond ((null? lst) #f)
        ((equal? (car lst) x) #t)
        (else (member? x (cdr lst)))))

(define (remove-dups lst)
  (cond ((null? lst) '())
        ((member? (car lst) (cdr lst))
         (remove-dups (cdr lst)))
        (else (cons (car lst) (remove-dups (cdr lst))))))

(define (solve a b)
  (remove-dups
    (cond ((null? a) '())
          ((member? (car a) b)
           (cons (car a) (solve (cdr a) b)))
          (else (solve (cdr a) b)))))

(define (print-list lst)
  (display "[")
  (cond ((null? lst) (display ""))
        (else (display (car lst))
              (let loop ((rest (cdr lst)))
                (cond ((null? rest) (display ""))
                        (else (display ", ")
                              (display (car rest))
                              (loop (cdr rest)))))))
  (display "]"))

(define (display-case i a b)
  (display "CASE")
  (display i)
  (display "=")
  (print-list (solve a b))
  (newline))

(display-case 0 '(1 2 2 3) '(2 3 4))
(display-case 1 '(1 2 3) '(4 5 6))
(display-case 2 '() '(1 2 3))
(display-case 3 '(1 1 1) '(1 2 3))
(display-case 4 '(-1 -2 -3) '(-2 -3 -4))
(display-case 5 '(1 2 3 4 5) '(3 4 5 6 7))
(display-case 6 '(0 0 0) '(0))
(display-case 7 '(1 2 3) '())
