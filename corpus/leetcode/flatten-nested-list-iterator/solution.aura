(define (tokenize s)
  (let ((len (string-length s)) (i 0) (toks '()))
    (define (peek)
      (if (>= i len) #\nul (string-ref s i)))
    (define (skip-comma)
      (when (and (< i len) (char=? (string-ref s i) #\,))
        (set! i (+ i 1))))
    (define (skip-bracket?)
      (cond ((>= i len) #f)
            ((or (char=? (string-ref s i) #\[) (char=? (string-ref s i) #\]))
             (set! i (+ i 1)) #t)
            (else #f)))
    (define (read-num)
      (let ((start i))
        (while (and (< i len)
                    (or (char-numeric? (string-ref s i))
                        (char=? (string-ref s i) #\-)))
          (set! i (+ i 1)))
        (let ((sub (substring s start i)))
          (set! toks (cons (string->number sub) toks)))))
    (define (char-numeric? c)
      (and (char>=? c #\0) (char<=? c #\9)))
    (while (< i len)
      (let ((c (string-ref s i)))
        (cond ((char=? c #\[) (skip-bracket?) (set! toks (cons 'open toks)))
              ((char=? c #\]) (skip-bracket?) (set! toks (cons 'close toks)))
              ((char=? c #\,) (skip-comma))
              ((or (char-numeric? c) (char=? c #\-))
               (read-num))
              (else (set! i (+ i 1))))))
    (reverse toks)))

(define (parse tokens)
  (define (parse-one)
    (let ((t (car tokens)))
      (set! tokens (cdr tokens))
      (if (eq? t 'open)
          (let ((elts '()))
            (while (not (eq? (car tokens) 'close))
              (set! elts (cons (parse-one) elts)))
            (set! tokens (cdr tokens))
            (cons 'list (reverse elts)))
          (cons 'num t))))
  (parse-one))

(define (flatten-help node out)
  (if (eq? (car node) 'num)
      (set! out (cons (cdr node) out))
      (let loop ((xs (cdr node)) (acc out))
        (if (null? xs) acc
            (loop (cdr xs) (flatten-help (car xs) acc))))))

(define (solve s)
  (let ((toks (tokenize s))
        (tokens (quote ())))
    (set! tokens toks)
    (let ((tree (parse tokens)))
      (let ((flat (reverse (flatten-help tree '()))))
        (define (iter rest)
          (if (null? rest)
              (begin (display "END") (newline))
              (begin (display (car rest)) (newline)
                     (iter (cdr rest)))))
        (iter flat)))))

(display "CASE0=") (display (solve "[[1,1],2,[1,1]]")) (newline)
(display "CASE1=") (display (solve "[]")) (newline)
(display "CASE2=") (display (solve "[1,2,3,4,5]")) (newline)
(display "CASE3=") (display (solve "[[],[],[]]")) (newline)
(display "CASE4=") (display (solve "[[1,[2,[3,[4,[5]]]]]]")) (newline)
(display "CASE5=") (display (solve "[1]")) (newline)
(display "CASE6=") (display (solve "[[],[1],[[[2]]]]")) (newline)
(display "CASE7=") (display (solve "[0,-7,42]")) (newline)
