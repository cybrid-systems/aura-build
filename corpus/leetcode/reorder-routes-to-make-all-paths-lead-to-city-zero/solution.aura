(define (solve n connections)
  (define adj '())
  (define (add-edge! a b cost)
    (set! adj (cons (cons a (cons b cost)) adj)))
  (define (build idx)
    (if (= idx (length connections))
        '()
        (let ((e (list-ref connections idx)))
          (let ((u (car e)) (v (cadr e)))
            (add-edge! u v 1)
            (add-edge! v u 0)
            (build (+ idx 1))))))
  (build 0)
  (let ((visited (make-vector n #f)))
    (define (dfs node)
      (vector-set! visited node #t)
      (let loop ((neighbors adj) (acc 0))
        (if (null? neighbors)
            acc
            (let ((nb (car neighbors)))
              (let ((nbr (car nb)) (cost (cdr nb)))
                (if (vector-ref visited nbr)
                    (loop (cdr neighbors) acc)
                    (+ cost (loop (cdr neighbors) (+ acc (dfs nbr))))))))))
    (dfs 0)))

(define (run-case i n conns)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n conns))
  (newline))

(run-case 0 5 '((1 0) (1 2) (2 3) (4 2)))
(run-case 1 4 '((1 0) (2 0) (3 2)))
(run-case 2 3 '((1 0) (2 0)))
(run-case 3 6 '((0 1) (1 2) (2 3) (3 4) (4 5)))
(run-case 4 6 '((5 4) (4 3) (3 2) (2 1) (1 0)))
(run-case 5 2 '((1 0)))
(run-case 6 2 '((0 1)))
(run-case 7 1 '())
