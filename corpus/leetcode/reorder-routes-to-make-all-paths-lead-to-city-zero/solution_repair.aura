(require "compat" all:)

(define (solve n connections)
  (if (= n 1)
      0
      (let ((adj (make-hash)))
        (define (put! key val)
          (hash-set! adj key (cons val (hash-ref adj key '()))))
        (define (add-edge! a b cost)
          (put! a (cons b cost)))
        (let loop ((idx 0) (cs connections))
          (if (null? cs)
              (begin)
              (let ((e (car cs)))
                (let ((u (car e)) (v (cadr e)))
                  (add-edge! u v 1)
                  (add-edge! v u 0)
                  (loop (+ idx 1) (cdr cs))))))
        (let ((visited (make-list n #f)))
          (define (dfs node)
            (list-set! visited node #t)
            (let loop ((neighbors (hash-ref adj node '())) (acc 0))
              (if (null? neighbors)
                  acc
                  (let ((nb (car neighbors)) (cost (cdr neighbors)))
                    (if (list-ref visited nb)
                        (loop (cdr nb) acc)
                        (let ((child-cost (+ cost (dfs nb))))
                          (+ acc child-cost)))))))
          (dfs 0)))))

(define (run-case i n conns)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve n conns))
  (newline))

(run-case 0 5 '((1 0) (1 2) (2 3) (4 2)))
(run-case 1 4 '((1 0) (2 0) (3 2)))
(run-case 2 3 '((1 0) (2 0)))
(run-case 3 6 '((0 1) (1 2) (2 3) (3 4) (4 5)))
(run-case 4 6 '((5 4) (4 3) (3 2) (2 1) (1 0)))
(run-case 5 2 '((1 0)))
(run-case 6 2 '((0 1)))
(run-case 7 1 '())
