(require "lc_json" all:)
(require "compat" all:)
(define (make-adj n connections)
  (let ((adj (make-list n '())))
    (define (loop conns)
      (if (null? conns)
          '()
          (let ((edge (car conns))
                (rest (cdr conns)))
            (let ((u (car edge))
                  (v (car (cdr edge))))
              (set! adj (list-set adj u (cons (list v u v) (list-ref adj u))))
              (set! adj (list-set adj v (cons (list u u v) (list-ref adj v))))
              (loop rest)))))
    (loop connections)
    adj))
(define (list-set lst i val)
  (let ((len (length lst)))
    (let loop ((j 0) (acc '()) (l lst))
      (if (= j len)
          (reverse acc)
          (if (= j i)
              (loop (+ j 1) (cons val acc) (cdr l))
              (loop (+ j 1) (cons (car l) acc) (cdr l)))))))
(define (list-ref lst i)
  (let loop ((j 0) (l lst))
    (if (= j i) (car l) (loop (+ j 1) (cdr l)))))
(define (solve n connections)
  (let ((adj (make-adj n connections)))
    (define (bfs)
      (let ((visited (make-list n #f)))
        (set! visited (list-set visited 0 #t))
        (define (queue-from lst)
          (let loop ((l lst) (acc '()))
            (if (null? l) acc (loop (cdr l) (cons (car l) acc)))))
        (let ((queue (queue-from (list-ref adj 0)))
              (count 0))
          (define (process q c)
            (if (null? q)
                c
                (let ((edge (car q))
                      (rest (cdr q)))
                  (let ((nbr (car edge))
                        (ou (car (cdr edge)))
                        (ov (car (cdr (cdr edge)))))
                    (if (list-ref visited nbr)
                        (process rest c)
                        (begin
                          (set! visited (list-set visited nbr #t))
                          (if (= ou nbr)
                              (process (append rest (list-ref adj nbr)) (+ c 1))
                              (process (append rest (list-ref adj nbr)) c))))))))
          (process queue count))))
    (bfs)))
(define (run-case n connections)
  (let ((result (solve n connections)))
    (display "CASE=")
    (display result)
    (newline)))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n") (hash-ref input "connections")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/reorder-routes-to-make-all-paths-lead-to-city-zero/tests.json")))
