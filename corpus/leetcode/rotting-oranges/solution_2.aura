(define (q-make) (cons '() '()))

; push back: add item after rear
(define (q-push-back q item)
  (let ((new (cons item '())))
    (if (null? (car q))
        (begin
          (set-car! q new)
          (set-cdr! q new))
        (begin
          (set-cdr! (cdr q) new)
          (set-cdr! q new)))))

; pop front: returns (item . new-q)
(define (q-pop-front q)
  (if (null? (car q))
      (cons '() q)
      (let ((item (car (car q))) (next (cdr (car q))))
        (set-car! q next)
        (if (null? next)
            (set-cdr! q '()))
        (cons item q))))

(define (q-empty? q) (null? (car q)))

(define (solve grid)
  (let ((n (length grid)))
    (if (= n 0)
        0
        (let ((m (length (car grid))))
          (if (= m 0)
              0
              (let ((q (q-make))
                    (fresh 0)
                    (time 0))
                ; scan grid
                (let loop-r ((r 0))
                  (if (= r n)
                    '()
                    (begin
                      (let loop-c ((c 0))
                        (if (= c m)
                          '()
                          (let ((v (grid-ref grid r c)))
                            (cond
                              ((= v 1) (set! fresh (+ fresh 1)))
                              ((= v 2) (q-push-back q (cons r (cons c '()))))
                              (else '()))
                            (loop-c (+ c 1)))))
                      (loop-r (+ r 1)))))
                (if (= fresh 0)
                    0
                    (let loop ()
                      (if (q-empty? q)
                        (if (= fresh 0) time -1)
                        (let ((sz 0))
                          (let count-loop ()
                            (if (q-empty? q)
                              '()
                              (let ((p (q-pop-front q)))
                                (set! sz (+ sz 1))
                                (count-loop))))
                          (let ((rotted-this-round 0))
                            (let bfs-loop ((k 0))
                              (if (= k sz)
                                '()
                                (begin
                                  ; Hmm, we need to pop sz items.
                                  ; This approach won't work because pop mutates.
                                  ; Let me restructure.
                                  (bfs-loop (+ k 1))))))
                          ; Actually let me redo
                          (loop)))))))))))

