(define (make-grid rows cols)
  (let ((g '()))
    (let loop ((r 0))
      (if (= r rows)
        g
        (let ((row '()))
          (let loop2 ((c 0))
            (if (= c cols)
              (begin
                (set! g (cons row g))
                (loop (+ r 1)))
              (begin
                (set! row (cons 0 row))
                (loop2 (+ c 1))))))))))

(define (grid-set! g r c v)
  (let ((rows (length g)))
    (let loop ((i 0) (acc g))
      (if (= i rows)
        g
        (let ((row (car acc)))
          (let loop2 ((j 0) (racc row))
            (if (= j c)
              (let ((new-row (cons v (cdr racc))))
                (loop (+ i 1) (cons new-row (cdr acc))))
              (loop2 (+ j 1) (cons (car racc) racc)))))))))

(define (grid-ref g r c)
  (let loop ((i 0) (acc g))
    (if (= i r)
      (let loop2 ((j 0) (racc (car acc)))
        (if (= j c)
          (car racc)
          (loop2 (+ j 1) (cdr racc))))
      (loop (+ i 1) (cdr acc)))))

(define (queue-make) (cons '() '()))

(define (queue-empty? q) (null? (car q)))

(define (queue-push q item) (cons (cons item (car q)) (cdr q)))

(define (queue-pop q)
  (if (null? (car q))
      (let loop ((acc (cdr q)) (rest (cdr q)))
        (if (null? acc)
            (cons '() '())
            (if (null? (cdr acc))
                (begin
                  (set-cdr! rest '())
                  (cons (car acc) (cons '() (cdr q))))
                (loop (cdr acc) (cdr rest)))))
      (let ((item (caar q)) (new-front (cdar q)))
        (cons new-front (cons (cdr q) '())))))

