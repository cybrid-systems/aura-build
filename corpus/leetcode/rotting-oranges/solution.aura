(let ((g6 (list (list 1 2 1 1))))
  (display "CASE6=")
  (display (solve g6))
  (newline))

(let ((g7 (list (list 2 2) (list 1 1) (list 1 1))))
  (display "CASE7=")
  (display (solve g7))
  (newline))
