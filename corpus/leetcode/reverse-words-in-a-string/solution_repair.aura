(require "compat" all:)

(define (string-split-words s)
  ;; Returns list of words (each word is a list of chars) in original order
  (let ((chars (string->list s))
        (result '())
        (current '())
        (state 'go))
    (define (flush)
      (set! result (cons (list->string (reverse current)) result))
      (set! current '())
      (set! state 'go))
    (define (loop cs)
      (cond ((null? cs)
             (if (eq? state 'word) (flush))
             result)
            ((char-whitespace? (car cs))
             (begin
               (if (eq? state 'word) (flush))
               (loop (cdr cs))))
            (else
             (set! current (cons (car cs) current))
             (set! state 'word)
             (loop (cdr cs)))))
    (loop chars)
    result))

(define (reverse-list lst)
  (let ((acc '()))
    (define (loop l)
      (if (null? l)
          acc
          (begin
            (set! acc (cons (car l) acc))
            (loop (cdr l)))))
    (loop lst)))

(define (join-words words)
  (cond ((null? words) "")
        ((null? (cdr words)) (car words))
        (else
         (string-append (car words)
                        " "
                        (join-words (cdr words))))))

(define (solve s)
  (let ((words (string-split-words s)))
    (join-words (reverse-list words))))

(define (run-case i s)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve s))
  (newline))

(run-case 0 "the sky is blue")
(run-case 1 "  hello world  ")
(run-case 2 "a   b   c")
(run-case 3 "   ")
(run-case 4 "")
(run-case 5 "single")
(run-case 6 "  leading and trailing  ")
(run-case 7 "one  two\tthree")
