(require "lc_json" all:)
(require "compat" all:)
(define (string-split-words s)
  ;; Returns list of words (each word is a list of chars) in order
  (let ((chars (string->list s))
        (result '())
        (current '()))
    (define (flush)
      (if (null? current)
          result
          (begin
            (set! result (cons (reverse current) result))
            (set! current '())
            result)))
    (define (loop cs)
      (cond ((null? cs) (flush))
            ((char-whitespace? (car cs))
             (let ((r (flush)))
               (loop (cdr cs))))
            (else
             (set! current (cons (car cs) current))
             (loop (cdr cs)))))
    (loop chars)
    result))
(define (reverse-list lst)
  (let ((acc '()))
    (define (loop l)
      (if (null? l) acc
          (begin
            (set! acc (cons (car l) acc))
            (loop (cdr l)))))
    (loop lst)))
(define (list->string-aux lst)
  (list->string lst))
(define (join-words words)
  (cond ((null? words) "")
        ((null? (cdr words)) (list->string (car words)))
        (else
         (string-append (list->string (car words))
                        " "
                        (join-words (cdr words))))))
(define (solve s)
  (let ((words (string-split-words s)))
    (join-words (reverse-list words))))
(define (display-list-of-chars lst)
  (cond ((null? lst) (display ""))
        (else
         (display (string (car lst)))
         (display-list-of-chars (cdr lst)))))
(define (run-case i s)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve s))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "s")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/reverse-words-in-a-string/tests.json")))
