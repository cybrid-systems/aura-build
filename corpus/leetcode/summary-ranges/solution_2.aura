(define (num->str n)
  (number->string n))

(define (range->str a b)
  (if (= a b)
      (num->str a)
      (string-append (num->str a) "->" (num->str b))))

(define (summarize nums)
  (cond
    ((null? nums) '())
    (else
      (let loop ((xs nums) (start (car nums)) (prev (car nums)) (acc '()))
        (cond
          ((null? xs)
           (reverse (cons (range->str start prev) acc)))
          (else
           (let ((cur (car xs)))
             (if (= (- cur prev) 1)
                 (loop (cdr xs) start cur acc)
                 (loop (cdr xs) cur cur (cons (range->str start prev) acc))))))))))

(define (print-list lst)
  (define (helper l)
    (if (null? l)
        '()
        (begin
          (display (car l))
          (newline)
          (helper (cdr l)))))
  (helper lst))

(define (solve nums)
  (print-list (summarize nums)))

(solve '())
(solve '(0))
(solve '(0 1 2 4 5 7))
(solve '(0 1 2 3 4))
(solve '(1 3 5 7))
(solve '(-3 -2 -1 0 2 3 5))
(solve '(-1 0 1))
(solve '(100))
