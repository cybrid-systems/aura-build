(define (int->string n)
  (number->string n))

(define (range->string a b)
  (if (= a b)
      (int->string a)
      (string-append (int->string a) "->" (int->string b))))

(define (summary-helper nums start)
  (cond
    ((null? nums) '())
    ((null? (cdr nums))
     (cons (range->string (car nums) (car nums)) '()))
    ((= (+ (car nums) 1) (cadr nums))
     (summary-helper-aux nums (car nums) (car nums)))
    (else
     (cons (range->string (car nums) (car nums))
           (summary-helper (cdr nums) #f)))))

(define (summary-helper-aux nums start current)
  (cond
    ((null? nums)
     (cons (range->string start current) '()))
    ((null? (cdr nums))
     (cons (range->string start (car nums)) '()))
    ((= (+ (car nums) 1) (cadr nums))
     (summary-helper-aux (cdr nums) start (cadr nums)))
    (else
     (cons (range->string start (car nums))
           (summary-helper (cdr nums) #f)))))

(define (solve nums)
  (summary-helper nums #f))

(define (display-list lst)
  (cond
    ((null? lst) (display ""))
    (else
     (display (car lst))
     (newline)
     (display-list (cdr lst)))))

(define (run-case label nums)
  (display label)
  (display "=")
  (newline)
  (display-list (solve nums)))

(run-case "CASE0" '())
(run-case "CASE1" '(0))
(run-case "CASE2" '(0 1 2 4 5 7))
(run-case "CASE3" '(0 1 2 3 4))
(run-case "CASE4" '(1 3 5 7))
(run-case "CASE5" '(-3 -2 -1 0 2 3 5))
(run-case "CASE6" '(-1 0 1))
(run-case "CASE7" '(100))
