(define (sub s start len)
  (let loop ((i 0) (acc '()))
    (if (= i len)
        (list->string (reverse acc))
        (loop (+ i 1) (cons (string-ref s (+ start i)) acc)))))

(define (valid? seg)
  (let ((len (string-length seg)))
    (cond ((< len 1) #f)
          ((> len 3) #f)
          ((and (> len 1) (char=? (string-ref seg 0) #\0)) #f)
          (else (let loop ((i 0) (val 0))
                  (if (= i len)
                      (<= val 255)
                      (let ((d (- (char->integer (string-ref seg i)) (char->integer #\0))))
                        (if (or (< d 0) (> d 9))
                            #f
                            (loop (+ i 1) (+ (* val 10) d))))))))))

(define (join parts)
  (cond ((null? (cdr parts)) (car parts))
        (else (string-append (car parts) "." (join (cdr parts))))))

(define (backtrack s pos parts n result)
  (cond ((= n 4)
         (if (= pos (string-length s))
             (set! result (cons (join (reverse parts)) result))
             result))
        (else
         (let loop ((end (+ pos 1)) (acc result))
           (if (or (> end (string-length s)) (> (- end pos) 3))
               acc
               (let ((seg (sub s pos (- end pos))))
                 (if (valid? seg)
                     (loop (+ end 1)
                           (backtrack s end (cons seg parts) (+ n 1) acc))
                     (loop (+ end 1) acc))))))))

(define (solve s)
  (let ((len (string-length s)))
    (if (or (< len 4) (> len 12))
        '()
        (reverse (backtrack s 0 '() 0 '())))))

(define (display-list lst)
  (cond ((null? lst)
         (begin (display "[]") (newline)))
        (else
         (display "[")
         (display (car lst))
         (let loop ((rest (cdr lst)))
           (if (null? rest)
               (begin (display "]") (newline))
               (begin (display ", ") (display (car rest)) (loop (cdr rest))))))))

(define (run-case i s)
  (display "CASE")
  (display i)
  (display "=")
  (let ((result (solve s)))
    (if (and (list? result) (not (null? result)) (string? (car result)))
        (display-list result)
        (begin (display result) (newline)))))

(run-case 0 "25525511135")
(run-case 1 "00000")
(run-case 2 "101023")
(run-case 3 "0000")
(run-case 4 "1111")
(run-case 5 "010010")
(run-case 6 "256256256256")
(run-case 7 "12345")
