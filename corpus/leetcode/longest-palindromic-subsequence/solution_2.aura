(define (string-length s)
  (let loop ((i 0) (s s))
    (if (null? s) i (loop (+ i 1) (cdr s)))))

(define (string-ref s i)
  (let loop ((k 0) (s s))
    (if (= k i) (car s) (loop (+ k 1) (cdr s)))))

(define (make-2d-list n m)
  (let loop ((i 0) (acc '()))
    (if (>= i n)
        (reverse acc)
        (loop (+ i 1) (cons (make-list m 0) acc)))))

(define (list-ref-safe lst i)
  (let loop ((k 0) (lst lst))
    (cond ((null? lst) 0)
          ((= k i) (car lst))
          (else (loop (+ k 1) (cdr lst))))))

(define (list-set! lst i v)
  (let loop ((k 0) (lst lst))
    (cond ((= k i) (set-car! lst v))
          (else (loop (+ k 1) (cdr lst))))))

(define (row-ref grid i)
  (let loop ((k 0) (g grid))
    (if (= k i) (car g) (loop (+ k 1) (cdr g)))))

(define (solve s)
  (let* ((n (string-length s))
         (dp (make-2d-list n n)))
    ; base cases for length 1
    (let loop-i ((i 0))
      (if (< i n)
          (begin
            (list-set! (row-ref dp i) i 1)
            (loop-i (+ i 1)))
          '()))
    ; fill by increasing length
    (let outer ((len 2))
      (if (> len n)
          (list-ref-safe (row-ref dp 0) (- n 1))
          (let inner-i ((i 0))
            (if (> i (- n len))
                (outer (+ len 1))
                (let* ((j (+ i (- len 1)))
                       (ci (string-ref s i))
                       (cj (string-ref s j))
                       (row-i (row-ref dp i))
                       (row-i+1 (row-ref dp (+ i 1)))
                       (row-i-j-1 (row-ref dp (+ i 1))))
                  (if (and (equal? ci cj) (not (= i j)))
                      (list-set! row-i j (+ (list-ref-safe row-i+1 (- j 1)) 2))
                      (if (= i j)
                          (list-set! row-i j 1)
                          (let ((v (max (list-ref-safe row-i+1 j)
                                        (list-ref-safe row-i (- j 1)))))
                            (list-set! row-i j v))))
                  (inner-i (+ i 1))))))))

(define (display-list lst)
  (display "[")
  (let loop ((first? #t) (l lst))
    (cond ((null? l) (display "]"))
          (else
           (if first? (set! first? #f) (display " "))
           (display (car l))
           (loop first? (cdr l))))))

(define (run-case idx s)
  (display "CASE")
  (display (number->string idx))
  (display "=")
  (let ((r (solve s)))
    (if (number? r)
        (display (number->string r))
        (display-list r)))
  (newline))

(run-case 0 "BBABCBCAB")
(run-case 1 "a")
(run-case 2 "")
(run-case 3 "aa")
(run-case 4 "ab")
(run-case 5 "abcdef")
(run-case 6 "AABCDEBAZ")
(run-case 7 "aaaaa")
