;; Helper: convert string to list of single-char strings
(define (string->char-list s)
  (let ((len (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (>= i len)
          (reverse acc)
          (loop (+ i 1) (cons (substring s i (+ i 1)) acc))))))

(define (string-length s)
  ;; Built-in in Aura
  (builtin-string-length s))

(define (substring s start end)
  (builtin-substring s start end))

(define (max a b)
  (if (> a b) a b))

(define (solve s)
  (let* ((chars (string->char-list s))
         (n (length chars)))
    ;; Build DP table: dp[i][j] = longest palindromic subseq length in chars[i..j]
    ;; Use list of lists; initialize with 0
    (let ((dp (make-list n (make-list n 0))))
      ;; Base case: single characters
      (let loop-i ((i 0))
        (if (< i n)
            (begin
              (set-car! (list-ref dp i) (make-list n 0))
              ;; Actually, let me restructure: dp is list of n lists, each of n zeros
              ;; Then fill
              (loop-i (+ i 1)))
            '()))
      ;; Initialize: dp[i][i] = 1 for all i
      (let loop-i ((i 0))
        (if (< i n)
            (begin
              (set-car! (list-ref (list-ref dp i) i) 1)
              (loop-i (+ i 1)))
            '()))
      ;; Fill by increasing length
      (let loop-len ((len 2))
        (if (> len n)
            '()
            (begin
              (let loop-i ((i 0))
                (if (> (+ i (- len 1)) (- n 1))
                    '()
                    (let* ((j (+ i (- len 1)))
                           (ci (list-ref chars i))
                           (cj (list-ref chars j)))
                      (let ((row-i (list-ref dp i))
                            (row-i1 (list-ref dp (+ i 1)))
                            (row-i-j1 (if (< (- j 1) 0) '() (list-ref dp i)))
                            )
                        ;; We need dp[i+1][j-1], dp[i+1][j], dp[i][j-1]
                        (let ((val (cond
                                     ((equal? ci cj)
                                      (+ (if (and (= i (+ i 1)) ...) 
                                          ;; i+1 > j-1 means i+1 > j-1, i.e., i >= j-1, i.e., len <= 2
                                          ;; For len=2 and equal chars: dp[i][i+1] = 2
                                          2
                                          (list-ref (list-ref dp (+ i 1)) (- j 1)))
                                         0))
                                     (else
                                      (max (list-ref (list-ref dp (+ i 1)) j)
                                           (list-ref row-i (- j 1)))))))
                          (set-car! (list-tail row-i j) val)))))
                    (loop-i (+ i 1))))
              (loop-len (+ len 1)))))
      ;; Answer is dp[0][n-1]
      (if (= n 0)
          0
          (list-ref (list-ref dp 0) (- n 1))))))

;; Simpler correct implementation
(define (solve s)
  (let* ((chars (string->char-list s))
         (n (length chars)))
    (if (= n 0)
        0
        ;; dp as vector-like: list of n lists of n zeros
        (let ((dp (build-list n (lambda (i) (build-list n (lambda (j) 0))))))
          ;; Base: dp[i][i] = 1
          (let loop ((i 0))
            (if (< i n)
                (begin
                  (set-car! (list-ref dp i)
                            (let ((row (list-ref dp i)))
                              ;; Set position i in row to 1, others 0
                              (build-list n (lambda (k) (if (= k i) 1 0)))))
                  (loop (+ i 1)))
                '()))
          ;; Actually setting just one element is tricky with immutable lists.
          ;; Use mutable approach via global, or rebuild.
          ;; ...
          0))))
