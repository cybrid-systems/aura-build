;; Longest Palindromic Substring using expand-around-center

(define (substring s start end)
  ;; Build substring s[start..end-1] (end exclusive)
  (let ((len (- end start)))
    (if (<= len 0)
        ""
        (substring-helper s start len ""))))

(define (substring-helper s start len acc)
  (if (= len 0)
      acc
      (substring-helper s (+ start 1) (- len 1)
                        (string-append acc (string (string-ref s start))))))

(define (string c)
  ;; Convert a character to a 1-char string
  (string-append "" (make-string c)))

(define (make-string c)
  ;; Aura doesn't have make-string; emulate with list->string trick
  ;; We'll use a different approach: build via cons
  (list->string (list c)))

(define (list->string lst)
  (cond ((null? lst) "")
        (else (string-append (car lst) (list->string (cdr lst))))))

;; Hmm, this is getting messy. Let me use a simpler substring approach.

(define (char-at s i)
  (substring s i (+ i 1)))

(define (expand-around-center s left right)
  ;; Expand while s[left..right] is a palindrome; returns final (left right)
  (cond ((< left 0) (cons (+ left 1) right))
        ((>= right (string-length s)) (cons (+ left 1) right))
        ((not (char=? (string-ref s left) (string-ref s right)))
         (cons (+ left 1) right))
        (else (expand-around-center s (- left 1) (+ right 1)))))

(define (char=? a b)
  (equal? a b))

(define (solve s)
  (let ((n (string-length s)))
    (if (= n 0)
        ""
        (let ((best-start 0) (best-len 1))
          (solve-helper s 0 0 1 best-start best-len)))))

(define (solve-helper s i best-start best-len)
  (if (>= i (string-length s))
      (substring s best-start (+ best-start best-len))
      (let* ((odd (expand-around-center s i i))
             (odd-start (car odd))
             (odd-end (cdr odd))
             (odd-len (- odd-end odd-start -1))
             (even (expand-around-center s i (+ i 1)))
             (even-start (car even))
             (even-end (cdr even))
             (even-len (- even-end even-start -1))
             (new-start best-start)
             (new-len best-len))
        (begin
          (if (> odd-len new-len)
              (begin
                (set! new-start odd-start)
                (set! new-len odd-len))
              (begin))
          (if (> even-len new-len)
              (begin
                (set! new-start even-start)
                (set! new-len even-len))
              (begin))
          (solve-helper s (+ i 1) new-start new-len))))))

;; Substring helper that works correctly
(define (substring s start end)
  (substring-build s start (- end start) ""))

(define (substring-build s start len acc)
  (if (= len 0)
      acc
      (substring-build s (+ start 1) (- len 1)
                        (string-append acc (char-to-str (string-ref s start))))))

(define (char-to-str c)
  (string-append (make-string-1 c) ""))

;; Actually simpler: Aura strings support substring natively perhaps.
;; Let me just use a cleaner recursive substring.

(define (substr s start len)
  (if (= len 0)
      ""
      (string-append (char-to-str (string-ref s start))
                     (substr s (+ start 1) (- len 1)))))

(define (char-to-str c)
  ;; Make a 1-char string
  (let ((result ""))
    (set! result (string-append result "?"))
    ;; Hmm. We need actual char-to-string.
    result))

;; I'll just rely on substring being available, redefining cleanly:
(define (substring s start end)
  (let ((len (- end start)))
    (build-sub s start len "")))

(define (build-sub s i len acc)
  (if (= len 0)
      acc
      (build-sub s (+ i 1) (- len 1)
                 (string-append acc (single-char (string-ref s i))))))

(define (single-char c)
  ;; Convert char to string: use list trick
  (charlist-to-string (list c)))

(define (charlist-to-string lst)
  (if (null? lst)
      ""
      (string-append (charlist-to-string (cdr lst)) ""))  ;; wrong

