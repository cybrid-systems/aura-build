(define (min-index nums)
  ;; Returns index of minimum element; ties broken by leftmost.
  (letrec ((len (length nums))
           (loop (lambda (i best-idx)
                   (if (= i len)
                       best-idx
                       (let ((v (list-ref nums i))
                             (bv (list-ref nums best-idx)))
                         (if (< v bv)
                             (loop (+ i 1) i)
                             (loop (+ i 1) best-idx)))))))
    (if (= len 0)
        -1
        (loop 1 0))))

(define (solve nums)
  (min-index nums))

(define (list->string lst)
  ;; Pretty-print a list as "[a,b,c]"
  (letrec ((loop (lambda (l first?)
                   (if (null? l)
                       (if first? "[]" "]")
                       (let ((rest (loop (cdr l) #f)))
                         (string-append
                           (if first? "[" ",")
                           (number->string (car l))
                           rest))))))
    (loop lst #t)))

(define cases
  (list
    (list 1 3 5 7 9)
    (list 2 2 2 0 1)
    (list 5 5 5 5 5)
    (list 3 1 2 3 3)
    (list 1)
    (list 2 1)
    (list 1 2 3)
    (list 3 3 1 3)
    (list 10 1 10 10 10)
    (list 4 4 4 0 4 4 4)))

(letrec ((run (lambda (cases i)
                (if (null? cases)
                    '()
                    (begin
                      (display (string-append "CASE" (number->string i) "="))
                      (display (number->string (solve (car cases))))
                      (newline)
                      (run (cdr cases) (+ i 1)))))))
  (run cases 0))
