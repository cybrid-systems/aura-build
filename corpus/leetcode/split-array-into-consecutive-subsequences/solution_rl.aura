(require "lc_json" all:)
(require "compat" all:)
(define (solve nums)
  (if (null? nums)
      #f
      (let* ((min-val (car nums))
             (max-val (last-val nums))
             (n (+ (- max-val min-val) 1))
             (cnt (make-vec n 0))
             (end (make-vec n 0))
             (offset min-val))
        (count-occurrences nums cnt offset)
        (try-build nums cnt end offset))))
(define (last-val lst)
  (if (null? (cdr lst))
      (car lst)
      (last-val (cdr lst))))
(define (make-vec n v)
  (build-list n v))
(define (build-list n v)
  (if (= n 0)
      '()
      (cons v (build-list (- n 1) v))))
(define (vec-set! vec i val)
  (if (= i 0)
      (set-car! vec val)
      (vec-set! (cdr vec) (- i 1) val)))
(define (vec-ref vec i)
  (if (= i 0)
      (car vec)
      (vec-ref (cdr vec) (- i 1))))
(define (count-occurrences lst cnt offset)
  (if (null? lst)
      '()
      (begin
        (vec-set! cnt (- (car lst) offset) (+ (vec-ref cnt (- (car lst) offset)) 1))
        (count-occurrences (cdr lst) cnt offset))))
(define (try-build lst cnt end offset)
  (cond
    ((null? lst) #t)
    (else
     (let ((c (vec-ref cnt (- (car lst) offset))))
       (cond
         ((= c 0)
          (try-build (cdr lst) cnt end offset))
         ((and (> (vec-ref end (- (car lst) offset)) 0))
          (vec-set! cnt (- (car lst) offset) (- c 1))
          (vec-set! end (- (car lst) offset) (- (vec-ref end (- (car lst) offset)) 1))
          (vec-set! end (- (car lst) offset 1) (+ (vec-ref end (- (car lst) offset 1)) 1))
          (try-build (cdr lst) cnt end offset))
         (else
          (let ((v (- (car lst) offset)))
            (if (and (< (+ v 2) (length cnt))
                     (> (vec-ref cnt (+ v 1)) 0)
                     (> (vec-ref cnt (+ v 2)) 0))
                (begin
                  (vec-set! cnt v (- (vec-ref cnt v) 1))
                  (vec-set! cnt (+ v 1) (- (vec-ref cnt (+ v 1)) 1))
                  (vec-set! cnt (+ v 2) (- (vec-ref cnt (+ v 2)) 1))
                  (vec-set! end (+ v 2) (+ (vec-ref end (+ v 2)) 1))
                  (try-build (cdr lst) cnt end offset))
                #f))))))))
(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))
(define CASE0 (list 1 2 3 3 4 4 5 5))
(define CASE1 (list 1 2 3 3 4 4 5 5 6))
(define CASE2 (list 1 2 3 4 5))
(define CASE3 (list 1 2 3 4))
(define CASE4 (list 1 1 2 2 3 3))
(define CASE5 (list 1 2 3))
(define CASE6 (list 1 2 3 5 6 7))
(define CASE7 (list))
(define (display-result name result)
  (display name)
  (display "=")
  (display (if result "T" "NIL"))
  (newline))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "nums")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/split-array-into-consecutive-subsequences/tests.json")))
