;; Convert sorted array to height-balanced BST and serialize to JSON.
;; We avoid building a tagged node type; instead we build a plain
;; association list '(val left right) which is easy to serialize.

(define (make-node v l r) (list v l r))

;; build from list of nums, picking the left-middle element as root
(define (build nums)
  (if (null? nums)
      '()
      (let* ((n (length nums))
             (mid (quotient n 2))
             (root-val (list-ref nums mid))
             (left-lst (take nums mid))
             (right-lst (drop nums (+ mid 1))))
        (make-node root-val (build left-lst) (build right-lst)))))

(define (take lst k)
  (if (= k 0)
      '()
      (cons (car lst) (take (cdr lst) (- k 1)))))

(define (drop lst k)
  (if (= k 0)
      lst
      (drop (cdr lst) (- k 1))))

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))

;; ---- JSON serialization (level-order, trailing nulls omitted) ----

(define (node->json node)
  (cond ((null? node) "null")
        (else
         (string-append "{\"val\":"
                        (number->string (car node))
                        ",\"left\":"
                        (node->json (cadr node))
                        ",\"right\":"
                        (node->json (caddr node))
                        "}"))))

(define (solve nums)
  (node->json (build nums)))

;; ---- embedded test cases ----

(define cases
  (list
    (list -10 -3 0 5 9)
    (list 1)
    (list)
    (list 1 2 3 4)
    (list 1 2 3 4 5 6)
    (list -5 -3 -1 0 2 4)
    (list 0 1 2 3 4 5 6 7 8)
    (list 42)))

(define (run-cases cs i)
  (if (null? cs)
      '()
      (begin
        (display "CASE")
        (display (number->string i))
        (display "=")
        (display (solve (car cs)))
        (newline)
        (run-cases (cdr cs) (+ i 1)))))

(run-cases cases 0)
