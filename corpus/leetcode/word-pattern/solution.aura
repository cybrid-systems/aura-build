(define (split-words s)
  ; split a string on spaces into a list of strings
  (let ((len (string-length s)))
    (let loop ((i 0) (start 0) (acc '()))
      (cond ((= i len)
             (if (= start len)
                 acc
                 (reverse (cons (substring s start len) acc))))
            ((char=? (string-ref s i) #\space)
             (loop (+ i 1) (+ i 1)
                   (reverse (cons (substring s start i) acc))))
            (else
             (loop (+ i 1) start acc))))))

(define (solve pattern sentence)
  (let ((chars (string->list pattern))
        (words (split-words sentence)))
    (let ((n (length chars))
          (m (length words)))
      (if (not (= n m))
          "NO"
          (let loop ((cs chars) (ws words) (c2w '()) (w2c '()))
            (cond ((null? cs)
                   (if (null? ws) "YES" "NO"))
                  (else
                   (let ((c (car cs))
                         (w (car ws)))
                     (let ((prev-c (assoc c c2w))
                           (prev-w (assoc w w2c)))
                       (cond ((and (pair? prev-c) (pair? prev-w))
                              (if (and (equal? (cdr prev-c) w)
                                       (equal? (cdr prev-w) c))
                                  (loop (cdr cs) (cdr ws) c2w w2c)
                                  "NO"))
                             ((or (pair? prev-c) (pair? prev-w))
                              "NO")
                             (else
                              (loop (cdr cs) (cdr ws)
                                    (cons (cons c w) c2w)
                                    (cons (cons w c) w2c)))))))))))))

(define (run-case i pat sen)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve pat sen))
  (newline))

(run-case 0 "abba" "dog cat cat dog")
(run-case 1 "abba" "dog cat cat fish")
(run-case 2 "aaaa" "dog cat cat dog")
(run-case 3 "abc" "one two three")
(run-case 4 "abc" "one one one")
(run-case 5 "a" "cat")
(run-case 6 "ab" "cat")
(run-case 7 "" "")
