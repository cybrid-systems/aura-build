; soft_leetcode_runtime slug=edit-distance path=llm
; materialize=proposed_source_fallback worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-1 hits=5/8
; baseline_hits=0/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(define (string-length-iter s)
  (let loop ((i 0) (acc 0))
    (if (>= i (string-length s)) acc
        (loop (+ i 1) (+ acc 1)))))

(define (char-at s i)
  (string-ref s i))

(define (min3 a b c)
  (if (<= a b)
      (if (<= a c) a c)
      (if (<= b c) b c)))

(define (make-list-of-zeros n)
  (let loop ((k 0) (acc '()))
    (if (>= k n) acc (loop (+ k 1) (cons 0 acc)))))

(define (set-list lst i v)
  (let loop ((k 0) (lst lst))
    (cond ((null? lst) '())
          ((= k i) (cons v (cdr lst)))
          (else (cons (car lst) (loop (+ k 1) (cdr lst)))))))

(define (list-ref-safe lst i)
  (let loop ((k 0) (lst lst))
    (if (= k i) (car lst)
        (loop (+ k 1) (cdr lst)))))

(define (edit-distance a b)
  (let* ((la (string-length a))
         (lb (string-length b))
         (la-plus-1 (+ la 1))
         (lb-plus-1 (+ lb 1)))
    (let* ((prev (make-list-of-zeros lb-plus-1))
           (cur  (make-list-of-zeros lb-plus-1)))
      (let loop-i ((i 0))
        (if (> i la)
            (list-ref-safe prev lb)
            (begin
              (set! cur (set-list cur 0 i))
              (let loop-j ((j 1))
                  (if (> j lb) 'done
                      (begin
                        (let* ((ch1 (char-at a i))
                               (ch2 (char-at b (- j 1)))
                               (cost (if (= ch1 ch2) 0 1))
                               (del-cost (+ (list-ref-safe prev j) 1))
                               (ins-cost (+ (list-ref-safe cur (- j 1)) 1))
                               (sub-cost (+ (list-ref-safe prev (- j 1)) cost)))
                          (set! cur (set-list cur j (min3 del-cost ins-cost sub-cost))))
                        (loop-j (+ j 1)))))
              (let ((tmp prev))
                (set! prev cur)
                (set! cur tmp))
              (loop-i (+ i 1))))))))

(define (solve a b)
  (edit-distance a b))

(define (run-case i a b)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve a b))
  (newline))

(run-case 0 "kitten" "sitting")
(run-case 1 "abc" "abc")
(run-case 2 "" "a")
(run-case 3 "a" "")
(run-case 4 "" "")
(run-case 5 "sunday" "saturday")
(run-case 6 "horse" "ros")
(run-case 7 "intention" "execution")

