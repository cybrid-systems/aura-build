; soft_leetcode_runtime slug=edit-distance path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-9 hits=8/8
; baseline_hits=5/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define min3
    (lambda (a b c)
      (let ((m (if (<=
            a b)
          a
          b)))
        (if (<=
            m c)
          m
          c))))
  (define make-row
    (lambda (n)
      (letrec ((loop (lambda (k acc)
          (if (>=
              k n)
            acc
            (loop
              (+
                k 1) (cons
                0 acc))))))
        (loop
          0 (quote ())))))
  (define row-set
    (lambda (lst i v)
      (letrec ((loop (lambda (k lst)
          (if (null? lst)
            (quote ())
            (if (=
                k i)
              (cons
                v (cdr lst))
              (cons
                (car lst) (loop
                  (+
                    k 1) (cdr lst))))))))
        (loop
          0 lst))))
  (define row-ref
    (lambda (lst i)
      (letrec ((loop (lambda (k lst)
          (if (=
              k i)
            (car lst)
            (loop
              (+
                k 1) (cdr lst))))))
        (loop
          0 lst))))
  (define edit-distance
    (lambda (a b)
      (let ((la (string-length a)))
        (let ((lb (string-length b)))
          (let ((ncol (+
              lb 1)))
            (let ((prev (make-row ncol)))
              (let ((cur (make-row ncol)))
                (begin
                  (letrec ((init-prev (lambda (j)
                      (if (>=
                          j ncol)
                        0
                        (begin
                          (set! prev (row-set
                              prev j j))
                          (init-prev (+
                              j 1)))))))
                    (init-prev 0))
                  (if (=
                      la 0)
                    lb
                    (if (=
                        lb 0)
                      la
                      (begin
                        (begin
                          (letrec ((outer (lambda (i)
                              (if (>
                                  i la)
                                (quote done)
                                (begin
                                  (set! cur (row-set
                                      cur 0 i))
                                  (letrec ((inner (lambda (j)
                                      (if (>
                                          j lb)
                                        (quote done)
                                        (begin
                                          (let ((ca (string-ref
                                              a (-
                                                i 1))))
                                            (let ((cb (string-ref
                                                b (-
                                                  j 1))))
                                              (let ((cost (if (=
                                                    ca cb)
                                                  0
                                                  1)))
                                                (let ((del-cost (+
                                                    (row-ref
                                                      prev j) 1)))
                                                  (let ((ins-cost (+
                                                      (row-ref
                                                        cur (-
                                                          j 1)) 1)))
                                                    (let ((sub-cost (+
                                                        (row-ref
                                                          prev (-
                                                            j 1)) cost)))
                                                      (begin
                                                        (set! cur (row-set
                                                            cur j (min3
                                                              del-cost ins-cost sub-cost)))
                                                        (inner (+
                                                            j 1))))))))))))))
                                    (inner 1))
                                  (let ((tmp prev))
                                    (begin
                                      (set! prev cur)
                                      (set! cur tmp)))
                                  (outer (+
                                      i 1)))))))
                            (outer 1)))
                        (row-ref
                          prev lb))))))))))))
  (define solve
    (lambda (a b)
      (edit-distance
        a b)))
  (define run-case
    (lambda (i a b)
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display (solve
            a b))
        (newline))))
  (run-case
    0 "kitten" "sitting")
  (run-case
    1 "abc" "abc")
  (run-case
    2 "" "a")
  (run-case
    3 "a" "")
  (run-case
    4 "" "")
  (run-case
    5 "sunday" "saturday")
  (run-case
    6 "horse" "ros")
  (run-case
    7 "intention" "execution"))
