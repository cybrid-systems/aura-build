(define (solve s1 s2)
  (let* ((n (string-length s1))
         (m (string-length s2))
         (target (make-vector 26 0))
         (window (make-vector 26 0)))
    (let loop-build ((i 0))
      (if (< i n)
          (begin
            (vector-set! target (char->int (string-ref s1 i)) (- (char->int (string-ref s1 i)) (char->int #\a)) (+ (vector-ref target (- (char->int (string-ref s1 i)) (char->int #\a))) 1))
            (loop-build (+ i 1)))
          'done))
    (if (< m n)
        #f
        (let loop-init ((i 0))
          (if (< i n)
              (begin
                (vector-set! window (- (char->int (string-ref s2 i)) (char->int #\a)) (+ (vector-ref window (- (char->int (string-ref s2 i)) (char->int #\a))) 1))
                (loop-init (+ i 1)))
              'done)))
    (let* ((matches
            (let loop-c ((k 0) (acc 0))
              (if (< k 26)
                  (if (= (vector-ref target k) (vector-ref window k))
                      (loop-c (+ k 1) (+ acc 1))
                      (loop-c (+ k 1) acc))
                  acc))))
      (if (= matches 26)
          #t
          (let loop-slide ((i n))
            (if (< i m)
                (let* ((in-char (string-ref s2 i))
                        (out-char (string-ref s2 (- i n)))
                        (in-idx (- (char->int in-char) (char->int #\a)))
                        (out-idx (- (char->int out-char) (char->int #\a)))
                        (old-matches matches))
                  (let* ((delta
                          (cond
                            ((and (= (vector-ref target in-idx) (vector-ref window in-idx))
                                  (= (+ (vector-ref window in-idx) 1) (vector-ref target in-idx)))
                             1)
                            ((and (= (vector-ref target in-idx) (vector-ref window in-idx))
                                  (/= (+ (vector-ref window in-idx) 1) (vector-ref target in-idx)))
                             0)
                            ((and (/= (vector-ref target in-idx) (vector-ref window in-idx))
                                  (= (+ (vector-ref window in-idx) 1) (vector-ref target in-idx)))
                             1)
                            (else 0)))
                          (delta-out
                            (cond
                              ((and (= (vector-ref target out-idx) (vector-ref window out-idx))
                                    (= (- (vector-ref window out-idx) 1) (vector-ref target out-idx)))
                               0)
                              ((and (= (vector-ref target out-idx) (vector-ref window out-idx))
                                    (/= (- (vector-ref window out-idx) 1) (vector-ref target out-idx)))
                               0)
                              ((and (/= (vector-ref target out-idx) (vector-ref window out-idx))
                                    (= (- (vector-ref window out-idx) 1) (vector-ref target out-idx)))
                               1)
                              (else -1)))))
                    (vector-set! window in-idx (+ (vector-ref window in-idx) 1))
                    (vector-set! window out-idx (- (vector-ref window out-idx) 1))
                    (let ((new-matches (+ old-matches delta delta-out)))
                      (if (= new-matches 26)
                          #t
                          (loop-slide (+ i 1)))))
                  (loop-slide (+ i 1))))
                #f))))))

(display "CASE0=") (display (solve "abc" "abcbacab")) (newline)
(display "CASE1=") (display (solve "abc" "cab")) (newline)
(display "CASE2=") (display (solve "abcd" "dabc")) (newline)
(display "CASE3=") (display (solve "hello" "oooll")) (newline)
(display "CASE4=") (display (solve "a" "a")) (newline)
(display "CASE5=") (display (solve "a" "b")) (newline)
(display "CASE6=") (display (solve "ab" "ba")) (newline)
(display "CASE7=") (display (solve "abcd" "abcdefgh")) (newline)
