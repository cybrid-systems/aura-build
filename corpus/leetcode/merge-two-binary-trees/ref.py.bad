def solve(t1, t2):
    """Merge two binary trees and return the root of the merged tree.

    Trees are represented as nested lists: [value, left, right].
    Use None for empty subtrees.
    """
    def to_list(node):
        # Convert [value, left, right] -> (value left right) or NIL
        if node is None:
            return ['NIL']
        val, left, right = node
        # Recursively format children
        return [f'({val} ' + ' '.join(to_list(left)) + ' ' + ' '.join(to_list(right)) + ')']

    def merge(a, b):
        if a is None and b is None:
            return None
        if a is None:
            val_b, lb, rb = b
            return [val_b, merge(None, lb), merge(None, rb)]
        if b is None:
            val_a, la, ra = a
            return [val_a, merge(la, None), merge(ra, None)]
        val_a, la, ra = a
        val_b, lb, rb = b
        return [val_a + val_b, merge(la, lb), merge(ra, rb)]

    merged = merge(t1, t2)
    return ''.join(to_list(merged))


CASES = [
    {
        't1': [1, [3, [5, None, None], [2, None, None]], [None, None, None]],
        't2': [2, [1, None, [4, None, None]], [3, None, None]],
    },
    {
        't1': None,
        't2': None,
    },
    {
        't1': [1, None, None],
        't2': [2, [3, None, None], [None, None, None]],
    },
    {
        't1': [1, [2, None, None], [3, None, None]],
        't2': [4, [5, None, None], [6, None, None]],
    },
    {
        't1': [1, [3, None, [5, None, None]], [2, None, None]],
        't2': [2, [1, None, None], [4, None, None]],
    },
    {
        't1': None,
        't2': [1, [2, None, None], [3, None, None]],
    },
    {
        't1': [10, [5, None, None], [15, None, None]],
        't2': [20, [30, [40, None, None], None], [50, None, [60, None, None]]],
    },
]


if __name__ == '__main__':
    import json
    results = []
    for i, case in enumerate(CASES):
        result = solve(case['t1'], case['t2'])
        results.append({
            'id': i,
            'input': {
                't1': case['t1'],
                't2': case['t2'],
            },
            'expected': json.dumps(result, separators=(',', ':'), ensure_ascii=False),
        })
    print(json.dumps(results, separators=(',', ':'), ensure_ascii=False))
