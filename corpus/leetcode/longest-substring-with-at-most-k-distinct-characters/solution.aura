(define (length-of-longest-substring-k-distinct s k)
  (let* ((n (string-length s))
         (freq (make-vector 26 0))
         (left 0)
         (distinct 0)
         (best 0))
    (define (char-idx c)
      (- (char->integer c) (char->integer #\a)))
    (let loop ((right 0))
      (if (= right n)
          best
          (let* ((ci (char-idx (string-ref s right)))
                 (fc (vector-ref freq ci)))
            (begin
              (vector-set! freq ci (+ fc 1))
              (if (= fc 0) (set! distinct (+ distinct 1)) 0)
              (let shrink ()
                (if (> distinct k)
                    (let* ((li (char-idx (string-ref s left)))
                           (lc (vector-ref freq li)))
                      (begin
                        (vector-set! freq li (- lc 1))
                        (if (= lc 1) (set! distinct (- distinct 1)) 0)
                        (set! left (+ left 1))
                        (shrink)))
                    0))
              (let ((window (- (+ right 1) left)))
                (if (> window best) (set! best window) 0))
              (loop (+ right 1))))))))

(define (solve s k)
  (length-of-longest-substring-k-distinct s k))

(define (display-result i result)
  (begin
    (display "CASE")
    (display i)
    (display "=")
    (display result)
    (newline)))

(define (run)
  (begin
    (display-result 0 (solve "eceba" 2))
    (display-result 1 (solve "aa" 1))
    (display-result 2 (solve "" 3))
    (display-result 3 (solve "abc" 0))
    (display-result 4 (solve "a" 1))
    (display-result 5 (solve "abaccc" 2))
    (display-result 6 (solve "abcdefghijklmnopqrstuvwxyz" 3))
    (display-result 7 (solve "aaaaaaaaaa" 5))
    0))

(run)
