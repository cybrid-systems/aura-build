(require "lc_json" all:)
(require "compat" all:)
(define (reverse-helper lst acc)
  (if (null? lst)
      acc
      (reverse-helper (cdr lst) (cons (car lst) acc))))
(define (my-reverse lst)
  (reverse-helper lst '()))
(define (plus-one-helper digits carry)
  (cond
    ((null? digits)
     (if (= carry 0)
         '()
         (cons carry '())))
    (else
      (let ((sum (+ (car digits) carry)))
        (if (= sum 10)
            (cons 0 (plus-one-helper (cdr digits) 1))
            (cons sum (plus-one-helper (cdr digits) 0)))))))
(define (solve digits)
  (my-reverse (plus-one-helper (my-reverse digits) 1)))
(define (display-list lst)
  (cond
    ((null? lst)
     (display "")
     )
    ((null? (cdr lst))
     (display (car lst)))
    (else
      (display (car lst))
      (display " ")
      (display-list (cdr lst)))))
(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display-list result)
  (newline)
  )

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "digits")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/plus-one/tests.json")))
