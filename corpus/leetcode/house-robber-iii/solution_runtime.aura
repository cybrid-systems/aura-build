; soft_leetcode_runtime slug=house-robber-iii path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-1 hits=1/8
; baseline_hits=0/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define build-vec
    (lambda (flat n)
      (let ((vec (make-vector
          n -999999)))
        (letrec ((loop (lambda (i)
            (if (>=
                i n)
              vec
              (begin
                (vector-set!
                  vec i (list-ref
                    flat i))
                (loop (+
                    i 1)))))))
          (loop 0)))))
  (define vec-money
    (lambda (vec idx n)
      (if (or
          (>=
            idx n) (negative? idx))
        -999999
        (vector-ref
          vec idx))))
  (define vec-present?
    (lambda (vec idx n)
      (and
        (>=
          idx 0) (<
          idx n) (not (negative? (vector-ref
              vec idx))))))
  (define dfs
    (lambda (vec idx n)
      (let ((li (+
          (*
            idx 2) 1)))
        (let ((ri (+
            (*
              idx 2) 2)))
          (let ((hl (vec-present?
              vec li n)))
            (let ((hr (vec-present?
                vec ri n)))
              (let ((m (vec-money
                  vec idx n)))
                (if (not (and
                      (>=
                        idx 0) (<
                        idx n) (not (negative? m))))
                  (cons
                    0 0)
                  (if (and
                      (not hl) (not hr))
                    (cons
                      m 0)
                    (let ((lr (if hl
                        (dfs
                          vec li n)
                        (cons
                          0 0))))
                      (let ((rr (if hr
                          (dfs
                            vec ri n)
                          (cons
                            0 0))))
                        (let ((lrob (car lr)))
                          (let ((lsk (cdr lr)))
                            (let ((rrob (car rr)))
                              (let ((rsk (cdr rr)))
                                (cons
                                  (+
                                    m lsk rsk) (+
                                    (max
                                      lrob lsk) (max
                                      rrob rsk))))))))))))))))))
  (define solve
    (lambda (tree)
      (let ((n (length tree)))
        (if (=
            n 0)
          0
          (let ((root-val (list-ref
              tree 0)))
            (if (negative? root-val)
              0
              (let ((vec (build-vec
                  tree n)))
                (let ((r (dfs
                    vec 0 n)))
                  (max
                    (car r) (cdr r))))))))))
  (define run-case
    (lambda (i tree)
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display (solve tree))
        (newline))))
  (begin
    (run-case
      0 (quote ()))
    (run-case
      1 (quote (-1)))
    (run-case
      2 (quote (0)))
    (run-case
      3 (quote (3
          2 3 -1 -1 -1 1)))
    (run-case
      4 (quote (3
          4 5 1 3 -1 1)))
    (run-case
      5 (quote (4
          1 -1 2 -1 -1 -1)))
    (run-case
      6 (quote (2
          1 3 -1 4)))
    (run-case
      7 (quote (1
          2 3 4 5 -1 6 -1 -1 -1 -1 -1 -1 7 -1)))))
