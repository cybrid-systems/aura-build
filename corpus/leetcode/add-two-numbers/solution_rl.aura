(require "lc_json" all:)
(require "compat" all:)
(define (list->digits lst)
  ;; consume a list of digits in normal order and build a linked list in reverse order
  ;; using cons cells: each node is a pair (val . next)
  (define (build rev-lst)
    (if (null? rev-lst)
        '()
        (cons (car rev-lst) (build (cdr rev-lst)))))
  ;; reverse the input list and build linked list
  (define (rev xs)
    (define (acc xs acc)
      (if (null? xs) acc (acc (cdr xs) (cons (car xs) acc))))
    (acc xs '()))
  (build (rev lst)))
(define (solve l1 l2)
  ;; l1 and l2 are linked lists (aura lists of pairs representing ListNodes)
  ;; Return a linked list (also aura list) of the sum, reverse-order digits.
  (define (add a b carry)
    (let ((da (if (null? a) 0 (car a)))
          (db (if (null? b) 0 (car b)))
          (ra (if (null? a) '() (cdr a)))
          (rb (if (null? b) '() (cdr b))))
      (let ((s (+ da db carry))
            (digit (modulo s 10))
            (new-carry (quotient s 10)))
        (cons digit
              (if (and (null? ra) (null? rb) (= new-carry 0))
                  '()
                  (add ra rb new-carry))))))
  (add l1 l2 0))
(define (display-list lst)
  ;; Print list elements comma-separated, no spaces, no brackets
  (define (loop lst first?)
    (if (null? lst)
        (display "")
        (begin
          (if (not first?) (display ","))
          (display (car lst))
          (loop (cdr lst) #f))))
  (loop lst #t))
(define cases
  (list
    (list (list->digits (list 2 4 3)) (list->digits (list 5 6 4)))
    (list (list->digits (list 0)) (list->digits (list 0)))
    (list (list->digits (list 9 9 9 9)) (list->digits (list 9 9 9 9 9 9)))
    (list (list->digits (list 1)) (list->digits (list 9 9)))
    (list (list->digits (list 5)) (list->digits (list 5)))
    (list (list->digits (list 1 2 3)) (list->digits (list 4 5 6)))
    (list (list->digits (list 9)) (list->digits (list 1 9 9)))
    (list (list->digits (list 2 4 3 9 9)) (list->digits (list 5 6 4)))))
(define (run-cases cases i)
  (if (null? cases)
      (display "")
      (begin
        (let ((c (car cases))
              (rest (cdr cases)))
          (let ((result (solve (car c) (car (cdr c)))))
            (display "CASE")
            (display i)
            (display "=")
            (display-list result)
            (newline)))
        (run-cases rest (+ i 1)))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "l1") (hash-ref input "l2")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/add-two-numbers/tests.json")))
