(require "lc_json" all:)
(require "compat" all:)
(define (string->chars str)
  (let ((len (string-length str)))
    (let loop ((i 0) (acc '()))
      (if (= i len)
          (reverse acc)
          (let ((c (substring str i (+ i 1))))
            (loop (+ i 1) (cons c acc)))))))
(define (lcs-length s t)
  (let ((cs (string->chars s))
        (ct (string->chars t))
        (m  (string-length t)))
    ;; dp[j] holds LCS length for prefixes ending at s[i-1] and t[j-1]
    ;; Initialize dp[j] = 0 for all j.
    (let ((dp (make-list (+ m 1) 0)))
      (let iloop ((i 0) (csi cs) (dp dp))
        (if (null? csi)
            (list-ref dp m)
            ;; prev holds dp[j-1] of the previous row; start with 0.
            (let ((prev 0)
                  (ch (car csi)))
              (let jloop ((j 1) (acc '()) (dp dp))
                (cond
                  ((> j m)
                   ;; We overwrote the list; but since we are building a fresh
                   ;; representation, we need to store back. Simpler: do
                   ;; in-place via set! on list elements using an index
                   ;; approach. So abandon this iteration style and do
                   ;; in-place mutation instead.
                   (cons 'done '()))
                  (else
                   (let ((cur (list-ref dp j))
                         (ti  (list-ref ct (- j 1))))
                     (let ((new
                             (if (string=? ch ti)
                                 (+ prev 1)
                                 (max (list-ref dp (- j 1)) cur))))
                       (set! prev cur)
                       (set! (list-ref dp j) new)
                       (jloop (+ j 1) #f dp))))))))))))
(define (list-set! lst index value)
  (let loop ((i 0) (xs lst))
    (if (= i index)
        (set-car! xs value)
        (loop (+ i 1) (cdr xs)))))
(define (lcs-length-2 s t)
  (let ((m (string-length t)))
    (let ((dp (make-list (+ m 1) 0)))
      (let iloop ((i 0) (len-s (string-length s)))
        (if (= i len-s)
            (list-ref dp m)
            (let ((ch (substring s i (+ i 1))))
              (let ((prev 0))
                (let jloop ((j 1))
                  (if (> j m)
                      (begin
                        (iloop (+ i 1) len-s))
                      (let ((cur (list-ref dp j))
                            (ti (substring t (- j 1) j)))
                        (let ((new
                                (if (string=? ch ti)
                                    (+ prev 1)
                                    (if (> (list-ref dp (- j 1)) cur)
                                        (list-ref dp (- j 1))
                                        cur))))
                          (set! prev cur)
                          (list-set! dp j new)
                          (jloop (+ j 1)))))))))))))
(define (lcs-length-clean s t)
  (let ((m (string-length t)))
    (define (char-at str k)
      (substring str k (+ k 1)))
    (let iloop ((i 0) (dp (make-list (+ m 1) 0)) (len-s (string-length s)))
      (if (= i len-s)
          (list-ref dp m)
          (let ((ch (char-at s i)))
            ;; Build new dp by scanning j=1..m, tracking prev (dp[i-1][j-1]).
            (let build ((j 1) (new-dp dp) (prev 0))
              (cond
                ((> j m)
                 (iloop (+ i 1) new-dp len-s))
                (else
                 (let ((cur (list-ref dp j))
                       (above (list-ref new-dp (- j 1)))
                       (ti (char-at t (- j 1))))
                   (let ((new
                           (if (string=? ch ti)
                               (+ prev 1)
                               (if (> above cur) above cur))))
                     (build (+ j 1)
                            (list-set-return new-dp j new)
                            cur)))))))))))
(define (list-set-return lst index value)
  (let loop ((i 0) (xs lst) (acc '()))
    (cond
      ((null? xs) (reverse acc))
      ((= i index)
       (loop (+ i 1) (cdr xs) (cons value acc)))
      (else
       (loop (+ i 1) (cdr xs) (cons (car xs) acc))))))
(define (make-list n val)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        (reverse acc)
        (loop (+ i 1) (cons val acc)))))
(define (solve s t)
  (lcs-length-clean s t))
(define (run-cases)
  (let ((cases (list
                 (list "ABCBDAB" "BDBACA")
                 (list "A" "A")
                 (list "ABC" "DEF")
                 (list "AGGTAB" "GXTXAYB")
                 (list "AAA" "AA")
                 (list "ABCDEF" "ABCDEF")
                 (list "AB" "BA")
                 (list "ZXVYZWQ" "ZYZWXRQ"))))
    (let loop ((i 0) (cs cases))
      (if (null? cs)
          'done
          (begin
            (let ((s (car (car cs)))
                  (t (car (cdr (car cs)))))
              (let ((ans (solve s t)))
                (display "CASE")
                (display (number->string i))
                (display "=")
                (display (number->string ans))
                (newline)))
            (loop (+ i 1) (cdr cs)))))))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "s") (hash-ref input "t")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/longest-common-subsequence/tests.json")))
