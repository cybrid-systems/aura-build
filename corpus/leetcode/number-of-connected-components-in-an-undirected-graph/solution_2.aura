(define (make-uf n)
  (let ((parent (list-tabulate n (lambda (i) i)))
        (rank (list-tabulate n (lambda (i) 0))))
    (cons parent rank)))

(define (list-tabulate n f)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        (reverse acc)
        (loop (+ i 1) (cons (f i) acc)))))

(define (uf-find uf x)
  (let ((parent (car uf))
        (rank (cdr uf)))
    (if (= (list-ref parent x) x)
        x
        (let ((root (uf-find uf (list-ref parent x))))
          (set-car! uf (list-set (car uf) x root))
          root))))

(define (list-set lst i v)
  (let loop ((j 0) (l lst) (acc '()))
    (if (null? l)
        (reverse acc)
        (if (= j i)
            (loop (+ j 1) (cdr l) (cons v acc))
            (loop (+ j 1) (cdr l) (cons (car l) acc))))))

(define (uf-union uf x y)
  (let ((rx (uf-find uf x))
        (ry (uf-find uf y)))
    (if (= rx ry)
        #f
        (let ((parent (car uf))
              (rank (cdr uf)))
          (let ((rx-rank (list-ref rank rx))
                (ry-rank (list-ref rank ry)))
            (cond
              ((< rx-rank ry-rank)
               (set-car! uf (list-set parent rx ry))
               #t)
              ((> rx-rank ry-rank)
               (set-car! uf (list-set parent ry rx))
               #t)
              (else
               (set-car! uf (list-set parent ry rx))
               (set-cdr! uf (list-set rank rx (+ rx-rank 1)))
               #t)))))))

(define (solve n edges)
  (let ((uf (make-uf n))
        (count n))
    (let loop ((es edges))
      (if (null? es)
          count
          (let ((u (car (car es)))
                (v (car (cdr (car es)))))
            (if (uf-union uf u v)
                (loop (cdr es))
                (loop (cdr es))))))))

(define (display-list lst)
  (display "(")
  (let loop ((l lst))
    (cond
      ((null? l) (display ")"))
      (else
        (display (car l))
        (if (null? (cdr l))
            (display ")")
            (begin
              (display " ")
              (loop (cdr l))))))))

(display "CASE0=") (display (solve 10 '())) (newline)
(display "CASE1=") (display (solve 5 (list (list 0 1) (list 1 2) (list 2 3) (list 3 4)))) (newline)
(display "CASE2=") (display (solve 1 '())) (newline)
(display "CASE3=") (display (solve 4 '())) (newline)
(display "CASE4=") (display (solve 6 (list (list 0 1) (list 2 3) (list 4 5)))) (newline)
(display "CASE5=") (display (solve 5 (list (list 0 1) (list 1 2) (list 0 2) (list 3 4)))) (newline)
(display "CASE6=") (display (solve 3 (list (list 0 1) (list 1 2)))) (newline)
(display "CASE7=") (display (solve 4 (list (list 0 1) (list 2 3) (list 1 2)))) (newline)
