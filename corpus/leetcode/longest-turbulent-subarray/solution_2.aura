(define (compare a b)
  (cond ((< a b) 'lt)
        ((> a b) 'gt)
        (else 'eq)))

(define (solve arr)
  (let ((n (length arr)))
    (if (<= n 1)
        n
        (let ((best 1)
              (curr 1)
              (prev-comp 'eq))
          (let loop ((i 1))
            (if (>= i n)
                best
                (let* ((c (compare (list-ref arr (- i 1)) (list-ref arr i)))
                       (new-curr
                        (cond ((eq? c 'eq) 1)
                              ((eq? prev-comp 'eq) 2)
                              ((or (and (eq? prev-comp 'lt) (eq? c 'gt))
                                   (and (eq? prev-comp 'gt) (eq? c 'lt)))
                               (+ curr 1))
                              (else 2))))
                  (set! best (max best new-curr))
                  (set! curr new-curr)
                  (set! prev-comp c)
                  (loop (+ i 1)))))))))

(define (display-case i arr)
  (let ((r (solve arr)))
    (display "CASE")
    (display i)
    (display "=")
    (display r)
    (newline)))

(define arr0 (list 9 4 2 10 7 8 8 1 9))
(define arr1 (list 4 8 12 16))
(define arr2 (list 1 1 1 1))
(define arr3 (list 1))
(define arr4 (list 1 2))
(define arr5 (list 2 1))
(define arr6 (list 2 1 2 1 2 1))
(define arr7 (list 1 2 3 2 1 2 3 4))

(display-case 0 arr0)
(display-case 1 arr1)
(display-case 2 arr2)
(display-case 3 arr3)
(display-case 4 arr4)
(display-case 5 arr5)
(display-case 6 arr6)
(display-case 7 arr7)
