(define (is-op? s)
  (or (equal? s "+") (equal? s "-") (equal? s "*") (equal? s "/")))

(define (trunc-div a b)
  (let ((q (quotient a b))
        (r (modulo a b)))
    (if (or (and (>= a 0) (>= b 0)) (and (< a 0) (< b 0)) (= r 0))
        q
        (- q 1))))

(define (apply-op op a b)
  (cond
    ((equal? op "+") (+ a b))
    ((equal? op "-") (- a b))
    ((equal? op "*") (* a b))
    ((equal? op "/") (trunc-div a b))
    (else 0)))

(define (string->int s)
  (let ((n (string-length s)))
    (let loop ((i 0) (sign 1) (val 0))
      (cond
        ((= i n) (* sign val))
        ((and (= i 0) (char=? (string-ref s 0) #\-))
         (loop 1 -1 val))
        ((and (= i 0) (char=? (string-ref s 0) #\+))
         (loop 1 1 val))
        (else
         (loop (+ i 1) sign
               (+ (* val 10)
                  (- (char->integer (string-ref s i)) (char->integer #\0)))))))))

(define (solve tokens)
  (let loop ((toks tokens) (stack '()))
    (cond
      ((null? toks) (car stack))
      ((is-op? (car toks))
       (let ((b (car stack))
             (a (car (cdr stack)))
             (rest (cdr (cdr stack))))
         (loop (cdr toks)
               (cons (apply-op (car toks) a b) rest))))
      (else
       (loop (cdr toks)
             (cons (string->int (car toks)) stack))))))

(define (display-list-of-int lst)
  (display "(")
  (let loop ((xs lst) (first #t))
    (cond
      ((null? xs) (display ")"))
      (first
       (display (car xs))
       (loop (cdr xs) #f))
      (else
       (display " ")
       (display (car xs))
       (loop (cdr xs) #f)))))

(display "CASE0=") (display (solve '("3" "4" "+" "5" "*"))) (newline)
(display "CASE1=") (display (solve '("15" "7" "1" "1" "+" "-" "/" "3" "*" "2" "1" "1" "+" "+" "-"))) (newline)
(display "CASE2=") (display (solve '("2" "1" "+" "3" "*"))) (newline)
(display "CASE3=") (display (solve '("4" "13" "5" "/" "+"))) (newline)
(display "CASE4=") (display (solve '("10" "6" "-" "9" "3" "+" "11" "*" "+"))) (newline)
(display "CASE5=") (display (solve '("0" "1" "/"))) (newline)
(display "CASE6=") (display (solve '("1" "2" "+" "3" "4" "-" "*" "5" "+"))) (newline)
(display "CASE7=") (display (solve '("-3" "-4" "+" "2" "*"))) (newline)
