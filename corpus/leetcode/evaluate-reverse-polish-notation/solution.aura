(define (token-list->list tokens)
  (cond ((null? tokens) '())
        (else (cons (car tokens) (token-list->list (cdr tokens))))))

(define (all-digits? s)
  (cond ((string=? s "") #f)
        ((string=? (substring s 0 1) "-") (all-digits? (substring s 1 (string-length s))))
        ((= (string-length s) 1) 
         (cond ((or (string=? (substring s 0 1) "0")
                    (string=? (substring s 0 1) "1")
                    (string=? (substring s 0 1) "2")
                    (string=? (substring s 0 1) "3")
                    (string=? (substring s 0 1) "4")
                    (string=? (substring s 0 1) "5")
                    (string=? (substring s 0 1) "6")
                    (string=? (substring s 0 1) "7")
                    (string=? (substring s 0 1) "8")
                    (string=? (substring s 0 1) "9")) #t)
               (else #f)))
        (else (and (all-digits? (substring s 0 1))
                   (all-digits? (substring s 1 (string-length s)))))))

(define (string->int s)
  (define (helper s i acc)
    (cond ((= i (string-length s)) acc)
          ((string=? (substring s i (+ i 1)) "0") (helper s (+ i 1) (+ (* acc 10) 0)))
          ((string=? (substring s i (+ i 1)) "1") (helper s (+ i 1) (+ (* acc 10) 1)))
          ((string=? (substring s i (+ i 1)) "2") (helper s (+ i 1) (+ (* acc 10) 2)))
          ((string=? (substring s i (+ i 1)) "3") (helper s (+ i 1) (+ (* acc 10) 3)))
          ((string=? (substring s i (+ i 1)) "4") (helper s (+ i 1) (+ (* acc 10) 4)))
          ((string=? (substring s i (+ i 1)) "5") (helper s (+ i 1) (+ (* acc 10) 5)))
          ((string=? (substring s i (+ i 1)) "6") (helper s (+ i 1) (+ (* acc 10) 6)))
          ((string=? (substring s i (+ i 1)) "7") (helper s (+ i 1) (+ (* acc 10) 7)))
          ((string=? (substring s i (+ i 1)) "8") (helper s (+ i 1) (+ (* acc 10) 8)))
          ((string=? (substring s i (+ i 1)) "9") (helper s (+ i 1) (+ (* acc 10) 9)))
          (else acc)))
  (cond ((= (string-length s) 0) 0)
        ((string=? (substring s 0 1) "-")
         (- 0 (helper s 1 0)))
        (else (helper s 0 0))))

(define (trunc-div a b)
  (cond ((or (= b 0) (= a 0)) 0)
        ((< (* a b) 0)
         (- 0 (quotient (abs a) (abs b))))
        (else (quotient (abs a) (abs b)))))

(define (abs n)
  (cond ((< n 0) (- 0 n))
        (else n)))

(define (apply-op op a b)
  (cond ((string=? op "+") (+ a b))
        ((string=? op "-") (- a b))
        ((string=? op "*") (* a b))
        ((string=? op "/") (trunc-div a b))
        (else 0)))

(define (eval-rpn tokens)
  (define (iter toks stack)
    (cond ((null? toks) (car stack))
          ((all-digits? (car toks))
           (iter (cdr toks) (cons (string->int (car toks)) stack)))
          (else
           (let ((b (car stack))
                 (a (car (cdr stack)))
                 (rest (cdr (cdr stack))))
             (iter (cdr toks) (cons (apply-op (car toks) a b) rest))))))
  (iter tokens '()))

(define (solve tokens)
  (eval-rpn tokens))

(define (display-list lst)
  (cond ((null? lst) (display "()"))
        (else (display "(")
              (display (car lst))
              (display-list-helper (cdr lst)))))

(define (display-list-helper lst)
  (cond ((null? lst) (display ")"))
        (else (display " ")
              (display (car lst))
              (display-list-helper (cdr lst)))))

(define t0 (list "3" "4" "+" "5" "*"))
(define t1 (list "15" "7" "1" "1" "+" "-" "/" "3" "*" "2" "1" "1" "+" "+" "-"))
(define t2 (list "2" "1" "+" "3" "*"))
(define t3 (list "4" "13" "5" "/" "+"))
(define t4 (list "10" "6" "-" "9" "3" "+" "11" "*" "+"))
(define t5 (list "0" "1" "/"))
(define t6 (list "1" "2" "+" "3" "4" "-" "*" "5" "+"))
(define t7 (list "-3" "-4" "+" "2" "*"))

(display "CASE0=") (display (solve t0)) (newline)
(display "CASE1=") (display (solve t1)) (newline)
(display "CASE2=") (display (solve t2)) (newline)
(display "CASE3=") (display (solve t3)) (newline)
(display "CASE4=") (display (solve t4)) (newline)
(display "CASE5=") (display (solve t5)) (newline)
(display "CASE6=") (display (solve t6)) (newline)
(display "CASE7=") (display (solve t7)) (newline)
