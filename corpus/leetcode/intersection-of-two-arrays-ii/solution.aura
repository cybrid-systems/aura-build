(define (take lst n)
  (if (or (null? lst) (= n 0))
      '()
      (cons (car lst) (take (cdr lst) (- n 1)))))

(define (split-by-space s)
  (let ((len (string-length s)))
    (let loop ((i 0) (start 0) (acc '()))
      (cond ((= i len)
             (reverse (cons (substring s start len) acc)))
            ((char=? (string-ref s i) #\space)
             (loop (+ i 1) (+ i 1)
                   (cons (substring s start i) acc)))
            (else
             (loop (+ i 1) start acc))))))

(define (count-list lst)
  (let loop ((xs lst) (acc '()))
    (if (null? xs)
        acc
        (let ((k (car xs))
              (rest (cdr xs)))
          (let ((found (assq k acc)))
            (if found
                (loop rest
                      (cons (cons k (+ (cdr found) 1))
                            (remove-assq k acc)))
                (loop rest (cons (cons k 1) acc))))))))

(define (remove-assq k alist)
  (cond ((null? alist) '())
        ((equal? (caar alist) k) (cdr alist))
        (else (cons (car alist) (remove-assq k (cdr alist))))))

(define (intersect-helper counts xs)
  (let loop ((xs xs) (counts counts) (out '()))
    (if (null? xs)
        out
        (let ((k (car xs))
              (rest (cdr xs)))
          (let ((found (assq k counts)))
            (if (and found (> (cdr found) 0))
                (loop rest
                      (cons (cons k (- (cdr found) 1))
                            (remove-assq k counts))
                      (cons k out))
                (loop rest counts out)))))))

(define (intersect nums1 nums2)
  (let ((c1 (count-list nums1))
        (c2 (count-list nums2)))
    (if (< (length c1) (length c2))
        (intersect-helper c1 nums2)
        (intersect-helper c2 nums1))))

(define (display-list lst)
  (let loop ((xs lst) (first? #t))
    (cond ((null? xs) #t)
          (else
           (if first?
               (begin (display (car xs)) (loop (cdr xs) #f))
               (begin (display " ") (display (car xs)) (loop (cdr xs) #f)))))))

(define (solve nums1 nums2)
  (intersect nums1 nums2))

;; ---- Embedded test cases ----
(display "CASE0=") (display-list (solve (list 1 2 2 1) (list 2 2))) (newline)
(display "CASE1=") (display-list (solve (list 4 9 5) (list 9 4 9 8 4))) (newline)
(display "CASE2=") (display-list (solve (list 1 2 3 4) (list 3 4 5 6))) (newline)
(display "CASE3=") (display-list (solve '() (list 1 2 3))) (newline)
(display "CASE4=") (display-list (solve (list 1 1 1 1) (list 1 1))) (newline)
(display "CASE5=") (display-list (solve (list 1 2 3) '())) (newline)
(display "CASE6=") (display-list (solve (list 5 5 5 5 5) (list 5 5 5))) (newline)
(display "CASE7=") (display-list (solve (list 0 0 0) (list 0 0))) (newline)
