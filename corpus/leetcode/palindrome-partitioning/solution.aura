(define (s->list s)
  (let ((len (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (>= i len)
          (reverse acc)
          (loop (+ i 1) (cons (string (string-ref s i)) acc))))))

(define (substring-of s i j)
  (let ((len (- j i)))
    (let loop ((k 0) (acc '()))
      (if (>= k len)
          (apply string-append (reverse acc))
          (loop (+ k 1) (cons (string (string-ref s (+ i k))) acc))))))

(define (palindrome? s)
  (let ((n (string-length s)))
    (let loop ((l 0) (r (- n 1)))
      (cond ((>= l r) #t)
            ((not (char=? (string-ref s l) (string-ref s r))) #f)
            (else (loop (+ l 1) (- r 1)))))))

(define (partition-helper s start current result)
  (let ((n (string-length s)))
    (cond ((>= start n)
             (set! result (cons (reverse current) result)))
           (else
            (let loop ((end start) (acc result))
              (if (> end n)
                  acc
                  (let ((sub (substring-of s start end)))
                    (if (palindrome? sub)
                        (partition-helper s (+ end 1) (cons sub current) acc)
                        acc)))))))
  result)

(define (solve s)
  (partition-helper s 0 '() '()))

(define (display-list lst)
  (display "[")
  (let loop ((l lst) (first #t))
    (cond ((null? l) (display "]"))
          (else
           (if first (set! first #f) (begin (display ",") (display " ")))
           (display (car l))
           (loop (cdr l) first))))
  (display "]"))

(define (display-partitions parts)
  (display "[")
  (let loop ((p parts) (first #t))
    (cond ((null? p) (display "]"))
          (else
           (if first (set! first #f) (begin (display ",") (display " ")))
           (display-list (car p))
           (loop (cdr p) first)))))

(display "CASE0=") (display-partitions (solve "aab")) (newline)
(display "CASE1=") (display-partitions (solve "a")) (newline)
(display "CASE2=") (display-partitions (solve "aba")) (newline)
(display "CASE3=") (display-partitions (solve "abba")) (newline)
(display "CASE4=") (display-partitions (solve "aaaa")) (newline)
(display "CASE5=") (display-partitions (solve "abc")) (newline)
(display "CASE6=") (display-partitions (solve "aabaa")) (newline)
(display "CASE7=") (display-partitions (solve "ab")) (newline)
