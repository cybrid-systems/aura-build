(require "lc_json" all:)
(require "compat" all:)
(define (solve n arr)
  (let ((sums '()))
    (define (backtrack i current-sum)
      (if (= i n)
          (if (not (null? 'dummy))
              (set! sums (cons current-sum sums))
              #f)
          (begin
            (backtrack (+ i 1) (+ current-sum (list-ref arr i)))
            (backtrack (+ i 1) current-sum))))
    (backtrack 0 0)
    (set! sums (cdr sums))
    (set! sums (sort-dedup sums))
    sums))
(define (sort-dedup lst)
  (let ((sorted (sort-list lst <)))
    (define (dedup xs)
      (if (or (null? xs) (null? (cdr xs)))
          xs
          (if (= (car xs) (cadr xs))
              (dedup (cdr xs))
              (cons (car xs) (dedup (cdr xs))))))
    (dedup sorted)))
(define (sort-list lst cmp)
  (if (null? lst)
      '()
      (let ((pivot (car lst))
            (rest (cdr lst)))
        (append (sort-list (filter (lambda (x) (cmp x pivot)) rest) cmp)
                (list pivot)
                (sort-list (filter (lambda (x) (not (cmp x pivot))) rest) cmp)))))
(define (filter pred lst)
  (cond ((null? lst) '())
        ((pred (car lst)) (cons (car lst) (filter pred (cdr lst))))
        (else (filter pred (cdr lst)))))
(define (append a b)
  (if (null? a) b (cons (car a) (append (cdr a) b))))
(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) (- i 1))))
(define (display-list lst)
  (define (helper xs first)
    (if (null? xs)
        (begin (newline) 'done)
        (begin
          (if (not first) (display " ") 'no)
          (display (car xs))
          (helper (cdr xs) #f))))
  (helper lst #t))

(require "lc_json" all:)
(define (lc-emit t)
  (let ((input (hash-ref t "input")))
    (lc-show (hash-ref t "id") (solve (hash-ref input "n") (hash-ref input "arr")))))
(define (lc-go ts)
  (if (null? ts) 0 (begin (lc-emit (car ts)) (lc-go (cdr ts)))))
(lc-go (json-parse (read-file "corpus/leetcode/subset-sums/tests.json")))
