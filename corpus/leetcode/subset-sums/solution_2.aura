(define (merge l r)
  (cond ((null? l) r)
        ((null? r) l)
        ((<= (car l) (car r))
         (cons (car l) (merge (cdr l) r)))
        (else
         (cons (car r) (merge l (cdr r))))))

(define (mergesort lst)
  (if (or (null? lst) (null? (cdr lst)))
      lst
      (let* ((len (length lst))
             (mid (quotient len 2))
             (split (lambda (l n acc)
                      (if (= n 0)
                          (cons (reverse acc) l)
                          (split (cdr l) (- n 1) (cons (car l) acc)))))
             (sp (split lst mid '()))
             (left (car sp))
             (right (cdr sp)))
        (merge (mergesort left) (mergesort right)))))

(define (dedup lst)
  (cond ((null? lst) '())
        ((null? (cdr lst)) lst)
        ((= (car lst) (cadr lst)) (dedup (cdr lst)))
        (else (cons (car lst) (dedup (cdr lst))))))

(define (backtrack arr idx end curr-sum acc)
  (if (>= idx end)
      (if (> curr-sum 0)
          (cons curr-sum acc)
          acc)
      (let ((with (backtrack arr (+ idx 1) end (+ curr-sum (list-ref arr idx)) acc))
            (without (backtrack arr (+ idx 1) end curr-sum acc)))
        (append with without))))

(define (solve n arr)
  (let ((sums (backtrack arr 0 n 0 '())))
    (dedup (mergesort sums))))

(define (display-list lst)
  (if (null? lst)
      (display "")
      (begin
        (display (car lst))
        (if (null? (cdr lst))
            (display "")
            (begin
              (display " ")
              (display-list (cdr lst)))))))

(define (run-case i n arr)
  (display "CASE")
  (display i)
  (display "=")
  (display-list (solve n arr))
  (newline))

(run-case 0 3 '(1 2 3))
(run-case 1 1 '(5))
(run-case 2 2 '(-1 1))
(run-case 3 4 '(1 2 4 8))
(run-case 4 1 '(-5))
(run-case 5 2 '(10 20))
