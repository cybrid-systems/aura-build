; soft_leetcode_runtime slug=binary-tree-maximum-path-sum path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=host_parallel fiber_llm_ok=true
; selected=llm-61 hits=8/8
; baseline_hits=0/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define node-val
    (lambda (n)
      (if (null? n)
        0
        (if (eq?
            (car n) (quote :val))
          (car (cdr n))
          (cadr (memq
              (quote :val) (cons
                (quote dummy) n)))))))
  (define plist-ref
    (lambda (plist key)
      (if (null? plist)
        #f
        (if (eq?
            (car plist) key)
          (car (cdr plist))
          (plist-ref
            (cdr (cdr plist)) key)))))
  (define node-val
    (lambda (n)
      (plist-ref
        n (quote :val))))
  (define node-left
    (lambda (n)
      (let ((v (plist-ref
          n (quote :left))))
        (if (eq?
            v #f)
          (quote ())
          v))))
  (define node-right
    (lambda (n)
      (let ((v (plist-ref
          n (quote :right))))
        (if (eq?
            v #f)
          (quote ())
          v))))
  (define G 0)
  (define max
    (lambda (a b)
      (if (>
          a b)
        a
        b)))
  (define max3
    (lambda (a b c)
      (max
        a (max
          b c))))
  (define solve
    (lambda (node)
      (begin
        (set! G (node-val node))
        (define helper
          (lambda (n)
            (if (null? n)
              0
              (let ((lv (helper (node-left n))))
                (let ((rv (helper (node-right n))))
                  (let ((v (node-val n)))
                    (begin
                      (set! G (max3
                          G (+
                            v lv rv) v))
                      (max
                        0 (+
                          v (max
                            lv rv))))))))))
        (let ((_ (helper node)))
          G))))
  (define display-case
    (lambda (i result)
      (begin
        (display "CASE")
        (display i)
        (display "=")
        (display result)
        (newline))))
  (define run
    (lambda ()
      (begin
        (display-case
          0 (solve (quote (:val
                1 :left (:val 2) :right (:val 3)))))
        (display-case
          1 (solve (quote (:val
                -10 :left (:val 9) :right (:val
                  20 :left (:val 15) :right (:val 7))))))
        (display-case
          2 (solve (quote (:val -3))))
        (display-case
          3 (solve (quote (:val
                2 :left (:val -1)))))
        (display-case
          4 (solve (quote (:val
                5 :left (:val
                  4 :left (:val
                    11 :left (:val 7) :right (:val 2))) :right (:val
                  8 :left (:val 13) :right (:val
                    4 :right (:val 1)))))))
        (display-case
          5 (solve (quote (:val
                -1 :left (:val -2) :right (:val -3)))))
        (display-case
          6 (solve (quote (:val
                1 :left (:val -2) :right (:val 3)))))
        (display-case
          7 (solve (quote (:val 0)))))))
  (run))
