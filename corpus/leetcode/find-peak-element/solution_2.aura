(define (list-get lst i)
  (if (= i 0)
      (car lst)
      (list-get (cdr lst) (- i 1))))

(define (list-len lst)
  (if (null? lst)
      0
      (+ 1 (list-len (cdr lst)))))

(define (peak-helper arr lo hi)
  (if (= lo hi)
      lo
      (let ((mid (quotient (+ lo hi) 2)))
        (let ((mid-val (list-get arr mid))
              (right-val (list-get arr (+ mid 1))))
          (if (> mid-val right-val)
              (peak-helper arr lo mid)
              (peak-helper arr (+ mid 1) hi))))))

(define (solve arr)
  (peak-helper arr 0 (- (list-len arr) 1)))

(define (run-test i arr)
  (display "CASE")
  (display i)
  (display "=")
  (display (solve arr))
  (newline))

(run-test 0 '(1 2 3 1))
(run-test 1 '(1 2 1 3 5 6 4))
(run-test 2 '(1))
(run-test 3 '(2 1))
(run-test 4 '(1 2))
(run-test 5 '(1 1 1 1 1))
(run-test 6 '(5 4 3 2 1))
(run-test 7 '(1 2 3 4 6 5))
(run-test 8 '(3 4 3 2 1))
(run-test 9 '(10 20 15 2 23 90 67))
