;; Find Peak Element - O(log n) binary search approach

(define (nth lst i)
  (if (= i 0)
      (car lst)
      (nth (cdr lst) (- i 1))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

;; Access helper for vector (represented as list with length)
(define (vec-get arr i n)
  (if (= i 0)
      (car arr)
      (vec-get (cdr arr) (- i 1) (- n 1))))

(define (find-peak arr lo hi)
  (if (= lo hi)
      lo
      (let ((mid (quotient (+ lo hi) 2))
            (n (+ (- hi lo) 1)))
        (let ((mid-val (vec-get arr mid n))
              (right-val (if (< (+ mid 1) hi)
                             (vec-get arr (+ mid 1) n)
                             -9999999999)))
          (if (> mid-val right-val)
              (find-peak arr lo mid)
              (find-peak arr (+ mid 1) hi)))))

(define (solve arr)
  (let ((n (length arr)))
    (find-peak arr 0 (- n 1))))

;; Display helper for case output
(define (display-case i result)
  (display "CASE")
  (display i)
  (display "=")
  (display result)
  (newline))

;; Embedded test inputs
(define tests
  (list
    (list 1 2 3 1)
    (list 1 2 1 3 5 6 4)
    (list 1)
    (list 2 1)
    (list 1 2)
    (list 1 1 1 1 1)
    (list 5 4 3 2 1)
    (list 1 2 3 4 6 5)
    (list 3 4 3 2 1)
    (list 10 20 15 2 23 90 67)))

(define (run-tests lst i)
  (if (null? lst)
      'done
      (begin
        (display-case i (solve (car lst)))
        (run-tests (cdr lst) (+ i 1)))))

(run-tests tests 0)
