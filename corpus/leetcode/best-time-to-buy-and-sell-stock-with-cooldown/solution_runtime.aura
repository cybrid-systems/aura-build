; soft_leetcode_runtime slug=best-time-to-buy-and-sell-stock-with-cooldown path=llm
; materialize=current-source worldline_backend=fiber_graph
; fiber_live=true incr_proven=false
; llm_via=fiber fiber_llm_ok=true
; selected=llm-0 hits=8/8
; baseline_hits=3/8
; Expected values used only for host scoring / LLM context, not hardcoded into display.
(begin
  (define solve
    (lambda (prices)
      (let ((n (length prices)))
        (if (<=
            n 1)
          0
          (if (=
              n 0)
            0
            (let ((p0 (car prices)))
              (let ((hold (- p0)))
                (let ((sold (- 999999999)))
                  (let ((rest 0))
                    (letrec ((loop (lambda (i h s r)
                        (if (>=
                            i n)
                          (if (>
                              s r)
                            s
                            r)
                          (let ((p (list-ref
                              prices i)))
                            (loop
                              (+
                                i 1) (if (>
                                  h (-
                                    r p))
                                h
                                (-
                                  r p)) (+
                                h p) (if (>
                                  r s)
                                r
                                s)))))))
                      (loop
                        1 hold sold rest)))))))))))
  (display "CASE0=")
  (display (solve (list
        1 2 3 0 2)))
  (newline)
  (display "CASE1=")
  (display (solve (list 1)))
  (newline)
  (display "CASE2=")
  (display (solve (list)))
  (newline)
  (display "CASE3=")
  (display (solve (list
        1 2 4)))
  (newline)
  (display "CASE4=")
  (display (solve (list
        2 1 4)))
  (newline)
  (display "CASE5=")
  (display (solve (list
        6 1 3 2 4 7)))
  (newline)
  (display "CASE6=")
  (display (solve (list
        1 2 3 4 5)))
  (newline)
  (display "CASE7=")
  (display (solve (list
        5 4 3 2 1)))
  (newline))
