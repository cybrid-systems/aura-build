;; Next Permutation in Aura
;; Approach: standard next_permutation algorithm
;; 1) Find largest index i such that arr[i] < arr[i+1]. If none, reverse all.
;; 2) Find largest index j > i such that arr[i] < arr[j].
;; 3) Swap arr[i] and arr[j].
;; 4) Reverse the suffix starting at i+1.

(define (list-ref lst i)
  (if (= i 0)
      (car lst)
      (list-ref (cdr lst) i)))

(define (list-set! lst i v)
  ;; mutate list using set-car! / set-cdr!
  (if (= i 0)
      (begin
        (set-car! lst v)
        #t)
      (list-set! (cdr lst) (- i 1) v)))

(define (list-swap! lst i j)
  (let ((vi (list-ref lst i))
        (vj (list-ref lst j)))
    (list-set! lst i vj)
    (list-set! lst j vi)))

(define (list-reverse-suffix! lst start)
  ;; reverse the list starting from index `start` to end
  ;; We need to gather elements from start..end, then rewrite in reverse.
  (define (take-rest l k)
    (if (= k 0)
        '()
        (cons (car l) (take-rest (cdr l) (- k 1)))))
  (define (write-back! l k vals)
    (if (null? vals)
        #t
        (begin
          (set-car! l (car vals))
          (write-back! (cdr l) (- k 1) (cdr vals)))))
  (let ((rest-lst (take-rest lst start)))
    (define (rev xs acc)
      (if (null? xs)
          acc
          (rev (cdr xs) (cons (car xs) acc))))
    (let ((revd (rev rest-lst '())))
      (write-back! lst start revd))))

(define (length lst)
  (if (null? lst)
      0
      (+ 1 (length (cdr lst)))))

(define (find-pivot lst n)
  ;; find largest i with 0 <= i < n-1 such that arr[i] < arr[i+1]
  ;; return -1 if none
  (define (helper i)
    (if (< i 0)
        -1
        (let ((a (list-ref lst i))
              (b (list-ref lst (+ i 1))))
          (if (< a b)
              i
              (helper (- i 1))))))
  (helper (- n 2)))

(define (find-j lst n pivot)
  ;; find largest j in [pivot+1, n-1] such that arr[pivot] < arr[j]
  (define (helper j)
    (if (< j (+ pivot 1))
        (+ pivot 1)
        (let ((a (list-ref lst pivot))
              (b (list-ref lst j)))
          (if (< a b)
              j
              (helper (- j 1))))))
  (helper (- n 1)))

(define (next-permutation! arr n)
  (let ((i (find-pivot arr n)))
    (if (= i -1)
        (list-reverse-suffix! arr 0)
        (let ((j (find-j arr n i)))
          (list-swap! arr i j)
          (list-reverse-suffix! arr (+ i 1))))))

(define (solve n arr)
  (next-permutation! arr n)
  arr)

;; helper to display a list in readable form: [a b c]
(define (display-list lst)
  (display "[")
  (define (loop xs)
    (cond ((null? xs) (display "]"))
          (else
           (display (car xs))
           (if (not (null? (cdr xs)))
               (display " "))
           (loop (cdr xs)))))
  (loop lst)
  (newline))

;; ---------- Test harness ----------
(define CASE0 3)
(define CASE0_ARR (list 1 2 3))
(define CASE1 3)
(define CASE1_ARR (list 3 2 1))
(define CASE2 3)
(define CASE2_ARR (list 1 1 5))
(define CASE3 4)
(define CASE3_ARR (list 1 3 2 4))
(define CASE4 4)
(define CASE4_ARR (list 1 2 3 4))
(define CASE5 1)
(define CASE5_ARR (list 1))
(define CASE6 4)
(define CASE6_ARR (list 2 3 1 3))
(define CASE7 5)
(define CASE7_ARR (list 5 4 3 2 1))

(display "CASE0=") (display-list (solve CASE0 CASE0_ARR))
(display "CASE1=") (display-list (solve CASE1 CASE1_ARR))
(display "CASE2=") (display-list (solve CASE2 CASE2_ARR))
(display "CASE3=") (display-list (solve CASE3 CASE3_ARR))
(display "CASE4=") (display-list (solve CASE4 CASE4_ARR))
(display "CASE5=") (display-list (solve CASE5 CASE5_ARR))
(display "CASE6=") (display-list (solve CASE6 CASE6_ARR))
(display "CASE7=") (display-list (solve CASE7 CASE7_ARR))
