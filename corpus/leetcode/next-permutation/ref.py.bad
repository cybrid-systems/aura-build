def solve(n, arr):
    i = n - 2
    while i >= 0 and arr[i] >= arr[i + 1]:
        i -= 1
    if i >= 0:
        j = n - 1
        while arr[j] <= arr[i]:
            j -= 1
        arr[i], arr[j] = arr[j], arr[i]
    # reverse suffix
    l, r = i + 1, n - 1
    while l < r:
        arr[l], arr[r] = arr[r], arr[l]
        l += 1
        r -= 1
    return arr


CASES = [
    {"n": 3, "arr": [1, 2, 3]},
    {"n": 3, "arr": [3, 2, 1]},
    {"n": 4, "arr": [1, 1, 5]},
    {"n": 4, "arr": [1, 3, 2, 4]},
    {"n": 1, "arr": [1]},
    {"n": 2, "arr": [1, 1]},
    {"n": 5, "arr": [1, 5, 1]},
    {"n": 6, "arr": [1, 2, 3, 4, 5, 6]},
]

EXPECTED = [
    [1, 3, 2],
    [1, 2, 3],
    [1, 5, 1],
    [1, 3, 4, 2],
    [1],
    [1, 1],
    [5, 1, 1],
    [1, 2, 3, 4, 6, 5],
]


if __name__ == '__main__':
    import json
    out = []
    for i, c in enumerate(CASES):
        inp = {"n": c["n"], "arr": list(c["arr"])}
        result = solve(c["n"], list(c["arr"]))
        out.append({"id": i, "input": inp, "expected": json.dumps(EXPECTED[i], separators=(',', ':'), ensure_ascii=False)})
    print(json.dumps(out, separators=(',', ':'), ensure_ascii=False))
