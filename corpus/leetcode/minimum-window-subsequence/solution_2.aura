(define (string-length s)
  (let loop ((i 0) (rest s))
    (if (null? rest)
        i
        (loop (+ i 1) (cdr rest)))))

(define (string-ref s i)
  (let loop ((i i) (rest s))
    (if (= i 0)
        (car rest)
        (loop (- i 1) (cdr rest)))))

(define (substring s start end)
  (let loop ((i 0) (rest s) (acc '()))
    (cond ((null? rest) (reverse acc))
          ((and (>= i start) (< i end))
           (loop (+ i 1) (cdr rest) (cons (car rest) acc)))
          (else (loop (+ i 1) (cdr rest) acc)))))

(define (list->string lst)
  (let loop ((rest lst) (acc ""))
    (if (null? rest)
        acc
        (loop (cdr rest) (string-append acc (string (car rest)))))))

(define (string . cs) (list->string cs))

(define (find-forward-end s i n t m)
  (let loop ((si i) (ti 0))
    (cond ((= ti m) (- si 1))
          ((>= si n) -1)
          ((equal? (string-ref s si) (string-ref t ti))
           (loop (+ si 1) (+ ti 1)))
          (else (loop (+ si 1) ti)))))

(define (solve s t)
  (let* ((n (string-length s))
         (m (string-length t))
         (best-start -1)
         (best-end -1))
    (let loop-i ((i 0))
      (if (>= i n)
          (begin)
          (let ((j (find-forward-end s i n t m)))
            (if (= j -1)
                (begin)
                (let ((len (- j i)))
                  (if (or (= best-start -1)
                          (< len (- best-end best-start))
                          (and (= len (- best-end best-start))
                               (< i best-start)))
                      (begin
                        (set! best-start i)
                        (set! best-end (+ j 1)))
                      (begin)))
                (let ((j2 (find-forward-end s (+ i 1) n t m)))
                  (if (= j2 -1)
                      (begin)
                      (let ((len2 (- j2 (+ i 1))))
                        (if (or (= best-start -1)
                                (< len2 (- best-end best-start))
                                (and (= len2 (- best-end best-start))
                                     (< (+ i 1) best-start)))
                            (begin
                              (set! best-start (+ i 1))
                              (set! best-end (+ j2 1)))
                            (begin)))))))
            (loop-i (+ i 1)))))
    (if (= best-start -1)
        ""
        (list->string (substring s best-start best-end)))))

(define (display-case i result)
  (display "CASE")
  (display (number->string i))
  (display "=")
  (display result)
  (newline))

(define (run-case i s t)
  (display-case i (solve s t)))

(run-case 0 "abacbabc" "abcabc")
(run-case 1 "abc" "abc")
(run-case 2 "abc" "abcd")
(run-case 3 "aaaaa" "aaa")
(run-case 4 "cabbac" "ab")
(run-case 5 "a" "a")
(run-case 6 "abcdebdde" "bde")
(run-case 7 "jmeqksfrqdcvcwv" "krqe")
(run-case 8 "ofashionnation" "ofn")
(run-case 9 "xyzabcxyzabc" "abc")
