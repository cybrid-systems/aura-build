;; Maximum Frequency Stack - Aura solution

(define (make-stack)
  ;; freq-map: association list of (x . count)
  ;; groups: list of stacks indexed by frequency
  ;; max-freq: current max frequency
  (let ((freq-map '()) (groups (list (list))) (max-freq 0))
    (define (get-freq x)
      (let loop ((m freq-map))
        (cond ((null? m) 0)
              ((equal? (car (car m)) x) (cdr (car m)))
              (else (loop (cdr m))))))
    (define (set-freq x f)
      (set! freq-map (cons (cons x f) freq-map)))
    (define (get-group f)
      ;; groups stored as list of lists; groups[i] is a list (stack)
      (let loop ((g groups) (i 0))
        (cond ((= i f) (car g))
              ((null? g) '())
              (else (loop (cdr g) (+ i 1))))))
    (define (set-group f s)
      (let loop ((g groups) (i 0) (acc '()))
        (cond ((= i f)
               (set! groups (append (reverse acc) (cons s (cdr g)))))
              (else (loop (cdr g) (+ i 1) (cons (car g) acc))))))
    (define (ensure-group f)
      (let loop ((g groups) (i 0))
        (cond ((null? g) (set! groups (append groups (list '()))) (loop groups (+ i 1)))
              ((< i f) (set! groups (append groups (list '()))) (loop (append g (list '()))) (+ i 1))
              (else #t))))
    (lambda (op x)
      (cond ((equal? op 'push)
             (let* ((f (get-freq x))
                    (new-f (+ f 1)))
               (set-freq x new-f)
               (if (> new-f max-freq)
                   (begin (set! max-freq new-f)
                          (set! groups (append groups (list (list x))))))
               (if (<= new-f (- (length groups) 1))
                   (begin
                     (let ((grp (get-group new-f)))
                       (set-group new-f (cons x grp))))
                   (set-group new-f (list x)))
               (set! max-freq (if (> new-f max-freq) new-f max-freq))
               #f))
            ((equal? op 'pop)
             (let ((grp (get-group max-freq)))
               (if (null? grp) #f
                   (let ((v (car grp))
                         (rest (cdr grp)))
                     (set-group max-freq rest)
                     (let ((f (get-freq v)))
                       (set-freq v (- f 1)))
                     (if (null? rest)
                         (set! max-freq (- max-freq 1)))
                     v))))))))

(define (solve ops)
  (let ((stk (make-stack))
        (results '()))
    (let loop ((i 0))
      (if (>= i (length ops))
          (reverse results)
          (let ((op (list-ref ops i)))
            (if (equal? (car op) 'push)
                (begin (stk 'push (car (cdr op)))
                       (loop (+ i 1)))
                (begin (set! results (cons (stk 'pop) results))
                       (loop (+ i 1))))))))

;; Test cases - print results
(define test0 '(("push" 1) ("push" 2) ("push" 2) ("push" 1) ("push" 1) ("pop") ("pop") ("pop")))
(define test1 '(("push" 5) ("pop")))
(define test2 '(("push" 7) ("push" 7) ("push" 7) ("pop") ("pop") ("pop")))
(define test3 '(("push" 1) ("push" 2) ("push" 3) ("pop") ("pop") ("pop")))
(define test4 '(("push" 1) ("push" 2) ("push" 1) ("push" 2) ("pop") ("pop") ("pop") ("pop")))
(define test5 '(("push" 1) ("pop") ("push" 1) ("push" 1) ("push" 1) ("pop") ("pop") ("pop")))
(define test6 '(("push" -1) ("push" -2) ("push" -1) ("pop") ("pop") ("pop")))
(define test7 '(("push" 1) ("push" 2) ("push" 3) ("push" 2) ("push" 3) ("push" 3) ("pop") ("pop") ("pop") ("pop") ("pop") ("pop")))

(display "CASE0=") (display (solve test0)) (newline)
(display "CASE1=") (display (solve test1)) (newline)
(display "CASE2=") (display (solve test2)) (newline)
(display "CASE3=") (display (solve test3)) (newline)
(display "CASE4=") (display (solve test4)) (newline)
(display "CASE5=") (display (solve test5)) (newline)
(display "CASE6=") (display (solve test6)) (newline)
(display "CASE7=") (display (solve test7)) (newline)
