(define (solve ops)
  (let ((freq (make-hash)) ; map value -> frequency
        (group (make-hash)) ; map frequency -> list of values (stack-like)
        (max-freq 0)
        (result '()))
    (define (freq-get x)
      (let ((v (hash-get freq x)))
        (if v v 0)))
    (define (group-push f x)
      (let ((lst (hash-get group f)))
        (if lst
            (hash-set group f (cons x lst))
            (hash-set group f (cons x '())))))
    (define (group-pop f)
      (let ((lst (hash-get group f)))
        (let ((v (car lst))
              (rest (cdr lst)))
          (if (null? rest)
              (hash-remove group f)
              (hash-set group f rest))
          v)))
    (define (process op)
      (let ((head (car op)))
        (if (equal? head "push")
            (let ((x (car (cdr op)))
                  (f (+ (freq-get x) 1)))
              (hash-set freq x f)
              (group-push f x)
              (if (> f max-freq) (set! max-freq f) '()))
            ; pop
            (let ((v (group-pop max-freq)))
              (set! result (append result (list v)))
              (hash-set freq v (- (freq-get v) 1))
              (let ((new-max 0))
                (define (find-max k)
                  (cond ((null? k) '())
                        ((> (car k) new-max) (set! new-max (car k)) '())
                        (else (find-max (cdr k)))))
                ; find new max freq by iterating possible frequencies
                (let loop ((f max-freq))
                  (cond ((<= f 0) (set! max-freq new-max) '())
                        ((hash-has? group f)
                         (if (> f new-max) (set! new-max f) '())
                         (loop (- f 1)))
                        (else (loop (- f 1))))))))))
    (define (run lst)
      (if (null? lst) '()
          (begin (process (car lst)) (run (cdr lst)))))
    (run ops)
    result))

; Helper hash functions (Aura doesn't have built-in hash, so use assoc lists)
(define (make-hash) '())
(define (hash-get h k)
  (cond ((null? h) #f)
        ((equal? (car (car h)) k) (cdr (car h)))
        (else (hash-get (cdr h) k))))
(define (hash-set h k v)
  (cond ((null? h) (list (cons k v)))
        ((equal? (car (car h)) k) (cons (cons k v) (cdr h)))
        (else (cons (car h) (hash-set (cdr h) k v)))))
(define (hash-remove h k)
  (cond ((null? h) '())
        ((equal? (car (car h)) k) (cdr h))
        (else (cons (car h) (hash-remove (cdr h) k)))))
(define (hash-has? h k)
  (cond ((null? h) #f)
        ((equal? (car (car h)) k) #t)
        (else (hash-has? (cdr h) k))))

; Display helpers
(define (display-list lst)
  (cond ((null? lst) '())
        (else (display (car lst))
              (if (null? (cdr lst)) '() (begin (display " ") (display-list (cdr lst)))))))

; Test cases
(define c0 '(("push" 1) ("push" 2) ("push" 2) ("push" 1) ("push" 1) ("pop") ("pop") ("pop")))
(define c1 '(("push" 5) ("pop")))
(define c2 '(("push" 7) ("push" 7) ("push" 7) ("pop") ("pop") ("pop")))
(define c3 '(("push" 1) ("push" 2) ("push" 3) ("pop") ("pop") ("pop")))
(define c4 '(("push" 1) ("push" 2) ("push" 1) ("push" 2) ("pop") ("pop") ("pop") ("pop")))
(define c5 '(("push" 1) ("pop") ("push" 1) ("push" 1) ("push" 1) ("pop") ("pop") ("pop")))
(define c6 '(("push" -1) ("push" -2) ("push" -1) ("pop") ("pop") ("pop")))
(define c7 '(("push" 1) ("push" 2) ("push" 3) ("push" 2) ("push" 3) ("push" 3) ("pop") ("pop") ("pop") ("pop") ("pop") ("pop")))

(display "CASE0=") (display-list (solve c0)) (newline)
(display "CASE1=") (display-list (solve c1)) (newline)
(display "CASE2=") (display-list (solve c2)) (newline)
(display "CASE3=") (display-list (solve c3)) (newline)
(display "CASE4=") (display-list (solve c4)) (newline)
(display "CASE5=") (display-list (solve c5)) (newline)
(display "CASE6=") (display-list (solve c6)) (newline)
(display "CASE7=") (display-list (solve c7)) (newline)
