;; N-Queens II - count distinct solutions using backtracking with three boolean arrays

(define (make-vector n)
  (let loop ((i 0) (v '()))
    (if (>= i n)
        (list->vector (reverse v))
        (loop (+ i 1) (cons #f v)))))

(define (solve n)
  (let* ((cols (make-vector n))
         (diag1 (make-vector (* 2 n)))
         (diag2 (make-vector (* 2 n)))
         (result 0))
    (define (backtrack row)
      (if (= row n)
          (set! result (+ result 1))
          (begin
            (define c 0)
            (while (< c n)
              (if (and (not (vector-ref cols c))
                       (not (vector-ref diag1 (+ (- row c) n)))
                       (not (vector-ref diag2 (+ (+ row c) n))))
                  (begin
                    (vector-set! cols c #t)
                    (vector-set! diag1 (+ (- row c) n) #t)
                    (vector-set! diag2 (+ (+ row c) n) #t)
                    (backtrack (+ row 1))
                    (vector-set! cols c #f)
                    (vector-set! diag1 (+ (- row c) n) #f)
                    (vector-set! diag2 (+ (+ row c) n) #f)))
              (set! c (+ c 1))))))
    (backtrack 0)
    result))

;; Read CASE0=... lines from stdin until EOF
(define (read-all)
  (let loop ((line (read-line)))
    (if (eof-object? line)
        '()
        (cons line (loop (read-line))))))

(define (parse-n line)
  (let* ((eq-pos (string-index line #\=))
         (s (substring line (+ eq-pos 1)))
         (len (string-length s)))
    (let loop ((i 0) (acc 0))
      (if (>= i len)
          acc
          (let ((ch (string-ref s i)))
            (if (and (char>=? ch #\0) (char<=? ch #\9))
                (loop (+ i 1) (+ (* acc 10) (- (char->integer ch) (char->integer #\0))))
                (loop (+ i 1) acc)))))))

(define (run-cases lines)
  (let loop ((ls lines) (i 0))
    (if (null? ls)
        '()
        (let* ((n (parse-n (car ls)))
               (ans (solve n)))
          (display (string-append "CASE" (number->string i)))
          (display "=")
          (display ans)
          (newline)
          (loop (cdr ls) (+ i 1))))))

(run-cases (read-all))
