(define (make-deque) (cons '() '()))
(define (deque-empty? d) (null? (car d)))
(define (deque-front d) (car (car d)))
(define (deque-back d) (car (cdr d)))
(define (deque-push-back! d x)
  (set-car! (cdr d) (cons x (car (cdr d)))))
(define (deque-pop-front! d)
  (let ((f (car (car d))))
    (set-car! d (cdr (car d)))
    f))
(define (deque-pop-back! d)
  (let ((b (car (cdr d))))
    (set-cdr! d (cdr (cdr d)))
    b))

(define (list-ref-aux lst i)
  (if (= i 0) (car lst) (list-ref-aux (cdr lst) (- i 1))))

(define (list-length-aux lst acc)
  (if (null? lst) acc (list-length-aux (cdr lst) (+ acc 1))))

(define (my-length lst) (list-length-aux lst 0))

(define (deque->list d)
  (define (rev-acc lst acc)
    (if (null? lst) acc (rev-acc (cdr lst) (cons (car lst) acc))))
  (rev-acc (car d) '()))

(define (solve nums k)
  (let* ((n (my-length nums))
         (deque (make-deque))
         (result '()))
    (define (clear-old i)
      (if (and (not (deque-empty? deque))
               (< (- i (- k 1)) (deque-front deque)))
          (begin (deque-pop-front! deque) (clear-old i))
          '()))
    (define (push-val i)
      (let ((v (list-ref-aux nums i)))
        (define (pop-loop)
          (if (and (not (null? (cdr deque)))
                   (<= (deque-back deque) v))
              (begin (deque-pop-back! deque) (pop-loop))
              '()))
        (pop-loop)
        (deque-push-back! deque v)))
    (define (loop i)
      (if (>= i n) result
          (let ((rest (clear-old i)))
              rest
              (push-val i)
              (if (>= i (- k 1))
                  (loop (+ i 1) (cons (deque-front deque) result))
                  (loop (+ i 1) result)))))
    (loop 0)))

;; Test harness - prints CASEi= for each input
(define (display-list lst)
  (display "[")
  (define (loop rest)
    (cond ((null? rest) (display "]"))
          (else (display (car rest))
                (if (null? (cdr rest))
                    (display "]")
                    (begin (display ", ") (loop (cdr rest)))))))
  (loop lst))

(display "CASE0=") (display-list (solve '(1 3 -1 -3 5 3 6 7) 3)) (newline)
(display "CASE1=") (display-list (solve '(1) 1)) (newline)
(display "CASE2=") (display-list (solve '(1 2 3) 4)) (newline)
(display "CASE3=") (display-list (solve '(4 4 4 4) 2)) (newline)
(display "CASE4=") (display-list (solve '(9 8 7 6 5 4 3 2 1) 3)) (newline)
(display "CASE5=") (display-list (solve '(1 2 3 4 5) 5)) (newline)
(display "CASE6=") (display-list (solve '(7 2 4) 2)) (newline)
(display "CASE7=") (display-list (solve '(-7 -8 -1 -3 -5 -2 -9) 3)) (newline)
