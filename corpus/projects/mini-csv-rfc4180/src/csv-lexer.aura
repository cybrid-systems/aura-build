;; csv-lexer.aura
;; The core CSV lexer / parser.
;;
;; Operates on an input source (string or port) and produces typed cells
;; according to RFC 4180. Handles:
;;   - Quoted fields: "hello, world"
;;   - Embedded delimiters inside quoted fields
;;   - Escaped double-quotes inside quoted fields: "he said ""hi"""
;;   - Both \r\n and \n line endings (with optional trailing newline)
;;   - Configurable delimiter (default comma)
;;   - Empty fields between delimiters
;;
;; Type coercion of raw strings into cells is delegated to (csv-coerce)
;; from csv-coerce.aura, so this file only deals with tokenization.
;;
;; Public API:
;;   (csv-open source :key delimiter)
;;   (lexer-state l)
;;   (lexer-exhausted? l)
;;   (lexer-next-cell l) -> cell | 'eof
;;   (lexer-next-row l)  -> row  | 'eof
;;
;; The lexer keeps an internal buffer (a list of characters, built in
;; reverse for O(1) cons) plus a "quoted" flag indicating whether the
;; current cell is inside a quoted region.

;; ----------------------------------------------------------------------------
;; Lexer state record
;; ----------------------------------------------------------------------------

;; A lexer state is a record containing:
;;   - port         : the input port (or #f for string source)
;;   - source-str   : remaining input as a string (or #f for port source)
;;   - src-idx      : next character index into source-str (or #f)
;;   - delimiter    : single-character delimiter (as a string)
;;   - buf          : reverse-list of accumulated characters for the cell
;;   - in-quotes    : boolean, are we currently inside a quoted region?
;;   - cell-start   : boolean, are we at the start of a new cell? Used to
;;                    distinguish a real empty field (between two delimiters)
;;                    from a trailing empty field before EOL/EOF.
;;   - exhausted    : boolean, has the lexer reached end of input?
;;   - eof          : the EOF sentinel (kept here so lexer-next-cell can
;;                    return the same value as other modules)
(define-record lexer port
                      source-str
                      src-idx
                      delimiter
                      buf
                      in-quotes
                      cell-start
                      exhausted
                      eof)

;; ----------------------------------------------------------------------------
;; Low-level character reading for both string and port sources
;; ----------------------------------------------------------------------------

;; Internal: read the next character from a lexer.
;; Returns the character, or the Aura EOF object if no more input.
;; Also marks the lexer as exhausted on EOF.
(define (lexer-read-char l)
  (let ((p (lexer-port l))
        (s (lexer-source-str l))
        (idx (lexer-src-idx l)))
    (cond
      ((and p (not (lexer-exhausted-record l)))
       (let ((ch (peek-char p)))
         (if (eof-object? ch)
             (begin
               (set-lexer-exhausted-record l #t)
               ch)
             (begin
               (read-char p)
               ch))))
      (s
       (if (>= idx (string-length s))
           (begin
             (set-lexer-exhausted-record l #t)
             (eof-object))
           (let ((ch (string-ref s idx)))
             (set-lexer-src-idx l (+ idx 1))
             ch)))
      (else
       (set-lexer-exhausted-record l #t)
       (eof-object)))))

;; ----------------------------------------------------------------------------
;; Public API
;; ----------------------------------------------------------------------------

;; Open a CSV source for parsing.
;;   source : either a string or an input port
;;   :key delimiter : a single-character string (default ",")
;;
;; Returns a lexer state value.
(define (csv-open source . kwargs)
  (let ((delim (if (null? kwargs) "," (car kwargs))))
    ;; Normalize delimiter to a single-character string.
    (let ((delim-str
           (cond
             ((string? delim) delim)
             ((char? delim)   (string delim))
             (else ","))))
      (let ((l (make-lexer #f               ; port
                           (if (string? source) source #f)
                           (if (string? source) 0 #f)
                           delim-str
                           '()              ; buf (reverse-list, initially empty)
                           #f               ; in-quotes
                           #t               ; cell-start
                           #f               ; exhausted
                           (eof-sentinel))))
        ;; If the source is a port, attach it now.
        (if (not (string? source))
            (set-lexer-port l source))
        ;; Strip a leading UTF-8 BOM if present.
        (csv-strip-bom-from-lexer l)
        l))))

;; Internal helper: discard a leading BOM character if present.
(define (csv-strip-bom-from-lexer l)
  ;; csv-strip-bom consumes a BOM from a port; for a string source we do
  ;; the equivalent here by advancing past an initial BOM character.
  (let ((p (lexer-port l))
        (s (lexer-source-str l)))
    (cond
      (p
       ;; csv-strip-bom from csv-util.aura reads+peeks on the port directly.
       ;; We don't want to strip from the underlying port and desync the
       ;; lexer; instead, peek ahead ourselves and consume one char if it's BOM.
       (let ((ch (peek-char p)))
         (if (and (char? ch) (csv-bom? ch))
             (read-char p)
             '())))
      (s
       (if (and (> (string-length s) 0)
                (csv-bom? (string-ref s 0)))
           (set-lexer-src-idx l (+ (lexer-src-idx l) 1))
           '()))
      (else '()))))

;; Return the internal lexer state (opaque). Provided for completeness.
(define (lexer-state l)
  l)

;; Has the lexer hit end of input?
(define (lexer-exhausted? l)
  (lexer-exhausted-record l))

;; ----------------------------------------------------------------------------
;; Cell parsing
;; ----------------------------------------------------------------------------

;; Internal: push a character onto the lexer's cell buffer.
(define (lexer-push-char l ch)
  (set-lexer-buf l (cons ch (lexer-buf l))))

;; Internal: take the lexer's cell buffer and return the cell object.
;; The buffer is a reverse-list of characters, so we reverse it back,
;; then convert to a string, then coerce via csv-coerce.
;; Also resets the buffer and the cell-start flag.
(define (lexer-take-cell l)
  (let ((rev (lexer-buf l)))
    (set-lexer-buf l '())
    (set-lexer-cell-start l #t)
    (let ((s (list->string (reverse rev))))
      (csv-coerce s))))

;; Reverse a list. Iterative.
(define (csv-reverse xs)
  (let loop ((acc '()) (xs xs))
    (if (null? xs)
        acc
        (loop (cons (car xs) acc) (cdr xs)))))

;; Convert a list of characters to a string.
(define (list->string cs)
  (let* ((len (length cs))
         (buf (make-string len)))
    (let loop ((i 0) (cs cs))
      (if (null? cs)
          buf
          (begin
            (string-set! buf i (car cs))
            (loop (+ i 1) (cdr cs)))))))

;; Read the next cell from the lexer.
;; Returns a cell, or the EOF sentinel when no more cells can be produced
;; (i.e. end of input AND nothing in the buffer).
(define (lexer-next-cell l)
  ;; If we're at end of input and either:
  ;;   (a) not in a quoted region and the buffer is empty, return EOF
  ;;   (b) not in a quoted region and the buffer is non-empty, return cell
  ;;   (c) in a quoted region, the input is malformed; return what we have
  ;;      and then EOF.
  (let loop ()
    (let ((ch (lexer-read-char l)))
      (cond
        ((eof-object? ch)
         ;; End of input.
         (cond
           ((lexer-in-quotes-record l)
            ;; Unterminated quoted field: flush whatever we have.
            (set-lexer-in-quotes-record l #f)
            (lexer-take-cell l))
           ((null? (lexer-buf l))
            ;; Truly empty: only EOF if cell-start is true
            ;; (i.e. there's no pending content and no field expected).
            (if (lexer-cell-start l)
                (lexer-eof l)
                (lexer-take-cell l)))
           (else
            (lexer-take-cell l))))
        ((lexer-in-quotes-record l)
         ;; Inside a quoted field.
         (cond
           ((char=? ch #\")
            ;; Could be an escaped quote or the end of the quoted field.
            (let ((next (lexer-read-char l)))
              (cond
                ((eof-object? next)
                 ;; Closing quote at end of input.
                 (set-lexer-in-quotes-record l #f)
                 (lexer-take-cell l))
                ((char=? next #\")
                 ;; Escaped quote: push one literal " and continue.
                 (begin
                   (lexer-push-char l #\")
                   (loop)))
                (else
                 ;; End of quoted field; the next char was already consumed
                 ;; (it's either delimiter or newline). Re-process it by
                 ;; putting it back. Since we can't unread, we instead
                 ;; handle it inline here by NOT consuming further chars;
                 ;; but we already consumed `next`. We need to handle
                 ;; delimiter/newline termination manually.
                 (set-lexer-in-quotes-record l #f)
                 (handle-delim-or-newline l next))))
            )
           (else
            (lexer-push-char l ch)
            (set-lexer-cell-start l #f)
            (loop))))
        (else
         ;; Outside quotes (or no quotes at all).
         (cond
           ((char=? ch #\")
            ;; Opening quote (only valid at start of cell).
            (set-lexer-in-quotes-record l #t)
            (set-lexer-cell-start l #f)
            ;; If the buffer had anything (e.g. spaces before a quote in a
            ;; non-strict mode), we keep it; for strict RFC 4180 the buffer
            ;; should be empty here.
            (loop))
           ((or (char=? ch (string-ref (lexer-delimiter l) 0))
                (char=? ch #\newline)
                (char=? ch #\return))
            (handle-delim-or-newline l ch))
           (else
            (lexer-push-char l ch)
            (set-lexer-cell-start l #f)
            (loop))))))))

;; Internal: handle a delimiter/newline character. The character has just
;; been consumed by lexer-read-char; we need to either:
;;   - finish the current cell and return it (on delimiter)
;;   - finish the current cell, swallow an optional following \n (for CRLF),
;;     and return the cell as well (on \r or \n)
;;
;; In the case of a delimiter/newline when the buffer is empty and
;; cell-start is true, we produce an empty cell.
(define (handle-delim-or-newline l ch)
  (cond
    ((char=? ch (string-ref (lexer-delimiter l) 0))
     ;; Delimiter: end of cell.
     (lexer-take-cell l))
    ((char=? ch #\return)
     ;; CR: end of cell; possibly followed by LF.
     (let ((cell (lexer-take-cell l)))
       ;; Don't swallow the next char here; we just return the cell.
       ;; The row-level logic will deal with CRLF pairing. But we need
       ;; to remember that we saw a CR so the next \n is ignored.
       ;; Simplest: peek for \n; if present, consume it. But peek-char
       ;; on a port would need careful handling. For string sources we
       ;; can check directly. For ports we rely on csv-next-line to
       ;; handle CRLF. Here we just return the cell.
       cell))
    ((char=? ch #\newline)
     (lexer-take-cell l))
    (else
     ;; Shouldn't happen.
     (lexer-take-cell l))))

;; Read the next row (list of cells) from the lexer.
;; Returns a row, or the EOF sentinel.
(define (lexer-next-row l)
  (let ((cells '()))
    (let loop ()
      (let ((c (lexer-next-cell l)))
        (cond
          ((equal? c (lexer-eof l))
           ;; EOF: if we collected some cells, return them as a row.
           ;; If we collected none AND the lexer is genuinely exhausted,
           ;; return the EOF sentinel.
           (c
