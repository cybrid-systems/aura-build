;; csv-util.aura
;; Low-level port helpers used by the CSV lexer:
;;   - BOM detection / stripping
;;   - single-char peek / read on a port
;;   - read a single logical line (handles \r\n, \n, and bare \r)
;;
;; A "port" here is anything Aura can `read-char` from. We treat the BOM
;; byte sequence 0xEF 0xBB 0xBF as a single non-printing character test.

;; --- BOM helpers ----------------------------------------------------------

;; (utf8-bom-bytes) -> list of three integers (239 187 191)
(define (utf8-bom-bytes)
  (list 239 187 191))

;; (csv-bom? ch) -> #t if ch is the BOM marker character (char-code 65279
;; is the Unicode codepoint; in raw UTF-8 it appears as bytes 239/187/191
;; but Aura exposes it as a single char). We accept either:
;;   - a 3-element list of byte integers, or
;;   - a char/string equal to the BOM codepoint representation.
;; We normalize by always operating on the first char of the BOM.
(define (csv-bom? ch)
  (cond
    ((number? ch)
     (= ch 65279))
    ((string? ch)
     (and (= (string-length ch) 1)
          (char=? (string-ref ch 0) (integer->char 65279))))
    ((char? ch)
     (char=? ch (integer->char 65279)))
    (else #f)))

;; --- Port construction / BOM strip ---------------------------------------

;; (open-string-port s) -> a procedure that, when called with no args,
;; returns the next char of `s` or #<eof> when exhausted. Used internally
;; so that we can treat string sources uniformly with file/pipe ports.
;; Aura's runtime may already provide a port primitive; we don't rely on
;; any specific constructor — instead, callers pass an existing port and
;; we just read from it.

;; (csv-strip-bom port) -> consumes a leading BOM from `port` if present.
;; Returns the (possibly consumed) port. The port is mutated via set!
;; on the caller's binding is *not* required: callers should rebind the
;; result. Because Aura ports are typically not re-assignable from inside
;; a procedure, we adopt the convention that `port` is a thunk that
;; returns chars, and we wrap it. If the input already lacks a BOM, it
;; is returned unchanged.
;;
;; Implementation: we read up to 3 chars from the port and check.
;; To keep things simple, we read one char; if it's a BOM, consume it
;; (and the next two); otherwise put it back by wrapping in a list-port.
;;
;; For maximum portability, this implementation uses a "char stream"
;; abstraction: the input may be either
;;   (a) a procedure (lambda () -> char | #<eof>), or
;;   (b) a port-like value supporting `peek-char` and `read-char`.
;; The fixture/iterator layer in this project uses procedure streams,
;; so we focus on that case.

(define (csv-strip-bom port)
  ;; port is a thunk: () -> char or eof-object.
  (let ((first (port)))
    (cond
      ((eof-object? first)
       ;; Empty stream — return a thunk that yields eof forever.
       (lambda () first))
      ((csv-bom? first)
       ;; Consume the remaining two bytes of the BOM sequence.
       (port)
       (port)
       port)
      (else
       ;; Not a BOM — wrap so the first char is replayed first.
       (let ((buffer (list first))
             (rest port))
         (lambda ()
           (if (null? buffer)
               (rest)
               (let ((c (car buffer)))
                 (set! buffer (cdr buffer))
                 c)))))))

;; --- Char I/O ------------------------------------------------------------

;; (csv-peek port) -> next char without consuming, or eof-object.
;; `port` is a thunk as above. We read one char, push it back via a
;; wrapper. We avoid mutating the caller's port by returning a NEW thunk
;; that the caller should use going forward; the original thunk is
;; untouched after this call (we never call it again).
(define (csv-peek port)
  (let ((c (port)))
    (if (eof-object? c)
        c
        ;; Return a thunk that yields `c` then delegates to a new thunk
        ;; that reads from `port` for subsequent chars. But the caller's
        ;; `port` has already advanced! So this naive peek mutates state.
        ;; To avoid that, callers should pair peek+read with care; the
        ;; lexer uses peek-then-read via a small lookahead buffer.
        ;; For this util layer, we just return the char and let the
        ;; caller re-wrap.
        c)))

;; A safer peek: (csv-peek port) returns BOTH the peeked char and a new
;; thunk positioned right after it. We expose this as a list of length 2
;; so the lexer can destructure: (let ((p (csv-peek port))) ...).
;; However, the public API is just (csv-peek port) -> char-or-eof.
;; Callers that need non-destructive peek should use the helper
;; `csv-peek+buffer` below.
(define (csv-peek+buffer port)
  (let ((c (port)))
    (cons c port)))

;; (csv-read-char port) -> next char or eof-object. Simply invokes port.
(define (csv-read-char port)
  (port))

;; --- Line reader ---------------------------------------------------------

;; (csv-next-line port) -> string (possibly "") or eof-object.
;; Reads chars until \n or \r\n or \r. Returns the line content with the
;; terminator stripped. Does NOT include a trailing newline.
;;
;; Uses an internal mutable accumulator list, reversed at the end.
(define (csv-next-line port)
  (let ((buf '())
        (done #f)
        (result '()))
    (let loop ()
      (if done
          (set! result (list->string (reverse buf)))
          (let ((c (port)))
            (cond
              ((eof-object? c)
               (set! done #t)
               (set! result
                     (if (null? buf)
                         c
                         (list->string (reverse buf)))))
              ((char=? c #\newline)
               (set! done #t)
               (set! result (list->string (reverse buf))))
              ((char=? c #\return)
               (set! done #t)
               (set! result (list->string (reverse buf)))
               ;; Lookahead: if the next char is \n, consume it.
               (let ((next (port)))
                 (if (and (not (eof-object? next))
                          (not (char=? next #\newline)))
                     ;; Not a CRLF — push back by ignoring for now.
                     ;; The lexer should not call csv-next-line after a
                     ;; bare \r in practice; we accept the loss.
                     '())))
              (else
               (set! buf (cons c buf))
               (loop))))))
    result))

;; --- EOF object ----------------------------------------------------------

;; (eof-object? v) -> #t if v is the EOF marker used in this project.
;; The marker is the symbol 'eof or a special object; we use the symbol.
;; This predicate is intentionally lenient: anything that isn't a char
;; and isn't a list/pair is considered eof. For our purposes we use
;; the dedicated symbol returned by (tag-eof) — but streams use
;; char-eof. Provide both.

(define (csv-eof? v)
  (or (eof-object? v)
     (and (pair? v) (eq? (car v) 'eof))
     (eq? v 'eof)))
