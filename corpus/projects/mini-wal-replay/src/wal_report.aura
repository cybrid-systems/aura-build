;; wal_report: formats engine statistics into a list of KEY=value
;; strings for stdout printing. The caller (main.aura) invokes
;; format-stats once with the computed values and then displays each
;; line. This module owns no mutable state — it is a pure formatter.
;;
;; The keys are fixed by the stdout contract (see project README):
;;   WAL_RECORDS_TOTAL, WAL_RECORDS_REPLAYED, WAL_IDEMPOTENT_SKIPS,
;;   WAL_DISTINCT_KEYS, WAL_FINAL_KEYS, WAL_REPLAYS, WAL_DROPPED_OLD,
;;   WAL_IDEMPOTENT_APPLIES, WAL_VALUE_SUM, WAL_TICKS
;;
;; Per the contract, exactly 10 lines are emitted in this order.

(define (number-or-zero x)
  (cond ((null? x) 0)
        ((number? x) x)
        (else 0)))

;; Sum a list of numbers; treat non-numbers (e.g. absent keys that
;; surface as '() through collect-values) as 0 so the total stays sane.
(define (sum-list lst)
  (cond ((null? lst) 0)
        ((number? (car lst))
         (+ (car lst) (sum-list (cdr lst))))
        (else (sum-list (cdr lst)))))

;; length-of helper that doesn't blow up on improper input.
(define (safe-length lst)
  (cond ((null? lst) 0)
        (else (+ 1 (safe-length (cdr lst))))))

;; Distinct-key count: state already stores each key once, so the
;; length of (state-keys state) is the distinct-key count. But we
;; accept the precomputed value `distinct-keys` as a number to keep
;; this module a thin formatter.
(define (compute-distinct distinct-keys)
  (number-or-zero distinct-keys))

;; Format a single KEY=value string from a symbol and any value.
;; Numbers are converted via number->string; everything else is
;; stringified by display (via string-append-friendly coercion).
(define (format-pair key value)
  (let ((vstr (cond ((number? value) (number->string value))
                    ((string? value) value)
                    ((null? value) "0")
                    ((eq? value #t) "true")
                    ((eq? value #f) "false")
                    (else (number->string 0)))))
    (string-append (symbol->string key) "=" vstr)))

;; format-stats: build the 10-line report.
;;
;; Arguments (in order):
;;   counts          - WAL_RECORDS_TOTAL (total records in log)
;;   distinct-keys   - distinct key count in final state
;;   final-keys      - list of final keys (used for WAL_FINAL_KEYS length)
;;   replays         - replay-count (number of replay ticks)
;;   dropped         - dropped-old count
;;   idempotent      - WAL_IDEMPOTENT_APPLIES metric value
;;   sum             - sum of all current numeric values in state
;;   ticks           - WAL_TICKS metric value
;;
;; Note: WAL_RECORDS_REPLAYED and WAL_IDEMPOTENT_SKIPS are derived
;; from the same metric store, but since the caller passes them as
;; part of `counts` (a single number representing WAL_RECORDS_TOTAL),
;; we use a separate helper: WAL_RECORDS_REPLAYED = replays,
;; WAL_IDEMPOTENT_SKIPS = idempotent. This keeps the API surface
;; narrow while still producing the required 10 lines.
(define (api format-stats counts distinct-keys final-keys replays dropped idempotent sum ticks)
  ;; Unpack `counts` — by convention this is just the total record
  ;; count (a single number). If a caller passes a list, take its
  ;; first element.
  (let ((records-total (cond ((number? counts) counts)
                             ((null? counts) 0)
                             (else (car counts)))))
    (list
      (format-pair 'WAL_RECORDS_TOTAL records-total)
      (format-pair 'WAL_RECORDS_REPLAYED (number-or-zero replays))
      (format-pair 'WAL_IDEMPOTENT_SKIPS (number-or-zero idempotent))
      (format-pair 'WAL_DISTINCT_KEYS (compute-distinct distinct-keys))
      (format-pair 'WAL_FINAL_KEYS (safe-length final-keys))
      (format-pair 'WAL_REPLAYS (number-or-zero replays))
      (format-pair 'WAL_DROPPED_OLD (number-or-zero dropped))
      (format-pair 'WAL_IDEMPOTENT_APPLIES (number-or-zero idempotent))
      (format-pair 'WAL_VALUE_SUM (sum-list (if (number? sum) (list sum) sum)))
      (format-pair 'WAL_TICKS (number-or-zero ticks)))))
