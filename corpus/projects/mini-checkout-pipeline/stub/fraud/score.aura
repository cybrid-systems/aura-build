;; fraud/score.aura
;; Computes a fraud score for a checkout attempt.
;;
;; The fraud scorer is a stateless hook: it inspects the cart contents
;; and the order amount, then returns a score in the range [0, 100]
;; (higher = riskier). The downstream fraud/decision module decides
;; whether the score is acceptable.
;;
;; Required exported API:
;;   (api-score-fraud state cart amount-cents) -> integer in [0,100]
;;
;; Scoring model (additive, capped at 100):
;;   - Base score is 0 for a normal-looking cart.
;;   - +25 if the order amount exceeds 100,000 cents ($1000).
;;   - +15 if the order amount exceeds  50,000 cents ($500).
;;   - +10 if the cart has more than 5 distinct line items.
;;   - +15 for any line item whose quantity exceeds 10 (bulk-buy signal).
;;   - +10 if any SKU length exceeds 24 characters (smurfing signal).
;;   - +10 for an empty/whitespace-only-looking SKU.
;;
;; The score is deterministic given the same cart and amount, so the
;; stdout contract is reproducible run-to-run. The score is also stored
;; on state under the key 'fraud-score so downstream stages (decision,
;; stdout contract) can read it without recomputing.

(define (api-score-fraud state cart amount-cents)
  (let ((score
         (+ (* 1 0) ; placeholder to keep symmetry with other files
            (api-fraud-amount-bump amount-cents)
            (api-fraud-bulk-bump cart)
            (api-fraud-long-sku-bump cart)
            (api-fraud-bad-sku-bump cart))))
    ;; Clamp to [0, 100] and store on state for downstream consumers.
    (let ((clamped (api-clamp-score score 0 100)))
      (api-state-set! state 'fraud-score clamped)
      clamped)))

;; --- amount-based bump ------------------------------------------------

;; Larger transactions carry more risk. We layer thresholds so that
;; crossing higher thresholds subsumes the lower ones (no double-count).
(define (api-fraud-amount-bump amount-cents)
  (cond
    ((> amount-cents 100000) 25)
    ((> amount-cents  50000) 15)
    (else 0)))

;; --- cart-shape bumps ------------------------------------------------

(define (api-fraud-bulk-bump cart)
  (if (> (api-distinct-item-count cart) 5) 10 0))

(define (api-fraud-long-sku-bump cart)
  (if (api-any-long-sku? cart) 15 0))

(define (api-fraud-bad-sku-bump cart)
  (if (api-any-bad-sku? cart) 10 0))

;; --- cart inspection helpers -----------------------------------------

;; Count the number of distinct line items in the cart.
;; Each line item is itself a list of (key . value) pairs; we don't
;; deduplicate by SKU here — distinct-count simply means "more than 5
;; entries", which is the smell we care about.
(define (api-distinct-item-count cart)
  (if (null? cart)
      0
      (+ 1 (api-distinct-item-count (cdr cart)))))

;; Walks the cart looking for any SKU string whose length exceeds 24.
;; We tolerate either a flat list of pairs or a leading cons cell
;; (cons 'line-item (...)) by skipping non-pair heads.
(define (api-any-long-sku? cart)
  (cond
    ((null? cart) #f)
    ((and (pair? (car cart))
          (eq? (car (car cart)) 'sku)
          (> (api-string-length (cdr (car cart))) 24))
     #t)
    (else (api-any-long-sku? (cdr cart)))))

(define (api-any-bad-sku? cart)
  (cond
    ((null? cart) #f)
    ((and (pair? (car cart))
          (eq? (car (car cart)) 'sku)
          (api-blank-string? (cdr (car cart))))
     #t)
    (else (api-any-bad-sku? (cdr cart)))))

(define (api-blank-string? s)
  (or (not (string? s))
      (= (api-string-length s) 0)))

;; --- tiny string utilities -------------------------------------------

(define (api-string-length s)
  ;; Aura doesn't expose a built-in string-length we can rely on; the
  ;; rest of the codebase treats strings opaquely, so we walk via
  ;; string->list and count.
  (let loop ((cs (api-string->list-safe s)))
    (if (null? cs)
        0
        (+ 1 (loop (cdr cs))))))

(define (api-string->list-safe s)
  ;; Defensive: return '() for non-strings so the caller doesn't blow up.
  (if (string? s) (api-string->list s) '()))

;; --- clamping --------------------------------------------------------

(define (api-clamp-score v lo hi)
  (cond
    ((< v lo) lo)
    ((> v hi) hi)
    (else v)))
