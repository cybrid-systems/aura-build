;; main.aura
;; Entry point for the mini-checkout-pipeline (variant 2).
;;
;; This file orchestrates a single GOAL scenario: it builds a checkout
;; state, runs the pipeline through saga/orchestrator, then prints a
;; fixed-key stdout contract that an external reference can diff.
;;
;; Stdout contract (exact order, one per line):
;;   API_VERSION=<version>
;;   STAGES=<comma-joined stage names>
;;   ORDER_ID=<order id>
;;   OUTCOME=<COMMITTED|COMPENSATED|REJECTED>
;;   SUBTOTAL_CENTS=<integer>
;;   TAX_CENTS=<integer>
;;   TOTAL_CENTS=<integer>
;;   AUTH_ID=<auth-id string>
;;   FRAUD_SCORE=<number>
;;   FRAUD_DECISION=<ACCEPT|REJECT|REVIEW>
;;   FRAUD_THRESHOLD=<number>
;;   COMMITTED=<#t|#f>
;;   ROLLBACK_STAGES=<NONE|stage1,stage2,...>
;;
;; main.aura does not bake expected values; every printed value is
;; computed via the module APIs.

(define (api-next-order-id)
  ;; Derive a deterministic-ish order id from wall-clock seconds. We
  ;; avoid hardcoding so the value comes out of the runtime.
  (let ((t (current-seconds)))
    (string-append "ORD-"
                   (number->string t))))

(define (api-run)
  ;; Step 1: API version + stage names from the contract module.
  (define VERSION (api-version))
  (define STAGE-NAMES (api-stage-names))

  ;; Step 2: build the sample cart and region.
  (define CART (api-sample-cart))
  (define REGION (api-sample-region))

  ;; Step 3: validate the cart. If invalid, we still print a stable
  ;; contract but with OUTCOME=REJECTED and zeroed financial fields.
  (define VALID (api-validate-cart CART))
  (define VALID-OK (car VALID))

  (cond
    ((not VALID-OK)
     ;; Rejected cart path: print full contract with rejection.
     (display "API_VERSION=") (display VERSION) (newline)
     (display "STAGES=") (display (join-strings STAGE-NAMES ",")) (newline)
     (display "ORDER_ID=") (display (api-next-order-id)) (newline)
     (display "OUTCOME=REJECTED") (newline)
     (display "SUBTOTAL_CENTS=0") (newline)
     (display "TAX_CENTS=0") (newline)
     (display "TOTAL_CENTS=0") (newline)
     (display "AUTH_ID=") (newline)
     (display "FRAUD_SCORE=0") (newline)
     (display "FRAUD_DECISION=REJECT") (newline)
     (display "FRAUD_THRESHOLD=") (display (api-fraud-threshold)) (newline)
     (display "COMMITTED=#f") (newline)
     (display "ROLLBACK_STAGES=NONE") (newline))
    (else
     ;; Step 4: price the cart.
     (define PRICED (api-price-order CART))
     (define SUBTOTAL (car PRICED))
     (define TAX (cadr PRICED))
     (define TOTAL (caddr PRICED))

     ;; Step 5: build the pipeline state and seed it with the priced
     ;; totals. The order id is generated here so other modules can
     ;; read it off state via (api-state-get state 'order-id).
     (define ORDER-ID (api-next-order-id))
     (define STATE (api-make-state ORDER-ID))
     (api-state-set! STATE 'subtotal SUBTOTAL)
     (api-state-set! STATE 'tax TAX)
     (api-state-set! STATE 'total TOTAL)
     (api-state-set! STATE 'region REGION)

     ;; Step 6: run the full pipeline. The orchestrator takes care of
     ;; authorize -> capture/void -> fraud -> commit/cancel -> saga.
     (api-run-pipeline STATE CART REGION)

     ;; Step 7: read everything we need back off the state for the
     ;; stdout contract.
     (define OUTCOME (api-outcome STATE))
     (define AUTH-ID (or (api-state-get STATE 'payment-auth-id) ""))
     (define FRAUD-SCORE (api-state-get STATE 'fraud-score))
     (define FRAUD-DECISION (api-fraud-decision FRAUD-SCORE))
     (define FRAUD-THRESHOLD (api-fraud-threshold))
     (define COMMITTED? (equal? OUTCOME "COMMITTED"))
     (define ROLLBACK-LIST (api-state-rollback-stages STATE))
     (define ROLLBACK-STR
       (if (null? ROLLBACK-LIST)
           "NONE"
           (join-strings ROLLBACK-LIST ",")))

     ;; Step 8: emit the contract in the exact required order.
     (display "API_VERSION=") (display VERSION) (newline)
     (display "STAGES=") (display (join-strings STAGE-NAMES ",")) (newline)
     (display "ORDER_ID=") (display ORDER-ID) (newline)
     (display "OUTCOME=") (display OUTCOME) (newline)
     (display "SUBTOTAL_CENTS=") (display SUBTOTAL) (newline)
     (display "TAX_CENTS=") (display TAX) (newline)
     (display "TOTAL_CENTS=") (display TOTAL) (newline)
     (display "AUTH_ID=") (display AUTH-ID) (newline)
     (display "FRAUD_SCORE=") (display FRAUD-SCORE) (newline)
     (display "FRAUD_DECISION=") (display FRAUD-DECISION) (newline)
     (display "FRAUD_THRESHOLD=") (display FRAUD-THRESHOLD) (newline)
     (display "COMMITTED=") (display (if COMMITTED? "#t" "#f")) (newline)
     (display "ROLLBACK_STAGES=") (display ROLLBACK-STR) (newline))))

;; ---------------------------------------------------------------------------
;; Small helpers used only by main.aura.
;; ---------------------------------------------------------------------------

(define (join-strings xs sep)
  ;; Join a list of strings with a separator. Empty list -> "".
  (cond
    ((null? xs) "")
    ((null? (cdr xs)) (car xs))
    (else
     (let loop ((rest (cdr xs)) (acc (car xs)))
       (if (null? rest)
           acc
           (loop (cdr rest)
                 (string-append acc sep (car rest))))))))

(define (current-seconds)
  ;; Best-effort wall-clock seconds. Aura's runtime may expose this
  ;; directly; if not, we fall back to a deterministic counter so the
  ;; pipeline still produces a stable order id across runs of the
  ;; same invocation. main.aura is not allowed to hardcode values,
  ;; but a counter seeded from runtime state is fine.
  (let ((t (get-current-time)))
    (if (number? t)
        t
        *order-id-counter*)))

(define *order-id-counter* 1000000)

(define (get-current-time)
  ;; Aura's standard library exposes (current-time) returning seconds
  ;; since epoch in most builds. We try that first; if it isn't bound
  ;; we fall back to the counter.
  (cond
    ((defined? 'current-time) (current-time))
    (else (set! *order-id-counter* (+ *order-id-counter* 1))
          *order-id-counter*)))

(define (defined? sym)
  ;; Cheap "is this top-level bound?" check. Aura evaluates a quoted
  ;; symbol reference via (eval ...) in some builds; here we just try
  ;; to look it up in the global environment through a tiny probe.
  (let ((probe (symbol-value sym #f)))
    (if (eq? probe *undefined-marker*) #f #t)))

(define *undefined-marker* (cons 'undefined 'undefined))

(define (symbol-value sym default)
  ;; Try to read a top-level binding. If the binding exists and is
  ;; not the undefined marker, return it; otherwise return default.
  (let ((v (top-level-value sym)))
    (if (eq? v *undefined-marker*) default v)))

(define (top-level-value sym)
  ;; Hook into the runtime's environment access. Different Aura
  ;; builds expose this differently; we try a couple of common
  ;; spellings before giving up.
  (cond
    ((procedure? top-level-value-impl) (top-level-value-impl sym))
    (else *undefined-marker*)))

;; If the host runtime supplies a real (top-level-value sym) we want
;; to use it; otherwise our probe just returns the marker and we
;; fall back to defaults. We define a stub here that the loader can
;; rebind if the runtime supports it.
(define (top-level-value-impl sym) *undefined-marker*)

;; ---------------------------------------------------------------------------
;; Kick off the scenario.
;; ---------------------------------------------------------------------------

(api-run)
