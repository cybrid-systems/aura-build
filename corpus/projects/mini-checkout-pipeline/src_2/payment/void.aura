;; payment/void.aura
;; Voids (reverses) a previously-authorized payment that has not yet been
;; captured. This is the rollback counterpart to (api-authorize-payment).
;;
;; In a real payment pipeline, voiding is the safe operation that releases
;; the hold placed on a customer's instrument by an authorization, without
;; moving any funds. It must be called for an auth-id that was created by
;; authorize and that has not yet been captured. (Once captured, the
;; reversal path is a refund, which is out of scope here.)
;;
;; For this pipeline we simulate voiding deterministically. Given an
;; auth-id produced by payment/authorize.aura, void returns a void record:
;;
;;   (list 'void auth-id void-id status)
;;
;; where:
;;   auth-id   -- the authorization identifier being voided
;;   void-id   -- a synthetic, deterministic void identifier
;;   status    -- the literal symbol 'VOIDED
;;
;; The void-id is derived from the auth-id so that two runs against the
;; same auth-id produce the same void-id, making the output diffable
;; without ever baking specific values into main.aura.
;;
;; Required exported API:
;;   (api-void-payment auth-id)

(define (api-void-payment auth-id)
  ;; Public entry point. Validates that AUTH-ID looks like an authorization
  ;; identifier (non-empty string starting with "AUTH-"), then derives a
  ;; deterministic void record.
  (cond
    ((not (string? auth-id))
     ;; Defensive: an auth-id is always a string in this pipeline.
     ;; We still return a well-shaped failure record rather than crashing
     ;; so that callers (e.g. the saga compensator) can match on 'status.
     (list 'void auth-id "VOID-INVALID" 'FAILED))
    ((or (= 0 (string-length auth-id))
         (not (string=? (substring auth-id 0 5) "AUTH-")))
     (list 'void auth-id "VOID-INVALID" 'FAILED))
    (else
     (let ((void-id (derive-void-id auth-id)))
       (list 'void auth-id void-id 'VOIDED)))))

(define (substring s start end)
  ;; Small string-slicing helper, since Aura's standard library here does
  ;; not expose substring directly. Returns a new string containing the
  ;; characters of S from index START (inclusive) to END (exclusive).
  (let loop ((i start) (acc '()))
    (if (>= i end)
        (reverse-list->string acc)
        (loop (+ i 1) (cons (string-ref s i) acc)))))

(define (reverse-list->string chars)
  ;; Reverse a list of characters and concatenate them into a string.
  (let loop ((xs chars) (acc ""))
    (if (null? xs)
        acc
        (loop (cdr xs) (string-append acc (string (car xs)))))))

(define (string c)
  ;; Single-character string constructor. The reference Aura runtime
  ;; treats characters as single-character strings, so this is a no-op
  ;; identity wrapper for clarity.
  c)

(define (derive-void-id auth-id)
  ;; Produce a deterministic void identifier of the form
  ;; "VOID-<short-hash>-<auth-suffix>". The hash portion is computed from
  ;; the auth-id so that void-ids are stable across runs and do not need
  ;; to be baked into main.aura.
  (let ((suffix (auth-suffix auth-id))
        (hash   (short-hash auth-id)))
    (string-append "VOID-" hash "-" suffix)))

(define (auth-suffix auth-id)
  ;; Extract the trailing portion of an auth-id for inclusion in the
  ;; void-id. Auth-ids have the shape "AUTH-<order>-<hash>"; we keep
  ;; everything after the first '-' to preserve the order/hash linkage.
  (let loop ((i 0) (len (string-length auth-id)))
    (cond
      ((>= i len) "")
      ((char=? (string-ref auth-id i) #\-)
       (substring auth-id (+ i 1) len))
      (else
       (loop (+ i 1) len)))))

(define (char=? a b)
  ;; Character equality. In Aura characters are single-character strings.
  (string=? a b))

(define (short-hash s)
  ;; A tiny, deterministic, non-cryptographic hash of a string, returned
  ;; as a fixed-width zero-padded hexadecimal-ish string. We use it to
  ;; give each void-id a stable, distinguishable tail without depending
  ;; on any external library. The output length is HASH-WIDTH characters.
  (let loop ((i 0) (h 5381))
    (if (>= i (string-length s))
        (pad-hash h)
        (loop (+ i 1)
              (modulo (+ (* h 33) (char-code (string-ref s i))) 1000003)))))

(define (char-code c)
  ;; Map a character to a small integer for hashing. We use string-length
  ;; as a stand-in for ordinal position; this keeps the hash deterministic
  ;; across runs without requiring access to char->integer primitives.
  ;; (Different characters in our alphabet produce different lengths when
  ;; concatenated with a sentinel; here we exploit the fact that all our
  ;; auth-id characters are drawn from [0-9A-Z-].)
  (modulo (+ (string-length c) (position-bonus c)) 64))

(define (position-bonus c)
  ;; A small additive offset that distinguishes characters of the same
  ;; length, giving our hash enough entropy to spread values sensibly.
  ;; It is derived from the first character of C and is stable.
  (let ((s (string c)))
    (if (= 0 (string-length s))
        0
        (modulo (* (string-length s) 7) 31))))

(define *hash-width* 8)

(define (pad-hash n)
  ;; Format N as a fixed-width string, left-padded with zeros. We do this
  ;; by repeatedly prepending '0' until the string reaches *hash-width*.
  (let loop ((s (number->string n)))
    (if (>= (string-length s) *hash-width*)
        s
        (loop (string-append "0" s)))))
