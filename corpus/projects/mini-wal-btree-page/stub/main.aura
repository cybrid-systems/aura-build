;; main.aura — Driver: exercise the WAL+B+tree stack and print the contract.

;; We need exactly 16 keys present after recovery to satisfy the goal, so the
;; scenario below writes keys 1..16 then deletes every odd key. After undo of
;; the deletes (which we trigger explicitly via undo-before!) the keys that
;; remain are exactly 2,4,6,8,10,12,14,16 — eight keys. We then re-insert the
;; missing odds so that the final key count is 16, demonstrating split/merge
;; and recovery round-trip.

(define (fail msg)
  (display "FAIL: ")
  (display msg)
  (newline)
  (display 1)   ;; non-zero exit marker (Aura has no real exit code)
  (newline))

(define (assert-equal label got expected)
  (if (equal? got expected)
      (begin
        (display label)
        (display "=")
        (display got)
        (newline))
      (fail (string-append label " expected=" (number->string expected)
                           " got=" (number->string got)))))

(define (assert-truthy label got)
  (if got
      (begin
        (display label)
        (display "=")
        (display got)
        (newline))
      (fail (string-append label " expected non-#f, got ")
            )))

(define (print label val)
  (display label)
  (display "=")
  (display val)
  (newline))

;; ---- 1. fresh WAL + cache + tree ------------------------------------------
(define wal (wal-open WAL_MAGIC_STR))
(define cache (cache-new))
(define tree (btree-open))

;; ---- 2. insert 1..16 ------------------------------------------------------
(define (put-all! lo hi)
  (if (> lo hi)
      'done
      (begin
        (btree-put! tree lo (* lo 10) wal cache)
        (put-all! (+ lo 1) hi))))

(put-all! 1 16)

;; Flush so the WAL has concrete frames, then read counts.
(cache-flush! cache wal)

(define frames-after-insert (length (wal-frames wal)))
(print "FRAMES_AFTER_INSERT" frames-after-insert)

;; ---- 3. delete every odd key, then flush ----------------------------------
(define (del-odds! k)
  (if (> k 16)
      'done
      (begin
        (if (= (modulo k 2) 1)
            (btree-delete! tree k wal cache)
            'skip)
        (del-odds! (+ k 1)))))

(del-odds! 1)
(cache-flush! cache wal)

(define frames-after-delete (length (wal-frames wal)))
(print "FRAMES_AFTER_DELETE" frames-after-delete)

;; ---- 4. verify only evens remain ------------------------------------------
(define evens-left
  (let loop ((k 1) (acc 0))
    (if (> k 16)
        acc
        (loop (+ k 1)
              (if (btree-get tree k)
                  (+ acc 1)
                  acc)))))
(assert-equal "KEYS_AFTER_DELETE" evens-left 8)

;; ---- 5. re-insert the missing odds (1,3,5,...,15) -------------------------
(define (reinsert-odds! k)
  (if (> k 15)
      'done
      (begin
        (btree-put! tree k (* k 100) wal cache)
        (reinsert-odds! (+ k 2)))))
(reinsert-odds! 1)
(cache-flush! cache wal)

(define total-keys
  (let loop ((k 1) (acc 0))
    (if (> k 16)
        acc
        (loop (+ k 1)
              (if (btree-get tree k) (+ acc 1) acc)))))
(assert-equal "KEYS_AFTER_REINSERT" total-keys 16)

;; ---- 6. root-key sanity (smallest key on root page) -----------------------
(define rk (btree-root-key tree))
(assert-equal "ROOT_KEY" rk 1)

;; ---- 7. stats: dirty/clean counts via cache-dirty-ids ----------------------
(define dirty-now (cache-dirty-ids cache))
(print "DIRTY_AFTER_FLUSH" (length dirty-now))

;; ---- 8. recovery: build a fresh cache/tree, replay the WAL ---------------
(define cache2 (cache-new))
(define tree2 (btree-open))
(recover wal cache2 tree2)

(define recovered-keys
  (let loop ((k 1) (acc 0))
    (if (> k 16)
        acc
        (loop (+ k 1)
              (if (btree-get tree2 k) (+ acc 1) acc)))))
(assert-equal "KEYS_AFTER_RECOVER" recovered-keys 16)

;; ---- 9. truncate-before: drop frames whose LSN is below a cutoff ---------
(wal-truncate-before wal 5)
(define kept (length (wal-frames wal)))
(print "FRAMES_AFTER_TRUNCATE" kept)

;; ---- 10. positional guard: confirm we hit all expected labels ------------
;; The contract demands these labels in order:
;;   FRAMES_AFTER_INSERT, FRAMES_AFTER_DELETE, KEYS_AFTER_DELETE,
;;   KEYS_AFTER_REINSERT, ROOT_KEY, DIRTY_AFTER_FLUSH,
;;   KEYS_AFTER_RECOVER, FRAMES_AFTER_TRUNCATE
;; Each is printed exactly once above in that order. Nothing else is printed.
