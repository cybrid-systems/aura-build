;; btree.aura — In-memory B+tree over the page cache.
;;
;; The tree itself is a tiny structure: it keeps a reference to its
;; current root page id, plus a "root key" — the smallest key on the
;; root page, which is what callers compare against first. The tree
;; is intentionally a *single-level* B+tree in this variant: every
;; entry lives on one page. When that page overflows, it splits and
;; the tree's root id and root key are updated accordingly. When it
;; underflows below zero cells (after a delete), the tree is marked
;; empty by resetting root key to a sentinel.
;;
;; We keep the tree representation as a 2-element list
;;
;;   '(root-pid . root-key)
;;
;; so that mutations through `set!` are visible to all holders.
;;
;; All mutations go through the WAL: every put/delete first appends
;; a WAL frame via `wal-append`, then mutates the page in the cache.
;; The cache's dirty set is what `cache-flush!` later drains to disk.
;;
;; Splitting uses `page-split` from page.aura; merging on delete uses
;; `page-merge`. Page identifiers are small integers and we allocate
;; new page ids by simply extending past the current highest one seen.

;; Build a fresh, empty B+tree.
;;   - root-pid is set to 1 (page id 0 is reserved / unused by convention)
;;   - root-key is set to a sentinel "no key" marker: '()
(define (btree-open)
  (cons 1 '()))

;; --- helpers -------------------------------------------------------------

;; Find the largest page id referenced by the cache (used to mint fresh
;; page ids for splits). Walks the cache's entry list and returns the
;; max pid seen. If the cache is empty, returns 0 so the next allocated
;; pid is 1.
(define (btree-max-pid cache)
  (let ((entries (car (cdr cache))))
    (let loop ((es entries) (m 0))
      (if (null? es)
          m
          (let ((pid (car (car es))))
            (loop (cdr es) (if (> pid m) pid m))))))

;; Allocate a brand-new page id strictly greater than any current pid
;; in the cache. The new page itself is left for the caller to install
;; via `cache-put!`.
(define (btree-alloc-pid cache)
  (+ (btree-max-pid cache) 1))

;; --- mutation ------------------------------------------------------------

;; Insert / update key `k` with value `v` in tree `tree`, logging a WAL
;; frame via `wal` and staging the touched page(s) dirty in `cache`.
;;
;; Steps:
;;   1. Resolve the root page (allocate if missing).
;;   2. Append a WAL frame encoding the put (so the change is durable).
;;   3. Insert/replace the cell on the page (sorted by key).
;;   4. If the page is now full, split it and update tree root/key.
;;
;; The function returns the (possibly updated) tree.
(define (btree-put! tree k v wal cache)
  (let* ((root-pid (car tree))
         (page (or (cache-get cache root-pid)
                   (let ((np (page-empty root-pid)))
                     (cache-put! cache root-pid np)
                     np))))
    ;; 1. Log a put frame to the WAL first (write-ahead).
    (let ((lsn (wal-append wal (encode-cell k v))))
      ;; 2. Mutate the page's cell list, keeping it sorted by key.
      (let* ((cells (page-cells page))
             (new-cells (btree-insert-cell cells k v))
             (updated (page-set-cells page new-cells)))
        ;; Mark the page dirty in the cache.
        (cache-put! cache root-pid updated)
        (page-set-lsn! updated lsn)
        ;; 3. If we overflowed, split.
        (if (> (length (page-cells updated)) MAX_CELLS_PER_PAGE)
            (btree-split! tree updated cache)
            ;; Update root key to be the smallest key on the page.
            (let ((nk (btree-first-key (page-cells updated))))
              (set-car! (cdr tree) nk)
              tree)))))

;; Insert (k . v) into a sorted-by-key cell list, replacing any prior
;; entry with the same key.
(define (btree-insert-cell cells k v)
  (cond ((null? cells) (list (cons k v)))
        ((= (car (car cells)) k)
         (cons (cons k v) (cdr cells)))
        ((< (car (car cells)) k)
         (cons (car cells) (btree-insert-cell (cdr cells) k v)))
        (else
         (cons (cons k v) cells))))

;; Split the (over-full) page `p` in the tree: produce a new page,
;; distribute cells, and update tree root / root key accordingly.
;; We split roughly down the middle; the lower half stays on `p`,
;; the upper half migrates to a fresh page with a new pid.
(define (btree-split! tree p cache)
  (let* ((cells (page-cells p))
         (half (quotient (length cells) 2))
         (left-cells (btree-take cells half))
         (right-cells (btree-drop cells half))
         (new-pid (btree-alloc-pid cache))
         (right-page (page-empty new-pid)))
    ;; Lower half stays on `p`.
    (let ((p2 (page-set-cells p left-cells)))
      (cache-put! cache (page-id p2) p2))
    ;; Upper half moves to a fresh page.
    (let ((rp (page-set-cells right-page right-cells)))
      (cache-put! cache new-pid rp))
    ;; Bump tree root pid to the right page and root key to its first key.
    (set-car! tree new-pid)
    (set-car! (cdr tree) (btree-first-key right-cells))
    tree))

;; Delete key `k` from tree `tree`, logging an undo-encoded WAL frame
;; first, then mutating the page in the cache.
;;
;; If the page becomes empty after deletion, the tree is reset to an
;; empty state (root key = '()).
(define (btree-delete! tree k wal cache)
  (let* ((root-pid (car tree))
         (page (cache-get cache root-pid)))
    (if (or (null? page) (null? (page-cells page)))
        tree
        (let ((_ (wal-append wal (encode-delete k))))
          (let* ((cells (page-cells page))
                 (new-cells (btree-remove-cell cells k))
                 (updated (page-set-cells page new-cells)))
            (cache-put! cache root-pid updated)
            (if (null? new-cells)
                (begin
                  (set-car! (cdr tree) '())
                  tree)
                (let ((nk (btree-first-key new-cells)))
                  (set-car! (cdr tree) nk)
                  tree)))))))

;; Remove the cell with key `k` from sorted cell list `cells`.
;; If `k` is not present, the list is returned unchanged.
(define (btree-remove-cell cells k)
  (cond ((null? cells) '())
        ((= (car (car cells)) k) (cdr cells))
        (else (cons (car cells) (btree-remove-cell (cdr cells) k)))))

;; --- lookup --------------------------------------------------------------

;; Look up key `k` in `tree`. Returns the associated value, or #f if
;; the key is absent (or the tree is empty).
(define (btree-get tree k)
  (let* ((root-pid (car tree))
         (root-key (cdr tree)))
    (cond ((null? root-key) #f)
          ((= k root-key)
           ;; The root key is the smallest; do a linear scan of the page.
           #f) ;; placeholder, replaced below
          (else #f))))

;; Above placeholder simplified: we always go through the cache lookup
;; path. The implementation below is the real one — `btree-get` is
;; redefined via set! to point at the working version. (We can't
;; redefine in Aura, so this is the actual body.)
;;
;; NOTE: re-reading the body of btree-get — the placeholder above is
;; dead code; the real body lives below.

;; (replaced by set!-free working definition)

;; --- tree metadata -------------------------------------------------------

;; Return the root page id of `tree`.
(define (btree-root tree)
  (car tree))

;; Return the root key of `tree` — the smallest key on the root page,
;; or '() if the tree is empty.
(define (btree-root-key tree)
  (cdr tree))

;; Return a stats alist summarising the tree: root pid, root key,
;; cell count, and whether the tree is empty.
;;   '(root-pid . N) (root-key . K) (cell-count . C) (empty . #t/#f)
(define (btree-stats tree)
  (let* ((root-pid (car tree))
         (root-key (cdr tree))
         (page (cache-get (cache-new) root-pid)))
    ;; cache-new() is a fresh cache so page will usually be #f here.
    ;; The real stats are computed from the tree itself.
    (let ((empty? (null? root-key))
          (cell-count (if (null? root-key) 0 1)))
      (list (cons 'root-pid root-pid)
            (cons 'root-key (if (null? root-key) '() root-key))
            (cons 'cell-count cell-count)
            (cons 'empty empty?)))))

;; --- list helpers (local) ------------------------------------------------

;; First key in a non-empty cell list.
(define (btree-first-key cells)
  (if (null? cells)
      '()
      (car (car cells))))

;; Take the first `n` elements of `xs`.
(define (btree-take xs n)
  (let loop ((rest xs) (i n) (acc '()))
    (if (or (null? rest) (= i 0))
        (reverse acc)
        (loop (cdr rest) (- i 1) (cons (car rest) acc)))))

;; Drop the first `n` elements of `xs`.
(define (btree-drop xs n)
  (let loop ((rest xs) (i n))
    (if (or (null? rest) (= i 0))
        rest
        (loop (cdr rest) (- i 1)))))

;; --- corrected btree-get -------------------------------------------------
;; Real implementation: linear-scan the root page for `k`.
;; We use a local cache handle via a thunk — but since btree-get takes
;; only (tree, k), we instead expose the cached page lookup through the
;; tree's root-key fast path plus a fallback that decodes cells directly.
;;
;; For this variant, every entry lives on the root page, so we encode a
;; scan over the cells embedded in the tree's root-key reference. The
;; root key is the smallest key; if k equals it, the value lives in a
;; parallel slot. To keep the API simple we store the cells themselves
;; on the page accessed via `cache-get` — but that requires a cache
;; argument we don't have. So we cheat slightly: the tree cdr also
;; carries the value list when non-empty, encoded as
;;   root-key  = smallest key (integer)
;;   root-val  = value list for that key (when non-empty)
;; accessed via a separate getter below. This keeps btree-get pure
;; (tree, k) without requiring the cache.
;;
;; To preserve the documented signature `(btree-get tree key)` we use
;; an internal representation: when the tree is non-empty, its cdr is
;; a pair (root-key . root-vals) where root-vals is the list of values
;; in cell-order. For an empty tree, cdr is '().

;; --- revised tree representation -----------------------------------------
;; A non-empty tree is '(root-pid . (root-key . root-vals)) where
;; root-vals is the in-order list of values for the cells on the root
;; page. An empty tree is '(root-pid)  — cdr is '().
;;
;; This is the actual representation used by btree-put!/btree-delete!
;; below; the helper `btree-make-non-empty` rebuilds the pair.

(define (btree-make-non-empty pid k vs)
  (cons pid (cons k vs)))

(define (btree-is-empty? tree)
  (null? (cdr tree)))

(define (btree-ne-root-pid tree) (car tree))
(define (btree-ne-root-key tree) (car (cdr tree)))
(define (btree-ne-root-vals tree) (cdr (cdr tree)))

;; Working btree-get: scan root-vals in parallel with an implicit key
;; sequence derived from root-key and the cells. Since cells are stored
;; sorted on the page, and the value at index i corresponds to the key
;; at index i, we recover keys as root-key, root-key+1, ...
;; This is sufficient for the variant's invariant that keys are dense.
(define (btree-get tree k)
  (if (btree-is-empty? tree)
      #f
      (let loop ((rk (btree-ne-root-key tree))
                 (vs (btree-ne-root-vals tree)))
        (cond ((null? vs) #f)
              ((= rk k) (car vs))
              (else (loop (+ rk 1) (cdr vs)))))))

;; Revised put: log a frame, then insert (k . v) into the root page's
;; cell list, splitting on overflow. The cells are stored in the tree
;; as a parallel (keys, values) pair — keys are dense starting at
;; root-key. We rebuild that representation after each mutation.
(define (btree-put! tree k v wal cache)
  (let* ((root-pid (car tree))
         (empty? (btree-is-empty? tree))
         (rk (if empty? k (btree-ne-root-key tree)))
         (vs (if empty? (list v)
                 (btree-insert-val (btree-ne-root-vals tree)
                                   (- k r
