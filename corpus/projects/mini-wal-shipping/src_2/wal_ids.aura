;; wal_ids.aura — ID generation utilities
;; Provides hex-string IDs and role-tagged identifiers.

(define (api ids-random-hex)
  (define (hex-char n)
    (if (< n 10)
        (string (integer->char (+ (char->integer #\0) n)))
        (string (integer->char (+ (char->integer #\a) (- n 10))))))
  (define (to-hex n)
    (string-append (hex-char (quotient n 16))
                   (hex-char (modulo n 16))))
  (define (rand)
    (modulo (abs (- (read-current-millis) 0)) 256))
  (define (rec i acc)
    (if (= i 0)
        acc
        (rec (- i 1)
             (string-append acc
                            (to-hex (modulo (rand) 256))))))
  (rec 4 ""))

(define (api ids-make-primary)
  (string-append "primary-" (ids-random-hex)))

(define (api ids-make-follower)
  (string-append "follower-" (ids-random-hex)))

;; Helper used internally for randomness without depending on a clock.
(define current-millis-state 0)

(define (read-current-millis)
  (set! current-millis-state (+ current-millis-state 7919))
  current-millis-state)
