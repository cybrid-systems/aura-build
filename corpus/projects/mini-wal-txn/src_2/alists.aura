; alists.aura - Association list utilities

(define (api alist-set alist key val)
  (set! alist (cons (cons key val) alist))
  alist)

(define (api alist-get alist key)
  (cond ((null? alist) #f)
        ((equal? (car (car alist)) key) (cdr (car alist)))
        (else (alist-get (cdr alist) key))))

(define (api alist-keys alist)
  (cond ((null? alist) '())
        (else (cons (car (car alist)) (alist-keys (cdr alist))))))

(define (api alist-count alist)
  (cond ((null? alist) 0)
        (else (+ 1 (alist-count (cdr alist))))))
