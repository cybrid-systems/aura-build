;; cycle_counter.aura
;; Counts compaction cycles performed by the daemon.
;; A cycle counter is represented as (cycle-counter count).

(define (api make-cycle-counter)
  ;; Fresh counter starting at zero cycles.
  (list 'cycle-counter 0))

(define (api cycle-count cc)
  ;; Return the number of cycles completed so far.
  (car (cdr cc)))

(define (api cycle-tick cc)
  ;; Increment the cycle counter in place and return the new value.
  ;; The caller must hold the same counter structure (mutable via set!).
  (let ((new-count (+ (api cycle-count cc) 1)))
    (set-car! (cdr cc) new-count)
    new-count))
