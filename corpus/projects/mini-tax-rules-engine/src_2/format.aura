;; format.aura -- Output formatting helpers
;; Formats numeric values for display. Money values are shown to
;; exactly 2 decimal places (rounded half up). This is the only
;; file responsible for human-readable number formatting.

;; Helper: return true if n is negative
(define (negative? n)
  (< n 0))

;; Helper: absolute value of a number
(define (abs-val n)
  (if (negative? n) (- 0 n) n))

;; Round a number to the nearest integer (half-up).
;; We add 0.5 then truncate via quotient.
(define (round-half-up n)
  (if (negative? n)
      (- 0 (round-half-up (abs-val n)))
      (quotient (+ n 0.5) 1)))

;; fmt-money: format a numeric amount as a money string with
;; exactly 2 decimal places (e.g. 12.5 -> "12.50", 0 -> "0.00").
;; Internally we work in cents to avoid floating-point drift.
;;
;; Steps:
;;   1. Take absolute value of n (in dollars).
;;   2. Convert to integer cents: round-half-up of (* n 100).
;;   3. Split into whole dollars and remaining cents.
;;   4. Pad cents to two digits if needed.
;;   5. Re-attach the sign if n was negative.
(define (fmt-money n)
  (let* ((neg (negative? n))
         (cents (round-half-up (* (abs-val n) 100)))
         (whole (quotient cents 100))
         (frac  (modulo cents 100))
         (frac-str (if (< frac 10)
                       (string-append "0" (number->string frac))
                       (number->string frac)))
         (whole-str (number->string whole))
         (sign (if neg "-" "")))
    (string-append sign whole-str "." frac-str)))

;; Optional: generic number formatter (no fixed decimals).
(define (fmt-number n)
  (number->string n))
