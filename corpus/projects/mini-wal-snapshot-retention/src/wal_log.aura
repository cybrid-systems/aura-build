;; wal_log.aura
;; In-memory Write-Ahead Log abstraction.
;;
;; A WAL is represented as an association list holding:
;;   ((next-lsn . <number>)              ; next LSN to assign
;;    (records   . <list-of-(lsn . payload)>) ; all records in order
;;    (segments  . <list-of-segments>)    ; materialized segments
;;    (seg-cap   . <number>)              ; records per segment
;;    (seg-count . <number>)              ; total records written
;;    (record-size . <number>))           ; logical bytes per record
;;
;; Records are (lsn . payload) pairs.
;; Segments are produced lazily on demand via `wal-segments`, but once
;; built are cached on the WAL itself for O(1) repeated access.
;;
;; Public APIs:
;;   (wal-append wal lsn payload) -> new wal with the record appended
;;   (wal-lsn wal)                -> next-lsn (high-water + 1)
;;   (wal-segments wal)           -> list of segments
;;   (wal-record-count wal)       -> total records in the WAL

(define (api name)
  (lambda args
    (apply (cond
             ((equal? name 'wal-append)       wal-append)
             ((equal? name 'wal-lsn)          wal-lsn)
             ((equal? name 'wal-segments)     wal-segments)
             ((equal? name 'wal-record-count) wal-record-count)
             (else (lambda _ (error "unknown wal api"))))
           args)))

;; ---- internal helpers ----

(define (wal-assq key wal)
  (cond ((null? wal) #f)
        ((equal? (car (car wal)) key) (car wal))
        (else (wal-assq key (cdr wal)))))

(define (wal-ref key wal)
  (let ((p (wal-assq key wal)))
    (if p (cdr p) (error "wal: missing key"))))

(define (wal-set key value wal)
  (cons (cons key value)
        (filter (lambda (cell) (not (equal? (car cell) key))) wal)))

;; Filter used by wal-set; uses the built-in-style member/recursion.
(define (filter pred lst)
  (cond ((null? lst) '())
        ((pred (car lst)) (cons (car lst) (filter pred (cdr lst))))
        (else (filter pred (cdr lst)))))

;; Build a single segment from a contiguous slice of records.
;; The segment is an alist with high, records, and size keys.
(define (build-segment records)
  (let ((high (car (car (reverse records))))
        (size (* (length records) 8)))
    (list (cons 'high high)
          (cons 'records records)
          (cons 'size size))))

;; Materialize all segments from the current record list and cache them.
(define (materialize-segments wal)
  (let ((recs  (wal-ref 'records wal))
        (cap   (wal-ref 'seg-cap wal))
        (cached (wal-assq 'segments wal)))
    (if (and cached (not (null? (cdr cached))))
        wal
        (let loop ((remaining recs) (acc '()))
          (if (null? remaining)
              (wal-set 'segments (reverse acc) wal)
              (let ((chunk (take cap remaining)))
                (loop (drop cap remaining)
                      (cons (build-segment chunk) acc))))))))

(define (take n lst)
  (if (= n 0)
      '()
      (cons (car lst) (take (- n 1) (cdr lst)))))

(define (drop n lst)
  (if (= n 0)
      lst
      (drop (- n 1) (cdr lst)))))

(define (length lst)
  (if (null? lst) 0 (+ 1 (length (cdr lst)))))

;; ---- public API ----

(define (wal-append wal lsn payload)
  (let* ((next    (wal-ref 'next-lsn wal))
         (recs    (wal-ref 'records wal))
         (new-rec (cons lsn payload))
         (wal2    (wal-set 'next-lsn (+ lsn 1) wal)))
    (wal-set 'records (append recs (list new-rec))
             (wal-set 'seg-count (+ (wal-ref 'seg-count wal) 1) wal2))))

(define (wal-lsn wal)
  (wal-ref 'next-lsn wal))

(define (wal-segments wal)
  (let ((m (materialize-segments wal)))
    (wal-ref 'segments m)))

(define (wal-record-count wal)
  (wal-ref 'seg-count wal))

;; ---- constructor (used by wal_manager) ----

(define (wal-make)
  (list (cons 'next-lsn 0)
        (cons 'records '())
        (cons 'segments '())
        (cons 'seg-cap 10)
        (cons 'seg-count 0)
        (cons 'record-size 8)))
