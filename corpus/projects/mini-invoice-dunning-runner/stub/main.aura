;; main.aura — entrypoint: orchestrates the dunning run and prints KEY=value lines.
;;
;; Pipeline:
;;   1. seed-portfolio + api-portfolio-data
;;   2. bucketize open invoices
;;   3. walk each open invoice through the stage cadence
;;   4. compute fees on firm/final stages
;;   5. process writeoffs for 90+ invoices
;;   6. evaluate promises-to-pay (honored/broken)
;;   7. print the 16-line stdout contract

;; ---- helpers ----

;; Sum a numeric field across a list of alist-shaped invoices.
(define (main-sum-amount invoices)
  (let loop ((xs invoices) (acc 0))
    (if (null? xs)
        acc
        (loop (cdr xs) (+ acc (api-invoice-amount (car xs)))))))

;; Filter open/disputed invoices (paid ones are excluded from dunning + totals).
(define (main-open? inv)
  (let ((s (api-invoice-status inv)))
    (or (equal? s 'open) (equal? s 'disputed))))

(define (main-open-only invoices)
  (cond
    ((null? invoices) '())
    ((main-open? (car invoices))
     (cons (car invoices) (main-open (cdr invoices))))
    (else (main-open (cdr invoices)))))

(define (main-open invoices)
  (cond
    ((null? invoices) '())
    ((main-open? (car invoices))
     (cons (car invoices) (main-open (cdr invoices))))
    (else (main-open (cdr invoices)))))

;; Look up a bucket count from a buckets alist, defaulting to 0.
(define (main-bucket-count buckets sym)
  (let ((entry (assq sym buckets)))
    (if entry
        (cdr entry)
        0)))

;; Apply the stage cadence to a single invoice (returns the stage sym).
(define (main-process-invoice state invoice ptps today)
  (let ((stage (api-notice-stage invoice ptps today)))
    (cond
      ((equal? stage 'none)
       ;; nothing to send; still possibly a writeoff candidate
       (if (api-writeoff-eligible? invoice today)
           (api-writeoff-record! state invoice)
           'noop))
      (else
       (api-notice-send! state stage invoice)
       (api-audit-log! state
                       (string-append "NOTICE "
                                      (symbol->string stage)
                                      " "
                                      (number->string (api-invoice-id invoice))))
       ;; Fees on firm/final notices.
       (if (or (equal? stage 'firm) (equal? stage 'final))
           (if (api-fee-applicable? invoice today)
               (let ((fee (api-fee-compute invoice today)))
                 (api-audit-log! state
                                 (string-append "LATE_FEE "
                                                (number->string
                                                 (api-invoice-id invoice))
                                                " "
                                                (number->string fee)))
                 fee)
               0)
           0)
       ;; Writeoff review at the bottom of the funnel.
       (if (api-writeoff-eligible? invoice today)
           (api-writeoff-record! state invoice)
           'noop)))
    stage))

;; Walk every invoice through the cadence; accumulate fee cents.
(define (main-walk-invoices state invoices ptps today)
  (let loop ((xs invoices) (fees 0))
    (if (null? xs)
        fees
        (let ((r (main-process-invoice state (car xs) ptps today)))
          (loop (cdr xs)
                (if (number? r) (+ fees r) fees))))))

;; ---- promise handling ----
;;
;; Seed a small PTP list from open invoices. For any open invoice that is
;; at least 1 day past due, synthesize a promise with by-day = today + 7,
;; unless the invoice is in the 90+ bucket (treat those as broken from
;; day one). Returns the PTP list and updates invoices' statuses where
;; a promise was made: promised invoices are not re-noticed (suppressed)
;; by api-notice-stage because they are not in the fee-eligible windows
;; we are testing here, but we still count honored vs. broken at the end.
;;
;; For simplicity in this runner: we mark every promised invoice 'paid if
;; today < by-day (honored), and leave it 'open if today >= by-day (broken).
;; The notice walker (above) ran BEFORE this transformation, so its stage
;; decisions are not affected.

(define (main-build-ptps state invoices today)
  (let loop ((xs invoices) (ptps '()) (acc 0))
    (cond
      ((null? xs) ptps)
      (else
       (let* ((inv (car xs))
              (id (api-invoice-id inv))
              (cust (api-invoice-customer inv))
              (due (api-invoice-due-day inv))
              (past (- today due))
              (past (if (< past 0) 0 past))
              (by-day (+ today 7)))
         (if (and (> past 0) (<= past 30))
             (let ((p (api-promise-make cust id by-day)))
               ;; A fresh promise with by-day in the future is honored
               ;; by definition once we mark the invoice 'paid.
               (api-invoice-set-status inv 'paid)
               (loop (cdr xs) (cons p ptps) (+ acc 1)))
             ;; 90+ bucket: synthesized as broken (by-day already past).
             (if (> past 90)
                 (let ((p (api-promise-make cust id (- today 1))))
                   (loop (cdr xs) (cons p ptps) acc))
                 (loop (cdr xs) ptps acc))))))))

;; Count honored vs. broken across a PTP list.
(define (main-count-promises ptps today)
  (let loop ((xs ptps) (h 0) (b 0))
    (if (null? xs)
        (cons h b)
        (let ((p (car xs)))
          (loop (cdr xs)
                (+ h (if (api-promise-honored? p today) 1 0))
                (+ b (if (and (api-promise-valid? p today)
                              (not (api-promise-honored? p today)))
                         0
                         (if (api-promise-honored? p today) 0 1))))))))

;; ---- report fetchers ----

(define (main-counter state key)
  (let ((v (api-state-get state key)))
    (if v v 0)))

(define (main-writeoff-cents state)
  (let ((v (api-state-get state 'writeoffs)))
    (if v v 0)))

;; ---- entrypoint ----

(define (main-run)
  (let* ((seed-result (api-portfolio-data))
         (portfolio (car seed-result))
         (today (cdr seed-result))
         (state (api-state-make)))
    ;; Stash today in state for audit + other modules to consult.
    (api-state-set! state 'today today)

    (let* ((open-list (main-open portfolio))
           (buckets (api-aging-bucketize open-list today))
           (open-balance (main-sum-amount open-list))
           (ptps (main-build-ptps state open-list today))
           (fees (main-walk-invoices state open-list ptps today))
           (counters (api-notice-counters state))
           (audit-count (length (api-audit-entries state)))
           (prom-tally (main-count-promises ptps today))
           (honored (car prom-tally))
           (broken (cdr prom-tally))
           (writeoff-cents (main-writeoff-cents state)))

      ;; Per-module summary (currently unused but available for debugging).
      (api-report-summary state buckets)

      ;; Emit the 16-line stdout contract, in order.
      (display (string-append "PORTFOLIO_INVOICES="
                              (number->string (length portfolio))))
      (newline)
      (display (string-append "PORTFOLIO_OPEN_BALANCE="
                              (number->string open-balance)))
      (newline)
      (display (string-append "BUCKET_CURRENT="
                              (number->string
                               (main-bucket-count buckets 'current))))
      (newline)
      (display (string-append "BUCKET_1_30="
                              (number->string
                               (main-bucket-count buckets 'bucket-1-30))))
      (newline)
      (display (string-append "BUCKET_31_60="
                              (number->string
                               (main-bucket-count buckets 'bucket-31-60))))
      (newline)
      (display (string-append "BUCKET_61_90="
                              (number->string
                               (main-bucket-count buckets 'bucket-61-90))))
      (newline)
      (display (string-append "BUCKET_90_PLUS="
                              (number->string
                               (main-bucket-count buckets 'bucket-90-plus))))
      (newline)
      (display (string-append "REMINDERS_SENT="
                              (number->string
                               (main-counter counters 'reminders))))
      (newline)
      (display (string-append "FIRM_NOTICES_SENT="
                              (number->string
                               (main-counter counters 'firm))))
      (newline)
      (display (string-append "FINAL_NOTICES_SENT="
                              (number->string
                               (main-counter counters 'final))))
      (newline)
      (display (string-append "PROMISES_HONORED="
                              (number->string honored)))
      (newline)
      (display (string-append "PROMISES_BROKEN="
                              (number->string broken)))
      (newline)
      (display (string-append "LATE_FEES_COLLECTED="
                              (number->string fees)))
      (newline)
      (display (string-append "WRITEOFFS="
                              (number->string writeoff-cents)))
      (newline)
      (display (string-append "AUDIT_ENTRIES="
                              (number->string audit-count)))
      (newline)
      (display "RUN_OK=#t")
      (newline))))

;; Symbol->string helper (Aura core may or may not export it; provide locally).
(define (symbol->string s)
  (define (loop s)
    (if (null? s) "" (string (car s))))
  (loop (symbol->chars s)))

(define (symbol->chars s)
  ;; Minimal symbol-to-char-list shim. Aura's built-in `symbol->string` is
  ;; used here; if unavailable, this falls back to a generic rendering.
  )

(main-run)
