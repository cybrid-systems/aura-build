;; data.aura — seeded AR portfolio + "today" day for the dunning runner.

;; ---- helpers (local to data.aura) ----

;; Build an invoice as an alist:
;;   ((id . <int>) (customer . <sym>) (amount . <int cents>)
;;    (due-day . <int>) (status . <sym>))
(define (mk-invoice id cust amount due-day status)
  (list (cons 'id id)
        (cons 'customer cust)
        (cons 'amount amount)
        (cons 'due-day due-day)
        (cons 'status status)))

;; A small, deterministic seed portfolio.
;; Mix of statuses: open, paid, disputed.
;; Due days are chosen (relative to today=90) so every aging bucket gets
;; at least one invoice: current, 1-30, 31-60, 61-90, 90+.
(define seed-portfolio
  (list
    ;; --- current (not yet due) ---
    (mk-invoice 1001 'acme        45000  105 'open)    ; due in 15d  -> current
    (mk-invoice 1002 'globex      12500  110 'open)    ; due in 20d  -> current
    ;; --- 1-30 days past due ---
    (mk-invoice 1003 'initech     78900   75 'open)    ; 15d past
    (mk-invoice 1004 'umbrella    22000   68 'open)    ; 22d past
    ;; --- 31-60 days past due ---
    (mk-invoice 1005 'hooli      156000   45 'open)    ; 45d past
    (mk-invoice 1006 'pied-piper  33000   55 'open)    ; 35d past
    ;; --- 61-90 days past due ---
    (mk-invoice 1007 'soylent     99000   20 'open)    ; 70d past
    (mk-invoice 1008 'stark-ind   64000   10 'open)    ; 80d past
    ;; --- 90+ days past due (writeoff candidates) ---
    (mk-invoice 1009 'wayne-ent  250000  -20 'open)    ; 110d past
    (mk-invoice 1010 'oscorp     180000  -40 'open)    ; 130d past
    ;; --- paid / closed (should be ignored by dunning) ---
    (mk-invoice 1011 'acme        45000   60 'paid)
    (mk-invoice 1012 'globex      12500   30 'paid)
    ;; --- disputed (held, no notices until resolved) ---
    (mk-invoice 1013 'hooli       50000   50 'disputed)
    (mk-invoice 1014 'umbrella    18000   40 'disputed)))

;; "Today" is expressed as a day counter (e.g., day 90 since AR epoch).
;; All due-days in seed-portfolio are interpreted relative to this value:
;; age-days = today - due-day.
(define seed-today 90)

;; ---- public API ----

;; Returns a two-element list: (portfolio today)
;;   portfolio : list of invoice alists (as produced by mk-invoice)
;;   today     : int day counter used by aging/fee/promise modules
(define (api-portfolio-data)
  (list seed-portfolio seed-today))
