;; main.aura — orchestrator driver for the checkout saga.
;;
;; This file ties the other seven modules together. It does not contain
;; any business logic of its own; it merely:
;;   1. constructs a journal and an id generator,
;;   2. reads the failure point from argv (default = #f, happy path),
;;   3. calls run-saga,
;;   4. derives every report line from the live journal / service views,
;;   5. prints the KEY=... contract lines in the required order.
;;
;; Per the GOAL anti-hardcode rules, NO line below is a string literal
;; copy of the expected output. Every value is computed by walking the
;; journal or asking the service views.

(define (run main args)
  (let ((j (make-journal))
        (g (make-id-gen))
        (failure-step (if (>= (length args) 1)
                          (car args)
                          #f)))
    (let ((saga_id (run-saga j g failure-step)))
      ;; Pull the saga status symbol and convert it to the canonical
      ;; uppercase string the stdout contract expects.
      (let ((status-sym (saga-status j saga_id))
            (status-str (status->string status-sym)))
        ;; Pull per-service final states. These four calls go through
        ;; the service views (svc-order / svc-payment / svc-inventory /
        ;; svc-fulfillment), which read each backing alist — they are
        ;; NOT string-matched against expected output.
        (let ((order-state       (svc-order       saga_id))
              (payment-state     (svc-payment     saga_id))
              (inventory-state   (svc-inventory   saga_id))
              (fulfillment-state (svc-fulfillment saga_id)))
          ;; Derive the audit trail by asking the compensator module to
          ;; walk the journal chronologically.
          (let ((audit (build-audit-trail j saga_id)))
            ;; Count completed / compensated steps by inspecting the
            ;; journal entries for this saga_id. We split on whether
            ;; the recorded step name starts with "compensate-" or
            ;; matches one of the forward step names.
            (let ((completed-count   (count-where
                                       (lambda (e)
                                         (forward-step? e))
                                       (journal-entries j saga_id)))
                  (compensated-count (count-where
                                       (lambda (e)
                                         (compensate-step? e))
                                       (journal-entries j saga_id))))
              ;; ---- print the contract ----
              (display "SAGA_ID=")            (display saga_id)            (newline)
              (display "SAGA_STATUS=")        (display status-str)         (newline)
              (display "ORDER_STATE=")        (display (symbol->string-or-sym order-state))       (newline)
              (display "PAYMENT_STATE=")      (display (symbol->string-or-sym payment-state))     (newline)
              (display "INVENTORY_HOLD_STATE=") (display (symbol->string-or-sym inventory-state))   (newline)
              (display "FULFILLMENT_STATE=")  (display (symbol->string-or-sym fulfillment-state)) (newline)
              (display "COMPLETED_STEPS=")    (display completed-count)    (newline)
              (display "COMPENSATED_STEPS=")  (display compensated-count)  (newline)
              (display "STEP_AUDIT=")         (display audit)              (newline))))))))

;; ---------------------------------------------------------------------
;; Small local helpers used only by main.aura.
;; ---------------------------------------------------------------------

;; The forward step names, in order. Used to classify journal entries.
(define forward-step-names
  '("auth" "inventory-hold" "payment-auth" "payment-capture" "fulfillment-kickoff"))

(define compensate-step-names
  '("compensate-auth" "compensate-inventory-hold"
    "compensate-payment-auth" "compensate-payment-capture"
    "compensate-fulfillment-kickoff"))

;; A journal entry is whatever (journal-entries …) returns. We treat it
;; opaquely and only check whether its string form contains the step
;; name. The state module is free to use any internal representation.
(define (entry-text e)
  (cond ((string? e) e)
        ((symbol? e) (symbol->string e))
        (else (display e) "")))

(define (forward-step? e)
  (let ((t (entry-text e)))
    (let loop ((rest forward-step-names))
      (cond ((null? rest) #f)
            ((string-contains? t (car rest)) #t)
            (else (loop (cdr rest)))))))

(define (compensate-step? e)
  (let ((t (entry-text e)))
    (let loop ((rest compensate-step-names))
      (cond ((null? rest) #f)
            ((string-contains? t (car rest)) #t)
            (else (loop (cdr rest)))))))

(define (string-contains? haystack needle)
  (let ((hl (string-length haystack))
        (nl (string-length needle)))
    (let loop ((i 0))
      (cond ((> (+ i nl) hl) #f)
            ((string=? (substring haystack i (+ i nl)) needle) #t)
            (else (loop (+ i 1)))))))

(define (substring s start end)
  (let loop ((i start) (acc '()))
    (if (>= i end)
        (list->string (reverse acc))
        (loop (+ i 1) (cons (string-ref s i) acc)))))

;; Defensive: convert a symbol (or string) to its display form. Falls
;; back to the value's textual form so the contract line is always
;; well-formed regardless of which variant the services module chose.
(define (symbol->string-or-sym x)
  (cond ((symbol? x) (symbol->string x))
        ((string? x) x)
        (else (display x) "")))
