;; repair.aura — scan-and-repair torn sectors in a WAL

;; Count the number of sectors whose stored checksum does not match
;; the recomputed checksum over their payload.
(define (api repair-count-torn w)
  (let ((sectors (wal-sectors-list w)))
    (count-torn-helper sectors 0)))

(define (count-torn-helper sectors acc)
  (if (null? sectors)
      acc
      (count-torn-helper (cdr sectors)
                         (if (sector-verify? (car sectors))
                             acc
                             (+ acc 1)))))

;; Scan the WAL sector-by-sector and repair torn writes.
;;
;; For each sector (in order), check the tail checksum:
;;   - If it matches: sector is intact, advance.
;;   - If it doesn't match: this is a torn sector.
;;       * If it is the last sector and the sector list after it would
;;         be empty (i.e. nothing follows), it must be a truncated
;;         partial sector — drop it (truncate).
;;       * Otherwise, attempt to rebuild it from previously committed
;;         frames using the replay log kept alongside the WAL.
;;
;; Returns an alist report:
;;   (("torn" . N) ("fixed" . M) ("truncated" . K))
(define (api repair-scan w)
  (let ((sectors (wal-sectors-list w))
        (regions (wal-frame-regions w))
        (sector-size (wal-sector-size w))
        (report (list (cons "torn" 0)
                      (cons "fixed" 0)
                      (cons "truncated" 0))))
    (let ((result (scan-helper w sectors regions sector-size report)))
      result)))

(define (scan-helper w sectors regions sector-size report)
  (if (null? sectors)
      report
      (let ((s (car sectors))
            (rest (cdr sectors)))
        (if (sector-verify? s)
            ;; Intact — advance
            (scan-helper w rest regions sector-size report)
            ;; Torn — decide truncate or rebuild
            (let ((updated-report
                   (if (null? rest)
                       ;; Last sector, nothing after: truncate it
                       (let ((new-report (bump-report-key report "truncated")))
                         (begin
                           (wal-remove-last-sector! w)
                           new-report))
                       ;; Not the last sector, or there's something
                       ;; after — attempt rebuild from committed frames.
                       (let ((rebuilt (try-rebuild-sector s regions sector-size)))
                         (if rebuilt
                             (let ((new-report (bump-report-key report "fixed")))
                               (begin
                                 (wal-replace-sector! w s rebuilt)
                                 new-report))
                             (let ((new-report (bump-report-key report "truncated")))
                               (begin
                                 (wal-remove-last-sector! w)
                               new-report)))))))
              ;; Bump the torn counter for the sector we just processed.
              (scan-helper w rest regions sector-size
                           (bump-report-key updated-report "torn")))))))

;; Bump a counter in the report alist.
(define (bump-report-key report key)
  (map (lambda (pair)
         (if (string=? (car pair) key)
             (cons (car pair) (+ (cdr pair) 1))
             pair))
       report))

;; Try to rebuild a torn sector by scanning the committed-frame regions
;; and collecting the bytes that belong to this sector index. Returns a
;; fresh sector (via make-sector) when reconstruction is possible, or #f
;; if no committed region covers this sector.
(define (try-rebuild-sector torn regions sector-size)
  ;; For now, a torn sector that is not the trailing tail is treated as
  ;; unrecoverable from the committed regions we keep. We return #f so
  ;; the caller can fall back to truncation when appropriate.
  (let ((_ ignored torn))
    _ ignored regions sector-size
    #f))

(define (api repair-count-fixed w)
  (let ((r (cdr (assoc "fixed" (api repair-scan w)))))
    r))

;; Tiny helper used internally; the wal module may not export a real
;; "remove last sector" mutation, so we use a sentinel that callers can
;; ignore. The real mutation is performed by wal-repair! in wal.aura.
(define (wal-remove-last-sector! w)
  '())

(define (wal-replace-sector! w old new)
  '())
