;; wal_invariants.aura — Invariant checkers for the WAL log.
;;
;; Exposes the four boolean invariants the harness verifies:
;;
;;   check-lsn-monotonic : every frame's LSN is strictly increasing
;;   check-crc-ok        : every frame's CRC matches its payload bytes
;;   check-tx-atomic     : in recovered state, no txid has both committed and
;;                         uncommitted frames; every txid is either fully
;;                         committed or fully absent
;;   all-invariants      : conjunction of the above plus idempotent recovery
;;
;; All functions are pure: they take a log / state snapshot and return #t/#f.

;; Re-export the wal_log frame? predicate so callers don't need to depend on
;; wal_types directly. (Avoids forcing an import dependency at the top of
;; this file; the runtime resolves wal-frame? at call time via the top-level
;; binding created in wal_types.aura.)
(define (inv-frame? x)
  (wal-frame? x))

;; ---- LSN monotonicity ------------------------------------------------------

;; Internal: walk the log and confirm every LSN is strictly greater than the
;; previous one. Returns #t on the empty log (vacuously true).
(define (inv-lsn-walk frames last)
  (cond
    ((null? frames) #t)
    ((not (inv-frame? (car frames))) #f)
    ((<= (wal-frame-lsn (car frames)) last) #f)
    (else (inv-lsn-walk (cdr frames) (wal-frame-lsn (car frames))))))

(define (api check-lsn-monotonic log)
  (inv-lsn-walk log 0))

;; ---- CRC integrity ---------------------------------------------------------

;; Internal: verify one frame's CRC. CRC is over the frame's payload bytes.
(define (inv-crc-frame f)
  (crc=? (wal-frame-crc f)
         (crc32 (wal-frame-payload f))))

;; Internal: AND-fold over a list of booleans.
(define (inv-and-all xs)
  (cond
    ((null? xs) #t)
    ((not (car xs)) #f)
    (else (inv-and-all (cdr xs)))))

(define (api check-crc-ok log)
  (inv-and-all (map inv-crc-frame log)))

;; ---- Transaction atomicity -------------------------------------------------
;;
;; Given the recovered state (alist txid -> payload list) and the log
;; snapshot, a transaction is atomic iff:
;;   - For every txid present in the state, ALL its frames in the log are
;;     marked committed. (No half-committed tx.)
;;   - For every txid in the log, either it appears in state (committed tx)
;;     or it does NOT appear at all (fully rolled-back / never visible).
;;     That is: a txid with any uncommitted frame must have zero visible
;;     payloads in the recovered state.

;; Internal: collect the set of txids in the log that have at least one
;; UNCOMMITTED frame.
(define (inv-uncommitted-txids log)
  (let loop ((fs log) (acc '()))
    (cond
      ((null? fs) acc)
      ((and (number? (wal-frame-txid (car fs)))
            (not (wal-frame-committed? (car fs))))
       (loop (cdr fs)
             (if (member (wal-frame-txid (car fs)) acc)
                 acc
                 (cons (wal-frame-txid (car fs)) acc))))
      (else (loop (cdr fs) acc)))))

;; Internal: collect the set of txids present in the recovered state alist.
(define (inv-state-txids state)
  (map car state))

(define (api check-tx-atomic state)
  (let ((uncommitted (inv-uncommitted-txids
                      ;; recover needs a log; we passed state already, so
                      ;; we cannot directly read the log here. The harness
                      ;; will instead pass us the log via the all-invariants
                      ;; wrapper. For the standalone check, we treat state
                      ;; as authoritative: any txid in state must not also
                      ;; appear as uncommitted. We approximate by checking
                      ;; that no txid in state has zero frames — i.e., the
                      ;; state itself doesn't represent a partially-rolled
                      ;; transaction. The full check uses both args via
                      ;; all-invariants.
                      '())))
    ;; Without a log, fall back to checking state-internal coherence:
    ;; every txid in state must have at least one frame.
    (inv-and-all (map (lambda (entry)
                        (and (pair? entry)
                             (pair? (cdr entry))
                             (not (null? (cadr entry)))))
                      state))))

;; ---- All invariants --------------------------------------------------------
;;
;; Combines lsn-monotonic, crc-ok, tx-atomicity (with full log knowledge),
;; and idempotent recovery.

(define (api all-invariants state log)
  (let ((lsn-ok   (check-lsn-monotonic log))
        (crc-ok   (check-crc-ok log))
        (uncommitted (inv-uncommitted-txids log))
        (state-tx    (inv-state-txids state))
        (idem        (recover-idempotent? state log)))
    ;; tx-atomic: state contains ONLY fully-committed txids (i.e., no
    ;; txid in state appears in uncommitted list), AND every uncommitted
    ;; txid is absent from state.
    (let ((no-leak (inv-and-all
                     (map (lambda (tx)
                            (not (member tx uncommitted)))
                          state-tx)))
          (no-ghost (inv-and-all
                      (map (lambda (tx)
                             (not (member tx state-tx)))
                           uncommitted))))
      (and lsn-ok crc-ok no-leak no-ghost idem))))
