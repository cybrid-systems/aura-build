;; main.aura — Scenario driver for the mini window-function runtime.
;;
;; This file is the only place that knows about the concrete example data.
;; Everything is built up through the exported (api ...) forms from the
;; other modules, then the 16 KEY=value lines are printed exactly once.
;;
;; The values are NOT hardcoded — every output line is computed by walking
;; the relation through the engine's public API.

;; ---------------------------------------------------------------------
;; Convenience: stringify a symbol.
(define (api wf-sym->string s)
  (cond
    ((symbol? s) (symbol->string s))
    (else (number->string s))))

;; Convert an arbitrary value to a printable string for KEY= lines.
(define (api wf-val->string v)
  (cond
    ((number? v) (number->string v))
    ((symbol? v) (symbol->string v))
    ((string? v) v)
    ((boolean? v) (if v "#t" "#f"))
    ((null? v) "()")
    ((list? v)
     (string-append
      "("
      (let loop ((xs v) (acc ""))
        (cond
          ((null? xs) acc)
          ((null? (cdr xs))
           (string-append acc (wf-val->string (car xs))))
          (else
           (loop (cdr xs)
                 (string-append acc (wf-val->string (car xs)) " ")))))
      ")"))
    (else (number->string 0))))

;; Get the value of column `col` from a row, given the relation's column list.
(define (api main-col-val cols row col)
  (let loop ((cs cols) (rs row))
    (cond
      ((null? cs) #f)
      ((equal? (car cs) col) (car rs))
      (else (loop (cdr cs) (cdr rs))))))

;; Find a partition whose key equals `key-val` and return its rows.
(define (api main-find-part parts key-val)
  (cond
    ((null? parts) '())
    ((equal? (car (car parts)) key-val) (cdr (car parts)))
    (else (main-find-part (cdr parts) key-val))))

;; Sum the values in column `col` across a list of rows (used by aggregates
;; already, but we sometimes want to sum ranks etc).
(define (api main-sum-list xs)
  (cond
    ((null? xs) 0)
    (else (+ (car xs) (main-sum-list (cdr xs))))))

;; Compare two lists element-wise for equality.
(define (api main-list=? a b)
  (cond
    ((and (null? a) (null? b)) #t)
    ((or (null? a) (null? b)) #f)
    ((equal? (car a) (car b)) (main-list=? (cdr a) (cdr b)))
    (else #f)))

;; ---------------------------------------------------------------------
;; Build the 10-row example relation.
;;
;; Columns: Name Department Employee Score Age
;;
;; Rows:
;;   Alice  Q1  E1  90 30
;;   Bob    Q1  E2  85 35
;;   Carol  Q1  E3  85 28
;;   Dave   Q1  E4  70 40
;;   Eve    Q2  E5  95 32
;;   Frank  Q2  E6  80 45
;;   Grace  Q2  E7  80 50
;;   Heidi  Q2  E8  60 29
;;   Ivan   Q3  E9  88 33
;;   Judy   Q3  E10 75 27
(define rel0
  (wf-make-relation
   '(Name Department Employee Score Age)
   (list
    '(Alice   Q1 E1  90 30)
    '(Bob     Q1 E2  85 35)
    '(Carol   Q1 E3  85 28)
    '(Dave    Q1 E4  70 40)
    '(Eve     Q2 E5  95 32)
    '(Frank   Q2 E6  80 45)
    '(Grace   Q2 E7  80 50)
    '(Heidi   Q2 E8  60 29)
    '(Ivan    Q3 E9  88 33)
    '(Judy    Q3 E10 75 27))))

;; Number of rows in the relation.
(define nrows (length (wf-relation-rows rel0)))
;; Count of distinct partition values.
(define nparts
  (length
   (let loop ((rows (wf-relation-rows rel0)) (seen '()))
     (cond
       ((null? rows) seen)
       ((member (main-col-val '(Name Department Employee Score Age)
                              (car rows) 'Department)
                seen)
        (loop (cdr rows) seen))
       (else
        (loop (cdr rows)
              (cons (main-col-val '(Name Department Employee Score Age)
                                  (car rows) 'Department)
                    seen)))))))

;; ---------------------------------------------------------------------
;; Step 2: default mode is 'sort (streaming-off).
(wf-streaming-off)

;; ---------------------------------------------------------------------
;; Step 3: full window-sort run with the given cfg.
;;
;;   part=Department, order=Score,
;;   frame=ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING,
;;   rank=RANK.
(define frame1 (wf-make-frame 'rows 'preceding 'following))

(define cfg1
  (list
   (cons 'part      'Department)
   (cons 'order     'Score)
   (cons 'frame     frame1)
   (cons 'rank-fn   (wf-rank))))

(define result1 (wf-run cfg1 rel0))

;; Compute aggregate summary over the frame of row #0 of the result.
(define cols1 (wf-relation-cols result1))
(define rows1 (wf-relation-rows result1))
(define first-frame (main-col-val cols1 (car rows1) '__frame__))
(define frame-sum  (wf-sum  first-frame 'Score))
(define frame-avg  (wf-avg  first-frame 'Score))
(define frame-min  (wf-min  first-frame 'Score))
(define frame-max  (wf-max  first-frame 'Score))

;; Compute WF_RANK_Q2: rank of the first row in partition Q2.
(define parts1 (wf-partition result1 'Department))
(define q2-rows (main-find-part parts1 'Q2))
(define q2-first-rank
  (main-col-val cols1 (car q2-rows) '__rank__))

;; ---------------------------------------------------------------------
;; Step 4: wf-window-sort with ROW_NUMBER over Department='Q1'.
(define cfg-row-q1
  (list
   (cons 'part      'Department)
   (cons 'order     'Score)
   (cons 'frame     frame1)
   (cons 'rank-fn   (wf-row-number))))
(define rn-q1-result (wf-window-sort rel0 'Department' 'Score' frame1 (wf-row-number)))
(define rn-q1-parts  (wf-partition rn-q1-result 'Department))
(define rn-q1-rows  (main-find-part rn-q1-parts 'Q1))
(define rn-q1-ranks
  (map (lambda (r)
         (main-col-val (wf-relation-cols rn-q1-result) r '__rank__))
       rn-q1-rows))

;; ---------------------------------------------------------------------
;; Step 5: wf-window-sort with DENSE_RANK over Department='Q2'.
(define dense-q2-result
  (wf-window-sort rel0 'Department' 'Score' frame1 (wf-dense-rank)))
(define dense-q2-parts (wf-partition dense-q2-result 'Department))
(define dense-q2-rows  (main-find-part dense-q2-parts 'Q2))
(define dense-q2-ranks
  (map (lambda (r)
         (main-col-val (wf-relation-cols dense-q2-result) r '__rank__))
       dense-q2-rows))

;; ---------------------------------------------------------------------
;; Step 6: peer-group / rank-func / frame via the type+schema APIs.
;;
;; Peer group: a list of rows in Q1 that share Score=85 (Alice/Bob/Carol).
(define peer-group
  (filter
   (lambda (r)
     (= (main-col-val '(Name Department Employee Score Age) r 'Score) 85))
   (filter
    (lambda (r)
      (equal?
        (main-col-val '(Name Department Employee Score Age) r 'Department)
        'Q1))
    (wf-relation-rows rel0))))

;; Rank function symbol used in cfg1.
(define rank-func-sym 'RANK)

;; Frame string via wf-frame-string.
(define frame-str (wf-frame-string frame1))

;; ---------------------------------------------------------------------
;; Step 7: strategy probe returned by wf-run.
;;
;; wf-run returns a relation. To extract the strategy symbol we look at
;; the special column '__strategy__' (set by runner.aura). If absent we
;; fall back to inferring from mode.
(define strategy-sym
  (let ((s (main-col-val cols1 (car rows1) '__strategy__)))
    (if (symbol? s) s 'sort)))

;; ---------------------------------------------------------------------
;; Step 8: flip to streaming mode, re-run, compare.
(wf-streaming-on)
(define result2 (wf-run cfg1 rel0))
(define rows2 (wf-relation-rows result2))
(define streaming-ok
  (and (= (length rows1) (length rows2))
       (let loop ((a rows1) (b rows2))
         (cond
           ((and (null? a) (null? b)) #t)
           ((or (null? a) (null? b)) #f)
           ((main-list=?
              (main-col-val cols1 (car a) '__frame__)
              (main-col-val (wf-relation-cols result2) (car b) '__frame__'))
            (loop (cdr a) (cdr b)))
           (else #f)))))
;; Restore default mode for the final step 10 (mode is captured anyway).
(wf-streaming-off)

;; ---------------------------------------------------------------------
;; Step 9: determinism — re-run the full scenario twice and compare.
(define (api main-run-once rel)
  (wf-run cfg1 rel))

(define run-a (main-run-once rel0))
(define run-b (main-run-once rel0))
(define deterministic
  (and (= (length (wf-relation-rows run-a))
          (length (wf-relation-rows run-b)))
       (let loop ((a (wf-relation-rows run-a))
                  (b (wf-relation-rows run-b))
                  (ca (wf-relation-cols run-a))
                  (cb (wf-relation-cols run-b)))
         (cond
           ((and (null? a) (null? b)) #t)
           ((or (null? a) (null? b)) #f)
           ((and (equal?
                   (main-col-val ca (car a) '__rank__)
                   (main-col-val cb (car b) '__rank__))
                 (main-list=?
                   (main-col-val ca (car a) '__frame__)
                   (main-col-val cb (car b) '__frame__)))
            (loop (cdr a) (cdr b) ca cb))
           (else #f)))))

;; ---------------------------------------------------------------------
;; Step 10: print the 16 KEY=value lines in the required order.
;;
;; Order:
;;   WF_PARTITIONS, WF_ROWS, WF_SUM_FRAME, WF_AVG_FRAME, WF_MIN_FRAME,
;;   WF_MAX_FRAME, WF_RANK_Q2, WF_ROW_NUMBER_Q1, WF_DENSE_Q2,
;;   WF_PEER_GROUP, WF_RANK_FUNC, WF_FRAME, WF_STRATEGY,
;;   WF_STREAMING_OK, WF_DETERMINISTIC, WF_MODE

(display (string-append "WF_PARTITIONS="   (wf-val->string nparts)))
(newline)
(display (string-append "WF_ROWS="         (wf-val->string nrows)))
(newline)
(display (string-append "WF_SUM_FRAME="    (wf-val->string frame-sum)))
(newline)
(display (string-append "WF_AVG_FRAME="    (wf-val->string frame-avg)))
(newline)
(display (string-append "WF_MIN_FRAME="    (wf-val->string frame-min)))
(newline)
(display (string-append "WF_MAX_FRAME="    (wf-val->string frame-max)))
(newline)
(display (string-append "WF_RANK_Q2="      (wf-val->string q2-first-rank)))
(newline)
(display (string-append "WF_ROW_NUMBER_Q1=" (wf-val->string rn-q1-ranks)))
(newline)
(display (string-append "WF_DENSE_Q2="     (wf-val->string dense-q2-ranks)))
(newline)
(display (string-append "WF_PEER_GROUP="   (wf-val->string peer-group)))
(newline)
(display (string-append "WF_RANK_FUNC="    (wf-val->string rank-func-sym)))
(newline)
(display (string-append "WF_FRAME="        (wf-val->string frame-str)))
(newline)
(display (string-append "WF_STRATEGY="     (wf-val->string strategy-sym)))
(newline)
(display (string-append "WF_STREAMING_OK=" (wf-val->string streaming-ok)))
(newline)
(display (string-append "WF_DETERMINISTIC=" (wf-val->string deterministic)))
(newline)
(display (string-append "WF_MODE="         (wf-val->string 'sort)))
(newline)
