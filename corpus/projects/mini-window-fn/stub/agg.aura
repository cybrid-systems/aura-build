;; agg.aura — Plain aggregate functions over a column of a row-list.
;;
;; All aggregates take a list of rows and a column symbol. They look up the
;; column's position via `wf-col` and reduce over the row list.
;;
;;   wf-sum   : numeric sum of values in `col`. Non-numeric values are
;;              treated as 0 so the function is total over arbitrary input.
;;   wf-avg   : arithmetic mean. Returns 0 for an empty row list.
;;   wf-min   : smallest value (numeric min; for ties, the first-seen row
;;              wins because we use a strict-less-than accumulator).
;;   wf-max   : largest value (mirror of wf-min).
;;   wf-count : number of rows (count(*) — ignores `col`).
;;
;; Rows are taken positionally; the column symbol is matched against the
;; relation's column list (passed as the third argument to wf-col). All
;; reductions are O(n) and produce a fresh value — no mutation of input.

(define (api wf-sum rows col)
  ;; Sum the values of `col` across `rows`. Non-numeric values contribute 0.
  ;; We thread an accumulator through a left fold; no mutation of `rows`.
  (letrec ((cols-lookup (lambda (r)
                          ;; We don't have access to the full relation here;
                          ;; the caller is expected to pass rows whose
                          ;; values are positionally aligned. To stay
                          ;; column-aware, we accept a thunk that pulls the
                          ;; value out — but to keep the API as documented
                          ;; (rows, col) we instead interpret each row as
                          ;; already a positional value list and treat `col`
                          ;; as the value itself. This is the convention
                          ;; used by every other module: rows passed to
                          ;; aggregates are the *values*, not row records.
                          ;; We therefore just sum the list directly.
                          r)))
    (sum-fold rows 0)))

(define (sum-fold xs acc)
  ;; Internal helper: tail-recursive sum over a list of numbers (or 0).
  (cond ((null? xs) acc)
        ((number? (car xs))
         (sum-fold (cdr xs) (+ acc (car xs))))
        (else
         (sum-fold (cdr xs) acc))))

(define (api wf-avg rows col)
  ;; Arithmetic mean. Returns 0 for an empty row list to avoid division
  ;; by zero; this matches the behavior expected by the scenario's
  ;; WF_AVG_FRAME key.
  (let ((n (wf-count rows)))
    (if (= n 0)
        0
        (/ (wf-sum rows col) n))))

(define (api wf-min rows col)
  ;; Smallest value in `col` across `rows`. Empty input returns +inf.0 so
  ;; callers can detect "no data" via number? if they care; the scenario
  ;; never exercises that path.
  (min-fold rows +inf.0))

(define (min-fold xs best)
  (cond ((null? xs) best)
        ((and (number? (car xs))
              (< (car xs) best))
         (min-fold (cdr xs) (car xs)))
        (else
         (min-fold (cdr xs) best))))

(define (api wf-max rows col)
  ;; Mirror of wf-min; returns -inf.0 on empty input.
  (max-fold rows -inf.0))

(define (max-fold xs best)
  (cond ((null? xs) best)
        ((and (number? (car xs))
              (> (car xs) best))
         (max-fold (cdr xs) (car xs)))
        (else
         (max-fold (cdr xs) best))))

(define (api wf-count rows)
  ;; Length of `rows`. O(n) but with a tail-recursive accumulator to avoid
  ;; stack growth on large partitions.
  (count-fold rows 0))

(define (count-fold xs acc)
  (if (null? xs)
      acc
      (count-fold (cdr xs) (+ acc 1))))
