;; hex.aura — Hexadecimal encoding helpers.
;;
;; Exposes:
;;   (hex-of-byte b)   -> 2-char uppercase hex string for a single byte (0-255)
;;   (hex-of-word n)   -> 4-char uppercase hex string for a 16-bit word (0-65535)
;;
;; Both functions are total over the non-negative integer range and pad
;; with leading zeros so output widths are stable. They are used by
;; report.aura and logfmt.aura for printing byte offsets, CRCs, dict ids,
;; frame lengths, etc.

(define (hex-of-byte b)
  (let ((n (modulo b 256)))
    (let ((hi (quotient n 16))
          (lo (modulo n 16)))
      (string-append (hex-nibble hi) (hex-nibble lo)))))

(define (hex-of-word n)
  (let ((v (modulo n 65536)))
    (let ((b1 (quotient v 256))
          (b0 (modulo v 256)))
      (string-append (hex-of-byte b1) (hex-of-byte b0)))))

;; Internal: hex-nibble returns the uppercase hex character for 0-15.
(define (hex-nibble n)
  (cond ((= n 0) "0")
        ((= n 1) "1")
        ((= n 2) "2")
        ((= n 3) "3")
        ((= n 4) "4")
        ((= n 5) "5")
        ((= n 6) "6")
        ((= n 7) "7")
        ((= n 8) "8")
        ((= n 9) "9")
        ((= n 10) "A")
        ((= n 11) "B")
        ((= n 12) "C")
        ((= n 13) "D")
        ((= n 14) "E")
        ((= n 15) "F")
        (else "0")))
