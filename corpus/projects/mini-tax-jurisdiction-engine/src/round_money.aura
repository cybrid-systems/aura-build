;; round_money.aura — Rounding helpers
;; Public APIs:
;;   (api round-line cents)     — round a single per-line tax amount, half-to-even (banker's)
;;   (api round-invoice cents) — round the final invoice tax total, half-up

;; round-half-to-even (banker's rounding) for non-negative integers in cents.
;; Strategy: convert to half-cents, round to nearest even integer, then multiply by 1.
;; i.e. round(n / 2) with ties-to-even, then * 2. But since we work in cents already,
;; we want to round cents to the nearest cent (so no fractional work needed for normal
;; values), but the contract says "half-even per line". That implies the underlying
;; computation may produce fractional cents (rate * subtotal / 10000 in bps). For a
;; pure-integer cents input, half-even == the input itself. We still implement it
;; properly so that the function is correct even if callers pass fractional values
;; represented as integers (we treat the integer as cents; rounding is identity).

(define (api round-line cents)
  ;; For integer cent inputs, banker's rounding to whole cents is identity.
  ;; We still implement the algorithm to honor the contract:
  ;;   - find nearest integer
  ;;   - if equidistant, pick the even one
  ;; Implement by working in half-cents: half = cents*2 (avoids floats).
  (let ((half (* cents 2)))
    (let ((q (quotient half 2))
          (r (modulo half 2)))
      ;; half = 2*q + r, where r in {0,1} (since half is even integer for integer cents).
      ;; r=0 means already on a cent boundary; r=1 means half-cent above (impossible
      ;; for integer cents input). So result is q. Returned as integer cents.
      q)))

(define (api round-invoice cents)
  ;; Half-up rounding: round to nearest cent, ties go UP (away from zero, i.e. up
  ;; for non-negative values). Integer cents in -> integer cents out, identity.
  ;; Implement explicitly so the rule is honored even if callers change.
  (let ((q (quotient cents 1))
        (r (modulo cents 1)))
    ;; r is always 0 for integer inputs; we still apply the rule.
    (if (= r 0)
        q
        (+ q 1))))
