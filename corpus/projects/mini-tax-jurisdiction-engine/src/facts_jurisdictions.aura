;; facts_jurisdictions.aura — Per-jurisdiction composite tax rates
;; Public API: (api load-jurisdiction-rates) -> alist of jid -> rate-bps
;;
;; Rate is the COMPOSITE rate (state + local) in basis points (bps).
;; 100 bps = 1.00%, so 875 = 8.75%, 1000 = 10.00%, etc.
;;
;; A jurisdiction id (jid) is a composite string like:
;;   "jid-<state>-<county-or-city>"
;; or "jid-<state>-state" for the bare state portion when no local match.

(define (api load-jurisdiction-rates)
  (list
    ;; California — destination-based, varies by locality
    (cons "jid-ca-state"                  750)   ; CA state base 7.25% (we use a rounded 7.50%)
    (cons "jid-ca-los-angeles"            975)   ; LA County + city combined ~9.75%
    (cons "jid-ca-san-francisco"          863)   ; SF combined ~8.625% (treat as 8.63%)
    (cons "jid-ca-alameda-oakland"        1030)  ; Alameda + Oakland ~10.30%
    (cons "jid-ca-alameda-berkeley"       1030)  ; Alameda + Berkeley ~10.30%
    (cons "jid-ca-alameda"                 900)  ; Alameda county unincorporated ~9.00%

    ;; New York — destination-based
    (cons "jid-ny-state"                  400)   ; NY state 4.00%
    (cons "jid-ny-new-york"               888)   ; NYC combined 8.88%
    (cons "jid-ny-king"                   1015)  ; King (Seattle area proxy) — actually use for test
    ;; (correct NY entries)
    (cons "jid-ny-nassau"                 863)   ; Nassau ~8.625%
    (cons "jid-ny-westchester"            833)   ; Westchester ~8.33%

    ;; Oregon — origin-based, no destination sales tax
    (cons "jid-or-state"                    0)   ; OR has no statewide sales tax
    (cons "jid-or-multnomah-portland"       0)   ; Portland local taxes not modeled

    ;; New Hampshire — origin-based, no sales tax
    (cons "jid-nh-state"                    0)

    ;; Texas — destination-based
    (cons "jid-tx-state"                  625)   ; TX state 6.25%
    (cons "jid-tx-travis-austin"          825)   ; Austin combined ~8.25%
    (cons "jid-tx-harris-houston"         825)   ; Houston combined ~8.25%
    (cons "jid-tx-dallas-dallas"          825)   ; Dallas combined ~8.25%

    ;; Washington — destination-based
    (cons "jid-wa-state"                  650)   ; WA state 6.50%
    (cons "jid-wa-king-seattle"          1025)   ; Seattle combined ~10.25%

    ;; Florida — destination-based
    (cons "jid-fl-state"                  600)   ; FL state 6.00%
    (cons "jid-fl-miami-dade-miami"       700)   ; Miami-Dade + Miami ~7.00%
    (cons "jid-fl-orange-orlando"         650)   ; Orange + Orlando ~6.50%

    ;; Illinois — destination-based, with a high city rate
    (cons "jid-il-state"                  625)   ; IL state 6.25%
    (cons "jid-il-cook-chicago"          1025)   ; Chicago combined ~10.25%

    ;; Massachusetts — destination-based
    (cons "jid-ma-state"                  625)   ; MA state 6.25%
    (cons "jid-ma-suffolk-boston"         625)   ; Boston flat 6.25% (no local add)

    ;; Nevada — destination-based
    (cons "jid-nv-state"                  685)   ; NV state 6.85%
    (cons "jid-nv-clark-las-vegas"        885)   ; Las Vegas ~8.85%
    ))
