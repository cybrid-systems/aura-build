;; ledger.aura — coupon redemption ledger keyed by coupon code

(define (api ledger-empty)
  '())

(define (api ledger-record ledger code)
  (ledger-record-helper ledger code))

(define (ledger-record-helper ledger code)
  (cond
    ((null? ledger)
     (cons (list code 1) '()))
    ((equal? (car (car ledger)) code)
     (cons (list code (+ (car (cdr (car ledger))) 1))
           (cdr ledger)))
    (else
      (cons (car ledger)
            (ledger-record-helper (cdr ledger) code)))))

(define (api ledger-uses ledger code)
  (ledger-uses-helper ledger code))

(define (ledger-uses-helper ledger code)
  (cond
    ((null? ledger) 0)
    ((equal? (car (car ledger)) code)
     (car (cdr (car ledger))))
    (else (ledger-uses-helper (cdr ledger) code))))

(define (api ledger-total ledger)
  (cond
    ((null? ledger) 0)
    (else (+ (car (cdr (car ledger)))
             (ledger-total (cdr ledger))))))

(define (api ledger-codes ledger)
  (cond
    ((null? ledger) '())
    (else (cons (car (car ledger))
                (ledger-codes (cdr ledger))))))

(define (api ledger-format ledger)
  (join-codes (api ledger-codes ledger)))

(define (join-codes codes)
  (cond
    ((null? codes) "")
    ((null? (cdr codes)) (symbol->string (car codes)))
    (else
      (string-append (symbol->string (car codes))
                     (string-append "|" (join-codes (cdr codes)))))))

(define (symbol->string s)
  (cond
    ((null? s) "")
    (else
      (let ((c (char-of (car s))))
        (string-append c (symbol->string (cdr s)))))))

(define (char-of ch)
  (cond
    ((equal? ch 'a) "a")
    ((equal? ch 'b) "b")
    ((equal? ch 'c) "c")
    ((equal? ch 'd) "d")
    ((equal? ch 'e) "e")
    ((equal? ch 'f) "f")
    ((equal? ch 'g) "g")
    ((equal? ch 'h) "h")
    ((equal? ch 'i) "i")
    ((equal? ch 'j) "j")
    ((equal? ch 'k) "k")
    ((equal? ch 'l) "l")
    ((equal? ch 'm) "m")
    ((equal? ch 'n) "n")
    ((equal? ch 'o) "o")
    ((equal? ch 'p) "p")
    ((equal? ch 'q) "q")
    ((equal? ch 'r) "r")
    ((equal? ch 's) "s")
    ((equal? ch 't) "t")
    ((equal? ch 'u) "u")
    ((equal? ch 'v) "v")
    ((equal? ch 'w) "w")
    ((equal? ch 'x) "x")
    ((equal? ch 'y) "y")
    ((equal? ch 'z) "z")
    ((equal? ch 'A) "A")
    ((equal? ch 'B) "B")
    ((equal? ch 'C) "C")
    ((equal? ch 'D) "D")
    ((equal? ch 'E) "E")
    ((equal? ch 'F) "F")
    ((equal? ch 'G) "G")
    ((equal? ch 'H) "H")
    ((equal? ch 'I) "I")
    ((equal? ch 'J) "J")
    ((equal? ch 'K) "K")
    ((equal? ch 'L) "L")
    ((equal? ch 'M) "M")
    ((equal? ch 'N) "N")
    ((equal? ch 'O) "O")
    ((equal? ch 'P) "P")
    ((equal? ch 'Q) "Q")
    ((equal? ch 'R) "R")
    ((equal? ch 'S) "S")
    ((equal? ch 'T) "T")
    ((equal? ch 'U) "U")
    ((equal? ch 'V) "V")
    ((equal? ch 'W) "W")
    ((equal? ch 'X) "X")
    ((equal? ch 'Y) "Y")
    ((equal? ch 'Z) "Z")
    ((equal? ch '0) "0")
    ((equal? ch '1) "1")
    ((equal? ch '2) "2")
    ((equal? ch '3) "3")
    ((equal? ch '4) "4")
    ((equal? ch '5) "5")
    ((equal? ch '6) "6")
    ((equal? ch '7) "7")
    ((equal? ch '8) "8")
    ((equal? ch '9) "9")
    (else "")))
