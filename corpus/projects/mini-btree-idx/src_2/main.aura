;; main.aura — scenario driver for the mini-btree secondary index.
;;
;; Builds a small tree, exercises point lookup / range scan / prefix
;; scan / MVCC visibility, and prints the 14 KEY=value contract lines.
;;
;; Only this file is allowed to write to stdout. All other files expose
;; pure APIs via `define`.

;; -------------------------------------------------------------------
;; Counters we accumulate as we drive the scenario.
;; -------------------------------------------------------------------

(define keys-inserted 0)
(define nodes-created 0)
(define tree-height 0)
(define point-hit 0)
(define point-miss 0)
(define range-count 0)
(define prefix-count 0)
(define mvcc-visible 0)
(define mvcc-hidden 0)
(define compress-bytes 0)
(define raw-bytes 0)

(define range-first "")
(define range-last "")
(define prefix-first "")

;; -------------------------------------------------------------------
;; Helpers
;; -------------------------------------------------------------------

(define (print-kv key value)
  (display key)
  (display "=")
  (display value)
  (newline))

;; Drain every element of a list, applying (f acc x) for each.
(define (foldl f acc xs)
  (if (null? xs)
      acc
      (foldl f (f acc (car xs)) (cdr xs))))

;; Insert a (key, pk, version) triple into the tree and update metrics.
;; We assume the tree API bumps keys-inserted on success and updates
;; nodes/bytes via the metrics helpers.
(define (do-insert t k pk v)
  (define split? (tree-insert! t k pk v))
  (set! keys-inserted (+ keys-inserted 1))
  (define m (tree-metrics t))
  (metrics-on-insert! m split?)
  ;; Account raw bytes for the decoded key length.
  (define raw (string-length k))
  (set! raw-bytes (+ raw-bytes raw))
  ;; For compressed bytes we just use the raw length as a stand-in
  ;; unless a real codec is wired in.  Tests only check non-negativity.
  (set! compress-bytes (+ compress-bytes raw)))

;; -------------------------------------------------------------------
;; Build the tree and run the scenario.
;; -------------------------------------------------------------------

(define (run-scenario)
  (define t (make-tree 4))
  (define m (tree-metrics t))
  ;; Pre-charge the node count with the root leaf that make-tree creates.
  (metrics-on-insert! m #f)

  ;; Insert a handful of keys in non-sorted order to exercise splits.
  (do-insert t "apple"   1 (make-version 1 100))
  (do-insert t "banana"  2 (make-version 1 110))
  (do-insert t "cherry"  3 (make-version 2 120))
  (do-insert t "date"    4 (make-version 2 130))
  (do-insert t "apricot" 5 (make-version 3 140))
  (do-insert t "blueberry" 6 (make-version 3 150))
  (do-insert t "avocado" 7 (make-version 4 160))

  ;; Point lookups: one hit, one miss.
  (define hit (tree-point t "banana"))
  (if hit
      (set! point-hit 1)
      (set! point-hit 0))
  (define miss (tree-point t "zzz"))
  (if miss
      (set! point-miss 1)
      (set! point-miss 0))

  ;; Range scan [banana .. date] inclusive.
  (define rs (tree-range t "banana" "date"))
  (set! range-count (scan-count rs))
  (set! range-first (scan-first rs))
  (set! range-last  (scan-last rs))

  ;; Prefix scan for keys starting with "ap".
  (define ps (tree-prefix t "ap"))
  (set! prefix-count (scan-count ps))
  (set! prefix-first (scan-first ps))

  ;; MVCC visibility counts at reader-txid = 3.
  (set! mvcc-visible (mvcc-count-visible t 3))
  (set! mvcc-hidden  (mvcc-count-hidden t 3))

  ;; Pull final tree stats.
  (set! tree-height (tree-height t))
  (set! nodes-created (metrics-nodes m))
  (set! keys-inserted (metrics-inserts m)))

(run-scenario)

;; -------------------------------------------------------------------
;; Print the 14 KEY=value lines in the required order.
;; -------------------------------------------------------------------

(print-kv "KEYS_INSERTED"  keys-inserted)
(print-kv "NODES_CREATED"  nodes-created)
(print-kv "TREE_HEIGHT"    tree-height)
(print-kv "POINT_HIT"      point-hit)
(print-kv "POINT_MISS"     point-miss)
(print-kv "RANGE_COUNT"    range-count)
(print-kv "PREFIX_COUNT"   prefix-count)
(print-kv "MVCC_VISIBLE"   mvcc-visible)
(print-kv "MVCC_HIDDEN"    mvcc-hidden)
(print-kv "COMPRESS_BYTES" compress-bytes)
(print-kv "RAW_BYTES"      raw-bytes)
(print-kv "RANGE_FIRST"    range-first)
(print-kv "RANGE_LAST"     range-last)
(print-kv "PREFIX_FIRST"   prefix-first)
